rved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":null,\"showMark\":false,\"tagList\":[],\"title\":\"Black Clover 2nd Season\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"电影精选\",\"coverType\":1,\"homeSectionId\":22227,\"homeSectionName\":\"Film Pilihan\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":1,\"name\":\"18+\",\"sort\":1},{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260615/1781508106958_554a25de5d738c9e9bccf49e716cac73蓝色电影v.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":149940,\"imageUrl\":\"https://img.netpop.app/cover/20260615/1781508100070_e2fa7b51da955db95de5b1c70147e57c蓝色电影.webp\",\"introduction\":\"Camboy fetish Aaron Eagle setuju untuk bermalam dengan klien anonim, hanya untuk menemukan ikatan yang mengganggu dengan masa lalunya.\",\"jumpAddress\":\"tiktik://jump/detail?id=149940&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":8,\"rankDesc\":\"Romance daftar Peringkat 2\",\"rankId\":140,\"rankType\":1},\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"LGBTQ\",\"Dewasa\"],\"title\":\"Blue Film\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260709/1783576567442_317a41319814db0bde6e37eb790439c9鬼玩人6：炼狱1.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":155000,\"imageUrl\":\"https://img.netpop.app/cover/20260709/1783576557079_20b8838508eca556997dad96bf50926c鬼玩人6：炼狱.webp\",\"introduction\":\"Setelah kehilangan suaminya, seorang wanita mencari hiburan bersama mertuanya. Saat satu demi satu mereka berubah menjadi orang mati, dia menyadari bahwa sumpah yang dia ambil dalam hidup - bertahan bahkan dalam kematian.\",\"jumpAddress\":\"tiktik://jump/detail?id=155000&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"HOT daftar Peringkat 2\",\"rankId\":5,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Horor\",\"Tegang\"],\"title\":\"Evil Dead Burn\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260507/1778139338032_1d48eb9147181117ca567c7994e23dbe2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":138661,\"imageUrl\":\"https://img.netpop.app/cover/20260507/1778139335031_df502329b44cd9173a494f210a8630f51.jpg\",\"introduction\":\"Setelah pasien seorang terapis menghilang ke dalam dimensi di luar kenyataan, dia harus menjelajah ke tempat yang tidak diketahui untuk menyelamatkannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=138661&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"American daftar Peringkat 4\",\"rankId\":148,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\"],\"title\":\"Backrooms\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260708/1783503464980_541f77dd3c0e8f58f4b05464520f578e行走天际：极限爱情故事X.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":154910,\"imageUrl\":\"https://img.netpop.app/cover/20260708/1783503458503_88c1b1af9dfcf01214797b1ad23abb9a行走天际：极限爱情故事.webp\",\"introduction\":\"Sepasang suami istri yang berani melakukan perjalanan ke seluruh dunia untuk mendaki gedung pencakar langit megatall 118 lantai, Merdeka 118, di Kuala Lumpur, Malaysia, mencoba aksi akrobatik yang berani di puncak menara untuk menyelamatkan karier dan hubungan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=154910&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Dokumentari\"],\"title\":\"Skywalkers: A Love Story\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260522/1779415034339_38f6c9336c4239e57150e65898861ee9鬼上车M.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":143487,\"imageUrl\":\"https://img.netpop.app/cover/20260522/1779415016418_3e505092de1f5b54086119668e92123c鬼上车.webp\",\"introduction\":\"Setelah pasangan muda menyaksikan kecelakaan jalan raya yang mengerikan, mereka segera menyadari bahwa mereka tidak meninggalkan lokasi kecelakaan sendirian, karena kehadiran setan yang disebut Penumpang tidak akan berhenti sampai mereka berdua hilang.\",\"jumpAddress\":\"tiktik://jump/detail?id=143487&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.6,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Passenger\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260605/1780651297197_05884f93c5d75049ae38962664fa2ff3十尺尖牢U.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":147686,\"imageUrl\":\"https://img.netpop.app/cover/20260605/1780651288368_628f78be3e33bd7ac5cf1dc8eff3f9a1十尺尖牢.webp\",\"introduction\":\"Setelah seorang pemuda terpisah dari teman-temannya saat berada di hutan, dia terjatuh ke dalam lubang paku sedalam 10 kaki, menusuk kakinya, dan membiarkannya terjebak. Dia segera mengetahui bahwa kejatuhannya bukanlah suatu kecelakaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=147686&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.3,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Pitfall\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260626/1782452094617_c3416f9b6ad1082e02aa333fc6882723蔷薇修剪术E.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":153038,\"imageUrl\":\"https://img.netpop.app/cover/20260626/1782452088985_c03424e980425e4be226aac2bfd0666a蔷薇修剪术.webp\",\"introduction\":\"Sebuah keluarga yang berjuang dengan penyakit genetik tinggal di kawasan pedesaan. Drama pribadi berkembang di antara mereka dalam potret intim ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=153038&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.7,\"showMark\":false,\"tagList\":[\"Komedi\",\"Thriller\"],\"title\":\"Rosebush Pruning\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260701/1782894998834_4f53db4926017652903ea1c4ae1b59aeqtYKFgFZNEOtsmgl9Iax0gFJcWN.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":146952,\"imageUrl\":\"https://img.netpop.app/cover/20260603/1780476787518_47cc0ad046b3fcdeb33180a6100fb6a01.jpg\",\"introduction\":\"Detektif Enola Holmes berangkat ke Malta, tempat cita-citanya menyatu dalam kasusnya yang paling rumit dan berbahaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=146952&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Kriminal\",\"Tegang\"],\"title\":\"Enola Holmes 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260629/1782701610138_ab9925e6231865100b2debadbcfd6f613XoVGJB2oTwriRYKk0l0TWm9yvN.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":153304,\"imageUrl\":\"https://img.netpop.app/cover/20260629/1782701607216_fc9959b9477b7cbaa7a03fe31bf40c186LmJD3Wohe0g4U62wgi7RyJqfE4.webp\",\"introduction\":\"Seorang pria mengambil keadilan ke tangannya sendiri, memburu penjahat. Aksi main hakim sendiri membuatnya menjadi bintang media sosial namun membuatnya berselisih dengan kepala polisi setempat.\",\"jumpAddress\":\"tiktik://jump/detail?id=153304&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Thriller\"],\"title\":\"Citizen Vigilante\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260515/1778822866107_0bb1b383049a4714db109fa8f33e74da痴迷u.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":141411,\"imageUrl\":\"https://img.netpop.app/cover/20260515/1778822860081_e792d33f12a4a133c8d236225ff13297痴迷.webp\",\"introduction\":\"Setelah menghancurkan \\\"One Wish Willow\\\" yang misterius untuk memenangkan hati kekasihnya, seorang romantis yang putus asa mendapati dirinya mendapatkan apa yang dia minta, tetapi segera menyadari bahwa beberapa keinginan harus dibayar dengan harga yang kelam dan mengerikan.\",\"jumpAddress\":\"tiktik://jump/detail?id=141411&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":8,\"rankDesc\":\"Populeritas Tertinggi daftar Peringkat 1\",\"rankId\":12,\"rankType\":1},\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Obsession\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260618/1781778318631_b7f194bee218bc2700b671e489a4e9412.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":151241,\"imageUrl\":\"https://img.netpop.app/cover/20260618/1781778316051_ce00a24df951c01bc8f9bab96d2377671.jpg\",\"introduction\":\"Bergulat dengan masa lalunya setelah kehidupan kriminal dan pembunuhan, Robin Hood mendapati dirinya terluka parah setelah pertempuran yang dia pikir akan menjadi yang terakhir. Di tangan seorang wanita misterius, dia ditawari kesempatan untuk diselamatkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=151241&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\"],\"title\":\"The Death of Robin Hood\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260513/1778662684828_349c7919c019fb68c40b3402aa1720c4lAHsO8hwVHO1SBnV6ki418I1SZ9.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":140734,\"imageUrl\":\"https://img.netpop.app/cover/20260513/1778662679576_32687b4cb4420d92afe71e335b053b274Iqcc8F0A8jVyXNTXZIAVXSZf8D.webp\",\"introduction\":\"Pekerjaan Woody, Buzz, Jessie, dan anggota geng lainnya tertantang saat mereka diperkenalkan dengan perangkat elektronik, sebuah ancaman baru terhadap waktu bermain.\",\"jumpAddress\":\"tiktik://jump/detail?id=140734&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"Animated Film daftar Peringkat 1\",\"rankId\":200,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Komedi\",\"Fantasi\"],\"title\":\"Toy Story 5\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260311/1773215631881_ef6840aee6fc1d38c58cc00643821d202cr7imTLVSSrzgL3bFKAMCMdgKw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":129733,\"imageUrl\":\"https://img.netpop.app/cover/20260311/1773215626174_f300bf1e318aebbb5a0124fc309561a5k0eYP3ZsgJDGl0ZN28lzJVCIqQI.jpg\",\"introduction\":\"Mengikuti perjuangan Miranda Priestly melawan Emily Charlton, mantan asistennya yang menjadi eksekutif saingan, saat mereka bersaing untuk mendapatkan pendapatan iklan di tengah menurunnya media cetak sementara Miranda hampir pensiun.\",\"jumpAddress\":\"tiktik://jump/detail?id=129733&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Komedi\"],\"title\":\"The Devil Wears Prada 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260623/1782203024018_c487f75f9806ad437ec49ddef2a9a648wivNPOtg6saz1XrCTU3C7sYYFt6.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":151980,\"imageUrl\":\"https://img.netpop.app/cover/20260623/1782203021016_734311f499522e9e0e232090ab0caaa91qeO6qbbOXFkwN19aCWQAlmpbHQ.webp\",\"introduction\":\"Di atas kereta berkecepatan tinggi, seorang biarawati yang kehilangan kepercayaannya harus melakukan pengusiran setan pertamanya pada penumpang yang kesurupan yang sangat ingin menabrakkan kereta yang sedang melaju.\",\"jumpAddress\":\"tiktik://jump/detail?id=151980&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":3.4,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Speed Demon\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260528/1779958115497_97328e6fb291a36f32b14ebb5166d539调音师p.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":145461,\"imageUrl\":\"https://img.netpop.app/cover/20260528/1779958069965_4a97dd3db3e57381db2fa51723b167b1调音师.webp\",\"introduction\":\"Seorang penyetel piano berbakat yang menderita hyperacusis menemukan bakat tak terduga dalam membobol brankas, sehingga mengubah hidupnya secara terbalik.\",\"jumpAddress\":\"tiktik://jump/detail?id=145461&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Musikal\",\"Romansa\",\"Thriller\"],\"title\":\"Tuner\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260604/1780541129423_118a4ca70f6182b98de2e25024667ac32.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":147064,\"imageUrl\":\"https://img.netpop.app/cover/20260604/1780541129213_4984b950d6cb6d3ed82214d616af23361.jpg\",\"introduction\":\"Dalam suasana tegang 72 jam sebelum D-Day, Jenderal Dwight D. Eisenhower dan Kapten James Stagg menghadapi pilihan yang mustahil--meluncurkan invasi lintas laut paling berbahaya dalam sejarah atau berisiko kalah perang sama sekali.\",\"jumpAddress\":\"tiktik://jump/detail?id=147064&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Sejarah\",\"Perang\"],\"title\":\"Pressure\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260612/1781244661684_3373294afe8eb1a366def930ebcd82aapme7D46PxaOdNWika46q5VUS2CR.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":149394,\"imageUrl\":\"https://img.netpop.app/cover/20260612/1781244656744_9ac4770cb2a97ceb029b092d6cf0ec31hDzllxB1TQ7uUxVvjnGHirJJovt.webp\",\"introduction\":\"Frankelda, seorang penulis muda Meksiko yang frustrasi dari abad ke-19, melakukan perjalanan dalam bentuk hantu ke kerajaan penemuannya sendiri yang dihuni oleh Spooks, yang semuanya merupakan karakter mengerikan yang ia ciptakan dalam kisah horornya. Pemandunya adalah Herneval, Pangeran Spooks, yang membawanya untuk membantunya menjaga keseimbangan antara Alam Fiksi dan Alam Eksistensi dengan menggunakan bakatnya sebagai penulis.\",\"jumpAddress\":\"tiktik://jump/detail?id=149394&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Anime\",\"Fantasi\",\"Horor\"],\"title\":\"Soy Frankelda\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260604/1780567672226_56205d066a8fb51e2254597873f15f78宇宙巨人：希曼崛起y.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":147331,\"imageUrl\":\"https://img.netpop.app/cover/20260604/1780567666132_5256f3f28bebce59ee2f0334a696016b宇宙巨人：希曼崛起.webp\",\"introduction\":\"Seorang pemuda di Bumi menemukan warisan rahasia yang luar biasa sebagai pangeran dari planet asing, dan harus menemukan pedang ajaib dan kembali ke rumah untuk melindungi kerajaannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=147331&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Masters of the Universe\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260420/1776671959801_fc07b152642af4a1e3eef78fa9712324tAeiebNAyYC23FjUEkgyUm9SnEo.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":135139,\"imageUrl\":\"https://img.netpop.app/cover/20260420/1776671951763_34fa9026b6f5cc0274eb732f55efdbb1jAE2G2grCdTOSd4jjHPBuMFSSUn.webp\",\"introduction\":\"Juara favorit penggemar -- kini bergabung dengan Johnny Cage sendiri -- diadu satu sama lain dalam pertarungan pamungkas untuk mengalahkan kekuasaan gelap Shao Kahn yang mengancam keberadaan Earthrealm dan para pembelanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=135139&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Mortal Kombat 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260427/1777270459809_4bc543fd5316100c63b1d08541875db5edVIvTc8RofOTxoAZN7a5kxIAay.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":136735,\"imageUrl\":\"https://img.netpop.app/cover/20260427/1777270447122_78a24cd6dfb43f6a9247c2c6da5a020fbOl0rJ86WWxVYlQlGttHhHuYiPQ.webp\",\"introduction\":\"Sebuah insiden yang terjadi ketika tim pembuat film pergi ke waduk untuk memperbarui tampilan jalan di mana sosok tak dikenal difilmkan dan menemukan sesuatu di perairan yang gelap dan dalam.\",\"jumpAddress\":\"tiktik://jump/detail?id=136735&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"Asia daftar Peringkat 4\",\"rankId\":147,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Salmokji: Whispering Water\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260526/1779780305851_742e68eb62b88b7cb63a6b4c5b6b06c3致命之旅C.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":144548,\"imageUrl\":\"https://img.netpop.app/cover/20260526/1779780296935_b16120cc137a5e50380f56333bfb5374致命之旅.webp\",\"introduction\":\"Sepasang suami istri yang disfungsional mundur ke kabin terpencil untuk memperbaiki hubungan mereka, namun masing-masing diam-diam berencana membunuh satu sama lain.\",\"jumpAddress\":\"tiktik://jump/detail?id=144548&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Thriller\"],\"title\":\"Over Your Dead Body\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260420/1776672028172_c0c10dc79cc1cdece3d4c3e8d2c6035b星球大战：曼达洛人与古古9.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":135146,\"imageUrl\":\"https://img.netpop.app/cover/20260420/1776672021524_99fb1daff6b2373c9a1b4e4b36b624a5星球大战：曼达洛人与古古.webp\",\"introduction\":\"Setelah menjadi pemburu hadiah sendirian, Mandalorian Din Djarin dan muridnya Grogu memulai petualangan Star Wars baru yang menarik.\",\"jumpAddress\":\"tiktik://jump/detail?id=135146&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Keluarga\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Star Wars: The Mandalorian & Grogu\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260429/1777445748306_ae00392f715165ef0eef4ac17a3d0138plDfFp8LWIh8c8WK5Xlgvwytgqs.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":137432,\"imageUrl\":\"https://img.netpop.app/cover/20260429/1777445741528_f261cc5d33306b9e51ee67589c39306e6pzI1DIlxwAFffw9OZcG6cr031U.webp\",\"introduction\":\"Setelah revolusi hewan, babi merebut kekuasaan dan sebuah peternakan diubah menjadi kediktatoran yang kejam.\",\"jumpAddress\":\"tiktik://jump/detail?id=137432&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":2.4,\"showMark\":false,\"tagList\":[\"Anime\",\"Komedi\",\"Fantasi\",\"Tegang\"],\"title\":\"Animal Farm\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260421/1776749867730_3d53b7ac77aa480263cc936dbcfbcc33木乃伊g.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":135284,\"imageUrl\":\"https://img.netpop.app/cover/20260421/1776749861222_6fb5ed1c8a52ca2b2ca0e50ae0e50995木乃伊.webp\",\"introduction\":\"Putri muda seorang jurnalis menghilang ke padang pasir tanpa jejak. Delapan tahun kemudian, keluarga yang hancur itu terkejut ketika dia dikembalikan kepada mereka, karena reuni yang seharusnya menyenangkan berubah menjadi mimpi buruk yang nyata.\",\"jumpAddress\":\"tiktik://jump/detail?id=135284&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Lee Cronin's The Mummy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260509/1778295467285_3c1661532b5fb7e6f6683541799433d92.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":139308,\"imageUrl\":\"https://img.netpop.app/cover/20260509/1778295457729_bf1a1e98c91e289ecda2982b55895dfe1.jpg\",\"introduction\":\"Sebuah tim rahasia yang terdiri dari agen elit hidup dalam bayang-bayang. Ketika seorang penguasa lalim yang kejam mencuri kekayaan bernilai miliaran dolar, mereka dikirim untuk mengambilnya kembali—sebuah perampokan mustahil yang berubah menjadi permainan strategi, penipuan, dan kelangsungan hidup yang mematikan.\",\"jumpAddress\":\"tiktik://jump/detail?id=139308&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Thriller\"],\"title\":\"In the Grey\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260624/1782293112419_1cb210ca36942ad81f6974268d2307d7sLQV9qzLPcR01pVchhbteVTKoZe.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":141984,\"imageUrl\":\"https://img.netpop.app/cover/20260518/1779081730467_f33e26810fe89d8b350200d986df8c08绵羊侦探团.webp\",\"introduction\":\"Setiap malam seorang gembala membacakan misteri pembunuhan dengan suara keras, berpura-pura dombanya dapat memahaminya. Ketika dia ditemukan tewas, domba-domba itu langsung menyadari bahwa itu adalah pembunuhan dan berpikir mereka tahu segalanya tentang cara menyelesaikannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=141984&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Tegang\"],\"title\":\"The Sheep Detectives\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260508/1778220983577_34cb34699d4a1e180a215ed109f073cd尤为明亮的生物A.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":138964,\"imageUrl\":\"https://img.netpop.app/cover/20260508/1778220976004_c5423c3730f1967dd102db85e21c33ad尤为明亮的生物r.webp\",\"introduction\":\"Melalui ikatan tak terduga yang terbentuk selama shift malam di akuarium setempat, Tova, seorang janda tua, mengetahui penemuan yang mengubah hidup yang mungkin sekali lagi memberinya kegembiraan dan keajaiban.\",\"jumpAddress\":\"tiktik://jump/detail?id=138964&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"Remarkably Bright Creatures\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260422/1776839241332_cbf6b1a94902f2dc94140970e19e2777eCsrzMDYCwvI4lQlTB9QCtnPipU.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":135643,\"imageUrl\":\"https://img.netpop.app/cover/20260422/1776839237838_520d085b2219abb62bbec68bf115da92ul4dQcA68mtSx8J56N5gEcaCCtP.webp\",\"introduction\":\"Diburu karena golongan darahnya yang langka, seorang wanita dibesarkan oleh keluarga pembunuh bayaran tetapi dia sendiri tidak pernah dilatih sebagai keluarga pembunuh bayaran, sampai sebuah serangan brutal merenggut nyawa banyak keluarga yang ditemukannya. Dia menjalani pelatihan intensif dan bersumpah untuk bertarung bersama pembunuh yang dia cintai untuk melindungi masa depan mereka ketika musuh lama muncul kembali.\",\"jumpAddress\":\"tiktik://jump/detail?id=135643&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Romansa\",\"Thriller\"],\"title\":\"My Dearest Assassin\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260429/1777445195522_d680b669574f7ef92dd90f4465be7955iYjlQzWbcFIjWe2WifbEPb4kErp.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":137426,\"imageUrl\":\"https://img.netpop.app/cover/20260429/1777445188585_2f4a1b375fdc1658d5cad0e780f3b74ecyI2Ugpq98WZN1GEYeWkn4ztXOc.jpg\",\"introduction\":\"Sekelompok penumpang internasional dalam perjalanan dari Los Angeles ke Shanghai terpaksa melakukan pendaratan darurat di perairan yang dipenuhi hiu. Kini mereka harus bekerja sama dengan harapan bisa mengatasi kegilaan hiu yang tertarik ke reruntuhan.\",\"jumpAddress\":\"tiktik://jump/detail?id=137426&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"Deep Water\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220830/1661842842871_61fe784f6682710c23b74c2953fee274月球 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":24525,\"imageUrl\":\"https://img.netpop.app/cover/20220830/1661842840046_4dbd7e46814d9415d20e4529966f3d14月球 竖.jpg\",\"introduction\":\"Di Moonfall, sebuah kekuatan misterius menjatuhkan Bulan dari orbitnya mengelilingi Bumi dan mengirimkannya meluncur di jalur tabrakan dengan kehidupan seperti yang kita kenal. Dengan hanya beberapa minggu sebelum dampak dan dunia di ambang kehancuran, eksekutif NASA dan mantan astronot Jo Fowler yakin dia memiliki kunci untuk menyelamatkan kita semua - tetapi hanya satu astronot dari masa lalunya, Brian Harper dan ahli teori konspirasi KC Houseman percaya padanya. . Pahlawan yang tidak mungkin ini akan melakukan misi terakhir yang mustahil ke luar angkasa, meninggalkan semua orang yang mereka cintai, hanya untuk menemukan bahwa mereka mungkin telah bersiap untuk misi yang salah.\",\"jumpAddress\":\"tiktik://jump/detail?id=24525&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Moonfall\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":19},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"错爱\",\"coverType\":1,\"homeSectionId\":85212,\"homeSectionName\":\"A Love in Fault\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260612/1781242451211_8fa7750f76b5007e1d26b9cc651a15aep2932739857.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":149338,\"imageUrl\":\"https://img.netpop.app/cover/20260612/1781242439213_edccd7c15d76ef5427604cfac0bfe2e2p2932739857.webp\",\"introduction\":\"Ketika pernikahan yang tampak sempurna tidak memiliki keintiman yang didambakan, Lalin mulai mencari kepuasan di tempat lain. Putus asa untuk menyelamatkan hubungan mereka, suaminya yang setia, Thanat, setuju untuk membiarkannya bersama pria lain. Namun begitu pernikahan mereka dibuka, tidak semuanya tetap transparan. Rahasia, hasrat yang tak terpuaskan, dan perubahan emosi perlahan-lahan menarik mereka lebih jauh dari yang pernah mereka bayangkan—melewati titik yang tidak bisa kembali lagi.\",\"jumpAddress\":\"tiktik://jump/detail?id=149338&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"Club Friday The Series 18: OpenRelationship\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210928/1632809179081_a13e4114f56b87cdb7aa6f407a2cbe24画板 1 拷贝 58.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":895,\"imageUrl\":\"https://img.netpop.app/cover/20210918/1631955606100_00943f865a4b58aa6ed1d2a4ba408d05kfcJl5e8CRWDU7e4vX6uNABPRbS.jpg\",\"introduction\":\"Seorang ibu pinggiran dari dua orang mengambil perjalanan memori yang dikenakan biaya fantasi yang membuatnya sangat menikah dengan kursus tabrakan dengan masa lalunya yang liar.\",\"jumpAddress\":\"tiktik://jump/detail?id=895&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance daftar Peringkat 3\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":5.4,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Sex/Life\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241228/1735387191662_49925f7fa9369e2eeb19c2e0d94bbbe1小心肝儿2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":65246,\"imageUrl\":\"https://img.netpop.app/cover/20241228/1735387185590_436a39f88c98e2d8489655b406ffe356小心肝儿1.jpg\",\"introduction\":\"Seorang CEO bertenaga tinggi menempatkan karier dan keluarganya di telepon ketika dia memulai perselingkuhan yang panas dengan pekerja magang yang jauh.\",\"jumpAddress\":\"tiktik://jump/detail?id=65246&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Tegang\",\"Thriller\"],\"title\":\"Babygirl\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260525/1779697738949_9686016f2620401e2eee155c327315ffuWnBAqtQlSTTYUMehyvL9CoZrTq.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":144252,\"imageUrl\":\"https://img.netpop.app/cover/20260525/1779697728359_3a72a881d8f3bbffac2601858d1cbad071K5KFtqK514ALejimxXgf25j9p.webp\",\"introduction\":\"Kisah cinta terlarang antara Noah yang berusia 18 tahun dan saudara tirinya Nick menghadapi tantangan saat mereka menempuh jalan yang berbeda - dia dalam bisnis, dia di Oxford - sambil menghadapi hubungan dan rahasia baru.\",\"jumpAddress\":\"tiktik://jump/detail?id=144252&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"Romantic\"],\"title\":\"Your Fault: London\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231025/1698220811433_fe7c99cb3dcd125f41c6d75a4846efceBurning Betrayal2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":38012,\"imageUrl\":\"https://img.netpop.app/cover/20231101/1698830967264_70552d181ac057ca19952269683d0ada叛我更幸福_.png\",\"introduction\":\"Babi menemukan pengkhianatan oleh mitra jangka panjangnya dan memutuskan untuk memulai petualangan baru dalam hidup. Dalam perjalanan ini, dia bertemu Hakim Marco dan mereka mulai menjalani cerita yang diresapi oleh banyak ketegangan seksual.\",\"jumpAddress\":\"tiktik://jump/detail?id=38012&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Horor\",\"Tegang\"],\"title\":\"Burning Betrayal\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260430/1777538187284_a180864e96cdfccc08a1c1e3f853cdd41oJSeynxNfGJm83de6bi83LetZR.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138045,\"imageUrl\":\"https://img.netpop.app/cover/20260430/1777538180216_f03e671f7ba8cdc55a93c1f049704d791oJSeynxNfGJm83de6bi83LetZR.webp\",\"introduction\":\"Shen adalah seorang wanita dari keluarga kaya yang memasuki pernikahan yang tampaknya sempurna dengan Phoem, seorang pejabat pemerintah yang menjanjikan. Hubungan mereka dimulai dengan kebahagiaan, namun keadaan berubah ketika Phoem berangkat untuk tugas kerja yang diperpanjang di luar negeri.\\n\\nSelama ketidakhadirannya, Shen terus-menerus menghadapi tekanan dan perlakuan buruk dari ibu mertuanya. Lingkungan yang sulit membuat emosinya terkuras, hanya berpegang pada harapan kembalinya suaminya. Namun, saat Phoem kembali, dia bukan lagi orang yang sama. Perilakunya yang dingin dan menjaga jarak memperdalam kesepian Shen.\\n\\nDalam keadaan rentan ini, dia menemukan kenyamanan dalam diri Tone, seorang pengemudi yang kehadirannya membawa dukungan emosional dan memperumit situasinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=138045&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT daftar Peringkat 4\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"Whisper of Desire\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":1,\"name\":\"18+\",\"sort\":1}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260415/1776232128945_551660f0bd29f707afb5e2cc195ed5233ANXZWhhcqPAh0q6nRZ979TIwxC.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":134108,\"imageUrl\":\"https://img.netpop.app/cover/20260415/1776232884490_8f538e1269ff6af2d325e6c6ea97d549tcPc5ZMBO4y2BtCJMe3o2nwZb2B.webp\",\"introduction\":\"Sebuah drama romantis berlatar perguruan tinggi yang menceritakan kisah cinta tak terduga antara seorang mahasiswa musik dan pemain hoki bintang universitas, mengeksplorasi tema cinta dan kompleksitas masa dewasa melalui persahabatan yang mendalam dan ikatan yang langgeng.\",\"jumpAddress\":\"tiktik://jump/detail?id=134108&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance daftar Peringkat 1\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"Olahraga\",\"Dewasa\",\"Romantic\"],\"title\":\"Off Campus Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260610/1781072913557_0dbe2d4b7d2352a7df48437f6221776apNenAgAq7rObNflDgifLxq62Vjx.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":148682,\"imageUrl\":\"https://img.netpop.app/cover/20260610/1781072909503_d7add06904fb64191ee305b5594a93e0nZGf0jnSJNXLf8o7iSzzX8qxHX9.webp\",\"introduction\":\"Dua sahabat seumur hidup mengeksplorasi pertanyaan abadi - bagaimana jika cinta pertama Anda ditakdirkan untuk menjadi belahan jiwa Anda? Sebuah kisah romantis tentang kemungkinan cinta yang tak lekang oleh waktu\",\"jumpAddress\":\"tiktik://jump/detail?id=148682&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance daftar Peringkat 4\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"Romantic\"],\"title\":\"Every Year After\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250213/1739426530699_928069c08e26bfaad9d64aa09e1f85cdaf7HqyI1CSxV2febOcIxyMLLFbl.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":72138,\"imageUrl\":\"https://img.netpop.app/cover/20250213/1739429971999_b77c1fd1236e87d961d194a9c6ccbde2bioObjvmJdDRxnWM3TrQYaMUbAQ.jpg\",\"introduction\":\"Seorang gadis berusia 18 tahun pindah dari Amerika ke London bersama ibu dan ayah tiri kaya. Dia bertemu dengan saudara tirinya, dan sebuah atraksi menyeduh meskipun ada upaya mereka. Tidak sadar, ayahnya yang terasing melacaknya setelah dibebaskan dari penjara\",\"jumpAddress\":\"tiktik://jump/detail?id=72138&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"My Fault: London\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251128/1764296663197_5f0e1a17f0e48a5f068cc887e1c506a8w0kz3oP6QJ1aqnX1QMgmv647MzN.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":115940,\"imageUrl\":\"https://img.netpop.app/cover/20251128/1764296654077_fe7f5fed2f3b9f77d8ae4c9cabb4f4d1iJ5xtuhWQ2L7MZC9d09iimkyWPc.webp\",\"introduction\":\"Kehidupan Kamila berubah drastis ketika Di Bianco bersaudara kembali setelah 7 tahun. Thiago memberikan ciuman pertamanya, Taylor adalah pelindungnya. Sekarang dia sudah berubah, tapi mereka masih punya cara untuk menghubunginya dengan cara yang tidak bisa dilakukan orang lain.\",\"jumpAddress\":\"tiktik://jump/detail?id=115940&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Remaja\"],\"title\":\"Tell Me Softly\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250107/1736237476026_a0aa0008c0749c25ff0dd73aaaeb44fbHidden Face2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":66730,\"imageUrl\":\"https://img.netpop.app/cover/20250107/1736237474232_afc0230dd0391f600d882610a0010e9bHidden Face1.jpg\",\"introduction\":\"Tentang satu ruang rahasia kekasih yang masuk untuk mengkonfirmasi cinta mereka dan tiba -tiba terjebak.\",\"jumpAddress\":\"tiktik://jump/detail?id=66730&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"Asia daftar Peringkat 3\",\"rankId\":147,\"rankType\":1},\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Hidden Face\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240522/1716346594252_3c1088a43dff08039b23d67f5793c2d44JV19qiBKJuFv9ZvgtKD75nYME6.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":44255,\"imageUrl\":\"https://img.netpop.app/cover/20240611/1718087471419_cabd5288695a3a26479a0582bb3d62f5不再沉默 第一季.png\",\"introduction\":\"Kehidupan seorang siswa berusia 17 tahun mengambil giliran besar ketika dia menggantung di fasad sekolah sebuah papan iklan yang mengatakan 'Hati-hati: pemerkosa bersembunyi di sini'.\",\"jumpAddress\":\"tiktik://jump/detail?id=44255&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"Raising Voices Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210928/1632804639223_a1d08e9077fdc90cdaae6227dde9f16clQq04q5TtgOb8yA4yhHAhNuTOLv.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2771,\"imageUrl\":\"https://img.netpop.app/cover/20220908/1662625741981_20d9b82a1a3c95f13d8cda6026bf9e241.jpg\",\"introduction\":\"Berdasarkan novel Anna Todd, setelah mengikuti Tessa (Langford), seorang siswa yang berdedikasi, putri berbakti, dan pacar setia kepada kekasih sekolah menengahnya, ketika dia memasuki semester pertamanya di perguruan tinggi dengan ambisi besar untuk masa depan. Dunia yang dijaganya terbuka ketika dia bertemu dengan Hardin Scott yang gelap dan misterius (Tiffin), pemberontak yang magnetis dan merenung yang membuat pertanyaannya semua yang dia pikir dia tahu tentang dirinya dan apa yang dia inginkan dari kehidupan.\",\"jumpAddress\":\"tiktik://jump/detail?id=2771&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Kampus\",\"Remaja\"],\"title\":\"After\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220211/1644571686543_7759243757a65d52fedbb442a856d230解禁恋爱.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":11261,\"imageUrl\":\"https://img.netpop.app/cover/20220209/1644402191439_0efa198ff12100dda35c4c07acb82449解禁男女11261竖版.png\",\"introduction\":\"Cinta tidak pernah menyakiti sangat baik untuk dua rekan kerja yang memasuki hubungan kontraktual sebagai mitra dalam permainan, kesenangan dan rasa sakit konsensus.\",\"jumpAddress\":\"tiktik://jump/detail?id=11261&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"Love and Leashes\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250925/1758763941730_644e4cd90cf5d3452b0a9eea7c604b78pdcsJIXelp3vo7xsqK16KzYB8Sy.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":108754,\"imageUrl\":\"https://img.netpop.app/cover/20250925/1758763922961_57e265753ade6716c757ff26fcacff15yzqHt4m1SeY9FbPrfZ0C2Hi9x1s.webp\",\"introduction\":\"Pernikahan Jenna dan Lion membawa reuni yang telah lama ditunggu-tunggu antara Nuh dan Nick setelah putus. Ketidakmampuan Nick untuk memaafkan Nuh berdiri sebagai penghalang yang tidak dapat diatasi. Dia, pewaris bisnis kakeknya, dan dia, memulai kehidupan profesionalnya, menolak memicu nyala api yang masih hidup. Tapi sekarang jalan mereka telah menyeberang lagi, akankah cinta lebih kuat dari kebencian?\",\"jumpAddress\":\"tiktik://jump/detail?id=108754&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Kampus\",\"Remaja\"],\"title\":\"Our Fault\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250512/1747033467244_f988ea3973dac6870e6674667bbe63152.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":90099,\"imageUrl\":\"https://img.netpop.app/cover/20250512/1747033465512_17f54ae43df1dee6ecc6186dcb78fad01.jpg\",\"introduction\":\"Seorang anak yatim piatu dan seorang gadis kaya yang dimanjakan berusaha mengungkap rahasia masa lalu untuk menyelamatkan romansa dan kulit mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=90099&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.2,\"showMark\":false,\"tagList\":[\"Romansa\",\"Thriller\"],\"title\":\"Mala influencia\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230614/1686709531057_24e5d052ce61bb87df7923cd64ae231epNOccytgkGuyofTLmh1sqEfTJuE.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":34618,\"imageUrl\":\"https://img.netpop.app/cover/20230612/1686538244070_2c10854a04a43d576f015593d76175de7.jpg\",\"introduction\":\"Nuh harus meninggalkan kotanya, pacar, dan teman -temannya dan pindah ke mansion suami kaya ibunya yang baru. Mereka dia bertemu Nick, saudara tirinya yang baru. Mereka diam -diam jatuh cinta dengan gila.\",\"jumpAddress\":\"tiktik://jump/detail?id=34618&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"My Fault\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211008/1633682501303_c232f8415c36a8328c6688581c50044e新月 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2983,\"imageUrl\":\"https://img.netpop.app/cover/20211008/1633682497267_e133cf70fd2bd3e78784d7a3588b689f新月 竖.jpg\",\"introduction\":\"Setelah Bella pulih dari serangan vampir yang hampir mengklaim hidupnya, dia ingin merayakan ulang tahunnya dengan Edward dan keluarganya. Namun, kecelakaan kecil selama perayaan menghasilkan darah Bella yang ditumpahkan, pemandangan yang membuktikan terlalu intens untuk Cullens, yang memutuskan untuk meninggalkan kota Forks, Washington demi Bella dan Edward. Awalnya patah hati, Bella menemukan bentuk kenyamanan dalam kehidupan yang ceroboh, serta persahabatan yang lebih dekat dengan Jacob Black. Bahaya dalam berbagai bentuk menunggu.\",\"jumpAddress\":\"tiktik://jump/detail?id=2983&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2009,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.7,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Fantasi\",\"Romansa\"],\"title\":\"The Twilight Saga: New Moon\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220819/1660902778991_2c5c65543d111339c3145cba6981234a111.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6177,\"imageUrl\":\"https://img.netpop.app/cover/20220819/1660902090812_54ffba67e20c945cc9ed12bc31a49c46嘲笑.jpg.png\",\"introduction\":\"Melihat kehidupan untuk sekelompok siswa sekolah menengah saat mereka bergulat dengan masalah narkoba, jenis kelamin dan kekerasan. Serial ini berfokus pada hubungan antara dua gadis muda yang mencoba menemukan tempat mereka di dunia: Memulihkan pecandu rue dan jules baru di kota.\",\"jumpAddress\":\"tiktik://jump/detail?id=6177&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\"],\"title\":\"Euphoria Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250324/1742800708946_e2a5e0819c477eea82cc1beee185c0c69qYD7pAOEdYBoQblv5VAMMSVAC8.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":81094,\"imageUrl\":\"https://img.netpop.app/cover/20250324/1742800706066_1f54699bc01fdaf6617d3a6afdcee4c2gZQU8BtCH2IbMZq6QETiU4HXQSR.jpg\",\"introduction\":\"Shaw telah menyukai pemerintahan sejak dia melihatnya, tetapi Rule tidak melihatnya sebagai pertandingan yang cocok, tetapi malam minum dan rahasia membuat mereka mempertanyakan apakah mereka bisa bersama tanpa merusak hubungan mereka ... atau satu sama lain.\",\"jumpAddress\":\"tiktik://jump/detail?id=81094&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.1,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"Marked Men\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":1,\"name\":\"18+\",\"sort\":1}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221017/1665988317490_733d79514ade7b003ff01888239aa460agi2rXACfZd8gK2jqNVOAHR6ZTS.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2776,\"imageUrl\":\"https://img.netpop.app/cover/20241105/1730793763507_cef4ccc6c5fce358dc2b86250784b115p2611609840.jpg\",\"introduction\":\"Massimo Torricelli, seorang bos muda dan tampan dari keluarga Mafia Sisilia, tidak memiliki pilihan lain tetapi untuk mengambil alih setelah ayahnya dibunuh. Laura adalah direktur penjualan di hotel mewah di Warsawa. Dia memiliki karier yang sukses, tetapi kehidupan pribadinya tidak memiliki gairah. Dia mengambil satu kesempatan terakhir untuk menyelamatkan hubungannya. Bersama dengan pacar berkepala tulangnya, Martin dan beberapa teman lain, dia melakukan perjalanan ke Sisilia. Dia tidak berharap bahwa Massimo, pria paling berbahaya di pulau itu, akan menghalangi dia, menculiknya, memegang tawanannya dan memberinya 365 hari - untuk jatuh cinta padanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=2776&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":3.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Dewasa\",\"adult\"],\"title\":\"365 Days\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230614/1686709786396_64af1cd3582b955bfc04233f838b481ezpY97OUNunOAPIxXYO4ZUGl7fnK.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":22264,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658200586663_dc3e5077d40a9cc09ba4f203f11dff70clAMlA3DcwKMJIYeAFGGN0vyJQp.jpg\",\"introduction\":\"Cassie Salazar dan Luke Morrow sangat berbeda. Cassie yang cerdas bekerja malam di sebuah bar di Austin, Texas untuk memenuhi kebutuhannya sambil mengejar mimpinya menjadi penyanyi/penulis lagu. Luke adalah seorang peserta pelatihan Angkatan Darat, yang akan dikirim untuk bertugas, yang menemukan kenyamanan dalam disiplin pelayanan yang teguh. Tapi pertemuan kebetulan di bar Cassie mengubah jalan hidup mereka berdua. Cassie tenggelam dalam tagihan medis setelah didiagnosis menderita diabetes.\",\"jumpAddress\":\"tiktik://jump/detail?id=22264&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Musikal\",\"Romansa\"],\"title\":\"Purple Hearts\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240407/1712457449238_09c389ba8349285a3ad2ac68a3ec054a竖.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":42763,\"imageUrl\":\"https://img.netpop.app/cover/20240407/1712457439413_1649213043374efc86a3a74cb6889bf5横.jpg\",\"introduction\":\"Terkadang ketakutan terbesar kita adalah menerima bahwa seseorang dapat dengan jujur mencintai kita apa adanya. Nica dan Rigel siap untuk menemukannya bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=42763&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Thriller\"],\"title\":\"The Tearsmith\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240619/1718776389100_7f8652d16f6501015167d3eb54678e1ciulA80d5u4oDHzFUrGOzF1kqUhZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":45698,\"imageUrl\":\"https://img.netpop.app/cover/20240619/1718783182067_9e489dc19cb618abd7f7c3d1fd68148dp2909365194.jpg\",\"introduction\":\"Oh Wan Soo mencapai puncak olahraganya sebagai pemain golf. Bermimpi memiliki kehidupan yang sempurna di kelas atas, dia menikahi penerus kelompok Hwain. Sekarang, Wan Soo bekerja sebagai ketua untuk sebuah yayasan dan telah mendapatkan ketenaran di seluruh dunia melalui pekerjaan amalnya. Dia memiliki SEO Do Yoon sebagai pengawal barunya. Do Yoon, yang lulus dari Universitas Kepolisian, unggul dalam seni bela diri. Dia bergabung dengan tim keamanan Grup Hwang karena alasan tertentu. Melalui pengawalnya, Wan Soo menghadapi rahasia keluarga Hwain.\",\"jumpAddress\":\"tiktik://jump/detail?id=45698&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Romansa\"],\"title\":\"Red Swan\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220216/1644978077383_888d6fa7aa6be013c683fe4f72fd01815OJOKbjjuX4Wt8oLanWqa56NCMv.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12339,\"imageUrl\":\"https://img.netpop.app/cover/20220901/1662024459179_b33e5bc79c76eabb0886138f63860ab93.jpg\",\"introduction\":\"Sebagai asisten co-CEO dari perusahaan penerbitan, Lucy Hutton dan Templeman Joshua duduk satu sama lain setiap hari - dan mereka saling membenci. Tidak tidak suka. Tidak sedikit mentolerir. MEMBENCI. Lucy tidak mengerti pendekatan Josh yang menyenangkan dan tegang pada pekerjaannya dan penolakan untuk tersenyum, yang sangat kontras dengan pakaiannya yang cerah, quirkiness, dan orang-orang yang efusif. Terperangkap di kantor bersama 5 hari seminggu, mereka telah bercokol dalam permainan satu-besarnya yang adiktif dan konyol. Lucy tidak bisa membiarkan Josh memukuli apa pun - terutama ketika promosi baru yang besar untuk mengelola direktur siap untuk diperebutkan. Mereka menyerang kesepakatan bahwa siapa pun yang tidak mendapatkan promosi harus berhenti. Ini game-on - tetapi karena ketegangan mencapai titik didih dan naik lift yang tidak bersalah berubah menjadi ciuman beruap, Lucy mulai menyadari betapa indahnya garis di antara cinta dan benci. \\n\",\"jumpAddress\":\"tiktik://jump/detail?id=12339&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"The Hating Game\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240311/1710126861724_21df287c866fc6ad7749bf118e8a8230pk5ibyxRfwhqJSjzjCwlP0hadHE.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":42031,\"imageUrl\":\"https://img.netpop.app/cover/20240311/1710126857799_0a964d798c1c9f76a4f7b6f8173b34dfY5P4Q3q8nrruZ9aD3wXeJS2Plg.jpg\",\"introduction\":\"Solène, seorang ibu tunggal berusia 40 tahun, memulai romansa yang tidak terduga dengan Hayes Campbell yang berusia 24 tahun, penyanyi utama August Moon, band boy terpanas di planet ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=42031&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"The Idea of You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250704/1751618332596_015ea09233547629314ef6f9f066e632lfCcFJop7ORb10pvrBnTZsc0Bqo.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":97584,\"imageUrl\":\"https://img.netpop.app/cover/20250704/1751618322188_a91bd01dac2c2075eef538bfd83c7ed6hpPG14pFqGMS2FLvAWDtzGL7sUr.webp\",\"introduction\":\"Evelyn bangun di Vegas menikah dengan bintang rock David setelah pingsan pada ulang tahunnya yang ke -21. Didorong ke ketenarannya, dia mempertanyakan apakah dia bisa menangani gaya hidupnya saat mereka menavigasi jika pernikahan mereka nyata atau kesalahan.\",\"jumpAddress\":\"tiktik://jump/detail?id=97584&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"lick\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230614/1686712187755_53db7cd4bcd20917f4426b1282f85852jYNapxT1L5pgqgdzCwatsN7op2q.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":33595,\"imageUrl\":\"https://img.netpop.app/cover/20230518/1684400478114_915f0a7d105dcf7a464be1c088c2d075c0Zk5EurIkqMo4n89WWjBl4UtIi.png\",\"introduction\":\" Matchmaker Teen Kitty Song Covey mengira dia tahu segalanya yang perlu diketahui tentang cinta. Tetapi ketika dia bergerak di tengah dunia untuk bersatu kembali dengan pacarnya yang jauh, dia akan segera menyadari bahwa hubungan jauh lebih rumit ketika itu adalah hatimu sendiri di telepon.\",\"jumpAddress\":\"tiktik://jump/detail?id=33595&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"XO, Kitty\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"疯狂世界\",\"coverType\":1,\"homeSectionId\":85336,\"homeSectionName\":\"Crazy World\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230628/1687919638646_6482b1901c4b7d983f7e5ced7b3a93e2疯狂元素城剧照.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":35098,\"imageUrl\":\"https://img.netpop.app/cover/20230815/1692078851869_02a4d0ae112fb78c7bcc6de89b6007efhIf8BUYEozn8Ox7iFm7AjUgfNgK.jpg\",\"introduction\":\"Mengikuti Ember dan Wade, di kota di mana penduduk, air, darat, dan penghuni udara hidup bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=35098&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Anime\",\"Komedi\",\"Fantasi\"],\"title\":\"Elemental: Forces of Nature\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241106/1730863230668_1dac74175e6b58378df941260c009a696cXqnUlCklzV52kqyn3EEqDonyM.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":54653,\"imageUrl\":\"https://img.netpop.app/cover/20241106/1730863227964_a41068c9a321bed5e48bc8e4749cc7b8yh64qw9mgXBvlaWDi7Q9tpUBAvH.jpg\",\"introduction\":\"Setelah menerima panggilan tak terduga dari leluhurnya yang mencari jalan, Moana melakukan perjalanan ke laut jauh Oceania dan ke perairan berbahaya yang sudah lama hilang untuk petualangan tidak seperti apa pun yang pernah dia hadapi.\",\"jumpAddress\":\"tiktik://jump/detail?id=54653&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Komedi\",\"Keluarga\",\"Fantasi\",\"Musikal\"],\"title\":\"Moana 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211202/1638429732748_767585ef8b479b5ee4bec3227a42e41cmCVQ2cZmGkAHG2Q3fDZTQA1YzeI.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":4137,\"imageUrl\":\"https://img.netpop.app/cover/20211022/1634872289767_1a377a0d444ace6f1b6a1269303699d5gLhHHZUzeseRXShoDyC4VqLgsNv.jpg\",\"introduction\":\"Kisah ini berputar di sekitar pahlawan sub-nol: mammoth berbulu, harimau bersoda, kemalasan dan kombinasi prasejarah dari tupai dan tikus, yang dikenal sebagai Scrat.\",\"jumpAddress\":\"tiktik://jump/detail?id=4137&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2002,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Keluarga\"],\"title\":\"Ice Age\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211202/1638425379610_73a9b4085e4ebc05c1a4b454b29bf384mAkPFEWkwKz9nmKyCiuETfTdpgX.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3900,\"imageUrl\":\"https://img.netpop.app/cover/20211020/1634715293869_56d3201ed84407397d4832b26f4d16e7w9kR8qbmQ01HwnvK4alvnQ2ca0L.jpg\",\"introduction\":\"Woody, Buzz Lightyear dan seluruh geng memulai perjalanan dengan Bonnie dan mainan baru bernama Forky. Perjalanan petualang berubah menjadi reuni yang tak terduga karena jalan memutar kecil Woody membawanya ke temannya yang sudah lama hilang. Sebagai Woody dan Bo mendiskusikan masa lalu, mereka segera mulai menyadari bahwa mereka dua dunia terpisah ketika sampai pada apa yang mereka inginkan dari kehidupan sebagai mainan\",\"jumpAddress\":\"tiktik://jump/detail?id=3900&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"Animated Film daftar Peringkat 4\",\"rankId\":200,\"rankType\":1},\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Keluarga\",\"Fantasi\"],\"title\":\"Toy Story 4\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211201/1638343349711_51887ed2f24818d9bf4ba5b725ac637fwFN8llYh215M8i2fqWAcPV8CSyL.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1765,\"imageUrl\":\"https://img.netpop.app/cover/20210916/1631775805550_53c734f25899d37a44385d1c78bb2c87o7Y2GeSpBCRKJMya8TEYuDeF80Z.jpg\",\"introduction\":\"Setelah gua mereka hancur, keluarga manusia gua harus melakukan perjalanan melalui dunia fantastik yang tidak dikenal dengan bantuan seorang bocah inventif.\",\"jumpAddress\":\"tiktik://jump/detail?id=1765&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Keluarga\",\"Fantasi\"],\"title\":\"The Croods\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250521/1747814652060_c9a5a0af50a8a6eee75e28562cf3972f7nfpkR9XsQ1lBNCXSSHxGV7Dkxe.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":91887,\"imageUrl\":\"https://img.netpop.app/cover/20250521/1747814645778_dc8b2b6a94af1b7a919bb7af614fd37cp5l2vKfXCXDY8U2vC5VO5QwICfK.webp\",\"introduction\":\"Polisi kelinci pemberani Judy Hopps dan temannya, si rubah Nick Wilde, kembali bekerja sama untuk memecahkan kasus baru, yang paling berbahaya dan rumit dalam karier mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=91887&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Kriminal\",\"Tegang\"],\"title\":\"Zootopia 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221116/1668593191117_c1635e5f5fe741dab9b80c0eb1d5cea2疯狂动物城+ 剧集 27067横版.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":27067,\"imageUrl\":\"https://img.netpop.app/cover/20221109/1667982984627_6521050a0be1f2fdccf8cc2ae8e81b56zoopia.png\",\"introduction\":\"Petualangan makhluk-makhluk metropolis paling luar biasa: Zootopia.\",\"jumpAddress\":\"tiktik://jump/detail?id=27067&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Kriminal\",\"Keluarga\",\"Musikal\",\"Romansa\"],\"title\":\"Zootopia+\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211105/1636095830913_5794a37d508ea8d177f149a0f58f49e2mIpCxBWNz6SHCQBe2K2PFr5MB7f.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1744,\"imageUrl\":\"https://img.netpop.app/cover/20211105/1636095828330_fe05266ecc77bbd9a0804f0038b90009y7thwJ7z5Bplv6vwl6RI0yteaDD.jpg\",\"introduction\":\"Melihat hubungan antara Mike Wazowski (Billy Crystal) dan James P. \\\"Sully\\\" Sullivan (John Goodman) selama hari-hari mereka di Monsters University, ketika mereka tidak selalu yang terbaik dari teman-teman.\",\"jumpAddress\":\"tiktik://jump/detail?id=1744&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Keluarga\",\"Fantasi\"],\"title\":\"Monsters University\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211105/1636090704163_cbff2bdfa507a89a0ed5ba4633effe67wf9C6iqY9tXG7TrQDg3E4Flgap7.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":5629,\"imageUrl\":\"https://img.netpop.app/cover/20211105/1636090703360_f7bc569862719e858a35e520da7aab60lW0kUtXTOVlHTVhDO2VzNBACAHX.jpg\",\"introduction\":\"Dalam dunia hewan antropomorfik, Koala Buster Moon memiliki teater, yang tertarik pada pertunjukan bisnis sejak ayahnya membawanya ke pertunjukan musik pertamanya sebagai seorang anak. Setelah masalah keuangan dibesarkan oleh perwakilan Bank Judith, ia memberi tahu temannya yang kaya Eddie bahwa ia akan menjadi tuan rumah persaingan bernyanyi dengan hadiah $ 1.000. Tetapi Asisten Buster, Nona Crawly, secara tidak sengaja menambahkan dua nol ekstra, dan selebaran promosi menunjukkan $ 100.000 ditiup keluar dari kantor Buster ke jalan-jalan kota.\",\"jumpAddress\":\"tiktik://jump/detail?id=5629&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Anime\",\"Komedi\",\"Tarian & Bernyanyi\"],\"title\":\"Sing\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211201/1638354050039_fcee7793fa962a55bbb635318fe530ffpGK0oaeIVxpIroNHu1wDqXf4vv5.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3375,\"imageUrl\":\"https://img.netpop.app/cover/20211201/1638354046219_1f4ed6586ff17f762b5585a9266b2d95qjlbN6aK1qgeg3SspFVovT2D1Me.jpg\",\"introduction\":\"Sebuah kota monster tanpa manusia yang disebut Monstropolis Center di sekitar perusahaan listrik kota, Inc. Monster raksasa behemoth yang menyenangkan, percaya diri, tangguh, berbulu bernama James P. Sullivan (lebih dikenal sebagai Sulley) dan teman terbaiknya , Pendek, Cyclops Green Monster Mike Wazowski, temukan apa yang terjadi ketika dunia nyata berinteraksi dengan mereka dalam bentuk seorang bayi perempuan berusia 2 tahun yang dijuluki \\\"Boo,\\\" yang secara tidak sengaja menyelinap ke dunia monster dengan Sulley. Dan sekarang terserah Sulley dan Mike untuk mengirim Boo kembali ke rumahnya sebelum ada yang tahu, terutama dua penjahat jahat seperti saingan utama Sulley sebagai Randall seperti bunglon (monster yang dimiliki Boo), yang memiliki Kemampuan untuk mengubah warna kulitnya, dan Bos Mike dan Sulley, Mr. Waternoose, ketua dan kepala eksekutif Monsters, Inc\",\"jumpAddress\":\"tiktik://jump/detail?id=3375&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2001,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Keluarga\",\"Fantasi\"],\"title\":\"Monsters, Inc.\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210915/1631699743808_7fb6d4b5f656553f6a8fd0d86b80d1ebp2fRZzxla6NoRbIH2KOZq0gHb5S.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2225,\"imageUrl\":\"https://img.netpop.app/cover/20221215/1671075218492_4206fbe4443fd38036d5b381e3ad0689tiCSE5oEGIaOtUQDe4ST48rc7cd.jpg\",\"introduction\":\"Dari gajah terbesar ke Shrew terkecil, kota Zootopia adalah kota metropolis mamalia tempat berbagai hewan hidup dan berkembang. Ketika Judy Hopps menjadi kelinci pertama yang bergabung dengan kepolisian, dia dengan cepat belajar betapa sulitnya menegakkan hukum. Bertekad untuk membuktikan dirinya, Judy melompat pada kesempatan untuk memecahkan kasus misterius. Sayangnya, itu berarti bekerja dengan Nick Wilde, seorang rubah cerdik yang membuat pekerjaannya lebih sulit.\",\"jumpAddress\":\"tiktik://jump/detail?id=2225&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Komedi\",\"Kriminal\",\"Keluarga\",\"Tegang\"],\"title\":\"Zootopia\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211214/1639454626769_846e0d52d8f735f2700fbd0ee1cdfd5a20pkC7yJdCV4J1IMKfsCT9QU7zV.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":8720,\"imageUrl\":\"https://img.netpop.app/cover/20240304/1709537725454_6ce981a5a14d88ec75952389c264b8f5ndTgVvcB2z0On48WOxMbD1KT1RX.jpg\",\"introduction\":\"Alice, seorang yang bersahaja dan individu 19 tahun, bertunangan dengan seorang bangsawan Inggris. Di pesta pertunangannya, dia melarikan diri dari kerumunan untuk mempertimbangkan apakah harus pergi dengan pernikahan dan jatuh ke lubang di kebun setelah melihat kelinci yang tidak biasa. Tiba di tempat yang aneh dan nyata yang disebut \\\"Underhany,\\\" dia menemukan dirinya di dunia yang menyerupai mimpi buruk yang dimilikinya sebagai seorang anak, dipenuhi dengan binatang yang berbicara, queens dan ksatria, dan bandernatches. Alice menyadari bahwa dia ada di sana karena suatu alasan - untuk menaklukkan jabberwocky yang mengerikan dan memulihkan ratu yang sah itu ke takhta.\",\"jumpAddress\":\"tiktik://jump/detail?id=8720&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2010,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Fantasi\"],\"title\":\"Alice in Wonderland\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632624760204_352d1ec35ce8b280b121036c06d7f280Big Hero 6.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1754,\"imageUrl\":\"https://img.netpop.app/cover/20220630/1656561772740_b7dff486a4310ac35b83c781ddc5d7af超能.jpg\",\"introduction\":\"Bond yang dikembangkan antara robot tiup berukuran plus Baymax dan Prodigy Hiro Hamada, yang bersama-sama bekerja sama dengan sekelompok teman untuk membentuk sekelompok pahlawan berteknologi tinggi.\",\"jumpAddress\":\"tiktik://jump/detail?id=1754&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Big Hero 6\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251029/1761703553891_6e7aa5229ffafd88f6f7680814790de6l8pwO23MCvqYumzozpxynCNfck1.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":112309,\"imageUrl\":\"https://img.netpop.app/cover/20251029/1761703547224_7431fa8984a70aa855094ae65ebb9c4fsi9tolnefLSUKaqQEGz1bWArOaL.webp\",\"introduction\":\"Setelah menantang rezim totaliter Penyihir di Oz, Elphaba harus bergulat dengan identitasnya sebagai \\\"Penyihir Jahat dari Barat\\\". Sementara itu, Penyihir telah memberikan Glinda gelar \\\"Glinda yang Baik\\\" dan status publik sebagai pembela negara melawan Elphaba. Kedua penyihir itu harus mengambil keputusan yang menentukan nasib mereka di seri musikal kedua ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=112309&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Tarian & Bernyanyi\",\"Romansa\"],\"title\":\"Wicked: For Good\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"捕风追影\",\"coverType\":1,\"homeSectionId\":84490,\"homeSectionName\":\"Tepi Bayangan\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231117/1700211844340_97e53dab7759db1a12a8aa7b2099d1ad7.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":14225,\"imageUrl\":\"https://img.netpop.app/cover/20220318/1647573910871_5432fedd10e367120a264209049c3905hPl71oz4f3vkGCXSO3O3X84J78v.jpg\",\"introduction\":\"Sebuah tim pengawasan polisi berteknologi tinggi berusaha untuk merobohkan sekelompok perampok bank yang kejam.\",\"jumpAddress\":\"tiktik://jump/detail?id=14225&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Thriller\"],\"title\":\"Cold Eyes\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220512/1652336710578_111d654ac25f7db67ba73a4e852b4161gT3LWL4TXCDZMD0bdV475LKeEAS.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":17870,\"imageUrl\":\"https://img.netpop.app/cover/20220512/1652336693142_8f6634f1b7e7417b792e6e15760681739QJ3cPpYgoPfhRnRPxpQUfx790r.jpg\",\"introduction\":\"Satu-satunya koneksi mantan agen khusus Cha Tae-Shik ke seluruh dunia adalah seorang gadis kecil, So-Mi, yang tinggal di dekatnya. Ibunya, Hyo-Jeong menyelundupkan obat-obatan dari organisasi perdagangan narkoba dan mempercayakan Tae-Shik dengan produk, tanpa memberi tahu dia. Para pedagang mencari tahu tentang penyelundupannya dan menculik Hyo-Jeong dan So-Mi. Geng itu berjanji untuk melepaskannya jika Tae-Shik melakukan pengiriman untuk mereka, namun itu sebenarnya adalah plot yang lebih besar untuk menghilangkan pemimpin cincin narkoba saingan. Ketika tubuh hyo-jeon disemboweled ditemukan, Tae-Shik menyadari bahwa kehidupan So-Mi mungkin juga dalam bahaya. Tae-Shik menjadi marah pada prospek bahwa So-mi mungkin sudah mati dan bersiap untuk pertempuran, menempatkan hidupnya sendiri dalam risiko.\",\"jumpAddress\":\"tiktik://jump/detail?id=17870&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2010,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Drama\",\"Thriller\"],\"title\":\"The Man from Nowhere\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220325/1648191010317_b8d40a5a9b807745849b9aa4cc132c73iRLdQu0Tvd7KaoL8t4e4i8XtesD.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":14743,\"imageUrl\":\"https://img.netpop.app/cover/20221229/1672298235976_c7593ad7ebeaba9da384176a517aea4c8.jpg\",\"introduction\":\"Mantan agen intelijen KI Heon ditugaskan dengan mengangkut SEO BOK dengan aman, klon manusia pertama, yang memegang rahasia kehidupan kekal. Beberapa pasukan mencoba mengendalikan Seo Bok untuk melayani agenda mereka sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=14743&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Seobok\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220218/1645148932126_5d46667307bcfbca6ee052b89b0caccednpSUzbvUy1sULcLddMMpUXsCAo.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12456,\"imageUrl\":\"https://img.netpop.app/cover/20220218/1645148928611_0eb5d80b8d0101e228f655ca7162d2b7n5ESZzOGxnmugkLvyd45wOsn0mg.jpg\",\"introduction\":\"Sekelompok mata-mata, 5446 Korps dilatih oleh pasukan khusus Korea Utara sejak masa muda mereka, dengan tujuan menyatukan Korea. Mereka secara embisius dikirim ke Korea Selatan, di mana setiap menyamar sebagai orang bodoh, penyanyi yang bercita-cita tinggi, dan seorang siswa sekolah menengah. Melewati waktu yang membosankan tanpa menerima pesanan dari Utara, mereka secara bertahap terbiasa dengan kehidupan sebagai tetangga biasa di kota kecil. Karena peristiwa pertempuran kedua Yeonpyeong, Korea Selatan menuntut nama, lokasi, dan peringkat 30 mata-mata Korea Utara yang aktif di Korea Selatan, membantu bantuan keuangan yang menjanjikan ke utara dengan kondisi Pyongyang berubah dalam mata-mata mereka. Untuk mencegah elit jatuh ke tangan musuh, pemerintah Korea Utara memerintahkan puluhan mata-mata bertugas aktif untuk mengambil nyawa mereka sendiri. Sementara itu, instruktur Tentara Korea Utara mereka Kim Tae-won melintasi perbatasan untuk menghilangkan mereka yang menolak untuk mematuhi.\",\"jumpAddress\":\"tiktik://jump/detail?id=12456&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Drama\"],\"title\":\"Secretly Greatly\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250221/1740123640067_13fd586a5fc5c1c0744d7c2a15f67b4b哈尔滨2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":74535,\"imageUrl\":\"https://img.netpop.app/cover/20250221/1740123618282_02a22338813fd4cb8990a55b4242cb3c哈尔滨1.jpg\",\"introduction\":\"Mengikuti aktivis kemerdekaan Korea yang meluncurkan serangan berani di Harbin terhadap Jepang untuk mendapatkan kemerdekaan negara mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=74535&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\"],\"title\":\"Harbin\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220524/1653379717604_8326ddc76b50e1d14bf01abb63988871g3hni0i9iAQ13jDGOFWavJFlojc.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":18831,\"imageUrl\":\"https://img.netpop.app/cover/20230104/1672827188261_02d03f31fdc5028122acafd0a076676a7.jpg\",\"introduction\":\"Seorang agen MI6 yang menyamar dikirim ke Berlin selama Perang Dingin untuk menyelidiki pembunuhan sesama agen dan memulihkan daftar agen ganda yang hilang.\",\"jumpAddress\":\"tiktik://jump/detail?id=18831&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2017,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Thriller\"],\"title\":\"Atomic Blonde\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241115/1731639303658_adaba14367da249f5d9b4fae58c78e1bpx0YfXxWKclI0PVM79fOV6Kh2As.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":55403,\"imageUrl\":\"https://img.netpop.app/cover/20241115/1731639299850_6df77c6d16ecb771c6d024a9208db8f55ktud4Nq5kCoBfajghqVHxYSDLg.jpg\",\"introduction\":\"Mantan mata -mata CIA Emily dan Matt ditarik kembali ke spionase setelah identitas rahasia mereka terpapar.\",\"jumpAddress\":\"tiktik://jump/detail?id=55403&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\"],\"title\":\"Back in Action\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240821/1724210928733_b6f2ccf16274c2d1f1ea678e797c59c2横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":49649,\"imageUrl\":\"https://img.netpop.app/cover/20240821/1724210924887_aecac5bd32d996781e109d4a7f3d086f竖.jpg\",\"introduction\":\"Loid Forger, seorang mata-mata elit, diperingatkan oleh pengurusnya bahwa ia berpotensi dipindahkan dari misinya yang sedang berlangsung, Operasi Strix. Untuk mempertahankan posisinya, ia harus membuat kemajuan signifikan terhadap tujuan operasi, yang melibatkan putri angkatnya Anya untuk mendapatkan cukup Bintang Stella untuk menjadi Sarjana Kekaisaran di Akademi Eden.\\n\\nSetelah mengetahui kontes memasak yang menghadiahkan siswa pemenang dengan Bintang Stella, Loid meneliti hidangan penutup pilihan juri untuk membantu meningkatkan peluang Anya. Namun, menciptakan kembali meremere favorit juri dengan sempurna membutuhkan lebih dari sekadar mengikuti resep. Jadi, keluarga Forger memulai liburan ke wilayah Frigis untuk mencoba meremere asli. Tidak semuanya berjalan lancar dalam perjalanan, karena keluarga Forger akhirnya terlibat dalam rencana jahat untuk menyalakan kembali perang antara negara Ostania dan Westalis.\",\"jumpAddress\":\"tiktik://jump/detail?id=49649&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Anime\",\"Komedi\"],\"title\":\"SPY×FAMILY CODE: White\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"热门动漫\",\"coverType\":1,\"homeSectionId\":22241,\"homeSectionName\":\"Anime Popular\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211208/1638935650610_761ad4afdf14d955a528348b0bb306echYC6uetTLSqbLZ3dFY0IfXWhl93.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":8220,\"imageUrl\":\"https://img.netpop.app/cover/20211208/1638935645297_5e085567f2757d578a4bdb7a91a1bc38fcXdJlbSdUEeMSJFsXKsznGwwok.jpg\",\"introduction\":\"Setelah tinggal seorang bajak laut bernama Gol D. Roger. Dia memperoleh kekayaan, ketenaran, dan kekuasaan untuk mendapatkan gelar Raja Bajak Laut. Ketika dia ditangkap dan akan dieksekusi, dia mengungkapkan bahwa harta karunnya yang disebut one piece disembunyikan di suatu tempat di Grand Line. Ini membuat semua orang berangkat untuk mencari dan mengungkap harta karun one piece, tetapi tidak ada yang menemukan lokasi Harta Gol D. Roger, dan Grand Line terlalu berbahaya tempat untuk diatasi. Dua puluh dua tahun setelah Gol D. Kematian Roger, seorang anak laki-laki bernama Monkey D. Luffy memutuskan untuk menjadi bajak laut dan mencari Harta Gol D. Roger untuk menjadi raja bajak laut berikutnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=8220&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1999,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":1177,\"resourceStatus\":1,\"score\":8.8,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Komedi\",\"Fantasi\"],\"title\":\"One Piece\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260624/1782279971218_090fe5571591d13ffb3f87443d80c34a无职转生Ⅲ 到了异世界就拿出真本事M.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":152256,\"imageUrl\":\"https://img.netpop.app/cover/20260624/1782279964598_44ea07edbf93a9ef5e6ae47b6a6e560b无职转生Ⅲ 到了异世界就拿出真本事.jpg\",\"introduction\":\"Musim ketiga Mushoku Tensei: Isekai Ittara Honki Dasu.\",\"jumpAddress\":\"tiktik://jump/detail?id=152256&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":3,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Mushoku Tensei: Jobless Reincarnation Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774516873487_1460a274f0ec310238f336b9dd629a28eJOy7YWAHgOS3V477sdTsq4v9jp.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131485,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774516866561_9ecbe981d2ba94333fe22cfa9f7d38d5155735l.jpg\",\"introduction\":\"Impian Raja Iblis Rimuru untuk menciptakan aliansi antara manusia dan monster semakin dekat untuk terwujud. Saat Tempest terus berkembang, Granville Rozzo dan cucunya, Maribel Rozzo, berselisih dengan Raja Iblis Rimuru mengenai rencana mereka untuk melindungi umat manusia dengan memerintah mereka. Sementara itu, di El Dorado, Raja Iblis Leon berupaya mencapai tujuannya sendiri. Kebangkitan Pahlawan baru semakin dekat!\",\"jumpAddress\":\"tiktik://jump/detail?id=131485&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"Hot-blooded daftar Peringkat 2\",\"rankId\":133,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"That Time I Got Reincarnated as a Slime Season 4\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260319/1773906510413_b4066984e9efe79048cf601dd72e71c3aSnG7CDiVUkxhngsq6cL6baLuHH.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":130720,\"imageUrl\":\"https://img.netpop.app/cover/20260405/1775321326832_aff3fe07854417ba25551234e27322eb黄泉的使者.webp\",\"introduction\":\"Di sebuah desa terpencil, lahirlah dua anak kembar, dipisahkan siang dan malam. Bertahun-tahun kemudian, dan ketika kakak laki-lakinya, Yuru, telah menjadi pemburu binatang, saudara perempuannya Asa telah dikurung di dalam sangkar, diperintahkan untuk melakukan tugas khusus yang melarang dia bertemu lebih dari beberapa individu terpilih.\\n\\nPada hari yang tidak mencolok, sekelompok pria bersenjata yang mengendarai helikopter, disebut sebagai \\\"naga\\\" oleh warga, menyerang desa untuk mencari Yuru, membunuh setiap orang dewasa yang terlihat. Ketika Yuru mencoba untuk bertemu dengan Asa dan melarikan diri, dia malah menemukan mayat—dan terlebih lagi, orang yang membunuhnya mengaku sebagai saudara kembar Yuru yang sebenarnya.\\n\\nSebelum wanita itu dapat menangkapnya, Yuru diselamatkan oleh seorang pria bernama Dera, orang luar yang sering mengunjungi desa. Namun, tak lama kemudian keduanya terpojok. Dalam upaya terakhirnya, Dera membuat Yuru memberikan hadiah kepada dewa desa, memanggil sepasang daemon yang keberadaannya pasti akan mengungkap kebenaran di balik peristiwa kacau ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=130720&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"Hot-blooded daftar Peringkat 4\",\"rankId\":133,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Fantasi\"],\"title\":\"Daemons of the Shadow Realm\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260325/1774425204352_43fab0890711a07386ee5d0623d91948p2925027418.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131298,\"imageUrl\":\"https://img.netpop.app/cover/20260325/1774425197292_5c06e30b91447979ed7d3897083903achM00JrQlrfI0wTSweYDMLUMcv8u.webp\",\"introduction\":\"Akankah Serfort bermimpi menepati janjinya kepada seorang teman masa kecil dengan menjadi seorang Magia Vander, salah satu pesulap perkasa yang duduk di atas menara penyihir. Namun, ia tidak dapat melemparkan bahkan mantra yang paling sederhana, meninggalkannya untuk melawan monster ruang bawah tanah untuk mendapatkan kredit di Aceperen Magical Academy. Seolah -olah itu tidak cukup, dia mendapati dirinya menguji keterampilan pedangnya terhadap seorang profesor intimidasi!\",\"jumpAddress\":\"tiktik://jump/detail?id=131298&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Anime\",\"Fantasi\"],\"title\":\"Tongkat Sihir dan Pedang Wistoria\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782371456848_e87576f3b3110b92ee5ac11b5c7b15c52.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":152767,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782371452775_5f23052c0eb7f03f775f418ce56957311.jpg\",\"introduction\":\"Monster menguasai 80% dunia, dan orang-orang di Hexaldoria menerima Kelas saat lahir. Kouji Kagami, seorang Penduduk Desa—Kelas terlemah—mencapai Level 999 yang belum pernah terjadi sebelumnya. Saat dia bertemu putri Raja Iblis, segalanya berubah.\",\"jumpAddress\":\"tiktik://jump/detail?id=152767&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"HOT daftar Peringkat 4\",\"rankId\":18,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"The Villager of Level 999\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782375999451_6cfabbc7bf2fc141d6528e00bd1fd4f0ceirDIa8QgeeiFKFnLcQpfAH5V7.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":152839,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782375995583_a0784c5fd5c4f8031aa6d08d6270975cwwVm2Mnpm210b5cDpGgwOO96KLg.webp\",\"introduction\":\"Jirou Azuma yang berusia tujuh belas tahun menjalani kehidupan yang tenang bersama kakeknya, memanfaatkan kemampuan supernaturalnya untuk berbicara dengan hewan untuk berteman dan melindungi mereka. Baik Jirou dan kakeknya adalah keturunan klan shinobi lama, berlatih pertempuran untuk menjaga seni pertempuran tetap hidup dalam keluarga mereka. Kehidupan Jirou dilanda pergolakan setelah menyelamatkan kucing hitam yang tampak normal, Ragou, hanya untuk mengetahui bahwa kucing itu sebenarnya adalah mononoke—roh iblis yang telah lama berperang dengan umat manusia. Ketika mononoke musuh datang mencari Ragou, Jirou menggunakan pelatihan shinobinya untuk melompat ke pertahanan kucing itu, tapi segera menderita luka mematikan.\\n\\nDihadapkan pada keputusan apakah akan melahap energi Jirou yang memudar atau tidak dan memulihkan dirinya ke kekuatan penuh, Ragou malah memilih untuk memberikan sisa energinya kepada Jirou. Menghidupkan kembali anak itu, transfer tersebut juga memberinya kekuatan supernatural yang melengkapi gaya bertarung shinobinya sendiri. Tindakan ini disaksikan oleh Ryousuke Shiba, seorang petugas di Biro Spionase yang tugasnya berkisar mengirimkan mononoke yang agresif. Shiba memberikan tawaran kepada Jirou dan kakeknya: untuk bergabung dengan pasukan baru Biro, Black Torch, dan membantu mereka melawan mononoke kuat yang berusaha melahap orang tak bersalah.\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=152839&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Black Torch\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782373998009_3d3e01e4acc49df52e23daf53abbb893filters_quality(95)format(webp) (1).webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":152804,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782373992724_2e622fb7f72f6790161a4b51def76c4ffilters_quality(95)format(webp) (1).webp\",\"introduction\":\"\\\"Kaulah pengantin yang kucari-cari selama ini.\\\"\\n\\nKisah Cinderella ayakashi ala Jepang! Ayakashi dan manusia hidup berdampingan secara harmonis. Ayakashi, yang memiliki kemampuan unggul dan penampilan cantik, terkadang menemukan pasangannya di antara wanita manusia, menjadikan mereka \\\"pengantin\\\" mereka. Pengantin wanita, sebagai imbalan untuk membawa kemakmuran, menerima cinta mutlak dari ayakashi.\\n\\nYuzu terus-menerus dibandingkan dengan saudara perempuannya, pengantin rubah iblis, dan dibenci oleh keluarganya setiap hari. Suatu hari, ketika Yuzu tidak tahan lagi, seorang pria muncul di hadapannya di jembatan. Pria ini adalah pria tercantik yang pernah Yuzu lihat... dan dia memanggilnya istrinya?!\\n\\n\\\"Diam saja dan biarkan aku memelukmu.\\\" Ayakashi yang paling kuat dan \\\"berhati dingin\\\" mencurahkan isi hatinya untuk Yuzu?!\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=152804&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Romansa\"],\"title\":\"The Ogre's Bride\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260629/1782717970833_8aee85a46f6a3cabf1e628d79bd5698bxuq0kl6BOlEtjJOG6FCjoGJuqqK.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":153493,\"imageUrl\":\"https://img.netpop.app/cover/20260629/1782717966423_9619dcc544a004aef78938c0ca3991edxuq0kl6BOlEtjJOG6FCjoGJuqqK.jpg\",\"introduction\":\"Menyamar di belakang garis musuh, rencana terbaru Jooheon untuk menyiksa TKBM adalah dengan menjatuhkan mereka dari dalam! Mencuri relik mereka dan menyebabkan pertikaian hanyalah puncak gunung es dari apa yang akan dia lakukan untuk membuat kelompok tersebut membayar dosa-dosa mereka. Namun dengan munculnya Tower of Pride, kemampuan Jooheon dalam memancing amarah akan benar-benar diuji karena ia harus mengadu panglima perang paling menakutkan satu sama lain! Akankah Jooheon Suh menjadi pemenang dalam pertempuran para penakluk terhebat dalam sejarah?\",\"jumpAddress\":\"tiktik://jump/detail?id=153493&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"HOT daftar Peringkat 1\",\"rankId\":18,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\"],\"title\":\"Tomb Raider King\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260319/1773905449491_0b9eddce75b658d074a97851c4091038MV5BZTM3MThlM2MtNGQwZi00ZTE0LWI0YTgtZjA2MjZiZDMyOWJiXkEyXkFqcGdeQXNvbG5vbXM@._V1_.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":130714,\"imageUrl\":\"https://img.netpop.app/cover/20260319/1773905444901_2eea001fdc22de3551364f81d3e97e13FE7g7DyOHD2oRxRXV2WXI7UtNl.webp\",\"introduction\":\"Coco, putri seorang penjahit yang sederhana, selalu terpesona oleh sihir dan para penyihir yang menggunakannya, meskipun mereka melakukan tindakan pencegahan yang ketat untuk menyembunyikan metode mereka dari publik. Namun, ketika Coco memanfaatkan kesempatan emas untuk memata-matai penyihir terampil Qifrey, dia menyadari bahwa buku bergambar favoritnya selama ini adalah buku sihir yang disamarkan! Dalam kegembiraannya, dia segera mulai menguji berbagai mantra.\\n\\nKetika sebuah mantra menyebabkan bencana di rumahnya, Qifrey menyelamatkannya tepat pada waktunya dan memutuskan untuk melatihnya, menyadari bahwa dia adalah petunjuk pertama yang dia temukan yang dapat membantunya melacak Brimmed Caps—kelompok bidat berbahaya yang bereksperimen dengan sihir pengubah tubuh terlarang dan menyebarkan artefak magis di antara rakyat jelata. Namun sebelum Coco dan Qifrey dapat menghadapi Topi Bertepi, dia harus meningkatkan keterampilan sihirnya dan belajar bergaul dengan murid Qifrey lainnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=130714&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":8.2,\"showMark\":true,\"tagList\":[\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Atelier of Witch Hat\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774514781708_8b21450de2aae9d6ca9555042ca2857fg1p4w1DNYjWhnmwUiKrW80gVCMZ.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131458,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774514777603_89df76b9f23d8d0fdff59ed04cb41ffdrke9UC2QrogvxiQD9TGpbvqDosi.webp\",\"introduction\":\"Karena tidak suka berurusan dengan orang lain, Koyuki Hikawa menjaga tembok antara dirinya dan orang lain. Dia menghabiskan waktunya di sekolah menengah jauh dari orang lain, sendirian. Setidaknya sampai dia bertemu Minato Amamiya yang terus menutup jarak di antara mereka karena suatu alasan. Koyuki yang penyendiri, Miki yang populer, Minato yang tak mengenal batas, dan anggota tim bola basket yang santai dan baik hati, Youta. Ini adalah kisah tentang empat orang yang agak rumit ini dan masa muda mereka yang menggoda dan kikuk.\",\"jumpAddress\":\"tiktik://jump/detail?id=131458&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Komedi\",\"Romansa\",\"Romantic\"],\"title\":\"The Ramparts of Ice\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260330/1774855945049_aec7ce3bb5c963ebf7562effa3e67acc2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131705,\"imageUrl\":\"https://img.netpop.app/cover/20260330/1774855941870_c00affd6589ba5b194019b34387689a01.jpg\",\"introduction\":\"Gray, dewa perang dengan kekuatan unik. Suatu hari, dia tertidur seperti biasa. Ketika dia bangun, dia datang ke dunia baru yang penuh dengan sihir dan monster, dan bereinkarnasi menjadi seorang anak bernama \\\"Arthur\\\". Ia tidak mampu menelusuri kebenaran di balik kematiannya di kehidupan sebelumnya, namun alih-alih hidup di masa lalu, ia terus bekerja keras untuk beradaptasi dengan kehidupan baru ini. Seiring bertambahnya usia, kemampuan Arthur berangsur-angsur bangkit, dan dia memulai petualangan dengan mitra baru...!\",\"jumpAddress\":\"tiktik://jump/detail?id=131705&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"The Beginning After the End Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260330/1774835143864_5fc06fd5f6a5966fce10c76849908bd82.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131647,\"imageUrl\":\"https://img.netpop.app/cover/20260330/1774835141107_8e423aff106b25bf27868813c36998971.jpg\",\"introduction\":\"Saat Ayanokouji dan teman-teman sekelasnya memulai tahun kedua mereka di Sekolah Menengah Pengasuhan Lanjutan, mereka disambut oleh tantangan ujian baru dan sejumlah siswa tahun pertama yang cukup unik. Mereka harus mengenal satu sama lain dengan cepat, karena ujian khusus pertama memasangkan siswa tahun pertama dan tahun kedua dalam ujian tertulis—dan hanya siswa tahun kedua yang akan dikeluarkan jika kinerja tim mereka buruk! Lebih buruk lagi? Tampaknya salah satu siswa tahun pertama juga berasal dari Ruang Putih. Bisakah Ayanokouji menghindari pengusiran sambil mengungkap identitas musuh tersembunyi ini?\",\"jumpAddress\":\"tiktik://jump/detail?id=131647&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Classroom of the Elite IV\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260325/1774423321790_4ac04109b5d9f1218b700c7b2c921613wvqUN75YWAqFMq6pNzrwaPK76Nq.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131285,\"imageUrl\":\"https://img.netpop.app/cover/20260325/1774423317355_be4da2bd0628c01476ba1868b85c1ac5i1RaaFQUSGfx48CavoBRqeloLYb.webp\",\"introduction\":\"Juuzou Oogami adalah pembunuh bayaran legendaris yang tidak pernah gagal dalam suatu tugas, betapapun mustahilnya. Suatu hari, setelah memusnahkan sebuah organisasi yang kuat, dia disengat oleh tawon misterius dan pingsan. Ketika dia bangun, pembunuh berusia 39 tahun yang menakutkan itu telah berubah menjadi seorang anak laki-laki berusia 13 tahun!\\n\\nSebelum dia dapat memproses apa yang terjadi, bosnya memberikan perintah baru: \\\"Di dalam tubuh itu, menyusup ke sekolah menengah.\\\" Apa yang menantinya adalah kehidupan sekolah tak terduga yang dipenuhi teman sekelas yang penuh warna, kekacauan masa muda, dan bahaya yang mengancam. Bisakah Juuzou kembali ke bentuk aslinya? Or will the assassins closing in on him end his second life before it even begins!?\",\"jumpAddress\":\"tiktik://jump/detail?id=131285&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Anime\",\"Komedi\"],\"title\":\"Kill Blue\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260327/1774589667087_4c48ae56bf3f61f835c84098c3512de49xpmB050xiiG1OD51Qf7SyUz6MC.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131541,\"imageUrl\":\"https://img.netpop.app/cover/20260327/1774589608188_dc57ee74b89f511e94bf938401ff6e269xpmB050xiiG1OD51Qf7SyUz6MC.jpg\",\"introduction\":\"Musim kedua Isekai Nonbiri Nouka.\",\"jumpAddress\":\"tiktik://jump/detail?id=131541&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\",\"Fantasi\"],\"title\":\"Farming Life in Another World Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260330/1774857373089_238374e4ea4aca1e39dea788e1142dfb2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131709,\"imageUrl\":\"https://img.netpop.app/cover/20260330/1774857369776_78b194c0c5f1c61b956358cf842793e21.jpg\",\"introduction\":\"Hibiki, seorang siswa sekolah menengah yang tiba-tiba dipindahkan ke dunia lain, mengembara sendirian di padang rumput luas di dunia fantasi yang dihuni monster. Yang dia miliki hanyalah skill non-tempur seperti \\\"Appraisal\\\"! Dari situasi tanpa harapan, dia diselamatkan oleh pertemuan, dan kemampuannya yang sangat kuat berkembang! Kisah petualangan dunia lainnya tentang cheat pembalikan ajaib meledak!\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=131709&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\"],\"title\":\"The Strongest Job is Apparently Not a Hero or a Sage, but an Appraiser (Provisional)!\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774515782424_810a4a50d5b5782e470250fbcbfa1f5d8WZ9Uhh7MJ3LQVGT6B84NysHNGQ.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131470,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774515777285_d7d4290e054039a5dd2c8e065c4eeec28WZ9Uhh7MJ3LQVGT6B84NysHNGQ.webp\",\"introduction\":\"Di pedesaan Jepang, rumah Minato Kusunoki yang dipenuhi roh menjadi damai setelah kekuatan uniknya mengusir entitas jahat. Kini, para dewa unik berkumpul di rumahnya yang telah disucikan, dan dia menikmati hari-hari yang tenang bersama para pengunjung dewa tersebut.\",\"jumpAddress\":\"tiktik://jump/detail?id=131470&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":7.2,\"showMark\":true,\"tagList\":[\"Anime\",\"Fantasi\"],\"title\":\"Kusunoki's Garden of Gods\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774516058374_12232071007614c17887e0e71c7b0a34p2927686271.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131471,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774516051741_56c10d379dac077e3cf014103b47a008p2930437893.webp\",\"introduction\":\"Bagian ketiga dari Dr. Stone: Masa Depan Sains.\",\"jumpAddress\":\"tiktik://jump/detail?id=131471&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Komedi\",\"Romansa\",\"Romantic\"],\"title\":\"Dr. Stone: Science Future Part 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774516047407_a800b02935080e93f22119f5f29a9b9egsVCLL8ay0ZYl4s62xK5EjQr4Mf.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131472,\"imageUrl\":\"https://img.netpop.app/cover/20260407/1775577402912_33439568ef99cacfbfc8b4086cca58fb和班上第二可爱的女孩子成为了朋友.webp\",\"introduction\":\"Maki Maehara yang penyendiri mengharapkan satu tahun lagi tanpa teman sampai dia bertemu dengan teman sekelas populer Umi Asanagi di toko video. Meskipun lingkaran sosial mereka berbeda, mereka terikat karena kesamaan minat dalam film B, dan Asanagi meminta untuk berteman.\",\"jumpAddress\":\"tiktik://jump/detail?id=131472&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Komedi\",\"Romansa\"],\"title\":\"I Made Friends with the Second Prettiest Girl in My Class\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240410/1712732204218_2af536d3054e6475f5eab354c082e556pVxHzLWKUOqR3RrSj2Sxwm2QNgB.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":42963,\"imageUrl\":\"https://img.netpop.app/cover/20241230/1735531382786_4e0747abb8a69bf17cc925a56b6c4b32我独自升级第二季.jpg\",\"introduction\":\" Di dunia pemburu dan monster yang berbakat, seorang pemburu lemah yang dinyanyikan Jinwoo memperoleh kekuatan luar biasa melalui program misterius, membawanya untuk menjadi salah satu pemburu terkuat dan bahkan menaklukkan ruang bawah tanah terkuat.\",\"jumpAddress\":\"tiktik://jump/detail?id=42963&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":20,\"rankDesc\":\"Romance daftar Peringkat 4\",\"rankId\":132,\"rankType\":1},\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Drama\",\"Fantasi\",\"Remaja\"],\"title\":\"Solo Leveling Season 2 Arise from the Shadow\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251219/1766122600570_2d97f1d6c6e14f4d6ac92ccd8f7f3d9f2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":119016,\"imageUrl\":\"https://img.netpop.app/cover/20251219/1766122588730_e7ac45608812138407040c9611f71b192.jpg\",\"introduction\":\" Protagonis dari \\\"Magic Return 0\\\", penyihir super Yuta Otoko akan bergabung dalam pertempuran di \\\"Death Return\\\". Dia akan tampil sebagai algojo, saling berhadapan dengan pedang knotweed. Polygonum cuspidatum dan Yigu, mereka diajar oleh orang yang sama, dan keduanya \\\"dibebani kutukan\\\".\",\"jumpAddress\":\"tiktik://jump/detail?id=119016&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Fantasi\",\"Thriller\"],\"title\":\"Jujutsu Kaisen: The Culling Game Part 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251230/1767088915368_fe321158316110114d56b822e5e6b24bvjiIuR3XGpoGSumQ7DziPAmxIYR.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":121277,\"imageUrl\":\"https://img.netpop.app/cover/20260116/1768529064899_0181bc0abc818e3f59ba2a8a674873dd1FX1Jzz9L8LPaAIYfBk2HU4m6ej.webp\",\"introduction\":\"Musim kedua Jigokuraku.\",\"jumpAddress\":\"tiktik://jump/detail?id=121277&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Hell's Paradise Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260328/1774689683404_884d924247487e981e1da61f6fab85dbzAUTsmMLC7JrQCaS7vj3SBFoQvw.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":131635,\"imageUrl\":\"https://img.netpop.app/cover/20260328/1774689678699_571ba7ea5d483c8692867fcaaf6a6ec2zAUTsmMLC7JrQCaS7vj3SBFoQvw.webp\",\"introduction\":\"Musim kedua Otonari no Tenshi-sama ni Itsunomanika Dame Ningen ni Sareteita Ken.\",\"jumpAddress\":\"tiktik://jump/detail?id=131635&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Komedi\",\"Romansa\"],\"title\":\"The Angel Next Door Spoils Me Rotten Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260119/1768787370948_9c4db6a2df464005339b5a8ae44aca47khbFm3O9JwA8MuoH1svdOo4OWAB.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":119031,\"imageUrl\":\"https://img.netpop.app/cover/20260119/1768787366836_3a5e269a330cc5c7a950d3b50d14cf08cHhJzdUGcEBq6av4wr9jsIvUITH.webp\",\"introduction\":\"Di dunia di mana Raja Iblis dikalahkan oleh pahlawan Himmel dan teman-temannya, Frieren, seorang penyihir elf yang telah hidup selama lebih dari seribu tahun dan membantu membawa perdamaian bersama Himmel dan kelompoknya, menitikkan air mata atas kematian Himmel dan, didorong oleh emosinya, memulai perjalanan untuk \\\"memahami hati manusia.\\\" Sepanjang jalan, dia bertemu Fern, seorang penyihir yang dibesarkan oleh mantan rekannya Heiter, dan Stark, seorang pejuang yang merupakan murid dari mantan rekannya yang lain, Eisen. Bersama-sama, mereka melakukan perjalanan menuju tanah tempat jiwa beristirahat, \\\"Aureole\\\". Perjalanan mereka dipenuhi dengan perjumpaan dengan berbagai orang, pertarungan melawan iblis dan monster licik, momen ketenangan, kekonyolan, intensitas, dan emosi yang mendalam. Setiap momen, setiap pengalaman, menjadi bagian yang tak tergantikan dalam perjalanan mereka. Apa yang menanti mereka di akhir perjalanan ini...?\",\"jumpAddress\":\"tiktik://jump/detail?id=119031&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.3,\"showMark\":true,\"tagList\":[\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Frieren: Beyond Journey's End Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251229/1767001664192_dce8d8165550b1025e265693245e2d59地狱模式 ～喜欢速通游戏的玩家在废设定异世界无双～W.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":121006,\"imageUrl\":\"https://img.netpop.app/cover/20251229/1767001656329_2014c58af6bd9585a3fe4565a14e9c9e地狱模式 ～喜欢速通游戏的玩家在废设定异世界无双～.webp\",\"introduction\":\"\\\"Naik level meski offline?! Itu bukan game dalam 'mode mudah'—itu hanya game AFK!\\\" Game online yang dimainkan Kenichi Yamada dengan penuh semangat sedang mematikan servernya, meninggalkan kekosongan di hatinya. Dia mencari permainan baru untuk mengisinya, tapi semua yang dia temukan terlalu mudah. Jenis permainan yang disukainya—jenis yang cukup menghukum hingga membuat pemainnya ingin menghabiskan ribuan jam untuk memainkannya—sudah tidak ada lagi.\\n\\n\\\"Apa ini? 'Kamu diundang ke permainan yang tidak akan pernah berakhir.'\\\" Kenichi menemukan sebuah permainan yang belum diberi judul, sebuah tantangan yang menjanjikan dan potensi yang belum pernah ada sebelumnya. Tanpa ragu-ragu, dia memilih tingkat kesulitan \\\"Mode Neraka\\\". Lihatlah, dia mendapati dirinya bereinkarnasi di dunia lain sebagai seorang budak! Sekarang bernama Allen, dia bertekad untuk mengungkap rahasia kelas Pemanggilnya yang sarat misteri; tanpa kemudahan panduan, panduan permainan, atau forum online, dia harus meraba-raba menuju puncak dunia barunya!\",\"jumpAddress\":\"tiktik://jump/detail?id=121006&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Hell Mode: The Hardcore Gamer Dominates in Another World with Garbage Balancing\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251229/1767003139303_4aa13f0ddcb1fe4ea78f9bb5cdfa0b5b转生之后的我变成了龙蛋U.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":121017,\"imageUrl\":\"https://img.netpop.app/cover/20260115/1768472967068_4cf4aa0021e42aa5d022efd763302077iPMmOoyHEMUW4l5FAnox8lQmBjh.webp\",\"introduction\":\"Pahlawan kita suatu hari terbangun di dunia yang benar-benar baru…tetapi kehidupan barunya tidak disertai dengan keterampilan bertarung atau kekuatan sihir, atau bahkan lengan dan kaki! Dia terlahir kembali sebagai telur tak berdaya, terjebak di hutan asing yang dikelilingi oleh binatang buas dan lapar yang menakutkan. Namun telur menetas, tukik bertumbuh, dan permulaan yang sederhana dapat menghasilkan sesuatu yang hebat. Dia akan melakukan yang terbaik untuk menjadi naga terkuat yang pernah ada, dan tidak ada sedikit pun cangkang yang akan menghalanginya!\",\"jumpAddress\":\"tiktik://jump/detail?id=121017&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Reincarnated as a Dragon Hatchling\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251229/1766986426355_430b939a40156c104c4afebb2340a5af横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":120826,\"imageUrl\":\"https://img.netpop.app/cover/20251229/1766986421238_be6e2819cbf13b38e87f23de2d0343a8竖.webp\",\"introduction\":\"\\\"Orn Doula, today will be your last day in the party.\\\"\\n\\nOrn, once a skilled Swordsman, had adapted to the role of Enchanter to fill a crucial gap in the Hero Party. Namun, suatu hari, pemimpin partai tiba-tiba memecatnya, dengan alasan keterampilannya kurang. Brander a \\\"weakling\\\" and a \\\"jack of all trades, master of none,\\\" by his former comrades, Orn is cast out without a second thought.\\n\\nDetermined to start anew, he returns to adventuring—this time as a Swordsman, the role he originally excelled in. But his time as an Enchanter was far from wasted. Pengalaman, pengetahuan, dan mantra orisinal yang tak terhitung jumlahnya yang ia kembangkan di Partai Pahlawan telah membentuknya menjadi seorang pejuang yang berbeda dari yang lain. Kini, dengan berbekal serangkaian keterampilan yang tidak biasa, Orn siap untuk menentukan jalannya sendiri—jalan yang akan membuktikan kekuatannya yang sebenarnya kepada dunia.\",\"jumpAddress\":\"tiktik://jump/detail?id=120826&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Jack-of-All-Trades, Party of None\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251230/1767084353261_8a10884d5ba6dd38256132ca843fb4bfnKm1VW9tqghLfX5NZeQ7Gm2gSs0.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":121223,\"imageUrl\":\"https://img.netpop.app/cover/20251230/1767084349546_e97e4f36edd7a2a998efa6e4e455511dnKm1VW9tqghLfX5NZeQ7Gm2gSs0.webp\",\"introduction\":\"Noah, anak berusia enam tahun terkuat di dunia, memegang posisi beruntung menjadi Pangeran Kaisar Ketigabelas. Terlahir dengan batas level tak terbatas dan keterampilan curang yang memungkinkan dia menambahkan kemampuan orang yang dia perintahkan ke miliknya, dia tidak tertandingi. Bereinkarnasi menjadi keluarga bangsawan, Noah tumbuh subur di lingkungan yang diperkaya dengan pendidikan luar biasa dan sumber daya yang melimpah, memungkinkan bakatnya berkembang. Namun, di balik keglamoran masyarakat aristokrat, tersembunyi dunia konspirasi dan perebutan kekuasaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=121223&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Noble Reincarnation: Born Blessed, So I'll Obtain Ultimate Power\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251229/1766987077900_09d94f16936dd06eeb821a461638f9f0竖.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":120836,\"imageUrl\":\"https://img.netpop.app/cover/20251229/1766987071713_eee0f9c1737c701cd152413eb5aeb712竖.webp\",\"introduction\":\"Terlahir buta, Kunon ingin menjadi orang pertama yang menggunakan sihir air untuk menciptakan mata baru bagi dirinya sendiri. Setelah lima bulan belajar, ia telah melampaui gurunya, dan terus mengembangkan bakatnya. Sihirnya tidak hanya dapat membantunya merasakan warna, tetapi dia juga dapat menggunakannya untuk membuat barang-barang berguna dan bahkan menyulap seekor kucing utuh! Kabar tentang keterampilan dan kecerdikannya segera sampai ke pengadilan dan memberinya tempat sebagai murid penyihir paling kuat di negeri itu. Namun apakah tujuan akhirnya bisa tercapai?\",\"jumpAddress\":\"tiktik://jump/detail?id=120836&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Kunon the Sorcerer Can See\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251229/1766985978711_bdcb8a7a23f9629a422448b1a9b78905横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Anime\",\"dramaType\":\"COMIC\"},\"id\":120820,\"imageUrl\":\"https://img.netpop.app/cover/20251229/1766985973715_2a2496844fcf239810a2fd9cc9b425b3竖.webp\",\"introduction\":\"\\\"Pahlawan\\\" adalah hukuman terburuk di dunia. Mereka yang dihukum karena kejahatan keji dijatuhi hukuman menjadi \\\"Pahlawan\\\" dan dipaksa memasuki dinas wajib militer dalam perang melawan Raja Iblis. Narapidana ini bahkan tidak diperbolehkan mati—jika terbunuh, mereka akan dibangkitkan untuk berperang di lain hari.\\n\\nPahlawan Xylo Forbartz, mantan kepala Ordo Ksatria Suci, memimpin unit hukuman yang terdiri dari orang-orang tercela yang bertempur di garis depan. Dalam keadaan yang paling buruk inilah dia bertemu dengan Teoritta, salah satu senjata terkuat di dunia. \\\"Saat seluruh musuh telah dikalahkan, kamu harus menghujaniku dengan pujian dan menepuk kepalaku.\\\" Untuk bertahan hidup dan membalas dendam pada orang-orang yang bersalah padanya, dia membuat perjanjian dengan sang dewi dan meluncurkannya ke dalam pusaran perang dan intrik.\",\"jumpAddress\":\"tiktik://jump/detail?id=120820&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\"],\"title\":\"Sentenced to Be a Hero\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":31},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"暴力青年\",\"coverType\":1,\"homeSectionId\":84461,\"homeSectionName\":\"Sekolah Menengah Atas Passion\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211027/1635326803991_0b11ea8ba2111830bf1033a9f4b01378MDZq0ci4aZAhfa5SMsVPz9snsb.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":4696,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658212012389_073e3c4ee91c8f7af74c3597f2420c502vH4cbVLLE4GmanvJHbZpKOPBdq.jpg\",\"introduction\":\"Kisah Baek Ho Rang yang bergabung dengan klub penyiaran sekolah menengahnya, dipimpin oleh Go Eun Taek, untuk mencari tahu siapa orang yang mencoba mengungkapkan rahasianya.\",\"jumpAddress\":\"tiktik://jump/detail?id=4696&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Live On\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221118/1668754373335_a662fc08e3652ed0d7513f4ce7d77482hj2YSkoqHB2FPHeoALfdd4eufue.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":28043,\"imageUrl\":\"https://img.netpop.app/cover/20221118/1668762712530_fe57892abebeb6057834e863b244a90fp2881967225.jpg\",\"introduction\":\"Yeon Shi Eun adalah seorang siswa model, yang berada di peringkat teratas di sekolah menengahnya. Secara fisik, Yeon Shi Eun tampak seperti anak laki -laki yang lemah, tetapi dengan menggunakan kecerdasan, alat, dan psikologinya, ia berjuang melawan kekerasan yang terjadi di dalam dan di luar sekolahnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=28043&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Kampus\",\"Remaja\"],\"title\":\"Yakhanyeongung\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220321/1647829110423_15f2ebf08c009ad561612954be1ad1cb4n6LRU9BfueuhrB9wbtSrItT7hZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":14295,\"imageUrl\":\"https://img.netpop.app/cover/20220325/1648191238058_bb82574572b652c334dd41dad08f921f热血青春14295竖版.png\",\"introduction\":\"Sebuah film romantis komedi tentang generasi muda muda dan romansa mereka yang bersemangat berbasis di Hongseong, Chungcheong Namdo pada 1980-an.\",\"jumpAddress\":\"tiktik://jump/detail?id=14295&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Hot Young Bloods\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250108/1736325700426_60b13d242f4fd18e88c4a4482368ac2a学习小组.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":66936,\"imageUrl\":\"https://img.netpop.app/cover/20250108/1736325677343_b3ea05e8e6f95a39d973efd5298f94e7学习小组.jpg\",\"introduction\":\"Ini mengikuti kehidupan siswa Yun Ga Min, yang ingin menjadi pandai belajar tetapi hanya pandai bertarung, karena ia membentuk kelompok belajar di sekolah terburuk di bumi dan menceritakan kisah sengit tentang ujian masuk perguruan tinggi di perguruan tinggi .\",\"jumpAddress\":\"tiktik://jump/detail?id=66936&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Crime daftar Peringkat 5\",\"rankId\":312,\"rankType\":1},\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Romansa\",\"Kampus\",\"Remaja\"],\"title\":\"Study Group\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231108/1699413592432_5b9281f58f3a18730d3ee44379158d0c1j9OuIQe4brFqowLHRsqGsuHUjB.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":38285,\"imageUrl\":\"https://img.netpop.app/cover/20231127/1701052536934_11eb694caa4e733c443fb386f8722b081S6nsQvYErXx8wH9TnSa0breFhJ.jpg\",\"introduction\":\"Berlatar latar tahun 1980-an pertengahan hingga akhir tahun 1980-an, drama ini menceritakan kisah para siswa di sebuah sekolah menengah pertanian di provinsi Chungcheong. Jang Byung Tae adalah anak kecil dan lemah yang tinggal di Onyang di provinsi Chungcheong Selatan. Dia berada di bagian bawah tangga sosial sekolah sehingga dia pindah ke sekolah menengah pertanian Buyeo. Di sana, ia menghadapi insiden tak terduga yang menjadi titik balik dalam hidupnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=38285&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Tegang\"],\"title\":\"Once Upon a Boyhood\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250107/1736229238365_50ace3547f62ae4d55c414883541e529微信截图_20250107134821.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":66646,\"imageUrl\":\"https://img.netpop.app/cover/20250123/1737616402983_f5e99972e4968787243b03621fb1b59cAng mutya ng Section E.png\",\"introduction\":\"Jay-Jay, satu-satunya gadis di bagian E yang nakal, berharap untuk awal yang baru di sekolah menengah tetapi dengan cepat menjadi target lelucon dan skema teman sekelasnya yang gaduh untuk membuatnya pergi. Dijuluki \\\"Mutya\\\" mereka, dia melawan dengan kecerdasan dan pesona, membalikkan meja pada penyiksanya. Di tengah kekacauan, persahabatan yang tak terduga berkembang, dan kesalahpahaman lucu menyebabkan momen yang menyentuh hati. Bisakah Jay-Jay selamat dari kegilaan Bagian E, atau akankah dia menang atas hati mereka?\",\"jumpAddress\":\"tiktik://jump/detail?id=66646&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.2,\"showMark\":false,\"tagList\":[\"Romansa\",\"Kampus\",\"Remaja\"],\"title\":\"Ang mutya ng Section E\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220519/1652934893959_3822f01ba94315cd84d8fcf22222e38df5xCw22fOR6DgDRCpDFGkPbKbmY.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":18378,\"imageUrl\":\"https://img.netpop.app/cover/20220818/1660806026359_4990e8c5cf6f9f80781fd206185f05581.jpg\",\"introduction\":\"Jang Pan Su adalah pemimpin geng, dan dalam posisi yang sangat tinggi. Kim Dong Hyeon adalah siswa sekolah menengah yang diintimidasi. Ketika Kim Dong Hyeon mengalami kecelakaan dengan Jang Pan Su, mereka bangun di rumah sakit untuk mengetahui bahwa tubuh mereka telah bertukar.\",\"jumpAddress\":\"tiktik://jump/detail?id=18378&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Fantasi\"],\"title\":\"The Dude in Me\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240529/1716953266217_3044420613be30479ab8845fab7e747d120889102.1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":44762,\"imageUrl\":\"https://img.netpop.app/cover/20240612/1718178914986_9d57d2fa1c5e82c0ef94dc69f972ef76黑社会的我成为了高中生.png\",\"introduction\":\"Kim Deuk Pal adalah gangster berusia 47 tahun yang merupakan pria #2 di gengnya. Dia tidak memiliki latar belakang pendidikan karena orang tuanya yang miskin, tetapi dia bermimpi menghadiri universitas. Deuk Pal telah belajar untuk mencapai mimpinya, tetapi itu tidak mudah. Suatu hari, dia melihat seorang pemuda, Song Yi Heon, akan bunuh diri. Pada waktu itu, semangat Deuk Pal memiliki tubuh siswa sekolah menengah berusia 19 tahun yang bunuh diri. Deuk Pal segera mengetahui bahwa Yi Heon adalah korban intimidasi, yang telah membuatnya ingin mengambil nyawanya sendiri. Kyung. Se Kyung adalah seorang siswa teladan yang tampaknya berada dalam situasi yang sempurna tetapi menderita kekerasan dalam rumah tangga di rumah oleh ayahnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=44762&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.5,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"High School Return of a Gangster\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211123/1637632904626_33e1dbbefb74040131d77204154ffbb743FpZytJjlReDAPrByR77i81mnr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":6971,\"imageUrl\":\"https://img.netpop.app/cover/20211122/1637582309540_d76dc9a054714e347e8b8feb4778d255vPzWMCAQJwte0nK1cX1GTtKHsCX.jpg\",\"introduction\":\"SMA Suzuran Suswa untuk anak laki-laki, dijuluki \\\"School of Crows\\\", adalah sekolah yang paling miskin, paling kejam di negara ini. Para siswa disebut \\\"Crows\\\" dan mereka bersatu di faksi, berjuang satu sama lain untuk pengaruh dan kekuasaan. Tetapi mereka semua memiliki tujuan bersama, yang belum pernah tercapai dalam sejarah sekolah: penyatuan. Tidak ada satu faksi yang pernah memerintah tertinggi. Genji Takiya, seorang siswa transfer yang berusaha untuk mengambil alih SUZuran Boys High School dan dibimbing oleh bocah tua Yakuza Katagiri ketika ia menghadap ke saingan Serizawa.\",\"jumpAddress\":\"tiktik://jump/detail?id=6971&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Thriller\"],\"title\":\"Crows Zero\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211122/1637578854903_9a383bdaab2ed71fc2a9bd22dc258527kEQee6JM5EtDGMcofa75enQ2B45.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":6967,\"imageUrl\":\"https://img.netpop.app/cover/20211122/1637578851136_ecc29a71ff5fd7b270cc72384509c3f8m53V2l1A5imyTvXDlxltc49hZfU.jpg\",\"introduction\":\"Sayaka Kudo adalah seorang Gyaru yang mengenakan raksasa dan pewarna rambutnya pirang. Meskipun dia adalah siswa sekolah menengah atas tahun ke-2, dia sedang berada di bidang secara akademis dengan siswa sekolah dasar kelas 4. Dia sering mentransfer antar sekolah karena dia tidak dapat berteman, dan pernah ditangguhkan karena ditangkap dengan rokok. Untuk mempersiapkannya untuk ujian masuk universitasnya, ibunya memutuskan untuk mengirimnya ke Sekolah Seiho Cram. Namun, ketika direktur sekolah, Yoshitaka Tsubota, mendengar tentang masalah akademik Sayaka, ia menjadikan prestasi pribadinya untuk membantunya memasuki Universitas pilihannya, Universitas Keio, sebuah universitas bergengsi yang dianggap sebagai salah satu yang paling sulit untuk dimasuki . Setelah ayahnya memberi label padanya \\\"kepala-udara\\\", Sayaka menjadi bertekad untuk belajar keras untuk membuktikan ayahnya salah. Selama liburan musim panas di tahun keduanya hingga ujian pada akhir tahun ketiga di sekolah menengah atas, Studi Sayaka sangat sulit. Dia bahkan menghilangkan pewarna rambut pirang dan memotong rambutnya untuk menunjukkan tekadnya. Hasilnya semakin meningkat dan nilai deviasi akademiknya meningkat pesat dari 30 hingga 70 dalam rentang waktu singkat ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=6967&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Keluarga\"],\"title\":\"Flying Colors\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210915/1631677829667_90c3349637f72d203b99f7d7cca7967f31N42LhrxltHtS1bHYfZghjPDNB.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1805,\"imageUrl\":\"https://img.netpop.app/cover/20210915/1631677826668_f1d92a47252f21f6836da28dc2f31d43sld43SJArZqlnANJabq8R5wdOZk.jpg\",\"introduction\":\"Setelah diintimidasi dan didiskriminasi karena penampilannya yang jelek, seorang gadis sekolah menengah mengubah dirinya menjadi \\\"dewi\\\" yang indah dan dengan cepat naik ke ketenaran setelah menguasai seni tutorial melalui video tutorial online.\",\"jumpAddress\":\"tiktik://jump/detail?id=1805&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\",\"Kampus\",\"Remaja\"],\"title\":\"Yeoshingangrim\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220321/1647829275206_5d7b5187e50e8236fe0cd5e2c787c0b4kgKQi27zoaBbgpAFn4GLv6WQbZV.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":14296,\"imageUrl\":\"https://img.netpop.app/cover/20220321/1647829271842_995324a2881dab887bc9a0fe6bd91edcwy6kUVovsT2fUTHU96iVOF9P8MZ.jpg\",\"introduction\":\"Seorang perenang berbakat menemukan bakatnya dengan memasuki persaingan melawan saingannya yang sudah lama.\",\"jumpAddress\":\"tiktik://jump/detail?id=14296&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.5,\"showMark\":false,\"tagList\":[\"Romansa\",\"Olahraga\"],\"title\":\"No Breathing\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231120/1700450372792_c4e3a86676752da9d7c8b912e36f12ca2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":38546,\"imageUrl\":\"https://img.netpop.app/cover/20231120/1700450330901_4380d9c3f457198b34beb4bc1414565b2.jpeg.jpg\",\"introduction\":\"Kisah Pahlawan So Si Min, yang pernah memerintah negara dengan keterampilan Hapkido top-tier sebagai atlet sekolah menengah. Tujuh tahun kemudian, setelah menjadi guru paruh waktu, jadi Si Min menemukan dirinya target siswa jahat Han Soo Kang.\",\"jumpAddress\":\"tiktik://jump/detail?id=38546&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Drama\"],\"title\":\"Brave Citizen\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211129/1638173707221_31ab6183a7021145945b0a46b0d7bb0ds6k1teuMVH01038PhjpvgX4dmht.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3313,\"imageUrl\":\"https://img.netpop.app/cover/20220808/1659939910972_b377f82f2e4d78f297dc147bed673a00企业微信截图_16599398168028.png\",\"introduction\":\"Sebuah kisah tak terlupakan tentang pemuda, persahabatan dan cinta. Through drama ini para siswa di perguruan tinggi olahraga untuk impian mereka dan berusaha untuk sukses sementara menyulap persahabatan dan cinta pada saat yang sama. Dua karakter utama melakukan rollecoaster emosi bersama bersama dengan banyak teman mereka. Drama ini mengikuti semua siswa ini melalui kesulitan mereka dan saat-saat yang baik dan mengingatkan pemirsa untuk selalu peduli dan mendukung mereka yang mengelilingi dan merawat Anda - memperlakukan orang lain dengan cara yang Anda inginkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=3313&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"Weightlifting Fairy Kim Bok-Joo\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211119/1637303986247_8e2c5383467330407f001fe0b26500d4snrF3YkSzsmUacDUtURKzZYZOfh.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6841,\"imageUrl\":\"https://img.netpop.app/cover/20211119/1637303976072_23411b7381c002f70e8aa70f7204ae16snrF3YkSzsmUacDUtURKzZYZOfh.jpg\",\"introduction\":\"Seorang gadis sekolah bernama Go Eun-byul pergi pada sekolah ke Teongyeong. Sementara di Teongyeong dia bertemu saudara kembarnya Lee Eun-BI untuk pertama kalinya. Lee Eun-BI mengalami kesulitan dalam hidup dan mempertimbangkan bunuh diri. Lee Eun-BI menggantikan GO Eun-byul hidup setelah dia menghilang dan harus hidup seperti dia dan berbohong kepada semua orang.\",\"jumpAddress\":\"tiktik://jump/detail?id=6841&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Who Are You: School 2015\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220722/1658476892836_1e8c2a2e9454826fab126860bb8e73507.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":22550,\"imageUrl\":\"https://img.netpop.app/cover/20220722/1658476888133_77620e080bed5ee9794d0b5aedd47db57.jpg\",\"introduction\":\"Genji dan aliansi GPS-nya yang menang menemukan diri mereka menghadapi tantangan baru oleh para siswa Akademi Hosen, yang ditakuti oleh semua orang sebagai &#39;Tentara Pembunuh.&#39; Kedua sekolah tersebut sebenarnya memiliki sejarah darah buruk di antara mereka. Dan bara kebencian yang membara akan berkobar lagi, membakar sisa-sisa gencatan senjata yang telah mereka amati dengan ketat sampai sekarang.\",\"jumpAddress\":\"tiktik://jump/detail?id=22550&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2009,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\",\"Kriminal\"],\"title\":\"Crows Zero 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240117/1705474808798_2fca1ccfc08a7e96c04fd923b24bb0fduksx1U7UKACy5feOHs6lgg2CUj8.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":40281,\"imageUrl\":\"https://img.netpop.app/cover/20240123/1705993435351_340546ac4a2e45ea687d9b60af512874真假学园.png\",\"introduction\":\"Seorang siswa transfer remaja mendaftar di sekolah menengah semua gadis. Setelah membela sesama siswa selama pertarungan di halaman sekolah, keterampilan seni bela diri terungkap, dan segera dia harus melawan serangkaian lawan yang menakutkan, masing -masing lebih tangguh daripada yang sebelumnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=40281&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2010,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Komedi\"],\"title\":\"Majisuka Gakuen\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220930/1664528673212_ce1dece314233d1ef33ef92f738f4969复仇笔记 剧集 24222横版.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":24222,\"imageUrl\":\"https://img.netpop.app/cover/20221020/1666252394435_3695fad371c636f0c8c6625235ef99e0复仇笔记.png\",\"introduction\":\"Ho Goo Hee telah menghabiskan masa remajanya untuk dipilih. Ketika Anda mengatakan nama lengkapnya, itu terdengar seperti kata untuk \\\"pecundang,\\\" Hogu. Keluarganya miskin, jadi dia juga harus membantu di toko ayam mereka. Ditambah lagi, pacarnya baru saja putus dengannya, dan pengganggu \\\"Zombie Club\\\" yang terkenal tidak memberinya ruang untuk bernafas. Beberapa wajah yang baik bertemu dengan sekolah di sekolah termasuk Ji Hoon, pria baik lokal yang mencoba membantu goo hee tetapi tidak banyak untuk kata -kata, dan Jung Duk Hee, seorang fangirl yang bodoh yang menjadi satu -satunya teman Ho Goo Hee. Ho Goo Hee juga mendapat dukungan penuh dari kakaknya, Ho Goo Jun, dan teman terbaiknya, penyanyi Cha Eun Woo. Suatu hari, Ho Goo Hee menemukan aplikasi \\\"Revenge Note\\\" yang tampaknya ajaib, yang menawarkan janji untuk memberikan balas dendam kepada siapa pun yang namanya dimasukkan ke dalamnya. Muak dengan intimidasi, dia memutuskan sudah waktunya untuk mendapatkan pengembalian kecil. Tapi tidak butuh waktu lama untuk balas dendam manisnya untuk menjadi asam.\",\"jumpAddress\":\"tiktik://jump/detail?id=24222&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2017,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Komedi\",\"Fantasi\"],\"title\":\"Revenge Note\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211018/1634541298847_74d5da9ccdf5b193cfcfbe849829954dzv8uqdLsJzuVkZZYF7pr1DtSQei.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3564,\"imageUrl\":\"https://img.netpop.app/cover/20211018/1634541296006_56bc558dca5f82edc1e974ba7ef2281dn4RX9QVXjHbMB31TDWqqRLjshgu.jpg\",\"introduction\":\"Cha Eun Sang dan ibunya yang cacat keduanya harus bekerja keras dan memalukan pekerjaan, untuk mendukung kakak perempuannya yang di universitas di Amerika. Cha Eun Sang tidak bisa menunggu saudara perempuannya, siapa idolanya, untuk kembali ke Korea, dan mulai menghasilkan uang, jadi dia bisa berhenti mencuci piring dan mendapatkan gelar dirinya. Namun suatu hari, Cha Eun Sang mengetahui bahwa saudara perempuannya akan menikah, dan menyadari bahwa dia tidak akan pernah kembali ke Korea, jadi dia akan selamanya harus mencuci piring. Dia memutuskan untuk pergi ke Amerika juga, dan mendapatkan kehidupan yang lebih baik. Namun, apa yang dia temukan di Amerika jauh lebih buruk daripada yang bisa dia bayangkan. Kakak perempuannya tidak hanya tidak menikah, tetapi juga tidak di universitas, dan menghasilkan uang yang bekerja sebagai pelayan, dan mungkin beberapa pekerjaan sisi shadier juga. Setelah saudara perempuannya memperhatikannya, mereka bertengkar, dia mengambil semua uang Cha Eun Sang dan melarikan diri, meninggalkannya untuk menangis dan mengumpulkan mimpinya yang hancur di trotoar. Seluruh pertukaran ini diamati oleh Kim Tan misterius, yang memiliki serangkaian masalah yang sama sekali berbeda, tetapi memutuskan untuk mengambil masalah Cha Eun Sang, juga. Pada awalnya enggan pergi dengan seorang pria yang tampaknya berkenalan dengan LAPD, dia setuju untuk pergi bersamanya hanya untuk tidak menghabiskan malam di jalan. Kim Tan yang seusia dengannya, daun tanpa orang tua di sekitar, di sebuah rumah besar, mewah, yang membuatnya segera menganggap dia seorang pengedar narkoba. Alih-alih menenangkannya, dia menyarankan dia mungkin juga berurusan dengan organ manusia untuk mendukung gaya hidup ini. Sementara itu di Korea, kita melihat sekelompok siswa sekolah menengah yang istimewa dan manja, masa depan 1% dari masyarakat Korea, yang semuanya tampak akrab dengan Kim Tan, dan tidak banyak dari mereka yang menyukainya. Salah satunya adalah Choi Young do, jenius tinggi, tampan, dengan kepribadian tengik, yang belajar sebelum mendapatkan resor megahnya sendiri, pertama-tama dia akan mendapatkan usia yang sama, sama indahnya dan \\\"menyenangkan\\\", saudara tirinya, siapa Juga bertunangan untuk menikah dengan tidak lain tetapi musuh lengkungnya, Kim Tan. \\n\",\"jumpAddress\":\"tiktik://jump/detail?id=3564&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"The Heirs\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220315/1647315386676_f963aec4dfb546a22a6a9593fe3520cdqph3c3QKAMsljHM7S0tI25MlQkD.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":14003,\"imageUrl\":\"https://img.netpop.app/cover/20220824/1661310196505_c6ec895fef6cf8aa6f4030d9afe45fc6Bf54AWoDRZcraOhu8PjDWhHVyU.jpg\",\"introduction\":\"Ini menceritakan kisah 6 mantan teman sekolah menengah dari sekolah di Busan yang bertemu lagi pada 2012 dan membawa kembali kenangan ke 1997 ketika mereka masih mahasiswa sekolah menengah. Bergerak bolak-balik antara tahun 90-an dan hari ini, pusat cerita tentang kehidupan Sung Shi Won (Jung Eun Ji), yang mengidolakan boy-band h.o.t., dan 5 teman sekolah menengahnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=14003&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2012,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Reply 1997\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"丧尸肆虐\",\"coverType\":1,\"homeSectionId\":84374,\"homeSectionName\":\"Zombie & Horor\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251024/1761272980008_eb55d3d88bf99bd572ef237bdc47b043cNmGq1bfUDhrZEHvJ77zwiWfoNA.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":111844,\"imageUrl\":\"https://img.netpop.app/cover/20251024/1761272970585_7c7126fcee7d67b732aebc9c583ae531hQYEkXiAcgzQkr4aqLxWpNUFvN5.webp\",\"introduction\":\"Sebuah keluarga disfungsional yang menjalankan bisnis jamu terkenal. Pemilik perusahaan mencoba berinovasi dengan menciptakan ramuan baru, yang akhirnya memicu wabah zombie.\",\"jumpAddress\":\"tiktik://jump/detail?id=111844&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.6,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Abadi Nan Jaya\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220208/1644288502923_18c62b3f466dbed6cffb34e0b85e2e59请叫我英雄10550横版.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":10550,\"imageUrl\":\"https://img.netpop.app/cover/20220208/1644288488295_5f19f15e0ccdb8ffed569aae81fb2d77请叫我英雄10550竖版.png\",\"introduction\":\"Asisten artis manga terkejut dengan kiamat zombie.\",\"jumpAddress\":\"tiktik://jump/detail?id=10550&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\"],\"title\":\"I Am a Hero\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632623716487_a91227378fff9aa8105c35dbb909a9ea画板 1 拷贝 430.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1707,\"imageUrl\":\"https://img.netpop.app/cover/20211108/1636365139414_83f53a574cd031ef0966ee2bf885be9apiGZDwFW4urLYDWGiYJMrt6hdCS.jpg\",\"introduction\":\"Tragedi, pengkhianatan dan penemuan misterius memicu pembalasan seorang wanita atas kehilangan suku dan keluarganya dalam episode khusus \\\"Kerajaan.\\\"\",\"jumpAddress\":\"tiktik://jump/detail?id=1707&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sejarah\",\"Horor\",\"Thriller\"],\"title\":\"Kingdom: Ashin of the North\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220217/1645091912347_14d7de157958e8e055de28f231cf1e66王国 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":12444,\"imageUrl\":\"https://img.netpop.app/cover/20230808/1691465189025_3396fb5438b0a809c8e98d6cc3b49e1elGyGVjon5slG7cIoBCQMm1gCRGq.jpg\",\"introduction\":\"Diatur dalam periode Joseon. Raja jatuh sakit dengan cacar dan rumor mulai menyebar bahwa dia benar-benar mati. Sementara itu, Mahkota Prince Lee Chang diberi label pengkhianat oleh klan Haewon Cho, klan ratu hamil saat ini dan ayahnya, CHEIF State Dewanel Cho Hak Joo. Sambil mencoba mengungkap misteri apa yang terjadi pada ayahnya, Putra Mahkota pergi dengan penjaganya, Thmoo Young, ke Dongnae untuk mencari dokter Lee Seung Hui yang memperlakukan ayahnya, hanya untuk terjebak dengan asisten dokter SEO BI dan misterius Manusia, Shin muda, di sebuah desa terganggu dengan penyakit misterius. Musim kedua berpusat pada kemajuan wabah di beberapa provinsi. Dalam memimpin untuk menghentikan wabah, wahyu dahsyat terjadi di Sangju. Setelah kedatangan musim dingin, gerombolan mayat hidup sekarang berkeliaran dengan bebas karena perubahan suhu sekitar. Khawatir konsekuensi invasi yang akan terjadi, Pangeran Lee Chang berusaha untuk mengumpulkan dukungan dari sekutunya untuk menghentikan mayat hidup dan merebut kembali haknya ke atas takhta. Unbeknownst untuk Pangeran, konspirasi lain untuk perolehan politik sedang diseduh dalam klan Corrupt Haewon Cho. Sebagai skema Queen Consort Cho untuk mencuri bayi baru lahir laki-laki ke semen sebagai pewaris takhta kerajaan, dia lebih lanjut mengatur strategi parit terakhir untuk menggunakan wabah terhadap warga Hanyang, jika rencana sebelumnya gagal berhasil. Sebagai bencana tampak di antara yang hidup, hanya satu pertanyaan yang tersisa. Bisakah Pangeran menyelamatkan rakyatnya pada waktunya dan mengakhiri gejolak politik di ibukota atau akankah wabah menandai akhir Dinasti Joseon?\",\"jumpAddress\":\"tiktik://jump/detail?id=12444&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sejarah\",\"Horor\",\"Thriller\"],\"title\":\"Kingdom Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211109/1636427655290_68ede3a4b0309b28eac945283485e858hWpVSEMWDvG49ezvpksnS5BSnvB.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3441,\"imageUrl\":\"https://img.netpop.app/cover/20211109/1636427601001_cd410117122ba49a5aecc44868e8f084zqf711LsnQ5CcW3rISFw2t7OYzb.jpg\",\"introduction\":\"The rapid spread of an unknown infection has left an entire city in ungovernable chaos, but one survivor remains alive in isolation. It is his story.\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=3441&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Horor\",\"Thriller\"],\"title\":\"#Alive\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211108/1636353300460_f59ef6386ebb3238d98df486ffb899d0p2701028754.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":5705,\"imageUrl\":\"https://img.netpop.app/cover/20220831/1661926669420_84e7c8b23aa1b57aed8b0d1f8dfab8d91.jpg\",\"introduction\":\"Terletak dalam waktu dekat, sebuah bangunan apartemen bertingkat tinggi telah baru dibangun di kota besar. Bangunan apartemen memiliki penduduk dari berbagai latar belakang, tetapi penyakit menular baru pecah. Karena wabah, apartemen bertingkat tinggi ditutup. Penduduk berjuang untuk bertahan hidup, sambil terserang ketakutan dan ketidakpercayaan terhadap orang lain.\",\"jumpAddress\":\"tiktik://jump/detail?id=5705&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":8.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Fantasi\",\"Thriller\"],\"title\":\"Haepiniseu\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260423/1776923554839_ae265448a8f67ae484cd5334a5aafd08jDvxsBemt2Iyslg7qn2WMzgxz23.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":135949,\"imageUrl\":\"https://img.netpop.app/cover/20260522/1779419481598_a3758cd5473005da9794b4a067de51fe群体.jpg\",\"introduction\":\"Profesor Se Jeong, menghadiri konferensi bioteknologi dan menyaksikan perkembangannya menjadi bencana ketika virus yang bermutasi dengan cepat menyebar. Ketika wabah menyebar dan orang yang terinfeksi mulai bertransformasi, pihak berwenang menutup seluruh fasilitas.\",\"jumpAddress\":\"tiktik://jump/detail?id=135949&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"Asia daftar Peringkat 2\",\"rankId\":147,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Colony\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220926/1664189764628_fb46bbbb433d1d322383c1797b42ed3e野兽.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3426,\"imageUrl\":\"https://img.netpop.app/cover/20220926/1664189712438_9057ac1767a7833bb7dac0d030c582e6野兽.jpg\",\"introduction\":\"Sementara virus zombie pecah di Korea Selatan, penumpang berjuang untuk bertahan hidup di kereta dari Seoul ke Busan.\",\"jumpAddress\":\"tiktik://jump/detail?id=3426&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\",\"Thriller\"],\"title\":\"Train to Busan\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220926/1664189867633_5255ab3ab61ffa044b0f9a11b375a7d7野兽.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":6571,\"imageUrl\":\"https://img.netpop.app/cover/20220926/1664189833828_7705b67da7734cc24436f548779ef2e7野兽.jpg\",\"introduction\":\"Semenanjung berlangsung empat tahun setelah wabah zombie di kereta ke Busan. Semenanjung Korea hancur dan Jung Seok, mantan prajurit yang telah berhasil melarikan diri ke luar negeri, diberi misi untuk kembali dan secara tak terduga memenuhi para penyintas.\",\"jumpAddress\":\"tiktik://jump/detail?id=6571&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.5,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\",\"Thriller\"],\"title\":\"Peninsula\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211217/1639723755130_31ab0e86fb8b940faa8965e6c1106662q2HdL4CE0yZ44NkcUkSIakyrkd0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":9149,\"imageUrl\":\"https://img.netpop.app/cover/20211217/1639723753291_443b781e16cdb4c8d7afcc1a1764bef4z9Q1ldFc1OpCq3G5LulYmnvnFYd.jpg\",\"introduction\":\"Serial ini mengikuti kisah Raja Taejong dan kedua putranya, Pangeran Chungnyung dan Pangeran Yangnyeong, bagaimana mereka melawan roh-roh jahat yang menjadi hidup dan harus diusir untuk menyelamatkan Joseon.\",\"jumpAddress\":\"tiktik://jump/detail?id=9149&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":2,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Fantasi\",\"Sejarah\",\"Horor\"],\"title\":\"Joseon Exorcist\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230115/1673769806403_e97346fa82bdc1f254034fb27b12168duDgy6hyPd82kOHh6I95FLtLnj6p.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":30291,\"imageUrl\":\"https://img.netpop.app/cover/20230115/1673769803106_f9e9d925cbe1bc78b0deb09d2ef43bc3uKvVjHNqB5VmOrdxqAt2F7J78ED.jpg\",\"introduction\":\"20 tahun setelah peradaban modern dihancurkan, Joel, seorang yang selamat, disewa untuk menyelundupkan Ellie, seorang gadis berusia 14 tahun, keluar dari zona karantina yang menindas. Apa yang dimulai sebagai pekerjaan kecil segera menjadi perjalanan yang memilukan brutal karena mereka berdua harus melintasi AS dan bergantung satu sama lain untuk bertahan hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=30291&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":9,\"resourceStatus\":2,\"score\":9.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Last of Us\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230726/1690362318372_a0b10863de138cf25ef1b59314125fabsweet home.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1062,\"imageUrl\":\"https://img.netpop.app/cover/20231128/1701139521085_7ad7c407ba4943b2027536929c8fc2be1h4OqxXYRRM2FA3Nu6GBgD3puJj.jpg\",\"introduction\":\"Hyun, seorang siswa sekolah menengah penyendiri yang kehilangan seluruh keluarganya dalam kecelakaan yang mengerikan, dipaksa meninggalkan rumahnya dan harus menghadapi kenyataan baru di mana monster berusaha menghapus semua umat manusia. Sekarang dia harus melawan segala peluang untuk mencoba dan berpacu dengan jam untuk menyelamatkan apa yang tersisa dari ras manusia sebelum terlambat.\",\"jumpAddress\":\"tiktik://jump/detail?id=1062&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Horor\",\"Thriller\"],\"title\":\"Sweet Home\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220830/1661842972632_a6f782084180fda106b76015c3b114a03.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":10403,\"imageUrl\":\"https://img.netpop.app/cover/20220830/1661842910805_a3a518b332bdce956d7e2d5d6585d687美食.jpg\",\"introduction\":\" SMA menjadi ground nol untuk wabah virus zombie. Para siswa yang terperangkap harus berjuang keluar atau berubah menjadi salah satu yang terinfeksi rabi.\",\"jumpAddress\":\"tiktik://jump/detail?id=10403&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"All of Us Are Dead\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241125/1732517325132_158573a48bf5a05d25e43987a8daaa79横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":56731,\"imageUrl\":\"https://img.netpop.app/cover/20241125/1732517320984_8d7e88e1364cdaf24f498b3ab313e4bf竖.jpg\",\"introduction\":\"1941. Provinsi Chumphon, Thailand. Mok dan unit tentara muda ragtag dilemparkan ke pasukan Jepang yang menyerang. Para penjajah membawa serta senjata biologis yang menakutkan, tidak menyadari bahwa ia memiliki rencana sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=56731&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Horor\"],\"title\":\"Operation Undead\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250421/1745224033010_ec1d7447e9106b511f491e0f7f66d805856p3cUgvhU7zs0PO8Mi2Kw0WZY.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":86944,\"imageUrl\":\"https://img.netpop.app/cover/20251009/1759993366743_28378c2207895dd950f2eb5fed344422UEMweWe3pyGdgmKalt1DEOMvbV.webp\",\"introduction\":\"Virus tak dikenal menyebar ke seluruh kota, mengubah populasi menjadi zombie, dan sekelompok siswa berlindung di sekolah untuk melindungi diri mereka sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=86944&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Kekacauan\"],\"title\":\"Zomvivor\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260313/1773391653044_502b911ab1ff8ce5a73b4615ebe18f10ar6PIx6HoEz5WMVmLFMw47ePAw6.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":130049,\"imageUrl\":\"https://img.netpop.app/cover/20260313/1773391645027_9bdbf8d4e214789b72e189869c6d5406pLYiyfCYmuLDYf36AbQApadFUhN.webp\",\"introduction\":\"Mengikuti Sloane dan empat siswa lainnya yang berlindung di sekolah menengah mereka selama wabah zombie.\",\"jumpAddress\":\"tiktik://jump/detail?id=130049&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\"],\"title\":\"This Is Not a Test\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250710/1752118521725_c6843ffc4f7a1673f0c1935075e87436tdMbbFhqyEqOK1QzNTvJjHWKbZX.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":98210,\"imageUrl\":\"https://img.netpop.app/cover/20250710/1752118515762_fb9fe809296b0ef13fbbeb2b40963938yHYj2t3NzsjkHVYa0bPri4sMBsg.webp\",\"introduction\":\"Di dunia yang menyerah pada kelaparan, seorang pejuang Muay Thai bertengkar dari zombie untuk menyelamatkan kekasihnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=98210&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\",\"Thriller\"],\"title\":\"Ziam\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220508/1651976375935_6e0b934a137db36e79861930b1cc4b12i2697sDjW0k6fA9em7DmWK0nTq4.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":17562,\"imageUrl\":\"https://img.netpop.app/cover/20220517/1652786972347_ccb0225e10ca0b4e43a134a0a60c0d8e活尸电梯 17562竖版.png\",\"introduction\":\"Claudio adalah seorang pengusaha di puncak permainannya. Dalam perjalanan ke pertemuan penting, liftnya macet. Apa yang dimulai sebagai kesulitan teknis belaka ternyata menjadi bencana dari proporsi yang jauh lebih besar. Sedikit demi sedikit dan dengan ponselnya menjadi satu -satunya sumber informasi karena ia terjebak di antara lantai, Claudio menyadari bahwa dunia karena ia tahu itu telah benar -benar sia -sia. Begitu wajah-wajah yang akrab telah berubah menjadi buas dan dipenuhi darah. Virus mematikan mengubah orang menjadi zombie pembunuhan yang sangat menular. Terjebak di dalam kandang logam, dengan hantu -hantu rakus untuk mendapatkannya, Claudio harus sepenuhnya mengandalkan kecerdasannya dan naluri bertahan hidup untuk keluar dari neraka di bumi ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=17562&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2017,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.3,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"The End?\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250520/1747727838759_707732eed8696acadf0da1f51b28e854p2919768135.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":91614,\"imageUrl\":\"https://img.netpop.app/cover/20250520/1747727844054_7a1014580dd4ea6cad651c4e9f9d151fp2919768135.webp\",\"introduction\":\"Tiga puluh lima tahun setelah pertempuran Sekigahara, Jepang, yang secara bertahap kembali ke era yang damai, tiba-tiba terganggu oleh monster yang menyerang dan melahap manusia. Makhluk-makhluk ini, yang dikenal sebagai \\\"Gun-Kyou,\\\" mulai muncul, mendorong shogunat untuk diam-diam mengirimkan regu pemusnahan untuk membakar daerah yang terkena dampak dan menutupi keberadaan mereka. Suatu hari, Orin memutuskan untuk melakukan perjalanan ke desa yang jauh untuk mendapatkan obat yang akan menyembuhkan penyakit Toki. Setelah mencapai desa, dia menemukan darah dan daging manusia tersebar di mana -mana. Segera, senapan-Kyou yang berubah dengan mengerikan menyerang Orin. Pada saat itu, kenangan menyakitkan Orin dari masa lalunya muncul kembali dengan jelas. Ini menandai awal dari perjalanannya yang intens untuk melindungi saudara perempuannya yang terkasih, Toki. Setelah dibenci dan dikurung karena kondisinya, dia mencari orang tertentu untuk memahami siapa dia sebenarnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=91614&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Kostum\"],\"title\":\"I, Kill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251104/1762245054857_2ca75222752ac243d8caba6663583e91KHXQeegxWos9fD9nBKlVijpObL.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":112908,\"imageUrl\":\"https://img.netpop.app/cover/20251104/1762245041094_bbf7e08c004ce0cc37cdacfd01250a76bT7sMDsvWNeIGgZ6ZsisNdBcHdq.jpg\",\"introduction\":\"Kisah penebusan di dunia yang menjadi gelap.\",\"jumpAddress\":\"tiktik://jump/detail?id=112908&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.4,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Forgive Us All\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250908/1757310102204_ce1d6245c4d3fd370f5f3d72ce890ce3DdsdqgPJaiTJ8dJ39aJtQTUksE.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":105756,\"imageUrl\":\"https://img.netpop.app/cover/20250908/1757310096187_4187f2f8cabb9bec039ffc61f0a1033dx3rqVVrLVQGJZAfgaEDgjAkFR2F.webp\",\"introduction\":\"Setelah kematian Lunthom, suaminya dan gundiknya pindah ke vila mereka, tetapi pada saat kedatangan, mereka menemukan peti mati kaca yang berisi tubuhnya, yang mengarah ke jalan balas dendam yang menakutkan. \\n\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=105756&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Tomb Watcher\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220114/1642149006452_a6e06ad81e97ec289a0f68d2a64f4d5fxKGOj6GE5uGAbX57fkELsBjdgsG.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":10812,\"imageUrl\":\"https://img.netpop.app/cover/20220114/1642149003209_671b1d006bfa30680335131603c35eccn0aekvXq6aQ7SduuArSlLlxRZko.jpg\",\"introduction\":\"Lee Chung adalah seorang pangeran Joseon, tetapi ia telah disandera kepada Dinasti Qing.\",\"jumpAddress\":\"tiktik://jump/detail?id=10812&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\"],\"title\":\"Rampant\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250925/1758800340497_957f3f51849bb30cda6b033aa5171299gT7MXlPs7ohpdefR5cdgdPx1zsf.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":108893,\"imageUrl\":\"https://img.netpop.app/cover/20250925/1758800336867_0969ab68fc0a218a9ad2cae89c5a6b62iqtTHHYsEb0Tvr6zi8ErABmaPKn.webp\",\"introduction\":\"Lee Jeong Hwan, seorang pelatih binatang yang ganas, menjalani kehidupan sehari -hari yang kacau dengan putrinya yang memberontak, Lee Su A, yang penuh hasrat untuk menari. Suatu hari, SU A terinfeksi oleh virus zombie yang telah melanda seluruh dunia. \\n\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=108893&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Sci-Fi\",\"Thriller\"],\"title\":\"My Daughter Is a Zombie\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250806/1754468843295_931b8e1c5230d6046ffaa9a478ba2bbbp2922160124.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":101887,\"imageUrl\":\"https://img.netpop.app/cover/20250806/1754468805682_7dce0cb0e53e3d5479b5ab9f0f361f65p2923107913.jpg\",\"introduction\":\"Perjalanan Daryl melintasi Prancis yang hancur namun tangguh karena dia berharap menemukan jalan pulang.\",\"jumpAddress\":\"tiktik://jump/detail?id=101887&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"The Walking Dead: Daryl Dixon Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250424/1745460077637_409aa470e92bbb314d0622a23c728d3119pr5CzgsBYs67FAJvke8GQxN4g.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":87320,\"imageUrl\":\"https://img.netpop.app/cover/20250424/1745460073119_d487b2fcf38333045d1796a3ad5df954s6kFtdxfTC4xR8yDGbIjTgGEcFI.webp\",\"introduction\":\"Sekelompok kenakalan muda, dipindahkan ke pangkalan militer terpencil untuk rehabilitasi, mendapati diri mereka terperangkap dalam jaring rahasia dan melawan pasukan jahat yang bersembunyi di bayang -bayang.\",\"jumpAddress\":\"tiktik://jump/detail?id=87320&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.2,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"Z-Zone\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250103/1735884452256_ce1f4f1b1cab75ef632e2f477d452528新乌托邦1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":66115,\"imageUrl\":\"https://img.netpop.app/cover/20250124/1737686727692_75c983d593a6a789a505b2365e9fd5c8p2917696639.png\",\"introduction\":\"Seorang prajurit menghadapi wabah zombie selama dinas militer. Pacarnya, seorang insinyur, menavigasi Seoul yang penuh zombie. Keduanya bertarung melalui kota yang dipenuhi mayat hidup, berusaha bersatu kembali di tengah kekacauan.\",\"jumpAddress\":\"tiktik://jump/detail?id=66115&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\",\"Thriller\",\"Kekacauan\"],\"title\":\"Newtopia\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211213/1639377608475_f2d734aca9225fe8bc58b19c4a2001d261O5T8LT32NMRomUusjFmABMVIn.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":8619,\"imageUrl\":\"https://img.netpop.app/cover/20211213/1639377607688_0c117e17913491886e6e15cda763e9b2hStPBeJFt0nHH2UbZPdfI5TSRpw.jpg\",\"introduction\":\"Jae-hyuk adalah pria biasa berusia 40-an. Dia bekerja sebagai salesman persediaan medis dan dilecehkan oleh dokter sepanjang hari. Saudaranya Jae-Pil adalah detektif yang tidak terlalu tertarik dengan keselamatan publik dan menghabiskan sebagian besar waktunya mengerang tentang pasar saham. Penemuan serangkaian tubuh mengambang, mengerikan di seluruh negeri memicu histeria. Komisaris polisi terganggu untuk melihat cuplikan CCTV orang-orang melompat ke air seolah-olah mereka memiliki, dan menenggelamkan diri. Waktu berlalu dan ratusan kasus serupa dilaporkan, meninggalkan pejabat bingung mengenai penyebab kematian. Pemerintah menyatakan darurat nasional. Jae-Pil bergabung dengan investigasi besar-besaran dan bertemu dengan walikota sebuah kota kecil yang mengklaim dia menyaksikan beberapa pria dalam seragam kerja membuang anjing yang terinfeksi ke dalam sungai dan menyadari bahwa ada konspirasi di balik wabah. Sementara itu, istri dan anak Jae-hyuk menunjukkan gejala yang sama dengan para korban, yang mengarah pada pencarian kedokteran yang panik. Melalui Jae-pil dia belajar gudang yang berisi penyembuhan potensial dalam ribuan dan ribuan dosis dan kepala di sana tanpa tahu apa yang sedang dia tuju\",\"jumpAddress\":\"tiktik://jump/detail?id=8619&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2012,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Deranged\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211213/1639388500570_78cce32a25b8116f8d775a9d2c9206b1PN7yjmQdmG0J62jsrtmrPi8ezK.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":8666,\"imageUrl\":\"https://img.netpop.app/cover/20211213/1639388458589_8a7f5f21c0b89ee92bbc78282dcecb1bja8nzgtzhJq0vtX3BJcnbceIxCF.jpg\",\"introduction\":\"Enam bulan yang menantang setelah peristiwa mengerikan 28 hari kemudian ... (2002), ketika virus kemarahan yang tak terbendung menghancurkan seluruh kota London, Angkatan Darat AS telah memulihkan ketertiban dan mengopopulasi kota yang dikarantina. Namun, setelah gelombang pertama pengembalian pengungsi, pembawa patogen yang tidak menaruh curiga dari Patogen yang sangat menuntut memasuki kota yang mati, dan tanpa sadar menyalakan kembali penyebaran infeksi mematikan. Memang, virus belum mati, dan kali ini, lebih berbahaya dari sebelumnya. Akankah mimpi buruk dimulai lagi?\",\"jumpAddress\":\"tiktik://jump/detail?id=8666&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\"],\"title\":\"28 Weeks Later\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221111/1668160607143_5f2a9dc0f508f411566348c92342cef628天 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":27732,\"imageUrl\":\"https://img.netpop.app/cover/20221111/1668160603496_3e6b117c031aa33ce7f26c8936f5e2ec28天 竖.jpg\",\"introduction\":\"Aktivis hewan menyerbu laboratorium dengan tujuan melepaskan simpanse yang sedang menjalani eksperimen, terinfeksi virus -virus penyebab kemarahan. Para aktivis yang naif mengabaikan permohonan seorang ilmuwan untuk menjaga agar kandang tetap terkunci, dengan hasil yang membawa malapetaka. Dua puluh delapan hari kemudian, protagonis kita, Jim, bangun dari koma, sendirian, di rumah sakit yang ditinggalkan. Dia mulai mencari orang lain untuk menemukan London sepi, tampaknya tanpa jiwa yang hidup. Setelah menemukan sebuah gereja, yang telah dihuni oleh zombie seperti manusia yang berniat membunuhnya, dia berlari untuk hidupnya. Selena dan Mark menyelamatkannya dari gerombolan itu dan memberinya informasi terkini tentang pembantaian massal dan kengerian saat seluruh London tercabik-cabik. Ini adalah kisah bertahan hidup dan akhirnya, heroik, dengan subteks bagus tentang sifat biadab umat manusia.\",\"jumpAddress\":\"tiktik://jump/detail?id=27732&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2002,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"28 Days Later\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250527/1748338324571_d8fb7f304bce03a1fc1a5eec91eeaa225z314zU4iraY1ZhbIvgfpbMRVA7.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":92770,\"imageUrl\":\"https://img.netpop.app/cover/20250527/1748338320708_47d6086832f1621bfcf91092b6d2ae6fhVKHzr4GwSw0FepqhqQ0DDiYHNY (1).webp\",\"introduction\":\"Sekelompok orang yang selamat dari virus kemarahan tinggal di sebuah pulau kecil. Ketika salah satu kelompok meninggalkan pulau itu dalam misi ke daratan, ia menemukan rahasia, keajaiban, dan kengerian yang telah bermutasi tidak hanya yang terinfeksi tetapi juga selamat lainnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=92770&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"28 Years Later\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"热门欧美剧\",\"coverType\":1,\"homeSectionId\":83061,\"homeSectionName\":\"Drama TV Barat\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260709/1783580104111_89e77eee75da48e962f0b1e019faaba3草原上的小木屋e.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":155030,\"imageUrl\":\"https://img.netpop.app/cover/20260709/1783580098145_634e29cc3731a65cb86228cfceae6493草原上的小木屋.webp\",\"introduction\":\"Keluarga Ingalls tinggal dan bekerja di sebuah pertanian di Amerika Barat Tengah pada akhir abad ke-19.\",\"jumpAddress\":\"tiktik://jump/detail?id=155030&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":6.6,\"showMark\":true,\"tagList\":[\"Keluarga\",\"Sejarah\",\"Romansa\",\"Romantic\"],\"title\":\"Little House on the Prairie Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260703/1783046232048_4b2ba96b6e3981cbe7f9bcc1fc874feduTWhbLc7Bj4qNSdW3ZvZKL8cOHv.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":154182,\"imageUrl\":\"https://img.netpop.app/cover/20260703/1783046229329_96d27ff68b4ad46d9f811c2e5931e1a261cSwVmu0urv7H5eqRFwYlnd3oS.jpg\",\"introduction\":\"Musim ketiga mengungkap kisah asal usul yang berlatarkan berabad-abad sebelumnya, sambil melanjutkan kisah masyarakat distopia yang terdiri dari 10.000 orang yang hidup di bawah tanah dalam keadaan misterius. Saat ini, Juliette Nichols selamat dari \\\"pembersihan\\\" paksa namun kembali dengan kehilangan ingatan saat silo pulih dari pemberontakan dan menghadapi ancaman baru yang berbahaya. Sementara itu, dalam \\\"Before Times\\\", jurnalis Helen Drew dan Anggota Kongres Daniel Keene mengungkap konspirasi yang menarik mereka ke dalam rangkaian peristiwa dengan konsekuensi bencana yang tidak dapat diubah.\",\"jumpAddress\":\"tiktik://jump/detail?id=154182&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":3,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\",\"Tegang\",\"Sci-Fi\"],\"title\":\"Silo Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260701/1782886144209_16eb825c62442f6e59c83b7b16cc75c72JjyMzJxWcfO5boofm8esEVFqvZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":153821,\"imageUrl\":\"https://img.netpop.app/cover/20260701/1782886140912_99a185176a7cdedf095177e682b7ad44u0Vj7zhVK0HYxsS3VMzkU37Pebp.jpg\",\"introduction\":\"Mengikuti perjalanan Elle Woods saat SMA, menjelajahi pengalaman formatif yang membentuknya menjadi karakter \\\"Legally Blonde\\\" yang ikonik dan percaya diri.\",\"jumpAddress\":\"tiktik://jump/detail?id=153821&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\",\"Drama\"],\"title\":\"Elle Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260626/1782452407159_ced43e89115cb62dd576736e0993b36caJtG4txtmiRHwAAqENQHZvBs6kY.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":153048,\"imageUrl\":\"https://img.netpop.app/cover/20260626/1782452402217_35d665246153138e892693d2449d34adslheIKz2Xxw6ISUhRqlaT7q1Tpn.webp\",\"introduction\":\"Pertanyaan untuk tinggal dan pergi oleh Sinni, yang berdiri teguh, menabrak restoran. \\n　　Memasak, layanan, komentar komunitas, dan bintang Michelin sialan. \\n Masa depan restoran dengan awal yang indah penuh dengan variabel yang tak terhitung jumlahnya ...\",\"jumpAddress\":\"tiktik://jump/detail?id=153048&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\",\"Drama\"],\"title\":\"The Bear Season 5\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260429/1777448982064_c92fbb83f19485da28caf994deedf5bfhouse-of-the-dragon-season-3.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":137467,\"imageUrl\":\"https://img.netpop.app/cover/20260429/1777450249733_b23e6ab3fbf30043dda10065ae559f3f去除图片文字.png\",\"introduction\":\"Perang suksesi internal dalam House Targaryen pada puncak kekuasaannya, 172 tahun sebelum kelahiran Daenerys Targaryen.\",\"jumpAddress\":\"tiktik://jump/detail?id=137467&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance daftar Peringkat 2\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Romansa\"],\"title\":\"House of the Dragon Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260618/1781760899838_f25a56daa54a7f8daa0bcb21cd4a2aad我会找到你c.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":151032,\"imageUrl\":\"https://img.netpop.app/cover/20260618/1781760892183_b96dab4861f90c2a80407ec9a3821eec我会找到你.webp\",\"introduction\":\"Seorang ayah yang dipenjara karena pembunuhan putranya menerima bukti yang menunjukkan bahwa anaknya mungkin masih hidup, sehingga memaksanya untuk melarikan diri dan mengungkap kebenaran.\",\"jumpAddress\":\"tiktik://jump/detail?id=151032&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"I Will Find You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260610/1781072913557_0dbe2d4b7d2352a7df48437f6221776apNenAgAq7rObNflDgifLxq62Vjx.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":148682,\"imageUrl\":\"https://img.netpop.app/cover/20260610/1781072909503_d7add06904fb64191ee305b5594a93e0nZGf0jnSJNXLf8o7iSzzX8qxHX9.webp\",\"introduction\":\"Dua sahabat seumur hidup mengeksplorasi pertanyaan abadi - bagaimana jika cinta pertama Anda ditakdirkan untuk menjadi belahan jiwa Anda? Sebuah kisah romantis tentang kemungkinan cinta yang tak lekang oleh waktu\",\"jumpAddress\":\"tiktik://jump/detail?id=148682&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance daftar Peringkat 4\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romansa\",\"Romantic\"],\"title\":\"Every Year After\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260607/1780803484555_fe81220b7a9109373fa4a17be81c48cciw1knpC8Jg5davMn2MPxNVxBF8N.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":147707,\"imageUrl\":\"https://img.netpop.app/cover/20260607/1780803477075_035a9d7241ac50eaceb0a732a33640cap2932389853.jpg\",\"introduction\":\"Seorang vampir menceritakan kisah epiknya tentang cinta, darah, dan bahaya keabadian kepada seorang jurnalis.\",\"jumpAddress\":\"tiktik://jump/detail?id=147707&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Fantasi\",\"Horor\",\"Romansa\"],\"title\":\"Anne Rice's The Vampire Lestat\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260605/1780626383016_da01d1df72b0acb01051a65d48d36cd667d7dSnCeGxjbyCXn7giFtjPN2k.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":147409,\"imageUrl\":\"https://img.netpop.app/cover/20260605/1780626379593_11e06b3b89d92ddce843924a09f13774mpZjJ0yOxMX2GCCXJ4viTZKhdRX.jpg\",\"introduction\":\"Sepasang suami istri yang bahagia menghadapi ancaman yang semakin besar ketika seorang pembunuh terkenal dari masa lalu mereka, Max Cady, dibebaskan dari penjara dan berusaha membalas dendam.\",\"jumpAddress\":\"tiktik://jump/detail?id=147409&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Drama\",\"Thriller\"],\"title\":\"Cape Fear\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260527/1779852509396_fd76b6d1d9a6458e5b61fdb00ebae6b0好女孩的谋杀调查指南 第二季Y.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":144766,\"imageUrl\":\"https://img.netpop.app/cover/20260527/1779852494730_44fd719ccad6284a2624255c86212507好女孩的谋杀调查指南 第二季.webp\",\"introduction\":\"Pip harus menerima dampak dari penyelesaian kasus ini. Tapi ada sesuatu yang tidak beres dan Pip sekali lagi menempatkan dirinya dalam bahaya untuk mencari tahu kebenarannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=144766&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":7.1,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"A Good Girl's Guide to Murder Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260408/1775626747749_5e2c1779e62a4077db22255023dbf2762.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":132648,\"imageUrl\":\"https://img.netpop.app/cover/20260408/1775626741049_ff45406192ef89f46383b3e713317c9f1.jpg\",\"introduction\":\"Sekuel \\\"The Handmaid's Tale\\\" ini mengikuti Agnes dan Daisy, dua remaja di Gilead yang harus menjalani sekolah persiapan elit di mana kepatuhan ditegakkan secara brutal. Ikatan mereka menjadi katalis yang akan mengubah kehidupan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=132648&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"The Testaments\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260515/1778832166927_21e49865a6249c7e9300d2c082df2c9d达顿牧场s.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":141621,\"imageUrl\":\"https://img.netpop.app/cover/20260515/1778832160783_585b4b793bf2e5f00f28815a0cec6089达顿牧场.webp\",\"introduction\":\"Beth Dutton dan Rip Wheeler berjuang untuk bertahan hidup di peternakan kesayangan mereka seluas 7.000 hektar di tengah masa-masa sulit dan persaingan yang ketat, sambil memastikan Carter muda menjadi pria yang seharusnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=141621&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":9,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"Dutton Ranch\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260520/1779248105560_d582b0179171b7b001d5c28dbff4ebea9mZlvYlGA4jblCvAvOpinrgn6hr.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":142747,\"imageUrl\":\"https://img.netpop.app/cover/20260520/1779248101787_5531e9a1af8a0cb703a92827d9c2d9e3f9U0oTlvLlqbww2Gm5j8Lhf1r9W.webp\",\"introduction\":\"Seorang ibu yang bercerai terjebak dalam jaringan pemerasan, pembunuhan, dan sepak bola remaja yang berbahaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=142747&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\",\"Thriller\"],\"title\":\"Maximum Pleasure Guaranteed\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260420/1776674498429_96bb86eb07068fac36e01c7ecb23c8503uhJ3AHKxSsEWe1BUG9pV0bpqna.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":135174,\"imageUrl\":\"https://img.netpop.app/cover/20260420/1776674488206_425479a1840b3f68249e94fd8a492f5a3uhJ3AHKxSsEWe1BUG9pV0bpqna.jpg\",\"introduction\":\"Dalam babak baru seri yang berlatar dunia 'Money Heist', Berlin kembali lebih kuat dari sebelumnya. Dan kali ini, Seville adalah kanvasnya.\\nSebuah pukulan hebat baru mulai terbentuk: pencurian seorang Da Vinci. Keindahan, bahaya, dan keanggunan kriminal murni.\\nGeng bersatu kembali untuk misi unik.\",\"jumpAddress\":\"tiktik://jump/detail?id=135174&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Kriminal\",\"Tegang\",\"Thriller\"],\"title\":\"Berlin and the Lady with an Ermine Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260513/1778648860113_c16b729abfc35346fe71ff2c21b62f8932mftHj5KbvSvFUtwfD0fSEwwgM.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":140501,\"imageUrl\":\"https://img.netpop.app/cover/20260513/1778648876066_d6c9865382aa85bd1558cffa67cd0d06去除图片红色圈出文字.png\",\"introduction\":\"Akhir Dunia akan segera tiba, yang berarti Malaikat cerewet dan Iblis yang hidup bebas dan terlalu menyukai kehidupan di Bumi terpaksa membentuk aliansi yang tidak terduga untuk menghentikan Armageddon.\",\"jumpAddress\":\"tiktik://jump/detail?id=140501&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":1,\"resourceStatus\":2,\"score\":8.0,\"showMark\":true,\"tagList\":[\"Komedi\",\"Fantasi\"],\"title\":\"Good Omens Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260507/1778140336442_285093e7ee2291874e5a7b3ec8431dc0极地恶灵 第三季J.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138678,\"imageUrl\":\"https://img.netpop.app/cover/20260507/1778140329390_1e98b7bbf6700afa82c6389fe38e54d4极地恶灵 第三季.webp\",\"introduction\":\"Pepper, seorang penggerak, mendapati dirinya berada di rumah sakit jiwa yang dipenuhi dengan hal-hal yang terlupakan oleh masyarakat. Untuk bisa bebas, dia harus menghadapi kejahatan yang berkembang dalam penderitaan, membuktikan bahwa iblis dalam dirinya adalah yang terburuk.\",\"jumpAddress\":\"tiktik://jump/detail?id=138678&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":8.0,\"showMark\":true,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"The Terror Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260423/1776921459716_4ebbbe7aa378abf60fc5410b0def98b3ywBcfA5eydWp0NQ3AZa0PxqMlpY.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":135898,\"imageUrl\":\"https://img.netpop.app/cover/20260423/1776921446997_30c3107e7741d78a0c904a6c2768ad9cnP1U99YT3rkAvPzmwCBrp62uaji.webp\",\"introduction\":\"Ruben muncul di pernikahan saudara laki-lakinya yang terasing (Niall), dan bertindak sebagai katalisator bagi kebangkitan kembali hubungan mereka selama 40 tahun terakhir.\",\"jumpAddress\":\"tiktik://jump/detail?id=135898&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"Half Man\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260512/1778554680811_e23d09ca6ff3b221846fd277ba9a08c0yx0sfeYOoXol2fjT22SXo9YyviI.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":139999,\"imageUrl\":\"https://img.netpop.app/cover/20260512/1778554676825_d1149aa4340055b0bda5f38c85222d645lcxWLVAEICkFpuAiV1aMy7ZZj3.webp\",\"introduction\":\"Seorang walikota yang skeptis memimpin penduduk yang percaya takhayul di pulau New England yang terkutuk.\",\"jumpAddress\":\"tiktik://jump/detail?id=139999&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":8.1,\"showMark\":true,\"tagList\":[\"Komedi\",\"Horor\"],\"title\":\"Widow's Bay\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260507/1778136684495_b57c61bafca16382d9c593fc959b84b8寒栗7.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138616,\"imageUrl\":\"https://img.netpop.app/cover/20260507/1778136670542_7de2411858305b6121cbeba0c1abd83b寒栗.jpg\",\"introduction\":\"Detektif Naia Thulin bertemu kembali dengan rekannya yang sempat absen, Mark Hess, untuk menyelidiki pembunuhan seorang wanita berusia 41 tahun. Kasus ini tampaknya terisolasi di permukaan, namun petunjuk rumit perlahan-lahan muncul, membawa kedua orang tersebut ke kebenaran yang lebih gelap dan berbahaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=138616&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":8.0,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"The Chestnut Man Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260429/1777443200837_cd33153f601a7c751c16308cb139289f2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":137390,\"imageUrl\":\"https://img.netpop.app/cover/20260429/1777443192608_9bda0b0f036a64e201ffa94e20d0a56b1.jpg\",\"introduction\":\"Mengikuti John Creasy, mantan tentara bayaran yang terluka dalam upaya membalas dendam atas kehilangan satu-satunya rekannya sambil membela putri rekannya yang telah meninggal dari kekuatan yang menghancurkan keluarganya.\",\"jumpAddress\":\"tiktik://jump/detail?id=137390&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Kriminal\",\"Thriller\"],\"title\":\"Man on Fire\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260421/1776762107849_5c627eeb7b864aa643c3bb51e608f26fcpfPXmANeYmzOly6vUD5r2wMRMt.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":135489,\"imageUrl\":\"https://img.netpop.app/cover/20260421/1776762102205_8cd3d4ee771b88dd3e8cebb5240abc58oVl01a7R8rfmWrolWtrlPXYQqzj.webp\",\"introduction\":\"Rosie adalah seorang istri dan ibu yang setia dalam aliran sesat Kristen konservatif, dan pertemuannya dengan narapidana Sam yang melarikan diri memicu perjalanan berbahayanya menuju kebebasan dan penemuan seksual.\",\"jumpAddress\":\"tiktik://jump/detail?id=135489&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"Unchosen\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260312/1773294136031_1e1d5bbfed1ec63d4babffb637154157黑袍纠察队 第五季B.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":129848,\"imageUrl\":\"https://img.netpop.app/cover/20260312/1773294130124_543f021be55dbdf17caa72a1182eb6c8黑袍纠察队 第五季.webp\",\"introduction\":\"Sekelompok warga yang main hakim sendiri berangkat untuk menjatuhkan pahlawan super korup yang menyalahgunakan kekuatan super mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=129848&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Komedi\",\"Kriminal\",\"Sci-Fi\"],\"title\":\"The Boys Season 5\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260312/1773280229130_970004520922f8c4b26174060dc9448a8k00HPQFczCiVGtnSEDX8mQmYXC.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":129787,\"imageUrl\":\"https://img.netpop.app/cover/20260312/1773280220116_24721e91f009b684ea2af3b361183605fRR0Ho2c1nFJQiXWg4LNIgRPbg0.webp\",\"introduction\":\"Ibu muda itu mendapati dirinya berjuang untuk memenuhi kebutuhan hidup. Ketika ayahnya yang terasing menawarkan bantuan, dia memulai akun OnlyFans menggunakan saran ayahnya dari gulat profesional. Meski sukses, dia bertanya-tanya apakah ketenaran di internet harus dibayar mahal.\",\"jumpAddress\":\"tiktik://jump/detail?id=129787&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\"],\"title\":\"Margo's Got Money Troubles\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260413/1776047244856_6442394e6295d8e677aeeb92f48d19cfvFur1VinsqHGvI3UBZq3sjo6YP8.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":123797,\"imageUrl\":\"https://img.netpop.app/cover/20260115/1768458784503_b04ea0698d09bf5dbb40fe4f0f33fe5avFur1VinsqHGvI3UBZq3sjo6YP8.webp\",\"introduction\":\"Sekelompok remaja mengalami naik turunnya cinta dan persahabatan dalam dunia jejaring sosial, seks, narkoba, dan kekerasan.\",\"jumpAddress\":\"tiktik://jump/detail?id=123797&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"Euphoria Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260409/1775728534483_01f5c2ac6fad4a7fdf4e76fa78c471881pOaF4TvLApAODYD1mNHUPVPzI7.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":133040,\"imageUrl\":\"https://img.netpop.app/cover/20260409/1775728513999_b8aa6e12ad6c59315c862b4afcdbbf4d99SkFAS3S3iOtnplwH0byFUMiHK.webp\",\"introduction\":\"Kecelakaan teknologi menjadi katalis bagi Lindy dan Les, sepasang suami istri, untuk mengevaluasi kembali dinamika kekuatan hubungan mereka, yang berujung pada pertikaian dramatis saat mereka bersaing untuk mendapatkan kendali dalam pernikahan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=133040&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"The Miniature Wife Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260404/1775295192244_a0e3b78055402cd79a2018480293ed9f掩耳盗邻 第二季H.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":132395,\"imageUrl\":\"https://img.netpop.app/cover/20260404/1775294516910_27fe1ac337010694eb3c14333c727206掩耳盗邻 第二季.webp\",\"introduction\":\"Kedatangan tetangga miliarder menawan mengganggu Westmont Village. Coop mendapati dirinya bersama rekan kejahatan baru yang tak terduga.\",\"jumpAddress\":\"tiktik://jump/detail?id=132395&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.7,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Drama\"],\"title\":\"Your Friends and Neighbors Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260409/1775727744170_a2b062c7a517f58c40bd38940bb3521ceerCQAUkogIQfRjNugG7qiRcNSG.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":133038,\"imageUrl\":\"https://img.netpop.app/cover/20260409/1775727729297_057849a52c1dc4398612a27303d78c0beerCQAUkogIQfRjNugG7qiRcNSG.webp\",\"introduction\":\"Setelah berita palsu dan merusak tersebar bahwa Deborah Vance telah meninggal dunia, dia dan Ava kembali ke Las Vegas, lebih bertekad untuk melindungi warisan artistik Deborah sebagai seorang komedian.\",\"jumpAddress\":\"tiktik://jump/detail?id=133038&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Komedi\"],\"title\":\"Hacks Season 5\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774503697818_efe4a774983499d33f5defcaf23aa03daoFqfw5QKBJi5ZFW50YBVLou2VA.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":131370,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774503690959_d8247bc8d1fca0a26225b85fd87e64cceSEpYHECa5wXJGidUocJuYrALZP.webp\",\"introduction\":\"Suasana horor tertentu terasa seminggu sebelum perayaan pernikahan naas.\",\"jumpAddress\":\"tiktik://jump/detail?id=131370&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Horor\"],\"title\":\"Something Very Bad Is Going to Happen\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260316/1773643004282_139a2e1f8d834e4edde46b3f7ec3e510爱欲焚身 第三季8.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":130154,\"imageUrl\":\"https://img.netpop.app/cover/20260316/1773642987803_259a93619a861e2ec57fe7f899d3811f爱欲焚身 第三季.webp\",\"introduction\":\"Seorang wanita yang sudah menikah melakukan perjalanan berbahaya di akhir pekan jauh dari rumah yang memicu hasrat namun berakhir tragis, membuatnya bertanya-tanya apakah orang-orang terdekatnya mengatakan yang sebenarnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=130154&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":11,\"resourceStatus\":2,\"score\":6.0,\"showMark\":true,\"tagList\":[\"Kriminal\",\"Romansa\",\"Thriller\"],\"title\":\"Fatal Seduction Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260126/1769418937392_d4b9a80e9ec8c4cc5ff7c65d4616fc37aWcPzZbFa9bQbuCjCYFViotxmYM.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":125709,\"imageUrl\":\"https://img.netpop.app/cover/20260126/1769418933668_e69135c5671a6e8b86af2a96e0ee1d86e3rggcNZeCvtJf4dNSqdiEbJ57x.webp\",\"introduction\":\"Sherlock Holmes muda yang dipermalukan mendapati dirinya terlibat dalam kasus pembunuhan yang mengancam kebebasannya. Kasus pertamanya mengungkap konspirasi yang tersebar di seluruh dunia, yang berpuncak pada pertikaian eksplosif yang mengubah hidupnya selamanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=125709&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Aksi\",\"Petualangan\",\"Tegang\"],\"title\":\"Young Sherlock\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"限时大逃杀\",\"coverType\":1,\"homeSectionId\":84189,\"homeSectionName\":\"Waktu Hampir Habis!\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250305/1741176447713_89e3a0383c746d7579a41158f87f50de微信截图_20250305200709.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":77543,\"imageUrl\":\"https://img.netpop.app/cover/20250922/1758522128544_757abd8946d7975a1a0feadcc872ded0aAGEhH0pQ5DNbYljGHvY1JtnW0N.webp\",\"introduction\":\"Arisu-pemuda yang lesu, menganggur dan video-game-terobsesi-tiba-tiba menemukan dirinya dalam versi Tokyo yang aneh dan dikosongkan di mana ia dan teman-temannya harus bersaing dalam permainan berbahaya untuk bertahan hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=77543&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Alice in Borderland Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250701/1751369426353_55be9fea343d7d1668a9a868a1a0213d横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":97217,\"imageUrl\":\"https://img.netpop.app/cover/20250701/1751369421450_0111e1de2a48af2d78e6b153175a2d82竖.webp\",\"introduction\":\"Sekelompok siswa melakukan perjalanan ke karnaval misterius untuk bersenang -senang, tetapi karnaval itu ternyata menjadi permainan bertahan hidup yang brutal yang dimainkan dengan kejam dengan pikiran mereka. Apakah mereka dapat menemukan pintu keluar?\",\"jumpAddress\":\"tiktik://jump/detail?id=97217&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.1,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Horor\",\"Thriller\"],\"title\":\"Exit\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210929/1632885115358_766443798224ffa7a7274b633743c70caIokpcLZ1CRJDqFCjb0KHlUY1UQ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2814,\"imageUrl\":\"https://img.netpop.app/cover/20211201/1638351532318_871b3926fa7c2f837e1a495aa289eb6e3Obn9IR47fjhbtYtNrO7CBSrZ2w.jpg\",\"introduction\":\"Seorang siswa sekolah menengah ke-2 bernama Shun Takahata menjalani kehidupan remaja biasa sampai suatu hari dia tiba-tiba terpaksa berpartisipasi dalam serangkaian permainan anak-anak seperti \\\"Daruma-san Ga Koronda\\\" dengan kematian sebagai penalti. Tanpa pengetahuan tentang siapa di balik permainan, dia pergi tanpa pilihan lain selain untuk terus menang sebagai satu-satunya cara untuk melindungi dirinya dan teman masa kecilnya, Ichika. Sementara itu, teman sekelas bermasalah bernama Takeru tampaknya benar-benar menikmati kesempatan untuk membunuh siswa lain\",\"jumpAddress\":\"tiktik://jump/detail?id=2814&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"As the Gods Will\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240706/1720258739186_0a03962e1b3759de0729de76baeeaf24dg59eyY8uAxICPSUalktdZSrTou.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":46505,\"imageUrl\":\"https://img.netpop.app/cover/20240706/1720258735135_a34f872f5ba3ca3b9df33bc5cc88585fiLrKRd4z9AwFNhnfpB6LpRctW7L.jpg\",\"introduction\":\"Hyakaou Academy adalah sebuah lembaga di mana peringkat akademik didasarkan pada kemenangan perjudian murid. Yumeko baru di Akademi. Penampilannya yang cantik hanya dilampaui oleh nafsu makannya yang rakus untuk mempertaruhkan semuanya dan memenangkan semuanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=46505&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Kakegurui Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231203/1701594216071_f1c0087770c4796582f0695112ce1e22aAcI6QkoqpKVbFWZyII0YOSZhUr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":38880,\"imageUrl\":\"https://img.netpop.app/cover/20231203/1701594213691_8827ae6e8bb01203ae3b60f85bfe1389oyA5JnUgrnx4onLWyav4UnUey0t.jpg\",\"introduction\":\"Sebuah permainan misteri-remaja misteri di mana permainan mafia berlangsung bagi siswa di Kelas 2 dan 3 yang meninggalkan retret dan perang psikologis yang intens dalam kecurangan dan penipuan dan ketegangan yang menakjubkan tentang metode kelangsungan hidup naluriah diciptakan.\",\"jumpAddress\":\"tiktik://jump/detail?id=38880&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Night Has Come\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220624/1656061429397_9dad785bebdc05eff2a67300a4147149纸钞屋（韩版）.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":17331,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658226879764_95899c8fedd35fbb429b737e7ec7346e企业微信截图_16582268453451.png\",\"introduction\":\"Seorang ahli strategi jenius dan kru berbakatnya yang terdiri dari pencuri kelas atas yang berusaha melakukan pencurian yang belum pernah terjadi sebelumnya di semenanjung Korea. Kisah ini menggambarkan tikungan dan berbelok yang tak terduga sebagai kru panggung sandera sambil menghadapi tantangan yang tidak dapat dijelaskan. Semua mata berfokus pada latar belakang dan definisi di balik judul area ekonomi bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=17331&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Money Heist: Korea\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240415/1713166754292_040831bc6079ef8ea8fb3e711f3ab129jGwv3lDH9yPjtY4wHud0rEYBYW0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":43092,\"imageUrl\":\"https://img.netpop.app/cover/20240415/1713166749579_100fc81f43b3b215bfc8a03fe078d316wFHY8S1PuOTw69ijV6xyY1c8QEe.jpg\",\"introduction\":\" 8 orang yang membutuhkan uang diundang untuk muncul di reality-variety show money Game. 8 orang akan tinggal di studio yang tidak terdiri dari tembok beton. Jika mereka dapat bertahan di sana selama 100 hari, mereka dapat membagi hadiah kemenangan 44,8 miliar yang dimenangkan. Tapi, semua yang mereka habiskan, termasuk kebutuhan seperti makanan, air, dan listrik, biaya 1.000 kali lebih banyak dari harga normal dan dikurangkan dari hadiah pemenang.\",\"jumpAddress\":\"tiktik://jump/detail?id=43092&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"The 8 Show\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250108/1736329226710_3fbcf9a5b89c0bc860e16fc03b7cf23d鱿鱼游戏3.1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":66959,\"imageUrl\":\"https://img.netpop.app/cover/20250627/1750992005258_6c62c7298f49d607e3543ea5fd7aa290MV5BYTU3ZDVhNmMtMDVlNC00MDc0LTgwNDMtYWE5MTI2ZGI4YWIwXkEyXkFqcGc@._V1_FMjpg_UX1000_.png\",\"introduction\":\"Pemberontakan yang gagal, kematian seorang teman, dan pengkhianatan rahasia. Meningkat setelah musim terakhir menemukan Gi Hun, pemain 456, pada titik terendahnya. Tetapi permainan cumi -cumi berhenti untuk siapa pun, jadi Gi Hun akan dipaksa untuk membuat beberapa pilihan penting dalam menghadapi keputusasaan yang luar biasa saat ia dan para pemain yang masih hidup didorong ke dalam permainan yang lebih mematikan yang menguji tekad semua orang. \\n\\n Dengan setiap putaran, pilihan mereka mengarah pada konsekuensi yang semakin serius. Sementara itu, di Ho melanjutkan perannya sebagai vokalis untuk menyambut para Vips misterius, dan saudaranya Jun Ho melanjutkan pencariannya untuk pulau yang sulit dipahami, tidak menyadari ada pengkhianat di tengah -tengah mereka. Akankah Gi Hun membuat keputusan yang tepat, atau akankah vokalis akhirnya mematahkan semangatnya?\",\"jumpAddress\":\"tiktik://jump/detail?id=66959&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Squid Game Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211102/1635849304926_b86015c7cab6729cc933a0e4a927b8e9赌博默示录.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2761,\"imageUrl\":\"https://img.netpop.app/cover/20211102/1635849253677_63e647eabca9999038a8c5a54ba13fe0赌博默示录.png\",\"introduction\":\"Kaiji ITO pindah ke Jepang setelah lulus dari sekolah menengah. Tidak dapat menemukan pekerjaan dan frustrasi dengan masyarakat luas, Kaiji menghabiskan judi hari-harinya, memanjakan mobil, dan minum minuman keras. Dua tahun kemudian dan hidupnya tidak lebih baik, seorang kolektor utang bernama Endo datang untuk mengumpulkan uang. Kolektor utang kemudian menawarkan dua pilihan kepada Kaiji: menghabiskan 10 tahun melunasi pinjaman atau naik kapal judi untuk satu malam untuk membayar utang Anda dan mungkin lebih banyak lagi. Sementara itu, Endo yang tidak bermoral sebenarnya adalah Conning Kaiji, percaya dia tidak akan kembali dari Voyage. Kaiji kemudian naik untuk malam hidupnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=2761&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2009,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"Kaiji: The Ultimate Gambler\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632652870327_0db1a07ef5fc48604a835638cbcb01e6画板 1 拷贝 221.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1060,\"imageUrl\":\"https://img.netpop.app/cover/20210927/1632740456082_4f0ee0b610ea02794be3be5156a8728120mOwAAPwZ1vLQkw0fvuQHiG7bO.jpg\",\"introduction\":\"A group of bored delinquents are transported to a parallel wasteland as part of a survival game.\",\"jumpAddress\":\"tiktik://jump/detail?id=1060&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Fantasi\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Alice in Borderland\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220211/1644543639482_6238ae7bb68a794f6334d1d5e82a371220.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12192,\"imageUrl\":\"https://img.netpop.app/cover/20220211/1644543632181_601b798ab0778291ee06a462f421067419.jpg\",\"introduction\":\"Enam orang yang berbeda, masing-masing dari jalan-jalan hidup yang sangat berbeda, terbangun untuk menemukan diri mereka di dalam kubus raksasa dengan ribuan kamar yang mungkin. Masing-masing memiliki keterampilan yang menjadi jelas ketika mereka harus bersatu untuk keluar: seorang polisi, jagatan matematika, seorang desainer bangunan, seorang dokter, seorang master pelarian, dan seorang pria cacat. Masing-masing berperan dalam pencarian mendebarkan mereka untuk menemukan jawaban mengapa mereka telah dipenjara\",\"jumpAddress\":\"tiktik://jump/detail?id=12192&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1997,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Tegang\"],\"title\":\"Cube\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250424/1745476200076_b597b9c84e95b26d25bc4e185c676d32yeS6BBdYcePmipl8r4e3saOBkfj.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":87354,\"imageUrl\":\"https://img.netpop.app/cover/20250424/1745476195998_99b0de7943ca6068c7d24fd0ee45926ce3ENTAEDEO949khpVkJWgcWnwGG.webp\",\"introduction\":\"Di sekolah swasta di mana perjudian menentukan status sosial, seorang siswa baru yang terampil dengan masa lalu yang misterius sedang mengguncang segalanya - dan bertaruh untuk membalas dendam.\",\"jumpAddress\":\"tiktik://jump/detail?id=87354&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Bet\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211129/1638164875509_da53949a8995f153ca05b3894a2a5a3avmT5VZb6AACzIt3s6FcIfARbqfP.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":2768,\"imageUrl\":\"https://img.netpop.app/cover/20210928/1632801131926_a10ad4bf5991e64f5d391ecbdeb7be03欺诈 竖.jpg\",\"introduction\":\"Trusting, gullible Nao suddenly finds herself participating in the mysterious Liar Game, a game where the players are issued large sums of money which they then have to cheat each other out of. A few get rich, while the rest find themselves in debt for life. Nao's opponent is her former teacher. Relieved, she goes to him for advice, but is tricked into giving him all her money. With no idea of how to retrieve the money to avoid debt, Nao is desperate. When she gets a tip that a genius swindler, Shinichi Akiyama, is about to be released from prison, she turns to him for help. With some initial reluctance, Akiyama agrees to be her right-hand man in the game. As the two get pulled deeper into increasingly difficult levels of the game, it gradually becomes clear that their participation was far from coincidental.\",\"jumpAddress\":\"tiktik://jump/detail?id=2768&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":11,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"Liar Game Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240205/1707100742212_f6dd1de2abc90c5d1250756394afa4cb3SwzpfS0C7Ta6Uesnz5uFxfCKiF.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":41035,\"imageUrl\":\"https://img.netpop.app/cover/20240205/1707100739594_540ffb0341a8c2345a17d98aca87a8243uTnw1XahydeVkwFzY5xq5aFUh7.jpg\",\"introduction\":\"Sekitar enam orang yang mendapati diri mereka terjebak dalam kubus seperti labirin dan harus mencari jalan keluar, sambil menghindari jebakan yang fatal. \\n\\n Enam orang terkunci di ruang berbentuk kubus misterius. 6 orang ini adalah: insinyur berusia 29 tahun Yuichi Goto, karyawan asosiasi berusia 37 tahun Asako Kai, freeer 31 tahun Shinji Ochi, siswa sekolah menengah berusia 13 tahun Chiharu Uno, mekanik berusia 39 tahun Hiroshi IDE dan eksekutif perusahaan berusia 61 tahun Kazumasa Ando. 6 orang ini sangat asing satu sama lain. Mereka tidak tahu mengapa mereka terkunci di dalam ruangan, tetapi mereka mencoba melarikan diri dari kubus misterius. Jika mereka tidak dapat menguraikan kode, mereka tidak akan keluar dari kubus.\",\"jumpAddress\":\"tiktik://jump/detail?id=41035&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Tegang\",\"Thriller\"],\"title\":\"Cube\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210929/1632888949518_05f559f83cd3a6c63c4c1eae9d37aee18Ls1tZ6qjGzfGHjBB7ihOnf7f0b.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2812,\"imageUrl\":\"https://img.netpop.app/cover/20210929/1632888941087_b80328608ce7e0813cf5651bc79607cc8Ls1tZ6qjGzfGHjBB7ihOnf7f0b.jpg\",\"introduction\":\"Enam orang asing diberi kotak hitam misterius dengan tiket ke ruang pelarian yang mendalam untuk kesempatan memenangkan banyak uang. Terkunci di beberapa kamar dengan kondisi ekstrem, mereka menemukan rahasia di balik ruang pelarian dan harus berjuang untuk bertahan hidup dan menemukan jalan keluar.\",\"jumpAddress\":\"tiktik://jump/detail?id=2812&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Horor\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Escape Room\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211201/1638350982656_7f27e539e81e6b763cd8a3accfc7b5a7n4rNQUV9S9DMgCkQVt7R7VLYxNr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2745,\"imageUrl\":\"https://img.netpop.app/cover/20211201/1638350956229_7b5077c89dc3566dcb5399889dc1179faLGKAQKgzWpJ6egyWzzC11jXBRJ.jpg\",\"introduction\":\"Empat puluh dua siswa, tiga hari, satu pulau sepi: selamat datang di Battle Royale. Sekelompok siswa kelas sembilan dari sekolah menengah Jepang telah dipaksakan oleh undang-undang untuk bersaing dalam pertempuran Royale. Para siswa dikeluarkan untuk saling membunuh dalam permainan tanpa stabil hingga kematian, sampai seseorang bertahan - atau mereka semua mati. Beberapa memutuskan untuk bermain game seperti Kiriyama psikotik atau Mitsuko seksual, sementara yang lain berusaha menemukan cara untuk turun dari pulau tanpa kekerasan. Namun, karena angka-angka itu berkurang apakah ada cara bagi Shuya dan teman-teman sekelasnya untuk bertahan hidup?\",\"jumpAddress\":\"tiktik://jump/detail?id=2745&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2000,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Battle Royale\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240715/1721031214037_c1344b923a808751e3d1709e722a1673aSvAKp2wCObifgR0tj9qYRNN1Fi.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":46946,\"imageUrl\":\"https://img.netpop.app/cover/20240715/1721031208282_6a76d4d107ad35677c5f34798f6573aetvIpBg12IIA5Dr9Sjn38ygS1vQp.jpg\",\"introduction\":\" Perjalanan fisik yang mendebarkan yang memungkinkan pendekatan ke kegelapan, di mana itu menakutkan untuk dilihat. Ini menarik bagi tanggung jawab sipil pemirsa dan memaksa mereka untuk menghadapi batas solidaritas mereka sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=46946&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Platform 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221010/1665393187335_ef56459b6dc1b710b6210769f6ab599e8edzqU74USlnfkCzHtLxILUfQW3.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":25991,\"imageUrl\":\"https://img.netpop.app/cover/20221010/1665393185207_2aa761b846b698ea209e738578a494d67Y2LdQzsysZiEaklEVhNJWAZRuE.jpg\",\"introduction\":\"Arisu adalah pria tanpa banyak uang atau keberuntungan. Dia menganggur saat ini juga. Tiba -tiba, cahaya yang menyilaukan menelannya suatu hari nanti bahwa kota Tokyo telah kehilangan semua penghuninya menyelamatkan Arisu dan dua teman. Ini adalah permainan bertahan hidup yang berbahaya dan berpotensi fatal sekarang di mana mereka dipaksa untuk ambil bagian.\",\"jumpAddress\":\"tiktik://jump/detail?id=25991&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Alice in Borderland Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220610/1654848790367_6c0522eaad627d9c86640e0dfb614e5a3tkDMNfM2YuIAJlvGO6rfIzAnfG.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":20441,\"imageUrl\":\"https://img.netpop.app/cover/20240520/1716187746867_4b6ba8df1f137943bac0aff9b3fd915fqjMy3qF0gIQAf75Xa824sa2YY5D.jpg\",\"introduction\":\"Penjara vertikal dengan satu sel per level. Dua orang per sel. Hanya satu platform makanan dan dua menit per hari untuk memberi makan. Mimpi buruk tanpa akhir yang terperangkap di dalam lubang.\",\"jumpAddress\":\"tiktik://jump/detail?id=20441&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Platform\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211126/1637921436034_a5ddd671e269982000c0894b607942264mcOCiR06dqQ5eoEJcG3zvonjOa.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":7357,\"imageUrl\":\"https://img.netpop.app/cover/20211126/1637921434015_394edea82c760614e1b524a813d26146eq9Yox8i2ZJHYW62GplzxtWtIIg.jpg\",\"introduction\":\"Bab kedua Saga \\\"Maze Runner\\\" epik. Thomas (Dylan O'Brien) dan rekannya Glader menghadapi tantangan terbesar mereka: mencari petunjuk tentang organisasi misterius dan kuat yang dikenal sebagai WCKD. Perjalanan mereka membawa mereka ke Scorch, lanskap sepi yang dipenuhi dengan rintangan yang tak terbayangkan. Bekerja sama dengan para pejuang perlawanan, Gladers mengambil pasukan WCKD yang sangat unggul dan mengungkap rencananya yang mengejutkan bagi mereka semua.\",\"jumpAddress\":\"tiktik://jump/detail?id=7357&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Maze Runner: The Scorch Trials\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210914/1631612323762_5cffa9562013a655e44570fdf6a08ec69R2FuGT0BeZl8usfsfqIcO7KK7v.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2525,\"imageUrl\":\"https://img.netpop.app/cover/20240205/1707122848415_ec5f7785ea7d3fa42cdfa96ed836db6f6.jpg\",\"introduction\":\"Dua belas orang asing bangun dalam kliring. Mereka tidak tahu di mana mereka berada, atau bagaimana mereka sampai di sana. Mereka tidak tahu mereka telah dipilih - untuk tujuan yang sangat spesifik - perburuan.\",\"jumpAddress\":\"tiktik://jump/detail?id=2525&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.5,\"showMark\":false,\"tagList\":[\"Aksi\",\"Horor\",\"Thriller\"],\"title\":\"The Hunt\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210916/1631759159983_5b956845a35a9ad42b7b6523696aedf0kiqHtUr8ohIxwu60rs8G9FFMhNF.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2237,\"imageUrl\":\"https://img.netpop.app/cover/20210916/1631759157193_d27df2bd6c0656f7dc0c248485549dd6jGYJyPzVgrVV2bgClI9uvEZgVLE.jpg\",\"introduction\":\"Enam orang tanpa disadari menemukan diri mereka terkunci dalam serangkaian kamar pelarian lain, perlahan-lahan mengungkap apa yang mereka miliki bersama untuk bertahan hidup. Bergabung dengan dua korban asli, mereka segera menemukan bahwa mereka semua memainkan permainan sebelumnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=2237&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Horor\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Escape Room: Tournament of Champions\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211202/1638424084878_88eebd277e2db758ff36fc88e82be0cc9DET8yv7MYMwOWe1eR2CigFkev4.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3836,\"imageUrl\":\"https://img.netpop.app/cover/20220706/1657088045120_da79c8e03c3906f3127f84ee26165043雪国.jpg\",\"introduction\":\"Terletak pada tahun 2031, seluruh dunia dibekukan kecuali bagi mereka di atas salju. Selama tujuh belas tahun, para penyintas dunia berada di kereta yang meluncur di seluruh dunia menciptakan sistem ekonomi dan kelas mereka sendiri. Dipimpin oleh Curtis (Chris Evans), sekelompok warga kelas bawah yang tinggal di Squalor di belakang kereta bertekad untuk sampai ke depan kereta dan menyebarkan kekayaan di sekitar. Setiap bagian dari kereta menampung kejutan baru bagi kelompok yang harus bertarung melalui jalan mereka. Sebuah revolusi sedang berlangsung.\",\"jumpAddress\":\"tiktik://jump/detail?id=3836&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sci-Fi\"],\"title\":\"Snowpiercer\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"不畏霸凌！\",\"coverType\":1,\"homeSectionId\":83328,\"homeSectionName\":\"Tidak takut dengan intimidasi kampus\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260513/1778661127116_a0ab0c395b95e7ff33fbf6731224726e8jUfpHfzJXfrnDJ6yztj8jRWfYB.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":140703,\"imageUrl\":\"https://img.netpop.app/cover/20260513/1778661121445_9ab2548dc2b9d11f46aaeb2a0cf3145dcDLlx3tQbDvYJmMzjS1LJldxvlr.webp\",\"introduction\":\"Runtuhnya Kewenangan Guru, pembentukan Biro Perlindungan Kewenangan Guru di bawah Kementerian Pendidikan, dan pengiriman pengawas ke sekolah bermasalah untuk menghukum siswa dan orang tua yang melanggar batas.\",\"jumpAddress\":\"tiktik://jump/detail?id=140703&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Crime daftar Peringkat 2\",\"rankId\":312,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\"],\"title\":\"Teach You a Lesson\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250120/1737356522909_55b8bb4056cdff62a946884d147e0a4a善意的竞争2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":68938,\"imageUrl\":\"https://img.netpop.app/cover/20250210/1739151785749_d5ee91417decf4e910e9549f41d31591善意的竞争.png\",\"introduction\":\"woo seul ki tumbuh di panti asuhan di provinsi. Dia pindah ke Seoul dan mendaftar di Sekolah Menengah Chaehwa, yang merupakan sekolah untuk 1% siswa teratas di Korea Selatan. Woo Seul Ki tidak cocok dengan siswa lain. Seorang siswa bernama Yoo Je Yi mendekatinya dan mereka menjadi teman.\",\"jumpAddress\":\"tiktik://jump/detail?id=68938&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Friendly Rivalry\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230518/1684377602145_6fa6c159cb4088a206c83155767ed071高中 竖.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":33914,\"imageUrl\":\"https://img.netpop.app/cover/20240314/1710384960562_946b66b756c6498d4ec84fac108d7c225.jpg\",\"introduction\":\"Baek Je Na adalah konglomerat generasi ketiga dan sendok emas kelas tertinggi di Cheongdam International High School. Kim Hye tumbuh dalam kemiskinan dan ditawari kesempatan untuk belajar di Sekolah Menengah Internasional Cheongdam dengan imbalan keheningannya atas pembunuhan yang dia saksikan. Cheongdam International High School adalah misteri pembunuhan yang mengikuti persaingan Je Na dengan Kim Hye karena mereka diadu satu sama lain dalam perang mental.\",\"jumpAddress\":\"tiktik://jump/detail?id=33914&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\"],\"title\":\"Bitch X Rich\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221118/1668754373335_a662fc08e3652ed0d7513f4ce7d77482hj2YSkoqHB2FPHeoALfdd4eufue.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":28043,\"imageUrl\":\"https://img.netpop.app/cover/20221118/1668762712530_fe57892abebeb6057834e863b244a90fp2881967225.jpg\",\"introduction\":\"Yeon Shi Eun adalah seorang siswa model, yang berada di peringkat teratas di sekolah menengahnya. Secara fisik, Yeon Shi Eun tampak seperti anak laki -laki yang lemah, tetapi dengan menggunakan kecerdasan, alat, dan psikologinya, ia berjuang melawan kekerasan yang terjadi di dalam dan di luar sekolahnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=28043&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Kampus\",\"Remaja\"],\"title\":\"Yakhanyeongung\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220317/1647501223917_40fabebbd940e3ea24f73775bac0db8a8AEX5oZB62UD6U7CDJ1xLbbgjMv.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":14167,\"imageUrl\":\"https://img.netpop.app/cover/20220317/1647501220312_356fd0d3e3951002b63d5157d7f10cc1j57pZCKyaXRParhXE18hDGJRfbA.jpg\",\"introduction\":\"Drama ini adalah tentang pengacara yang sangat sukses yang jatuh dari rahmat karena satu kasus. Dia menjadi guru istilah tetap di sekolah menengah yang terkait dengan kasus itu untuk mendapatkan kembali kehormatannya. Meskipun dia masuk ke ruang kelas karena alasan egois, dia mulai melihat kejahatan yang terjadi dan dia memerhatikan tangannya sendiri untuk membantu melindungi korban dari rekan-rekan mereka. Drama ini akan bersinar pada kenyataan remaja yang dihadapi tidak ada dampaknya setelah melakukan kejahatan karena mereka adalah remaja, tidak memberikan perlindungan bagi mereka yang menjadi korban kejahatan ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=14167&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\"],\"title\":\"Class of Lies\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220225/1645779446440_b3852d3816f27bb5bf095ad462e6c519少年法庭.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":12117,\"imageUrl\":\"https://img.netpop.app/cover/20220211/1644547498288_ee28772a7920f191dac0d54d0056b985少年法庭 12117竖版.png\",\"introduction\":\"Seorang hakim yang terkenal karena ketidaksukaan mereka terhadap remaja menjadi hakim pengadilan remaja yang baru ditunjuk di distrik Yeonhwa. Korban kejahatan remaja di masa mudanya, ia menghadapi berbagai kasus yang melibatkan kenakalan remaja dan pemuda lainnya, yang membantu dia menemukan apa artinya menjadi dewasa.\",\"jumpAddress\":\"tiktik://jump/detail?id=12117&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\"],\"title\":\"Juvenile Justice\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231203/1701594216071_f1c0087770c4796582f0695112ce1e22aAcI6QkoqpKVbFWZyII0YOSZhUr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":38880,\"imageUrl\":\"https://img.netpop.app/cover/20231203/1701594213691_8827ae6e8bb01203ae3b60f85bfe1389oyA5JnUgrnx4onLWyav4UnUey0t.jpg\",\"introduction\":\"Sebuah permainan misteri-remaja misteri di mana permainan mafia berlangsung bagi siswa di Kelas 2 dan 3 yang meninggalkan retret dan perang psikologis yang intens dalam kecurangan dan penipuan dan ketegangan yang menakjubkan tentang metode kelangsungan hidup naluriah diciptakan.\",\"jumpAddress\":\"tiktik://jump/detail?id=38880&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Night Has Come\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240529/1716953266217_3044420613be30479ab8845fab7e747d120889102.1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":44762,\"imageUrl\":\"https://img.netpop.app/cover/20240612/1718178914986_9d57d2fa1c5e82c0ef94dc69f972ef76黑社会的我成为了高中生.png\",\"introduction\":\"Kim Deuk Pal adalah gangster berusia 47 tahun yang merupakan pria #2 di gengnya. Dia tidak memiliki latar belakang pendidikan karena orang tuanya yang miskin, tetapi dia bermimpi menghadiri universitas. Deuk Pal telah belajar untuk mencapai mimpinya, tetapi itu tidak mudah. Suatu hari, dia melihat seorang pemuda, Song Yi Heon, akan bunuh diri. Pada waktu itu, semangat Deuk Pal memiliki tubuh siswa sekolah menengah berusia 19 tahun yang bunuh diri. Deuk Pal segera mengetahui bahwa Yi Heon adalah korban intimidasi, yang telah membuatnya ingin mengambil nyawanya sendiri. Kyung. Se Kyung adalah seorang siswa teladan yang tampaknya berada dalam situasi yang sempurna tetapi menderita kekerasan dalam rumah tangga di rumah oleh ayahnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=44762&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.5,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"High School Return of a Gangster\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230627/1687845438059_ececbd3fc90d05e22f07e0cceb5a3158逃兵 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":35068,\"imageUrl\":\"https://img.netpop.app/cover/20230726/1690359224219_5b32838cc61d2128c0ac150da26c49bf丁.png\",\"introduction\":\"Tugas seorang swasta muda untuk menangkap desertir tentara mengungkapkan realitas menyakitkan yang dialami oleh masing -masing pendaftar selama panggilan tugasnya yang wajib.\",\"jumpAddress\":\"tiktik://jump/detail?id=35068&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Drama\"],\"title\":\"D.P. Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240220/1708400153403_236032d6cc90cf286ba89e7952b092a2hLHtMWn0o01ZrCnEyWnelDvHMMX.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":41420,\"imageUrl\":\"https://img.netpop.app/cover/20240220/1708400148351_8b7b2f2846d9d2c2cf738221f8454ff3pBUERwWNCuO36CPxiVFsoQCPu7W.jpg\",\"introduction\":\"setiap Kamis sore, sebulan sekali, siswa di Sarang High School memberikan suara mereka dalam jajak pendapat popularitas. Hasil? Sistem peringkat brutal yang menentukan seluruh hierarki sosial sekolah. Setelah memulai dari bawah, dapatkah siswa transfer baru Su Ji berjalan ke puncak piramida? Atau akankah dia menggulingkan permainan sama sekali?\",\"jumpAddress\":\"tiktik://jump/detail?id=41420&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\"],\"title\":\"Pyramid Game\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240103/1704269831071_dcdf6c63933ca28f6c767c8736028e59p2889065824.jpg.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":29253,\"imageUrl\":\"https://img.netpop.app/cover/20230821/1692585074768_3c500324f937c5777cf069cb3b50a5cduUM4LVlPgIrww07OoEKrGWlS1Ej.jpg\",\"introduction\":\" Ini adalah kisah balas dendam yang menyedihkan yang dimulai dengan seorang siswa sekolah menengah yang bermimpi menjadi seorang arsitek. Namun, dia harus putus sekolah setelah menderita kekerasan sekolah yang brutal. Bertahun -tahun kemudian, pelaku menikah dan memiliki anak. Begitu anak itu berada di sekolah dasar, mantan korban menjadi guru wali kelas mereka dan memulai balas dendam menyeluruh terhadap para pelaku dan pengamat dari hari -hari intimidanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=29253&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"The Glory\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230203/1675405567292_641fceda29db44a1650e3658f7a6ccfa屏幕截图 2023-02-03 142530.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":30756,\"imageUrl\":\"https://img.netpop.app/cover/20230203/1675414973205_d3e3d46dd2fd435ca4291951c3673382p2887397422.jpg\",\"introduction\":\"Rainbow Deluxe Taxi kembali berbisnis. Meskipun kru bubar setelah Do Gi yang sukses membalas dendam, Seong Cheol, GO EUN, Gyeong Gu, dan Jin Eon tidak bisa tidak bersatu kembali dengannya sekali lagi. Masing -masing dari mereka mencoba menjalani kehidupan biasa dengan pekerjaan biasa, tetapi adalah sifat mereka untuk melawan ketidakadilan. Perusahaan juga menyambut seorang karyawan baru. Berjuang atas nama semua orang yang telah dianiaya dalam masyarakat yang tidak setara ini, para kru bekerja untuk lebih banyak klien daripada sebelumnya. Namun, organisasi misterius adalah setelah Rainbow Taxi kali ini. Mereka pertama -tama menunjukkan keberadaan mereka dengan membunuh salah satu penjahat yang do Gi mengejar tetapi kembali bersembunyi tanpa memberinya kesempatan untuk mengetahuinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=30756&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Thriller\"],\"title\":\"Mobeomtaeksi 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211206/1638768796871_8a89a39e51b6f82d4f2fc0a17f8ff7ffgDPoUx97YV2JZ41ljaqoCFPUxxE.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":7998,\"imageUrl\":\"https://img.netpop.app/cover/20211206/1638768792840_5ee2cbc01233d87c327269a1694c9e7bxaUyUOf3CPV5MxaALRxUQMxsDvE.jpg\",\"introduction\":\"Sekelompok penjahat disatukan oleh hukum untuk membantu menghentikan kejahatan.\",\"jumpAddress\":\"tiktik://jump/detail?id=7998&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":11,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Drama\"],\"title\":\"Bad Guys\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211115/1636966032719_89e867d222926116ccd27207f41309eblyTvNYixDDHyB5ddfD8CJHW4dnQ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1582,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658227216237_20e262dbca9130b0b65acec540ba475d企业微信截图_16582271836885.png\",\"introduction\":\"Ini adalah kisah siswa sekolah menengah yang menjadi kusut dalam serangkaian konflik dan peristiwa yang menantang nilai-nilai dan moralitas manusia. JISOO (Kim Dong-hee) adalah mahasiswa model sekolah menengah. Untuk membayar biaya kuliah universitasnya, ia membuat pilihan yang buruk. Ini mengarah pada kejahatan serius yang terjadi. Minhee (Jung Da-Bin) dan Gyuri (Park Joo-hyun) menghadiri sekolah menengah yang sama dengan JISOO dan mereka terlibat dalam kejahatan JISOO.\",\"jumpAddress\":\"tiktik://jump/detail?id=1582&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\"],\"title\":\"Extracurricular\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250612/1749715671852_f7642072be5601dbfbe5a97453dedf38DkLvRo_3f.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":94546,\"imageUrl\":\"https://img.netpop.app/cover/20250703/1751532628586_28a8367d9208bd2797d8aca683a78b9bGsp9z4EawAA4nfy.png\",\"introduction\":\"Setelah musim gugur penjahat Oh Shi Eun di Musim 1 ... Hirarki yang dulu tak tergoyahkan di Cheongdam International High School sekarang patah!\",\"jumpAddress\":\"tiktik://jump/detail?id=94546&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Bitch X Rich Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220321/1647836137999_a0b4280c09b5aef8aad4a4a730d5f3ca猪猡之王.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":13214,\"imageUrl\":\"https://img.netpop.app/cover/20220826/1661507226099_6ada30d310315bc86593085d612e732b1651047055520_6ada30d310315bc86593085d612e732b7.jpg\",\"introduction\":\"Dua teman bertemu dan mengingat pengalaman mereka sebagai korban intimidasi sekolah ketika mereka menerima pesan dari seorang teman dari 20 tahun yang lalu dan pembunuhan serial misterius mulai terjadi. \\n\\n Kyung min hidup dengan trauma kekerasan sekolah yang dia alami dua puluh tahun yang lalu dan kasus yang tidak terduga menyebabkan emosinya yang ditekan untuk muncul kembali. Sementara itu, Detektif Jong Suk menerima pesan misterius yang dikirim dari seorang teman dari 20 tahun yang lalu yang mengingatkannya pada kekerasan sekolah yang terjadi saat itu. Mengejar pesan misterius, ia mencoba menghentikan pembunuhan. \\n\\n Melalui karakter-karakter ini dengan nasib tragis, drama menyentuh asal-usul kekerasan sekolah dan intimidasi yang meliputi masyarakat modern.\",\"jumpAddress\":\"tiktik://jump/detail?id=13214&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":8.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"The King of Pigs\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240520/1716197451067_3aa7de1e438db2072452e7708f36089ff6rZahL26DPooofKRcO1P6680U2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":44170,\"imageUrl\":\"https://img.netpop.app/cover/20240529/1716964029725_671d5144f4c53c6c35cc19dbd4e3ad5aszr7QFNnuspcyhW0rsoDMDN73pP.jpg\",\"introduction\":\" Sekolah Menengah Jooshin adalah sekolah paling bergengsi di Korea Selatan. Sekolah ini didirikan oleh kelompok konglomerat Jooshin. Biasanya, hanya siswa yang dipilih saat lahir untuk menghadiri Jooshin High School diizinkan. Para siswa itu termasuk Jeong Jae Yi, yang merupakan putri pertama dari keluarga yang menjalankan kelompok Jaeyool; Kim Ri An, yang merupakan penerus kelompok Jooshin; Yoon He Ra, yang merupakan putri termuda dari Perusahaan Perdagangan Internasional Yoon, dan Lee Woo Jin yang merupakan putra kedua dari keluarga politisi yang kuat. \\n\\n Sementara itu, Kang Ha dipindahkan ke Jooshin High School. Dia memiliki senyum murni dan polos, tetapi dia memegang rahasia. Karena dia, dunia konkret SMA Jooshin mulai retak. \\n\",\"jumpAddress\":\"tiktik://jump/detail?id=44170&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"Hierarchy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220701/1656661173563_6369f75c808234903d134d2490cbc8d7p29YKyHeyo4bgQaXoMuEs8mVJgk.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":21452,\"imageUrl\":\"https://img.netpop.app/cover/20220701/1656661171369_56e2c6ce6a1bea278c50db762d705df2yIQgdVGDjryehtnhPnQ12yZa6gk.jpg\",\"introduction\":\"Seorang gadis yang diganggu berteman dengan anak baru selama istirahat, tetapi ketika kelas dimulai lagi, persahabatan baru mereka hampir hancur ketika intimidasi berlanjut.\",\"jumpAddress\":\"tiktik://jump/detail?id=21452&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Drama\",\"Keluarga\"],\"title\":\"The World of Us\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211119/1637303986247_8e2c5383467330407f001fe0b26500d4snrF3YkSzsmUacDUtURKzZYZOfh.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6841,\"imageUrl\":\"https://img.netpop.app/cover/20211119/1637303976072_23411b7381c002f70e8aa70f7204ae16snrF3YkSzsmUacDUtURKzZYZOfh.jpg\",\"introduction\":\"Seorang gadis sekolah bernama Go Eun-byul pergi pada sekolah ke Teongyeong. Sementara di Teongyeong dia bertemu saudara kembarnya Lee Eun-BI untuk pertama kalinya. Lee Eun-BI mengalami kesulitan dalam hidup dan mempertimbangkan bunuh diri. Lee Eun-BI menggantikan GO Eun-byul hidup setelah dia menghilang dan harus hidup seperti dia dan berbohong kepada semua orang.\",\"jumpAddress\":\"tiktik://jump/detail?id=6841&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Who Are You: School 2015\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632652812557_b70b80e98f6041cb6c475b7947d78a1a画板 1 拷贝 223.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1061,\"imageUrl\":\"https://img.netpop.app/cover/20210924/1632471174625_a2d7a9fdf10a54020444148a410aef6auemn2sQ4FsnplGxRGebMmwbgeex.jpg\",\"introduction\":\"Wielding a light-up sword through the dark corners of a high school, a nurse with an unusual gift protects students from monsters only she can see.\",\"jumpAddress\":\"tiktik://jump/detail?id=1061&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":6.5,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Fantasi\"],\"title\":\"The School Nurse Files\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"无法抗拒的“BL”\",\"coverType\":1,\"homeSectionId\":81011,\"homeSectionName\":\"Boys' Love: Manis & Mesra\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260626/1782458717943_10db793b68617f5b9f7d83bb06c87c8d入戏u.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":153125,\"imageUrl\":\"https://img.netpop.app/cover/20260626/1782458706431_807b1d602922c2b0f3e258245d83cbeb入戏.webp\",\"introduction\":\"Ini menceritakan kisah aktor Zhang Zhun, yang mengikuti audisi film \\\"Into the Role\\\" dalam upaya mengatasi kemerosotan karier. Selama prosesnya, ia terlibat dengan Zhen Xin, seorang sutradara yang mencapai ketenaran di usia muda.\\nDalam film tersebut, keduanya memerankan seorang dokter dan seorang pasien yang terlibat dalam pergulatan hasrat dan manipulasi emosional. Namun di luar film, perilaku Zhen Xin yang semakin mengganggu menyebabkan hubungan mereka menjadi tidak terkendali. Ketika pertunjukan dan kenyataan saling terkait, mereka semakin sulit membedakan perasaan asli dan fiksi.\",\"jumpAddress\":\"tiktik://jump/detail?id=153125&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 30000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Deep In\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260703/1783072155180_fa268e557fdd20443eefe6f4078a930aq9q5Y2aljVXUthe2PjTFZ2gstE6.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":154373,\"imageUrl\":\"https://img.netpop.app/cover/20260703/1783072152877_17adf137a8dc0651f26bfcf652377a40AicPNTCRUVbQ9njUAO7rdDHsifS.webp\",\"introduction\":\"Kehidupan Lu Xiao Fan berubah secara tak terduga ketika dia meninggalkan kampung halamannya di pedesaan untuk menikah dengan seorang keluarga terkemuka dan kaya di Beijing.\\n\\nMengharapkan kehidupan mewah dan bergengsi, dia segera menyadari bahwa pernikahannya palsu. Namun nasibnya berubah ketika ia bertemu dengan saudara ipar barunya: Bei Lu Qing yang canggih. Tertarik ke dunia Lu Qing, Xiao Fan mati-matian berusaha menemukan tempatnya dalam kehidupan pria itu. Dia bercita-cita menjadi orang kepercayaan atau teman setia, tapi takdir mempunyai rencana lain.\\n\\nMelalui serangkaian cobaan yang canggung dan tekanan yang semakin besar, Xiao Fan mendapati dirinya dipaksa ke dalam posisi yang unik dan tidak lazim sebagai kekasih Lu Qing.\\n\\nApakah Xiao Fan sudah bertindak terlalu jauh dalam keinginannya untuk dekat dengan Lu Qing?\",\"jumpAddress\":\"tiktik://jump/detail?id=154373&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\",\"Romantic\"],\"title\":\"Bittersweet Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782378493185_1e35448cfd7969eb8618d2bc9e64d8befeISh3qoREwIPWbSaLqqumbmh7m.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":152882,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782378487742_c425011c73138b48acd3d95f03a5c6b5lK6DrnFecG0AsA8O5UqEYOrOArd.jpg\",\"introduction\":\"Lima belas tahun yang lalu, pembunuhan seorang maestro kasino besar menyeret kehidupan dua anak laki-laki ke dalam neraka. Yang satu menjadi \\\"anak korban\\\", ditinggalkan dengan rasa sakit yang mendalam seperti seorang ayah yang dicuri; yang lainnya menjadi \\\"anak si pembunuh\\\", yang dicap dengan tangan ayahnya yang berlumuran darah. Bertahun-tahun kemudian, takdir mempertemukan mereka kembali sebagai jaksa dan penyelidik. Terperangkap dalam lingkaran setan takdir, mereka menggali jaringan korupsi besar-besaran yang terjalin melalui perusahaan besar dan penuntutan itu sendiri. Film thriller misteri yang intens dan penuh gairah ini mengikuti dua pria yang, di tengah kekacauan, menjadi kelemahan fatal satu sama lain dan satu-satunya penyelamat.\",\"jumpAddress\":\"tiktik://jump/detail?id=152882&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Horror daftar Peringkat 1\",\"rankId\":126,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\",\"LGBTQ\"],\"title\":\"The Prosecutors Proposal\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260615/1781502229157_01a359f9a4a55a8d2ec9d78bf2cc7bbcnP7hng2CDtqjEOG7yr1m4ssQlZ0.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":149807,\"imageUrl\":\"https://img.netpop.app/cover/20260615/1781502226600_78eb63fcc969762c3742c76edcce13fex3P6dPwBLOH6qGoaPyKE7lHGWrm.webp\",\"introduction\":\"Di puncak karirnya, selebriti papan atas Feng Qing Lang melarikan diri ke gunung teh terpencil, mencari istirahat sejenak dari sorotan. Sebaliknya, ia bertemu dengan Xu Chang Yang, seorang petani teh muda yang berjiwa bebas dan berjiwa liar. Yang satu milik dunia ketenaran yang mempesona, yang lain milik hutan dan tanah.\\n\\nSaat mereka semakin dekat di antara pegunungan dan hutan belantara, cinta diam-diam berakar. Namun pengawasan yang tiada henti terhadap industri hiburan dan kenyataan pahit di masyarakat semakin mendekat, mendorong mereka untuk berpisah berkali-kali. Pada akhirnya, akankah mereka mengikuti panggilan hati mereka dan mempertaruhkan segalanya demi cinta?\",\"jumpAddress\":\"tiktik://jump/detail?id=149807&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\",\"Romantic\"],\"title\":\"A Winter Sun Wakes the Wind in Spring Hills' Dream\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782381037253_af04e68addf4efb097b3364ded2d050dasObI5BixnoumvMG93EOuUsdwZh.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":152891,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782381032930_ca55577f0bb9832cc4d564e5df961b4feQPvnG9Gl3dbK0Tl8fgTpwuJqRi.jpg\",\"introduction\":\"Pada tahun 1976, seorang siswa muda melangkah ke barisan pohon. Di sana, dia bertemu rekan seperjuangan dari Ban Saeng Dao. Lahirlah sebuah ikatan yang memberikan inspirasi pada jalur ideologi.\",\"jumpAddress\":\"tiktik://jump/detail?id=152891&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"When Light Fades\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260622/1782096515808_c6a6a7b49c8eeb76a99c63399fac0d0f地平线边缘Y.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":151352,\"imageUrl\":\"https://img.netpop.app/cover/20260622/1782096507934_415d53efaeda6bbf0f384e8bb12d67b2地平线边缘.webp\",\"introduction\":\"Saat sebuah kerajaan menghadapi perubahan, seorang pangeran mempertaruhkan segalanya demi rakyat jelata yang pernah ia cintai di dunia yang melarang ikatan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=151352&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT daftar Peringkat 3\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"The Edge of Horizon\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260529/1780044743925_f0a113260a5d042ee82d71e41b2d1d484sNasT3NFzcol4YztlWPpJb3Zye.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":145866,\"imageUrl\":\"https://img.netpop.app/cover/20260529/1780044740411_6198518a418e1c4b20aa129a6ec583bfd7VEPr11cZc5mUTHyYJXfbblbeJ.webp\",\"introduction\":\"Setelah pramugari Kanit bentrok dengan tiga EMT dan tasnya secara tidak sengaja tertukar dengan tas EMT Toto, ketiganya yang kacau itu meminjam barang-barang mahalnya untuk keluar malam dan barang-barang itu dicuri. Ketika kebenaran terungkap dan Toto tidak mampu membayar kembali Kanit, dia setuju untuk berdagang tenaga kerja. Kanit menugaskan Toto mengungkap perselingkuhan pacarnya. Namun ketika dia melakukannya, Toto disuap oleh pacar pilot Kanit agar tetap diam. Saat keduanya menghabiskan lebih banyak waktu bersama dan kedekatan mereka semakin meningkat, Toto mungkin mulai menyesali kebohongannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=145866&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":28,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"A Dog and a Plane\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260527/1779873056184_e11ff364d3aa19114de8650f103405ddwGBjZnQ5LtSSTkC3aA6ZALHZaUm.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":145021,\"imageUrl\":\"https://img.netpop.app/cover/20260527/1779873052902_a0c398399689f345b2abb774231fad083Y9DTIGNgdxCZkhXIyoGJWjtSuu.webp\",\"introduction\":\"Saat berkompetisi dalam acara survival idola bersama, Hyeon Jae dan Su An semakin dekat. Namun, hanya Hyeon Jae yang melakukan potongan terakhir untuk debut, memaksa mereka untuk berpisah meskipun ketertarikan mereka masih ada. Bertahun-tahun kemudian, mereka berhasil bersatu kembali melalui sebuah proyek, tapi ini bukan reuni bahagia yang mereka harapkan: sekarang mereka sudah lebih mapan di industri hiburan, mengungkapkan perasaan satu sama lain secara terbuka bahkan lebih berisiko daripada sebelumnya.\\n\\nSesama idola Jae Min, yang berusaha memulihkan reputasinya setelah sebuah skandal, dan Khun, yang datang ke Korea dari Thailand untuk mencari awal yang baru, terikat karena bersimpati atas situasi sulit mereka, tetapi mereka juga harus menghadapi kenyataan bahwa mereka mungkin tidak bisa bertindak berdasarkan perasaan mereka.\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=145021&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":15,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Musikal\",\"Romansa\",\"LGBTQ\"],\"title\":\"Love Class Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260520/1779244196111_e619f5b54c940330146e72a30d9ff5e8sbenI8G0SYE6zH8jFlRsVeLubFK.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":142677,\"imageUrl\":\"https://img.netpop.app/cover/20260520/1779244192720_8aa7cd16cb4b8eb20c2751ae4be18922gd2nyCPgKpttZNhKlEiLvhlojgA.webp\",\"introduction\":\"Akkhara, yang berulang kali disakiti karena cinta, sulit percaya bahwa dia akan bertemu cinta sejati dalam hidup ini. Suatu hari, dia membuat permohonan di kuil, mengatakan pada dirinya sendiri untuk \\\"mencobanya untuk yang terakhir kalinya.\\\" Saat itu juga, dia bertemu Intha, seorang pemilik bar yang tangguh dan percaya diri. Intha memercayai instingnya dan mulai mengejar Akkhara secara terbuka, tapi Akkhara, yang terluka oleh rasa sakit di masa lalu, tidak bisa memaksa dirinya untuk menerima perasaannya.\\n\\nSaat keduanya bekerja dan tinggal bersama di bar ChermChey, dengan alkohol yang melonggarkan hati mereka dan perawatan sehari-hari yang membuat mereka semakin dekat, mereka perlahan-lahan berubah dari orang asing menjadi orang yang paling ingin mereka lindungi.\",\"jumpAddress\":\"tiktik://jump/detail?id=142677&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT daftar Peringkat 5\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"ChermChey\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260517/1779009526107_74899687f8ce1ccc5aaf27dbcdb815b8去除图片文字.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":141736,\"imageUrl\":\"https://img.netpop.app/cover/20260517/1779008971976_0045bf9674f47f66b46e04ccc321a355p2932235966.jpg\",\"introduction\":\"Untuk menyelamatkan panti asuhan yang didirikan oleh kakeknya dan untuk melunasi utangnya, Somsak, yang sejauh ini secara finansial mendukung lembaga ini dengan keuntungan dari novel petualangannya yang sekarang tidak dapat dipasarkan, memutuskan untuk menulis genre yang lebih disukai generasi saat ini—\\\"anak laki-laki suka\\\"\\n\\nMelihat penderitaan kakeknya, Save—cucu Gen Z Somsak—memutuskan untuk membantunya dalam misi ini, meskipun mereka sering bentrok karena perbedaan generasi.\\n\\nUntuk memberikan kakeknya wawasan nyata untuk novelnya, Save memilih untuk berkencan dengan temannya yang telah menyatakan perasaannya padanya. Di sisi lain, Somsak mengalami tantangan dalam upaya memperluas wawasannya.\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=141736&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"My Grandpa Is a BL Writer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260514/1778726275457_99439724e057160791cf655160647a78aKsVftGoopv1HbkIQG1qfJ1qqa5.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":140882,\"imageUrl\":\"https://img.netpop.app/cover/20260514/1778726269117_b44c860cfb4da69cf14bd1d869babcfbkoWJdCFLPLI2VSWQhssoF91k5al.webp\",\"introduction\":\"Setelah secara tidak sengaja menghancurkan kehidupan sahabatnya, Narutaki Ryu meninggalkan segalanya dan meninggalkan Jepang. Dia hampir mati di sebuah gereja di luar negeri sebelum dia diselamatkan oleh petinju Korea bernama Hwang Jo Han. Keduanya membawa luka yang dalam dan belum tersembuhkan, dan saat jiwa mereka yang kesepian saling tertarik satu sama lain, segera menjadi jelas bahwa mereka adalah belahan jiwa. Karena takdir, mereka memutuskan untuk hidup bersama. Perjalanan mereka membawa mereka melewati Berlin, Seoul dan Tokyo, di mana mereka mengalami beragam emosi: rasa sakit yang tak terlupakan, penderitaan, dan, pada akhirnya, kegembiraan.\",\"jumpAddress\":\"tiktik://jump/detail?id=140882&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Soul Mate\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260505/1777965318867_dc571396d66b141fa5f8f3e26ff08dbf3tdPMz367L4p9MEWkxa9MeEmjAE.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138115,\"imageUrl\":\"https://img.netpop.app/cover/20260505/1777965284696_ae0dc6206c6d0d210815a6f57ad68407gIC5zrpfSCvOTUozOMyWxEcg6rm.webp\",\"introduction\":\"Pete, seorang pemuda malang yang membawa pecahan jiwa iblis, memiliki kemampuan untuk merasakan Yao—energi aneh yang melahap kekuatan hidup dan mengendalikan pikiran. Ketika dia bertemu dengan Niran, seorang pria yang dikaruniai kemampuan langka untuk mengubah takdirnya sendiri dan orang yang membawanya ke dunia Wu, keduanya menjadi pasangan yang tidak terduga, dipaksa untuk saling mengandalkan melalui setiap rintangan—sampai jiwa mereka terikat bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=138115&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":9,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Fantasi\",\"LGBTQ\"],\"title\":\"Wu\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260424/1777019455514_5df9d52490bf12227a681308f534ff365yUF8mQlT8JT82dDfSkmLAGUiJh.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":136456,\"imageUrl\":\"https://img.netpop.app/cover/20260424/1777019448828_0e95c46c623426058c6f3ff736a3adc05oc5QFYrlPmGlJZWBo9DwyynlUw.webp\",\"introduction\":\"Seorang petugas polisi yang tegas dengan masa lalu yang menyakitkan menjalin ikatan tak terduga dengan seorang pria muda yang berjuang membesarkan seorang anak sendirian.\",\"jumpAddress\":\"tiktik://jump/detail?id=136456&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Love of Silom\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260425/1777125185251_027db35b364ba9808588fbc76ff87aa2scGPHhUGqXSTwuaqqHC1CcaRfx6 (1).webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":136529,\"imageUrl\":\"https://img.netpop.app/cover/20260425/1777125145615_1a149ba58897a00e1fa8c2d90d70500e123SH5RVqynQ7BwzKcq1O8mJKA0.webp\",\"introduction\":\"Seorang CEO yang dingin menculik makhluk ajaib untuk mencuri aromanya yang tak tertahankan, hanya untuk menemukan aroma tersebut, dan kelangsungan hidupnya, bergantung pada memenangkan hati korbannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=136529&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\"],\"title\":\"Flower Boy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260702/1782986752098_8613fa57d1b4da3c644faf6e1a75f7e0胡2.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":132402,\"imageUrl\":\"https://img.netpop.app/cover/20260407/1775493520670_b19b95885a6c00dc4b39a091ae30ad22胡乱的深见君.webp\",\"introduction\":\"Saat jagoan penjualan yang diam-diam menghakimi, Kaji, menemukan pesona tak terduga dari rekannya yang tampak membosankan, Fukami, selama perjalanan semalam, pandangan mereka yang sama tentang cinta memicu pengaturan kasual yang penuh gairah yang perlahan berkembang menjadi romansa sejati.\",\"jumpAddress\":\"tiktik://jump/detail?id=132402&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Unexpectedly Naughty Fukami\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260324/1774338906366_385322d56cb074d1a9ac9eb5b533a417微信图片_20260324155419_19_7.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":131128,\"imageUrl\":\"https://img.netpop.app/cover/20260324/1774338397070_d3021256618bbb03f57765f53380f6fap2930636942.jpg\",\"introduction\":\"Akhirnya, Musim Semi\",\"jumpAddress\":\"tiktik://jump/detail?id=131128&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Finally, Spring\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260317/1773716208784_d40f7917716d406378c025bb9072ed67sorV5TksqTAFDztNFjth5Tris1C.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":130275,\"imageUrl\":\"https://img.netpop.app/cover/20260317/1773716202168_67d54efdfe36a2b7acb5d7c4f9f125a6tD5NXyURSqBxjh09Ew2lWSHkpNr.webp\",\"introduction\":\"Musuh bebuyutan Ha Neul dan Sae Byeok kini menjadi sepasang kekasih. Setelah jeda ingatan selama 10 tahun, Ha Neul terbangun dan menemukan musuh bebuyutannya di sisinya. Terjebak di antara perasaan dan waktu yang hilang, sebuah kebenaran mengejutkan muncul kembali. \\\"Tunggu, bukankah kita seharusnya putus?\\\"\",\"jumpAddress\":\"tiktik://jump/detail?id=130275&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\"],\"title\":\"Never Forget Your Enemy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260313/1773406404387_fc56c389301e85b0f70efb6fc8663805ky8k5v71odYQjaIAuQmzpWYFWmz.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":130089,\"imageUrl\":\"https://img.netpop.app/cover/20260313/1773406418429_041fb1b47d02fc0083b13fca459eb4c787poJu88dlaReAe67HD6TUec1Cr.webp\",\"introduction\":\"Bertempat di Kowloon Walled City tahun 1980-an, tempat triad merajalela, dan korupsi menjangkiti kepolisian, He Chu San bermimpi untuk belajar dengan giat dan melarikan diri dari kekacauan. Rencananya gagal ketika Xia Liu Yi, wakil pemimpin triad, secara paksa menariknya ke dalam skema kriminal. Ketika konspirasi terungkap dan perebutan kekuasaan semakin intensif, kedua tokoh ini beralih dari sekutu yang enggan menjadi mitra dalam balas dendam. He Chu San, seorang ahli strategi keuangan yang penuh perhitungan namun sangat setia, dan Xia Liu Yi, seorang penegak hukum yang galak namun tidak disangka-sangka, mendapati diri mereka berjuang berdampingan. Di kota tanpa hukum yang seimbang antara hitam dan putih, cinta menjadi pertaruhan paling berbahaya. Bisakah mereka mencari jalan untuk bertahan hidup satu sama lain?\",\"jumpAddress\":\"tiktik://jump/detail?id=130089&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":9,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Sammy’s Children’s Day\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260314/1773489076369_c8aa3dc8a697aa15f6dcfd624235819a47alTFbslr8EW78EG6HeVjsLl2s.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":130095,\"imageUrl\":\"https://img.netpop.app/cover/20260314/1773489073165_ff145c4e005cc1a3bf0d75225588f85c7NEZmleIbrL7krMmZtWpl6ReuOn.jpg\",\"introduction\":\"Guru sekolah dasar Pobmek tidak menyukai anak-anak, tetapi pacarnya, Guru Solar, menyukainya, dan dia lebih dari cukup menyukai Solar untuk menebusnya. Namun, ketika dia mengalami kecelakaan, Solar mengalami kerusakan otak, dan terkadang mengalami kemunduran mental hingga usia tujuh tahun. Setelah ia membawa pulang \\\"Nong Sun\\\", ada hari-hari di mana Pobmek tidak mendapat kelonggaran dari anak-anak.\",\"jumpAddress\":\"tiktik://jump/detail?id=130095&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\",\"LGBTQ\"],\"title\":\"Love You Teacher\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260305/1772690222823_0b640acee9d28937737c6b9af3480afdmeJhZt0zDjC4IjGO12ThnTxxJZL.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":129090,\"imageUrl\":\"https://img.netpop.app/cover/20260305/1772690214275_7dd9ca003338b5f69b1ec93cb7dfe7afn3vbWmYzkDCYXQkSBpWa63GTK77.webp\",\"introduction\":\"Setelah terbangun sebagai dirinya yang berusia 17 tahun, seorang pelukis terkenal bertemu kembali dengan cinta pertamanya dan menghadapi kesempatan langka untuk menulis ulang kisah mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=129090&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Romansa\",\"LGBTQ\"],\"title\":\"Always Meet Again\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260304/1772617932074_542e5f8ecf3470da446d0ba04dbd2e90mJwZyF34XDygzbEqo5P0Om4Ig8A.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":129026,\"imageUrl\":\"https://img.netpop.app/cover/20260304/1772617925349_d9d0997cad82b7856c6d9fd0b0055e5btjP9D8j2r2VOd3tNhUk5Gmy1yXN.jpg\",\"introduction\":\"Sebuah kisah tentang tiga pemuda dari tiga kebangsaan berbeda dan tiga gaya berbeda yang diadopsi dan dibesarkan sebagai saudara kandung dan saling mencintai tanpa tergoyahkan seolah-olah mereka adalah saudara sedarah.\",\"jumpAddress\":\"tiktik://jump/detail?id=129026&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Love Like a Bike\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260227/1772206383264_7db0c51ecc1682091d49aaf51927ef462.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":128405,\"imageUrl\":\"https://img.netpop.app/cover/20260227/1772206379847_a0345edd90445ea25f034f7140d2186b1.jpg\",\"introduction\":\"Jurusan drama, penyutradaraan, seni, musik, dan tari terjebak dalam jaring persaingan, seks kasual, dan kerentanan yang kusut. Jack mengarahkan mantan Deannya ke atas panggung dengan peran yang diinginkan Raffy. Dean mencoba membuat adik laki-laki Jack, Roma, menghalangi Raffy dari hidupnya. Bagian dari produksi panggung Romeo & Romeo adalah Tua yang memendam perasaan terhadap aktor dan penari yang dibintangi Arnold.\",\"jumpAddress\":\"tiktik://jump/detail?id=128405&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Only Friends: Dream On\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260206/1770347870856_9059d9939938da85aca8b5f97e8d2d3bvktbPNuzX7RnMCY4sqXfrthkb52.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":126887,\"imageUrl\":\"https://img.netpop.app/cover/20260206/1770347868177_f0fe6656ab556df83b937176bbb01a1dhNwqY2IqbcGEPTQ9nsWbUmR5pLs.webp\",\"introduction\":\"Saat Hae Jun dan Jae Hun bersiap merayakan Natal dan Tahun Baru pertama mereka bersama, Jae Hun mengajak Hae Jun ke vila rahasia miliknya yang lain.\\n\\nKenangan manis yang seharusnya menjadi kenangan segera berubah menjadi tegang dengan kembalinya teman dekat mereka, Kang Su Hyeok. Dengan menyamar sebagai “sahabat”, dia secara metodis mengungkap masa lalu Jae Hun yang tersembunyi, mengubah rahasia yang telah lama terkubur menjadi senjata tajam, dan berusaha meninggalkan tanda “pihak ketiga” dalam hubungan mereka—semuanya tampak seperti bagian dari permainan yang kejam dan memutarbalikkan. Di tengah gelombang yang ditimbulkan oleh Su Hyeok, mampukah cinta mereka bertahan dalam ujian dan tumbuh semakin kuat?\",\"jumpAddress\":\"tiktik://jump/detail?id=126887&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\",\"Romantic\"],\"title\":\"Tide of Love Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260201/1769961048827_28259d29fa55954884d4ed780ff93758cSBAVqS2o88NkD5K3v5HSbWYEp8.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":126216,\"imageUrl\":\"https://img.netpop.app/cover/20260201/1769961046107_aef4f6e5941d1d066b158bdca115ebadsOXqyyyNaGnnCkucCnP5RHcjwho.webp\",\"introduction\":\"Pai dan North, keponakan seorang taipan miliarder dan pewaris kerajaan Jiramongkolthanan, menjadi korban dua penipu, Yu dan Tim, yang menikahi mereka demi kekayaan! North diam-diam mengikat ikatan dengan Yu, hanya untuk mengetahui bahwa dia telah ditipu. Parahnya, dia tidak bisa bercerai karena dia sudah menandatangani sebagian hartanya!! Sementara itu, Tim sedang sibuk merencanakan pernikahannya dengan Pai.\\n\\nAkankah Tim terbongkar sebagai penipu yang selama ini mempermainkan Pai!? Ketika cinta dimulai dengan kebohongan, kemana arahnya?\",\"jumpAddress\":\"tiktik://jump/detail?id=126216&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"My Romance Scammer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251219/1766108907687_7e64342a785da738ee07442443f94223横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":118952,\"imageUrl\":\"https://img.netpop.app/cover/20251219/1766108902499_a1629b8a737de3d4308286f217d0e438竖.webp\",\"introduction\":\"Ketika Puifai meninggal setelah semalaman berpesta dengan teman-temannya, inspektur polisi baru Kamin dan Kapten Jade, yang bermusuhan, bersaing untuk mencari tahu kebenaran di balik kematiannya, bahkan ketika ketertarikan mereka semakin meningkat. Namun, kasus ini ternyata tidak sesederhana yang terlihat pada pandangan pertama.\",\"jumpAddress\":\"tiktik://jump/detail?id=118952&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Tegang\",\"Romansa\",\"LGBTQ\"],\"title\":\"Dare You to Death\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251222/1766370444921_23d9436203d8d29814fb380f0ebd39c9四方极爱IIf.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":119283,\"imageUrl\":\"https://img.netpop.app/cover/20251222/1766370428981_7f605e547cd4d16afec022bc2e645972四方极爱II.jpg\",\"introduction\":\"Hubungan kusut dalam kelompok pertemanan Easter dan North mulai bergejolak sekali lagi.\\n\\nTyphoon bertemu kembali dengan mantan kakak laki-laki tetangganya, Tonfah, hanya untuk mengetahui bahwa rahasia yang mereka tinggalkan masih menyakitkan. Meski begitu, dia rela kembali ke kehidupan Tonfah dengan cara apa pun yang dia bisa.\\n\\nDaotok, bocah artistik yang bisa berbicara dengan roh, dengan enggan ditarik oleh tetangganya Arthit untuk mencari jiwa mendiang ibunya. Namun semakin mereka mengejar orang mati, semakin banyak hati mereka yang hidup terisi dengan sesuatu yang baru.\\n\\nTiger, putra bungsu yang kesepian dari keluarga berkuasa, bertemu teman sekelas Dueannao saat uji coba sepak bola. Bentrokan pertama mereka berubah menjadi kehangatan—yang membuat Tiger ingin melewati batas dari persahabatan menjadi sesuatu yang lebih.\\n\\nTiga pasang. Air mata, perpisahan, dan garis rapuh antara teman dan sesuatu yang lebih dalam—mulai sekali lagi.\",\"jumpAddress\":\"tiktik://jump/detail?id=119283&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":25,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Romansa\",\"LGBTQ\",\"Remaja\"],\"title\":\"Fourever You Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260126/1769393979930_4b5cecae9d428fb3a5a662364f1a8c68横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Variety Show\",\"dramaType\":\"VARIETY\"},\"id\":125541,\"imageUrl\":\"https://img.netpop.app/cover/20260126/1769393972574_817dd0ec2f47977decd5890eeff01ac6竖.webp\",\"introduction\":\"Dunia serial ini terus berkembang — dan cinta mereka mulai bergerak lagi. Angsuran keempat dari serial realitas romansa yang mengikuti hubungan antar pria.\\n\\nMusim ini berlatar di Korea selama musim dingin, dengan pemandangan yang tertutup salju. Pertemuan pertama yang penuh dengan ketegangan dan antisipasi, serta reuni tak terduga yang belum pernah terjadi di musim sebelumnya, sangat mengguncang emosi para pria. Saat perasaan rumit saling terkait, jarak di antara mereka perlahan menyempit, dan hidup bersama selama satu minggu di bawah satu atap dimulai.\\n\\nSiapa yang akan berbagi kamar dengan siapa? Pilihan mana yang akan mendekatkan cinta, dan mana yang akan menjauhkan perasaan? Setiap keputusan menjadi titik balik dalam kisah cinta mereka. Kali ini, peraturan yang lebih keras ditambahkan, dan ketika emosi semakin dalam karena hidup bersama, hati menjadi goyah karena kata-kata biasa dan tindakan kecil, yang secara dramatis mengubah hubungan mereka. Dalam waktu terbatas yang diberikan, mampukah mereka menemukan cinta sejati?\",\"jumpAddress\":\"tiktik://jump/detail?id=125541&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Reality show\",\"Romansa\",\"LGBTQ\"],\"title\":\"His Man Season 4\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260113/1768293500411_62b64b412b68b17775bf03f6c66bc656d1o28ieGegcKe3c0H0mreUDucAW.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":123442,\"imageUrl\":\"https://img.netpop.app/cover/20260113/1768293490695_8696972ff0d9d67bf75afa0bfd325b9duUoafeNRGfdVuJarhBuGOJH2PAc.webp\",\"introduction\":\"Meskipun ada ikatan erat di antara sesama pembelot, Cheol Jeon—seorang pembelot muda Korea Utara—merasa terisolasi saat menyembunyikan identitas gaynya. Terakhir, dia mengambil langkah pertamanya ke komunitas gay Korea Selatan yang dinamis dan menjalin hubungan dekat setelah bertemu Yeong Jeon di sebuah pertemuan santai. Namun, kesalahpahaman sepele menghancurkan ikatan rapuh ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=123442&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.2,\"showMark\":false,\"tagList\":[\"LGBTQ\"],\"title\":\"3670\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260113/1768292366097_8f1487f444f77ba2ee9a17eed1e20919竖.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Variety Show\",\"dramaType\":\"VARIETY\"},\"id\":123430,\"imageUrl\":\"https://img.netpop.app/cover/20260113/1768292356308_a42b6c514bc58a83b59a7892b1cd426f竖.jpg\",\"introduction\":\"Setiap kepingan salju itu unik — begitu pula kisah cinta yang akan terungkap di antara sekelompok pria di tempat peristirahatan bersalju.\\n\\nMusim ini mengubah latarnya ke musim dingin di Hokkaido, di mana sepuluh pria menginap bersama di sebuah penginapan nyaman yang dijuluki Ruang Hijau. Dikelilingi oleh selimut salju putih, mereka mulai menemukan apa yang mereka inginkan dalam suatu hubungan dan siapa yang mereka harapkan sebagai pasangan. Mulai dari bermain lereng bersama hingga berbagi percakapan intim di igloo darurat, negeri ajaib musim dingin menjadi tempat sempurna untuk menumbuhkan cinta.\\n\\nTentu saja, tidak hanya pemandian air panas dan wisata sauna yang santai. Kelompok ini juga bertugas mengoperasikan truk kopi berwarna peppermint, bekerja secara bergiliran secara berpasangan. Selama 15 episode, teman serumah berharap untuk mengembangkan koneksi lambat yang pantas untuk ditunggu — seperti kopi tetes yang mereka sajikan.\\n\\nBerusia antara 20 hingga 40 tahun, para pria hidup bersama selama dua bulan dengan harapan dapat membentuk ikatan yang langgeng — dan bahkan mungkin menemukan pacar impian mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=123430&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":15,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"The Boyfriend Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":1,\"name\":\"18+\",\"sort\":1},{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251128/1764318833257_8a72c77eb9aed9ed719c04ab5fffeedb1LQE7WzkgqSJFaKY1zWM6ExPdGm.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":116046,\"imageUrl\":\"https://img.netpop.app/cover/20251128/1764318828045_43521943797feb37cf6e3dae251bb40fepgr7n61vVIniyAghz2GYj22DkC.webp\",\"introduction\":\"Dua bintang hoki saingan yang berada di puncak permainan mereka menghadapi tantangan tak terduga ketika mereka mengembangkan perasaan satu sama lain, sehingga mempersulit karier dan ekspektasi olahraga mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=116046&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.1,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Olahraga\",\"LGBTQ\",\"Dewasa\"],\"title\":\"Heated Rivalry\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":35},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"怦然心动的“她”\",\"coverType\":1,\"homeSectionId\":81157,\"homeSectionName\":\"Girl's Love: Tulus, Indah & Murni\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260618/1781775867438_e288c4d58d6fab6bd41203abb36c36562.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":151227,\"imageUrl\":\"https://img.netpop.app/cover/20260618/1781775864553_c5c9499bdc6c48c8e2c4e95c769b60f01.jpg\",\"introduction\":\"Coley, 17, dari pedesaan Oregon, menjalani keintiman setelah kematian ibunya. Bertemu dengan Sonya memicu perasaan baru, namun keraguan menghalangi hubungan mereka. Sonya, yang tidak terbiasa berkencan dengan gadis, merasa tidak yakin. Mereka belajar menerima emosi\",\"jumpAddress\":\"tiktik://jump/detail?id=151227&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Girls Like Girls\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260625/1782396218393_d18af0089b338501fc5df4076cbf2f8bobtydOJh4gLfJUkv8zhrrKZO2oW.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":152898,\"imageUrl\":\"https://img.netpop.app/cover/20260625/1782396209417_b7458b4238e603f6fe116cb52d49fd4bobtydOJh4gLfJUkv8zhrrKZO2oW.jpg\",\"introduction\":\"Penyamaran mungkin bisa menyembunyikan kebenaran, tapi tidak pernah bisa menyembunyikan perasaan yang lahir di dalam hati. Ketika seorang pengawal wanita harus melindungi seorang wanita muda nakal yang menjadi cahaya hidupnya... bagaimana kisah cinta ini akan berakhir?\",\"jumpAddress\":\"tiktik://jump/detail?id=152898&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"My Lady's Bodyguard\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260619/1781869582393_1a4d63c5d8a5e5f6394ef91e5ee5c1312.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":151270,\"imageUrl\":\"https://img.netpop.app/cover/20260619/1781869578962_cefadcb914b24ee892ffd8acf6862eb21.jpg\",\"introduction\":\"Seorang pengacara glamor dan ahli waris Gen-Z bercerai setelah tekanan keluarga menghancurkan pernikahan mereka. Namun ketika kesepakatan bisnis besar memaksa mereka untuk bersatu kembali dan memalsukan hubungan yang bahagia, perasaan lama mulai muncul kembali. Saat cinta kembali berkobar dan luka tersembunyi kembali terbuka, pasangan tersebut harus memutuskan apakah pernikahan mereka yang rusak layak mendapatkan kesempatan kedua—atau apakah beberapa bekas luka tidak akan pernah bisa disembuhkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=151270&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"In Love Forever\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260529/1780045185529_f7eb73a3d05696483faf374dcbdc059f1gai54mpPozYCFCv1PlY94KPIvI.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":145882,\"imageUrl\":\"https://img.netpop.app/cover/20260529/1780045179015_0e42be67f4b30dd6f37fa584484962b94o1n1RjOjs3vTKmRtTx3YmswLsD.webp\",\"introduction\":\"Setelah kencan satu malam, ilmuwan yang dijaga, Song, melebur ke dalam percintaan dengan kekasihnya — yang ternyata adalah putri bosnya.\\n\\nTiga wanita yang melarikan diri dari cinta berpapasan dengan tiga orang lainnya yang menolak menyerah mengejar hati mereka — membuktikan bahwa cintalah yang membuat jiwa manusia tetap hidup. Sekeras apa pun kita berusaha melarikan diri, pada akhirnya semua orang tetap ingin mencintai dan dicintai.\",\"jumpAddress\":\"tiktik://jump/detail?id=145882&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Chasing Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260525/1779697172106_6fa8fd081670122adc8a4fb81c4d463610 Rules before I Fell for YouS.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":144244,\"imageUrl\":\"https://img.netpop.app/cover/20260525/1779697161810_68b7a41bdc8fe508cdcd1d5970c812d510 Rules before I Fell for You.jpg\",\"introduction\":\"Time, penulis buku terlaris “10 Rules Before I Fell for You,” percaya bahwa cinta dapat dijelaskan melalui teori. Saat dia bepergian ke homestay pedesaan yang tenang untuk menulis buku barunya, dia menemukan pemiliknya, Lean, adalah seseorang yang pernah mengkritik karyanya secara online. Bentrokan antara seseorang yang percaya pada logika cinta dan seseorang yang percaya pada perasaan murni membuat Saatnya menguji sepuluh aturannya untuk jatuh cinta pada seseorang.\",\"jumpAddress\":\"tiktik://jump/detail?id=144244&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\",\"Romantic\"],\"title\":\"10 Rules before I Fell for You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260504/1777826435412_fd0faf9f451fe4f4f33c87a1091d89c6Enemies with Benefits1.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138095,\"imageUrl\":\"https://img.netpop.app/cover/20260504/1777827535453_9a550bbaeb3ae9ea6a89838387c73337b00c87579aac4056b459dc64c56c744a1777455759611.jpg\",\"introduction\":\"Kepala Penjualan Lan bertekad untuk menang atas Kepala Akuntansi Wine. Anggur adalah kebalikannya, yang dikenal karena kekejamannya. Saat malam yang liar mengarah pada hubungan pertemanan yang menguntungkan, mereka akan melakukan apa pun untuk merahasiakannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=138095&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\",\"Romantic\"],\"title\":\"Enemies with Benefits\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260418/1776514572122_d688a58e18eeef49374e77cc1d4fe66alfICQwnICnGojvlMmrkcnLNt5iF.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":134889,\"imageUrl\":\"https://img.netpop.app/cover/20260418/1776514566626_e416026e5957bf94a8c3524d361f8babvCtIUnr7bwKMfg4Ouu5lcly7FJb.webp\",\"introduction\":\"Di sekolah perempuan paling elit di Thailand, peraturan dibuat untuk dilanggar. Enam siswa dan satu guru memicu badai skandal, hasrat, dan revolusi digital. Saat cinta tersembunyi dan rahasia yang meledak-ledak saling bertabrakan, keduanya akan menghancurkan mitos tentang gadis baik-baik dan mendefinisikan kembali apa artinya tumbuh di era video viral dan menghapuskan budaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=134889&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Shades\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260424/1777035723852_473f28595320a10c70fe6c949de41f212.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":136521,\"imageUrl\":\"https://img.netpop.app/cover/20260424/1777035719838_ed1a951b9d09af0642d4e4231c17bbd71.jpg\",\"introduction\":\"Dari kekasih saat kuliah hingga pasangan seumur hidup, Pafun dan Aioon membangun kehidupan yang penuh kasih dan pengabdian bersama—memimpikan sebuah keluarga yang tampaknya di luar jangkauan. Ketika kerinduan Pafun untuk menjadi ibu semakin dalam, harapan mereka tumbuh seputar janji untuk mengadopsi seorang anak suatu hari nanti. Segalanya berubah ketika sahabat mereka, Nubnueng, kembali secara tak terduga dan membawa peluang yang mengubah hidup. Saat cinta, kehilangan, dan tanggung jawab saling bertabrakan, pasangan harus menghadapi patah hati, ketahanan, dan tantangan menjadi orang tua baru. Fulfill adalah perjalanan yang lembut dan emosional yang merayakan keluarga terpilih dan kekuatan cinta untuk menyelesaikan apa yang belum selesai dalam hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=136521&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Fulfill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260403/1775210048581_110c0bbc2f8a973a57b3615a0b4f8ba8nEzMQzOFnJGvV4NVaYGQhGYVgME.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":132388,\"imageUrl\":\"https://img.netpop.app/cover/20260403/1775210040883_3c2fdaf94fc68767d11869767f1591898LVRD8PUsUb4CJ561hOEy0xCRKg.webp\",\"introduction\":\"Si, seorang pewaris masyarakat kelas atas, bercita-cita menjadi presiden perusahaan keluarganya. Namun, orang tuanya malah memberikan posisi tersebut kepada adik perempuannya, karena percaya bahwa Si terlalu manja dan tidak bertanggung jawab, menghabiskan jutaan dolar tanpa berpikir dua kali. Ketika bisnis keluarga menghadapi krisis yang melibatkan pembaruan sewa tanah yang penting, negosiasi gagal—sampai Klaokawi, sang pemilik tanah, mengajukan proposal yang tidak biasa: dia akan memperbarui sewa hanya jika Si setuju untuk menikahinya. Meskipun gaya hidup mereka sangat bertolak belakang, pengaturan aneh ini membawa keduanya ke dalam hubungan yang tak terduga dan rumit.\",\"jumpAddress\":\"tiktik://jump/detail?id=132388&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\",\"LGBTQ\",\"Romantic\"],\"title\":\"Hometown Romance\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260409/1775666670240_407485486c9ab4dcd2ee1103a5dacad8绯闻营业中n.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":132778,\"imageUrl\":\"https://img.netpop.app/cover/20260409/1775666652249_a34dec813724ff2b76d45f91ddcfa470绯闻营业中.webp\",\"introduction\":\"Dalam industri idola yang sangat dikomersialkan, emosi sering kali diproduksi dan dijual sebagai bagian dari merek. Scandal Love mengikuti empat wanita yang menavigasi berbagai tingkat kekuasaan dalam sistem girl grup K-pop. Saat mereka berjuang dengan kontrak yang ketat, pengawasan publik yang berlebihan, dan perasaan tulus mereka sendiri, masing-masing terpaksa membuat pilihan yang mustahil. Serial ini mengeksplorasi satu pertanyaan sentral: dapatkah cinta sejati bertahan dalam hubungan yang dirancang dan dikendalikan dengan cermat?\",\"jumpAddress\":\"tiktik://jump/detail?id=132778&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\",\"Romantic\"],\"title\":\"Scandal Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260330/1774835466364_ba5fcec7d339e11ed5615cc9c40b08ff2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":131644,\"imageUrl\":\"https://img.netpop.app/cover/20260330/1774835462071_dbc70d3c172d5c427750e74ed32e88591.jpg\",\"introduction\":\"Arisa adalah seorang wanita yang ingin membalas dendam pada kapitalis di balik pembunuhan ibunya; tapi saat melakukan itu, dia jatuh cinta dengan putri musuh.\",\"jumpAddress\":\"tiktik://jump/detail?id=131644&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"LGBTQ\"],\"title\":\"Broken of Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260309/1773070718925_f5ab2583a9aefb9f032870d306ca86f871HVcRRtTkMdcEKmSzGWsF16EPx.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":129462,\"imageUrl\":\"https://img.netpop.app/cover/20260309/1773070715863_652d403f5e945dd8105ee715ac1fcd89qvXFXd4TXj9Ou8MS3dsZqgApsnP.webp\",\"introduction\":\"Sekelompok teman mengalami kekacauan saat ikatan mereka diuji dalam berbagai cara, dimulai dengan kembalinya mantan pacar.\\n\\nPrim dan Min menjalankan perusahaan periklanan bersama ketika klien baru Bambi, mantan Prim, muncul ingin kembali bersama. Menambah lingkaran mereka adalah stylist muda Prim, Gorya yang menginginkan hubungan yang lebih dalam, model Shasha yang bebas pilih-pilih dan menawan, dan Praew, fotografer lesbian dari bar yang sering dikunjungi Min.\",\"jumpAddress\":\"tiktik://jump/detail?id=129462&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\",\"Romantic\"],\"title\":\"Girl Rules\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260213/1770961467460_1c378ff1923740c776fe7dd7b8142dfdjQvrRQgHpGqUCc5oT3GxSfvDWqO.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":127606,\"imageUrl\":\"https://img.netpop.app/cover/20260213/1770961461312_664836cf30fad33470c9e007103bebbdjQvrRQgHpGqUCc5oT3GxSfvDWqO.jpg\",\"introduction\":\"Vicky, putri seorang perwira polisi yang berkuasa, telah menghindari upaya pembunuhan dan kini diam-diam mengikuti program pelatihan elit. Di sana, ia bertemu Thara, seorang perwira disiplin dengan naluri tajam. Mereka terpaksa berbagi kamar, dan chemistry mereka mulai berubah. Namun konspirasi politik, pembunuhan tersembunyi, dan masa lalu yang rumit mengancam untuk memisahkan mereka. Saat Thara mengetahui bahwa ayah Vicky mungkin ada hubungannya dengan tragedi keluarganya sendiri, perasaan mereka diuji oleh kewajiban, bahaya, dan pengorbanan kebenaran. Mereka harus memilih antara keadilan dan cinta yang tidak pernah mereka sadari sebelumnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=127606&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Heart Code\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250609/1749458666030_5f2791ac7a7cc88fd121e9a25fde1b9a20221128_tsukutabe_01.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":94066,\"imageUrl\":\"https://img.netpop.app/cover/20251121/1763707714446_f8a812a11910369785d09eea93ca1195She Loves To Cook, And She Loves To Eat.png\",\"introduction\":\"Nomoto, seorang koki rumahan yang bersemangat, mengundang tetangganya yang sendirian Kasuga ketika dia memasak terlalu banyak. Persahabatan yang tidak mungkin berkembang saat mereka menikmati makanan lezatnya bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=94066&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"She Loves To Cook, And She Loves To Eat\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260212/1770904615730_415ecdb697a80922a66b05ef852e3e963pLP1RB5ee0zXkMKEnBTSK3m81A.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":127569,\"imageUrl\":\"https://img.netpop.app/cover/20260212/1770904611976_bde71a6b5c7439009700d9b55e2333ecisk1ShHQJR0zp7963J5qhQznYDw.webp\",\"introduction\":\"Pingrak adalah seorang mahasiswa universitas yang tampan, populer di kalangan teman-temannya. Hanya sedikit yang tahu bahwa dia dulunya adalah seorang kutu buku pemalu dan berkacamata yang cinta pertamanya adalah seorang siswa sekolah menengah yang menakjubkan namun dingin. Lalu takdir mengambil alih. Pingrak terlempar kembali bersama cinta pertamanya, P'Charm, “yang dingin”. Adapun Charm, dia tidak menyangka wanita cantik ini adalah anak berkacamata yang sama yang biasa mengikutinya. Apa yang akan dia pikirkan jika dia tahu gadis ini pernah naksir dia?\",\"jumpAddress\":\"tiktik://jump/detail?id=127569&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Frozen Valentine\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260130/1769743632772_7b032eb919aaabdb84d6cab261dd024a1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":126084,\"imageUrl\":\"https://img.netpop.app/cover/20260130/1769743628114_76af90357bfef0a227a91cbe290d65061.jpg\",\"introduction\":\"Ada banyak alasan untuk menikah dengan orang yang sama dua kali. Bagi Phraenarin, pertama kali menikah karena permintaan ayahnya. Namun untuk kedua kalinya, dia ingin menikah karena keinginan terdalamnya untuk menghormati orang yang dicintainya.\",\"jumpAddress\":\"tiktik://jump/detail?id=126084&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"LGBTQ\"],\"title\":\"Denied Love Special Endless\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251205/1764915908174_1ed14c4e591afc04ca89fecb6a5917cdcuojG4fZiOzp0KpCFG75yeJCI7n.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":116883,\"imageUrl\":\"https://img.netpop.app/cover/20251205/1764915903607_793ac853192cacc7b0772551270cf4d53NaKzcgs1Q9eush1St76DQIHapL.webp\",\"introduction\":\"Ketika seorang tamu rumah yang menawan (Galitzine) tiba di sebuah kastil terpencil, dinamika halus antara seorang suami yang lalai, pengantinnya yang tidak bersalah, Cherry (Monroe), dan pelayan setia mereka, Pahlawan (Corrin), dilemparkan ke dalam kekacauan.\",\"jumpAddress\":\"tiktik://jump/detail?id=116883&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.2,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Romansa\",\"LGBTQ\"],\"title\":\"100 Nights of Hero\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250421/1745244082744_beb5bc4e5ae69d8999e1732b7fec6bc9khJx1wdufa8bq4aXRH6wlkUfOAZ.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":86981,\"imageUrl\":\"https://img.netpop.app/cover/20251105/1762323894452_2ba5df3a6d9e65abf2ccac4776c9b889wNb7PxdshRHLkJiDgfOuDB0IamA.webp\",\"introduction\":\"Bell Lalita ditangkap atas tuduhan kepemilikan narkoba. Meskipun kasus tersebut bukan miliknya, dengan bukti yang memberatkannya, pengacaranya mengatakan kepadanya bahwa dia tidak memiliki peluang untuk memenangkan kasus tersebut jika mereka melawannya. Karena tidak punya pilihan, dia masuk penjara dengan hukuman lima belas bulan.\\n\\nHidup di penjara tidak senyaman yang dia harapkan. Dia menjadi sasaran kelompok kuat di tempat itu. Bahkan sipir pun menutup mata terhadap tindakan mereka. Dia tidak punya pilihan lain; harapan terakhirnya untuk bertahan hidup terletak pada Claire Nineteen Scars, seorang narapidana yang dipenjara karena kejahatan serius yang tidak berani didekati oleh siapa pun.\",\"jumpAddress\":\"tiktik://jump/detail?id=86981&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.8,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"LGBTQ\"],\"title\":\"ClaireBell\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251024/1761284405237_44b9c8b190bc95aa488963a3c57dde6fmWLgee5VumCSzvkfpGOkBXCoh5r.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":111867,\"imageUrl\":\"https://img.netpop.app/cover/20251024/1761284382059_95de88cef42392022e579495f2dbd56d9vJMTObP0s8ijwwDu1TJaoK18nd.webp\",\"introduction\":\"Alin dan Jane adalah sahabat masa kecil. Mereka tumbuh bersama, tinggal bersebelahan. Tanpa sepengetahuan Alin, diam-diam Jane telah memendam perasaan padanya sejak lama. Suatu hari, Alin meninggalkan Jane untuk belajar di luar negeri. Bertahun-tahun kemudian, pertunangan yang putus membawanya pulang, tempat mereka menghadapi perasaan yang sudah lama tak terucapkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=111867&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"My Safe Zone\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251005/1759672421359_aa9da7b940f695a827d391d3b9c9e1454f04i0kqSNweyCtWIh321gbW6iR.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":109749,\"imageUrl\":\"https://img.netpop.app/cover/20251005/1759672415077_41cad0e7ea42c497b18216d92c0b38fbamtHcdictKMPxo045gaMuXvxmi2.webp\",\"introduction\":\"Pun mengira hidupnya berantakan ketika Pethai, pria yang dipekerjakannya untuk pernikahan palsu, mengambil uangnya dan berlari langsung ke pelukan seorang mafia. Sekarang dia kembali ke Thailand, bertekad untuk melacaknya dan mendapatkan beberapa jawaban. Tapi itu tidak akan mudah. Satu -satunya harapannya? Ploy-a aktris yang menakjubkan dan cerdik yang memegang kunci rahasia Pethai. Untuk mendapatkan apa yang dia butuhkan, permainan kata -kata harus memikat jalannya ke dalam hati taktik. Tapi semakin dia mencoba memanipulasi, semakin dia jatuh untuk taktik. Apa yang dimulai sebagai permainan cinta dengan cepat berubah menjadi rollercoaster romantis, dan Pun mungkin baru saja menemukan dirinya dalam perjalanan hidupnya. Dalam permainan hati ini, siapa yang benar -benar pemain?\",\"jumpAddress\":\"tiktik://jump/detail?id=109749&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Player\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250920/1758370499563_6c6eeaf30cf9192b0255b1594826580foTzt4Fe1IIwbn0ocJWPqkKk4CDu.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":108082,\"imageUrl\":\"https://img.netpop.app/cover/20250920/1758370491920_25dc2ce30dc32254b181e6083df71b37oTzt4Fe1IIwbn0ocJWPqkKk4CDu.webp\",\"introduction\":\"Cinta adalah racun, memabukkan hati. Namun, pada akhirnya, cinta beracun yang membuat hati berlomba.\",\"jumpAddress\":\"tiktik://jump/detail?id=108082&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":44,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Poisonous Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250811/1754877960405_d3030714d30bd11adfe3566a18b779f26r33JZ6wM0S7dRvGsi942UVUnvV.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":102338,\"imageUrl\":\"https://img.netpop.app/cover/20250811/1754877953546_4d6bdbdbbb285a9096b2ec871b8f1484pY6cNh8CoAaSgSOvOykatcE76gG.jpg\",\"introduction\":\"Kee, tsundere yang keren, dan Peem, seorang gadis kaya yang nakal, menjadi teman yang tidak terpisahkan. Namun, tidak ada yang tahu kebenaran, itu, mereka secara diam -diam jatuh cinta satu sama lain sejak sekolah menengah. Tapi cinta tidak pernah begitu mudah, dan nasib memainkan triknya. Keduanya terpisah dan akan menjadi tujuh tahun sebelum mereka bertemu lagi ... sebagai bos dan karyawan.\",\"jumpAddress\":\"tiktik://jump/detail?id=102338&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\",\"LGBTQ\"],\"title\":\"Somewhere Somehow\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250815/1755191216383_11faaccfec2dbd7488fa0a856218b3451.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":102957,\"imageUrl\":\"https://img.netpop.app/cover/20250815/1755191211048_f8917a48f976b1198e5945356ab50f1d1.jpg\",\"introduction\":\"Musuh sejak sekolah hingga memasuki industri hiburan, Rey dan cetak bertemu lagi ketika mereka mendapatkan peran dalam seri yang sangat dinanti. Satu minggu sebelum syuting untuk memulai, sesuatu yang aneh terjadi: jiwa mereka beralih tubuh.\",\"jumpAddress\":\"tiktik://jump/detail?id=102957&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Queendom\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250814/1755136806127_9ba8aff2160761997db5466f611addb8横.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":102765,\"imageUrl\":\"https://img.netpop.app/cover/20250814/1755136801556_70124814e22dfd7e534a9ee303108688竖.webp\",\"introduction\":\"Menjalani kehidupan yang riang telah mulai mengambil korban. Melompat ke rollercoaster suatu hubungan adalah memberi para pencari sensasi ini merasakan perasaan di luar kegembiraan.\",\"jumpAddress\":\"tiktik://jump/detail?id=102765&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":32,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Roller Coaster\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250625/1750848184158_e6e043b489de31285a48566397e70d18afpJz3pIyG5mpUiYa9ngeXVJnfZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":96611,\"imageUrl\":\"https://img.netpop.app/cover/20250625/1750848178423_9c271b1cc92225ecff2e62011337ba00mWVDzFvAryOS4l1yA2ROpMTwQas.jpg\",\"introduction\":\"Wan mewarisi toko kelontong ayahnya yang berjuang dan bertemu Maewnam, seorang pelanggan yang setia. Maewnam membantu upaya Wan untuk menghidupkan kembali bisnis tetapi menyembunyikan bahwa perusahaan keluarganya sendiri mengancam rencana Wan.\",\"jumpAddress\":\"tiktik://jump/detail?id=96611&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\",\"LGBTQ\"],\"title\":\"Whale Store xoxo\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250530/1748573276378_49f03510d2778dc0191941f3b32973e72.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":93146,\"imageUrl\":\"https://img.netpop.app/cover/20250530/1748573259269_3b44586c0e21ef3ccbfb4de864f5812c1.jpg\",\"introduction\":\"Kondisi ayahnya untuk datang ke warisannya adalah, Phraenarin harus menikah dengan Khemjira selama dua tahun. Tidak peduli bagaimana anak itu mencoba merayunya, sama sekali, sama sekali tidak ada cara dia akan jatuh cinta padanya. \\\"Khem melakukan pekerjaan rumahnya dengan baik, apakah kamu tidak akan jatuh bahkan sedikit?\\\"\",\"jumpAddress\":\"tiktik://jump/detail?id=93146&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Denied Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250627/1750990377872_5c98779be89afc5b654cfe41c6c6072c7uEnzvSHe7PkgSLyDX9hvgOVsrB.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":96738,\"imageUrl\":\"https://img.netpop.app/cover/20251126/1764143583424_baa9aa13099c5cf655c07ff2d8a82121Ayaka Is in Love×Love×Love with Hiroko 2nd Stage.png\",\"introduction\":\"Ayaka jatuh cinta dengan kolega seniornya Hiroko. Mereka berdua mengira yang lain lurus, tetapi setelah kemajuan Ayaka yang ceroboh, keduanya akhirnya mulai berkencan! \\n\\n setahun telah berlalu sejak itu. Ayaka telah datang untuk hidup dengan Hiroko, dan mereka mulai hidup bersama. Hiroko sangat disukai Ayaka sehingga dia telah bersumpah untuk tidak bergerak dengan ringan sehingga tidak menyakitinya, dan dalam mode super-doting! Sementara itu, Ayaka samar -samar khawatir tentang Hiroko, yang tidak pernah bergerak padanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=96738&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"LGBTQ\"],\"title\":\"Ayaka Is in Love×Love×Love with Hiroko 2nd Stage\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250508/1746681304715_cf216da0c7098e7df566bb9c13c44689p2920088343.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":89310,\"imageUrl\":\"https://img.netpop.app/cover/20250627/1751010151778_ec0dfa759bdfc74e1e313469ad528d82Even if You Become an Adult.png\",\"introduction\":\"Ayano, seorang guru sekolah dasar berusia tiga puluhan, mampir ke bar suatu hari dan bertemu wanita lain bernama Akari. Sparks terbang sebagai keduanya mengobrol, dan sebelum malam berakhir, Ayano bahkan masuk untuk ciuman. Akari tertarik tetapi bingung ... terutama ketika dia menemukan bahwa Ayano memiliki seorang suami! Baik Ayano dan Akari akan mengetahui bahwa cinta tidak menjadi lebih mudah, bahkan ketika Anda bertambah tua.\",\"jumpAddress\":\"tiktik://jump/detail?id=89310&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"LGBTQ\"],\"title\":\"Even if You Become an Adult\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250118/1737191289630_eeed979d241c945bf0c01f43ff044ab7xG3b2YNEBxYEY67BvsvvJk3n8D7.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":68725,\"imageUrl\":\"https://img.netpop.app/cover/20250123/1737634602651_13ae67840c3fe2063a2b919e15e538bf我们的爱情.png\",\"introduction\":\"Dokrak yang berusia sembilan belas tahun memutuskan untuk mengambil jeda satu tahun untuk menemukan dirinya setelah menyelesaikan sekolah menengah. Dia memiliki pekerjaan paruh waktu di sebuah kedai kopi di Galeri Seni & AS. Di sinilah dia menyeberang jalan dengan siswa kedokteran gigi berusia dua puluh dua Pam yang biasa di kafe untuk memukul buku. Saat dia mengenal Pam, Dokrak mengembangkan naksir. Namun, ketika kakaknya bertemu Pam, dia jatuh cinta pada pandangan pertama. Kawi menoleh ke Dokrak, memintanya bermain mak comblang. Karena dia mencintainya dan ingin melihatnya bahagia, Dokrak mulai melatihnya. Namun, seiring berjalannya waktu, dia mendapati dirinya tidak dapat mengabaikan perasaannya yang tumbuh pada Pam. Sebelum dia menyadarinya, dia sepenuhnya jatuh cinta dan Pam adalah pacar Kawi.\",\"jumpAddress\":\"tiktik://jump/detail?id=68725&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":48,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"LGBTQ\"],\"title\":\"Us\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250115/1736930220699_c12bc1017e309b2b294d5c7eb89c51638FgzQadEF68NYvmTVyuY4pCtred.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":68052,\"imageUrl\":\"https://img.netpop.app/cover/20250115/1736930218690_8128bd84d0c31fffae938d8031bcc109794PfYjTz3yxMRdTRmdFYt6w6ff.jpg\",\"introduction\":\"Letnan Polisi New Jersey Laurel Hester dan mitra domestiknya yang terdaftar, Stacie Andree, untuk mendapatkan manfaat pensiun Hester ketika dia didiagnosis menderita kanker stadium akhir.\",\"jumpAddress\":\"tiktik://jump/detail?id=68052&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Biografi\",\"Drama\",\"LGBTQ\"],\"title\":\"Freeheld\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":27},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"热门泰剧\",\"coverType\":1,\"homeSectionId\":83985,\"homeSectionName\":\"Drama Thailand\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260708/1783475845610_5ca7d1eacee7fd1d04510c8f7279bd62sPdNRrZgWl3j3wsAbDNWmveAAyc.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":154766,\"imageUrl\":\"https://img.netpop.app/cover/20260708/1783475839503_c956de2f64c99122f53f3280f2b6d7a7fizdLbNRs3R4G04j7p2nL0E7uJU.webp\",\"introduction\":\"Kay, seorang seniman manga terkenal, mendapati dirinya berada di bawah pengawasan Phat, inspektur yang mengawasi kasus pembunuhan berantai, setelah profil para korban, metode pembunuhan, dan TKP ditemukan memiliki kemiripan yang mencurigakan dengan adegan-adegan dari karya lama Kay. Disatukan oleh keadaan, keduanya harus bekerja sama untuk mengungkap kebenaran, menyelesaikan kasus, dan melacak pembunuhnya. Dalam perjalanannya, dua orang asing perlahan-lahan mendapati diri mereka terikat oleh sesuatu yang terasa seperti kepercayaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=154766&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT daftar Peringkat 2\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":1,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\"],\"title\":\"Mr. Kill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260516/1778925567023_a0cbbd3be60c7f8950325a25d37ccb78dKrWpfYiqVXVK3FfdMAFcYnF2Wa.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":141726,\"imageUrl\":\"https://img.netpop.app/cover/20260516/1778925559482_8e26f87e3bcb93c689990a1879341c2e7ISgZENoJ9j8bsEND9QOURjIQko.webp\",\"introduction\":\"Setelah ayah angkatnya dibunuh oleh organisasi rahasia Fire Phoenix, Taiga melakukan perjalanan ke Thailand untuk mengungkap kebenaran. Menyusup ke perusahaan kuat yang terkait dengan dunia kriminal, dia mencari “Iblis” misterius sambil bentrok dengan Rin, pengawal yang dijaga yang memiliki hubungan tragis dengan konspirasi yang sama.\",\"jumpAddress\":\"tiktik://jump/detail?id=141726&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":24,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Tegang\",\"Romansa\"],\"title\":\"Wicked Temptation\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260430/1777538187284_a180864e96cdfccc08a1c1e3f853cdd41oJSeynxNfGJm83de6bi83LetZR.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":138045,\"imageUrl\":\"https://img.netpop.app/cover/20260430/1777538180216_f03e671f7ba8cdc55a93c1f049704d791oJSeynxNfGJm83de6bi83LetZR.webp\",\"introduction\":\"Shen adalah seorang wanita dari keluarga kaya yang memasuki pernikahan yang tampaknya sempurna dengan Phoem, seorang pejabat pemerintah yang menjanjikan. Hubungan mereka dimulai dengan kebahagiaan, namun keadaan berubah ketika Phoem berangkat untuk tugas kerja yang diperpanjang di luar negeri.\\n\\nSelama ketidakhadirannya, Shen terus-menerus menghadapi tekanan dan perlakuan buruk dari ibu mertuanya. Lingkungan yang sulit membuat emosinya terkuras, hanya berpegang pada harapan kembalinya suaminya. Namun, saat Phoem kembali, dia bukan lagi orang yang sama. Perilakunya yang dingin dan menjaga jarak memperdalam kesepian Shen.\\n\\nDalam keadaan rentan ini, dia menemukan kenyamanan dalam diri Tone, seorang pengemudi yang kehadirannya membawa dukungan emosional dan memperumit situasinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=138045&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT daftar Peringkat 4\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"Whisper of Desire\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260120/1768878623770_dfc9a1eea062be9b435c9561dc50d140横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":124525,\"imageUrl\":\"https://img.netpop.app/cover/20260120/1768878618875_bd4ed8f45cb0120fd279e785951fbd2e竖.jpg\",\"introduction\":\"\\\"Kalau semuanya tetap sama, itu tidak disebut karma, kan?\\\" Saat dunia seperti sekarang sepertinya masih membutuhkan Nanno untuk menggoyahkan keadaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=124525&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Fantasi\",\"Horor\",\"Thriller\"],\"title\":\"Girl from Nowhere: The Reset\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251204/1764816440590_3bf034a0a391a4be955bc376d50cf0f7p2927539735.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":116692,\"imageUrl\":\"https://img.netpop.app/cover/20251204/1764816432975_d7ef36dd199fe51838607deefdd581ccp2927539718.jpg\",\"introduction\":\"Win, Game, dan Dear mendapati diri mereka ditarik kembali ke dunia yang mereka coba tinggalkan. Di bawah komando Ae, seorang politisi lokal yang kuat yang ambisinya mencakup hal-hal spiritual dan korup, mereka dipaksa untuk mengambil bagian dalam “Proyek Mega Merit” yang baru.\",\"jumpAddress\":\"tiktik://jump/detail?id=116692&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Thriller\"],\"title\":\"The Believers Season 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251105/1762336267501_d10c11b119cc5f108f1e21b841818d7a2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":113053,\"imageUrl\":\"https://img.netpop.app/cover/20251105/1762336338668_514e971f1de5f9c31c11cfeeed7c64891.jpg\",\"introduction\":\"Ini adalah kata-kata yang diucapkan Baikhaw kepada Tulip saat mereka pertama kali bertemu—sebelum dunia mereka berubah selamanya. Apa yang dimulai dari persahabatan indah antara dua remaja putri terurai menjadi jaringan rasa iri dan tipu daya yang berbahaya. Baikhaw menyembunyikan kecemburuannya di balik senyuman sempurna, dibantu oleh Tao, teman SMA setianya yang sudah lama mencintainya dan akan melakukan apa pun untuknya. Di sisi lain, Tulip menemukan sekutu dalam diri Namo, teman kuliahnya yang penuh perhatian dan selalu berada di sisinya dan melindunginya. Namun balas dendam jarang berakhir di awal, dan permainan pengkhianatan ini mungkin akan menghancurkan mereka semua. Karena terkadang, musuh yang paling berbahaya… adalah sahabatmu.\\n\",\"jumpAddress\":\"tiktik://jump/detail?id=113053&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"LGBTQ\"],\"title\":\"Friendshit Forever\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250903/1756898153816_7374021bd9c67c1b842a92c5138ff97b2ns20NPWM2IGCp8qBtqwkjvhx1y.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":105241,\"imageUrl\":\"https://img.netpop.app/cover/20260209/1770624884795_274a690c30f1b3ba435efa411fbabff4The Thirsty Thirty.png\",\"introduction\":\"Selamat datang di Thirties Anda. Apakah Anda siap untuk melangkah ke dalam mimpi yang Anda bayangkan?\",\"jumpAddress\":\"tiktik://jump/detail?id=105241&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Keluarga\",\"Romansa\"],\"title\":\"The Thirsty Thirty\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250812/1754979433620_cec34f0bc601ecae54c2ad01b3cc457fAAAABeUVvXTM59QvTm0Nfwfos27LBisxE17Ic5tBL0gop_BH5gjG01efHD8JPAakX8QD3Os2j3jqwGTeeo5g2d3ITDce2fcBLBMDiIL9.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":100171,\"imageUrl\":\"https://img.netpop.app/cover/20260206/1770372436927_986403f5d287df068cfe3a9f4ecf7bbeGemini_Generated_Image_v9j13sv9j13sv9j1.png\",\"introduction\":\"Ketika drama \\\"The Bloom and A Thousand Bees\\\" sedang dibuat ulang, ia membutuhkan casting yang serius untuk peran utama wanita. Sekarang, semua orang di showbiz berebut dan tampaknya mereka akan melakukan apa pun. Dengan demikian, mata yang waspada dari kelompok tertentu menjulang di atas audisi ini. Yang tidak diketahui siapa pun adalah bahwa ada rahasia berbahaya yang bersembunyi di balik tirai, dan apa pun sihir hitam yang dipanggil.\",\"jumpAddress\":\"tiktik://jump/detail?id=100171&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":5,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\"],\"title\":\"Enigma 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250912/1757642311048_7d4456099fe322cf54ed85a9897786beeJ9y4NjkS2t9VagGTEtTzOlkQcz.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":106749,\"imageUrl\":\"https://img.netpop.app/cover/20250912/1757642307270_bdebc00180b17b7896f560e6f1656342sXFgAo1X0HzjkpaTLBmgdtkP2gt.webp\",\"introduction\":\"Senior SMA Samut adalah orang yang terlalu berprestasi akademis. Dia adalah perwakilan dari sekolahnya yang bersaing dalam kontes akademik. Namun, masa depannya yang cerah, lenyap setelah ia terlibat dalam pertengkaran dan dikeluarkan dari sekolah. Dia dipindahkan ke sekolah baru dan, karena trauma, kehilangan hasratnya untuk sekolah. \\n\\n Suatu hari, Samut menemukan dadu kuno yang membawanya dan tujuh siswa lainnya ke dalam permainan papan misterius. Delapan siswa berkompetisi, mengakali, dan saling menguntungkan untuk tetap hidup dalam permainan misterius ini. Kehidupan mereka dipertaruhkan dan satu -satunya cara untuk keluar dari permainan adalah dengan mengalahkan kontestan lain.\",\"jumpAddress\":\"tiktik://jump/detail?id=106749&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Thriller\"],\"title\":\"The Dark Dice\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250725/1753435152324_ca37626adcc721a93e58a597879148cbd2QvyfaT4ykIH6sNwNhhbV3A1xH.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":100163,\"imageUrl\":\"https://img.netpop.app/cover/20250725/1753435148755_9aa367128a9477297a45bb8de0bc2448d2QvyfaT4ykIH6sNwNhhbV3A1xH.webp\",\"introduction\":\"Kisah ini mengikuti Phing, media roh terkenal yang secara tak terduga terlibat dalam pesta liar bernama Paradise Seven, sebuah hotspot untuk orang -orang muda yang seksi, termasuk empat playboy terkenal: Pi, ter, atlet dan kotoran. Juga hadir adalah Bam, seorang wanita yang menakjubkan dan memikat yang membakar pesta. Dengan semua orang minum secara berlebihan dan melepaskan diri, malam menjadi kekacauan. \\n\\n Keesokan paginya, semua orang bangun untuk pemandangan yang mengejutkan, tubuh Bam yang tak bernyawa. Phing, yang kebetulan menyaksikan pemandangan itu, berupaya menggunakan kemampuannya untuk berkomunikasi dengan semangat Bam dan mengungkap pembunuhnya. Sayangnya, meskipun dia berhasil menghubunginya, Bam begitu mabuk pada malam pembunuhan sehingga bahkan hantu tidak dapat mengingat apa yang terjadi. Dengan segala sesuatu yang semakin rumit, pertanyaan besar tetap ada, dapatkah phing membantu roh Bam menemukan kebenaran?\",\"jumpAddress\":\"tiktik://jump/detail?id=100163&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":32,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Tegang\",\"Thriller\"],\"title\":\"The Tipsy Mystery\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250701/1751339781597_569b451b68332b7b6d36d38ed43a7b462.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":97111,\"imageUrl\":\"https://img.netpop.app/cover/20250701/1751339773786_74707bdb66474a91cd0bae680b4b7dd52.jpg\",\"introduction\":\"Chatfah, adik perempuan termuda dari keluarga Bupphachinda, baru saja menerima bagian terbesar dari warisan ayahnya dan akan menikah. Namun, Chatfah jatuh dari lantai tertinggi rumah liburan untuk matanya yang tiga kakak perempuannya yang terkejut. Ketika tubuhnya menghilang, ketiga saudara perempuannya - Baibua, Chomphu, dan Picha - menjadi tersangka dalam menghilangnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=97111&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Tegang\",\"Romansa\"],\"title\":\"Hide & Sis\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250920/1758354212689_fc94a43ba0558825ceefc948da82d5c32.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":108072,\"imageUrl\":\"https://img.netpop.app/cover/20250920/1758354207857_bef49b80dd7aa801bc940c91a0253def1.jpg\",\"introduction\":\"Seorang pembunuh berantai yang dikenal sebagai \\\"kepala pemburu\\\" meneror Makhwan sampai ia menyerang sebuah keluarga, dan seorang anak selamat. Ini menyebabkan penangkapannya - seorang ahli bedah yang sudah menikah dengan seorang anak di jalan.\",\"jumpAddress\":\"tiktik://jump/detail?id=108072&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\"],\"title\":\"Mouse\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250604/1749026820489_bbae96e98e639572ab2f040bb59738df2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":93513,\"imageUrl\":\"https://img.netpop.app/cover/20250604/1749026817432_6089f14e72a95ac38a115e249c45cc2b1.jpg\",\"introduction\":\"Surga kondominium mungkin tampak seperti tempat yang bagus untuk hidup, tetapi segera menjadi tempat tragedi yang mengerikan. Setelah seseorang yang tinggal di dalam kontrak kompleks, penyakit aneh yang menyebabkan penderitaan yang kejam, seperti zombie, pihak berwenang menguncinya untuk mencegah penyebaran-dengan penghuninya masih di dalam. Untuk mencoba dan menghentikan epidemi, petugas polisi berlari dan Prat pindah, tetapi mereka segera menemukan bahwa misi mereka lebih sulit daripada yang terlihat. Ketika infeksi terus menyebar, penduduk kondominium menjadi agresif terhadap satu sama lain, memprioritaskan kelangsungan hidup mereka sendiri di atas segalanya. Dapatkah berlari dan Prat menemukan cara untuk menghilangkan situasi sebelum terlambat?\",\"jumpAddress\":\"tiktik://jump/detail?id=93513&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Happiness\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250527/1748329741383_7742de68866d1218096271a6afc389612.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":92727,\"imageUrl\":\"https://img.netpop.app/cover/20250527/1748329737734_293575fb4312642eae45c526c50612521.jpg\",\"introduction\":\"Sun ditugaskan oleh ayah Sahirung, seorang wanita dengan gangguan identitas disosiatif, untuk membuat kelima kepribadiannya jatuh cinta padanya dalam upaya untuk memperbaikinya. Salah satu kepribadiannya, Manmok, bertekad untuk mengusirnya dari kehidupan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=92727&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"I Love ‘A Lot Of’ You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250427/1745733541515_b5a35550c7181cad39e32f081f124f96cC7PnhSZNtaWsZhfjKkYYLXbrt0.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":87828,\"imageUrl\":\"https://img.netpop.app/cover/20250618/1750210289140_3579d60faa1aaf472c99af1dbad6d069Rabbit on the Moon.png\",\"introduction\":\"Jira adalah tuan rumah bar berusia dua puluh sembilan tahun bukan karier yang dia bayangkan untuk dirinya sendiri. Phugh yang berusia dua puluh delapan tahun adalah agen real estat dari keluarga kaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=87828&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.2,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"Rabbit on the Moon\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231108/1699422704035_865d1677a883e99f337db3326e3e1f6efaceless-love-LL-1024x536.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":38283,\"imageUrl\":\"https://img.netpop.app/cover/20231122/1700623785489_50d9422cc4a2a40da74329e716c04071泰版富贵男贫穷女.png\",\"introduction\":\"Veekij adalah CEO muda yang tabah dengan prosopagnosia atau \\\"kebutaan wajah,\\\" yang berarti ia tidak dapat membedakan wajah orang. Untuk alasan ini, ia memutuskan untuk menyewa seorang asisten untuk membantu menghubungkannya dengan seluruh dunia. Mirin menjadi gadis yang bertanggung jawab untuk itu. Apakah kondisinya akan disembuhkan?\",\"jumpAddress\":\"tiktik://jump/detail?id=38283&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Faceless Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250402/1743582848313_4511acc821f22033420352c51a7ae6e6微信截图_20250402163121.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":83481,\"imageUrl\":\"https://img.netpop.app/cover/20250610/1749542516032_142d94de75568dd46c7acb4d8833bf25Until the Sun Meets the Star.png\",\"introduction\":\"Setelah kecelakaan mobil yang tragis mengklaim kehidupan Weha, putrinya Napdao dan Namfah dibiarkan menavigasi dunia yang dipenuhi dengan kesulitan. Tinggal dengan pecandu perjudian mereka di sebuah kumuh di daerah kumuh, Napdao mengorbankan pendidikannya untuk mendukung sekolah saudara perempuannya sementara Khimhan dan Phromtawan berjuang dengan nyonya dan saudara tiri baru ayah mereka. Ketika mereka menghadapi tantangan dan mengejar impian mereka, mereka tetap tidak menyadari bahwa Ratri, yang mengasumsikan identitas lain setelah menghabiskan bertahun -tahun di penjara, sebenarnya adalah ibu kandung Napdao yang mencari balas dendam terhadap Techit karena merobek keluarga mereka. \\n\\n Dengan koneksi yang tidak terduga yang terbentuk antara karakter dan agenda tersembunyi di balik permainan, cerita ini mengeksplorasi kompleksitas hubungan ketika terurai pengisian surgu. Seperti kebohongan terpapar dan ketegangan meningkat, semua orang yang terlibat harus menghadapi keinginan mereka dan menghadapi konsekuensi yang menanti mereka dalam perjalanan yang penuh gejolak ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=83481&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":19,\"resourceStatus\":2,\"score\":8.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Until the Sun Meets the Star\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250123/1737632516611_3357724589a061f55e1ada1a6661f076mqqOLB76zkJ72vqhWLchWskXxIF.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":69694,\"imageUrl\":\"https://img.netpop.app/cover/20250210/1739175412127_68e6d2a53e56d8f05c78f38176506378泰版金秘书为何那样.png\",\"introduction\":\"Seorang sekretaris yang cakap dan bos narsis jatuh ke sungai cinta, dan pada saat yang sama mengungkapkan masa lalu yang tak tertahankan, yang membuat mereka ragu bahwa perasaan mereka nyata atau hasil dari trauma umum.\",\"jumpAddress\":\"tiktik://jump/detail?id=69694&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"Dear My Secretary\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250401/1743498195657_1fde731d71710992755bdbc3584953aey68HVMhys4PLZ4xy7sp0VhFN2a8.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":81405,\"imageUrl\":\"https://img.netpop.app/cover/20250401/1743498224544_ea1b64745abd33dbb6b45c81ee3c426f9NP7S7NlmAx52NZ31WRkIey8Tan.jpg\",\"introduction\":\"Dilahirkan pada siang dan malam tanggal 29 Februari, siang dan malam masing -masing terganggu oleh kutukan mengerikan yang, setiap empat tahun, akan mengambil dari mereka orang yang paling mereka hargai.\",\"jumpAddress\":\"tiktik://jump/detail?id=81405&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"Leap Day\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250227/1740645313639_4eb342f3a786c11530f60a83e3195481横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":76207,\"imageUrl\":\"https://img.netpop.app/cover/20250227/1740645305933_2108a7e6b7f56530100e82b74b3bbc32竖.jpg\",\"introduction\":\"Ketika polisi berlomba untuk melacak tersangka dalam kasus pembunuhan profil tinggi, kematian misterius itu terbukti sebagai permulaan dalam serangkaian wahyu gelap yang menunggu untuk diungkap. Serial ini mengikuti Dalah, seorang desainer bunga yang penuh gaya yang disewa untuk menangani rangkaian bunga untuk pernikahan OHM yang sangat dinanti, kandidat utama Perdana Menteri, dan calon pengantinnya. Pernikahan mereka yang akan datang telah menarik perhatian nasional karena memiliki dua dinasti paling menonjol di negara itu. Ketika pengantin pria ditemukan tewas pada hari pernikahannya, semua orang menjadi tersangka utama dalam penyelidikan pembunuhan. Terjangkau dalam jaring urusan rahasia dan skandal masyarakat tinggi, Dalah memutuskan untuk mensayang jalan menuju kebenaran, mengungkap rahasia gelap dan konspirasi yang mencapai masa lalunya.\",\"jumpAddress\":\"tiktik://jump/detail?id=76207&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\",\"Thriller\"],\"title\":\"Dalah: Death and the Flowers\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220207/1644215482595_d90004573f3b6fc97f9fe89fcd333b88泰版流星花园10146横版.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":10146,\"imageUrl\":\"https://img.netpop.app/cover/20220207/1644215478998_567797b31dadee19a70897eac67c5318泰版流星花园10146竖版.png\",\"introduction\":\"Gorya adalah gadis kelas rendah akan menerima ke sekolah menengah bergengsi yang dihadiri oleh orang kaya. Sekolah itu diperintah oleh klique elit yang dikenal sebagai F4, terdiri dari 4 anak laki-laki yang kaya, tampan, dan manja. Gorya adalah satu-satunya yang berdiri dengan cara intimidasi mereka, meninggalkan semua anak laki-laki yang kagum, terutama Thyme, pemimpin kelompok itu. Hampir terpukul oleh Gorya, thyme secara romantis mengejarnya, tetapi dia tidak tertarik padanya karena kesan pertama. Dia kemudian jatuh untuk sahabatnya Ren, tetapi Ren jatuh cinta dengan cinta masa kecilnya. Dalam semua kekacauan sekolah, Gorda akan tidak dapat membantu diri sendiri jatuh karena thyme karena kedermawanannya kepadanya dan keluarganya, dan perubahan karakternya.\",\"jumpAddress\":\"tiktik://jump/detail?id=10146&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.8,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"F4 Thailand: Boys Over Flowers\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241125/1732531575658_d52fc9c4e37381b02deffbadf36a3624x4gJWy_3f.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":56794,\"imageUrl\":\"https://img.netpop.app/cover/20241220/1734660721674_69a2b384c20b438e1ea04ce950d1cba7蒂莎的抗争与重生.png\",\"introduction\":\"Seorang gadis muda melarikan diri dari tanah airnya untuk memulai kembali dengan ibunya. Tetapi ketika cincin kejahatan menghancurkan hidupnya, dia mengadopsi identitas baru untuk membalas dendam.\",\"jumpAddress\":\"tiktik://jump/detail?id=56794&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Thriller\"],\"title\":\"Thiicha\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241015/1728923760262_1c66d86c550cca6596930a9ea75453d0rUOrxMyQnRi0suTgyRaKsvmPK3N.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":53322,\"imageUrl\":\"https://img.netpop.app/cover/20241015/1728923757551_740cbc40294bf5c389adc2a488f5cca7pLl0Mk4aM5JN1wOXigEeR45zlp8.jpg\",\"introduction\":\"Ketika sekolah Siamwit jatuh pada masa -masa sulit, administrator sekolah Paphada memutuskan untuk menggabungkan kampus Udon Phithak dengan kampus utama, Burapha. Kedua kampus telah lama berselisih, dan sekarang mereka akan berbagi satu atap untuk tahun ajaran berikutnya. \\n\\n Saint, Kepala Kelas M.5/2, tidak peduli dengan sekolah atau siapa pun di dia. Di sekolah menengah, dia memimpin sekelompok pengganggu. Sekarang, dia bertemu dengan Shin yang memberontak, temperamental, dan keras kepala. Di masa lalu, Saint dan Shin adalah teman dekat, tetapi sesuatu terjadi di antara mereka yang mengakhiri dengan kekerasan pada persahabatan mereka. Gesekan antara keduanya menyebabkan perang kelas dan guru Jan dan Sung harus mengesampingkan perbedaan mereka dan berkumpul untuk mengakhiri pertempuran yang akan membutuhkan rekonsiliasi antara Saint dan Shin.\",\"jumpAddress\":\"tiktik://jump/detail?id=53322&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"LGBTQ\"],\"title\":\"High School Frenemy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241018/1729228006262_d24fdcfd824c528fac58280786b2cf15mWGMr5tXigNhWsGIt6tY1KoXHbg.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":53696,\"imageUrl\":\"https://img.netpop.app/cover/20241018/1729228002435_a86f8de5336c424644b53b930a8256bf8WJ9AqvqEjiVfMAvWjlhfgw4JRc.jpg\",\"introduction\":\"Terlepas dari kesalahpahaman awal dan keberatan dari keluarga mereka, Wichai dan Anong menemukan kenyamanan di perusahaan masing-masing. Pengacara yang bersemangat Wichai mendapati dirinya secara acak ditugaskan untuk menyaring calon suami untuknya. Tugasnya adalah menghilangkan kandidat yang tidak cocok dan membuka jalan bagi adiknya. Namun, Wichai mendefinisikan kembali apa artinya layak, membuat Anong menyadari bahwa tidak ada yang lebih cocok daripada Wichai sendiri. Namun, dia hanya melihatnya sebagai saudara ipar. Anong berusaha untuk memenangkan hatinya, bahkan jika hanya ada kesempatan \\\"satu dari seratus\\\" bahwa seorang wanita yang percaya diri seperti dia bisa mendaratkan orang suci seperti dia\",\"jumpAddress\":\"tiktik://jump/detail?id=53696&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":19,\"resourceStatus\":2,\"score\":8.3,\"showMark\":false,\"tagList\":[\"Sejarah\",\"Romansa\"],\"title\":\"My Cherie Amour\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240611/1718087736315_65c1aca6a90353e38b4aa25db4b223ce致我们单纯的小美好(泰版) 剧照.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":44655,\"imageUrl\":\"https://img.netpop.app/cover/20240611/1718087725726_a6b98ed3bd06e88de49d45582d572dc7致我们单纯的小美好(泰版).png\",\"introduction\":\"Punn adalah pemilik toko vintage. Dia tertarik dengan pelanggan regulernya Jet, pemilik museum dengan suasana kerahasiaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=44655&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":18,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Because You're My First Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241029/1730187257708_de86bdbddb5ec4262e3fcc4bfe2cd76e横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":54212,\"imageUrl\":\"https://img.netpop.app/cover/20241106/1730894302407_fff45f770337fb57f73df539341184b31780_The Empress of Ayodhaya.png\",\"introduction\":\"Dari perspektif seorang kaisar perempuan yang penuh dengan ambisi yang ambisius dan ideal dalam sejarah, drama itu memberi tahu selir (Mai) dari klan kerajaan timur dan selir keluarga kerajaan barat, keluarga kerajaan selatan, dan klan kerajaan utara Kekuatan King melakukan permainan yang mendebarkan untuk merebut kekuasaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=54212&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":4.1,\"showMark\":false,\"tagList\":[\"Sejarah\",\"Romansa\"],\"title\":\"The Empress of Ayodhaya\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241104/1730724566477_7077d926e6323ee78172c1394124baff横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":54546,\"imageUrl\":\"https://img.netpop.app/cover/20241104/1730724560716_d5cae0ae9edacb0925624aa479970da1竖.jpg\",\"introduction\":\"Seorang ibu dan putrinya yang masih kecil melarikan diri ke rumah keluarga mereka yang ditinggalkan tetapi segera mendapati diri mereka dihantui oleh insiden paranormal yang menyebabkan hilangnya misterius gadis kecil itu.\",\"jumpAddress\":\"tiktik://jump/detail?id=54546&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Don't Come Home\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231019/1697692206484_7a3cea8f5a72a62bb267e2d7c4230051横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":37912,\"imageUrl\":\"https://img.netpop.app/cover/20231019/1697692201313_4aedd27cb02b032efd30a1d02a526fb9竖.jpg\",\"introduction\":\"Ketika seorang teman junior woos vee, bar, bersumpah untuk hanya mencintai satu dalam hidup, bar harus memutuskan hubungan dengan Mark. Tapi Tuhan memainkan lelucon pada mereka dan sesuatu terjadi antara Vee dan Mark. Mark memilih untuk menyelipkan dan menggali diakhirinya. Namun, Vee tidak ingin mengakhiri dengan Mark. Mark sendiri mencintai Vee meskipun dia tahu Vee memiliki pacar tercinta. Akankah cinta di antara mereka berhasil? Kapan canggung akan pecah? Apa yang akan dilakukan vee?\",\"jumpAddress\":\"tiktik://jump/detail?id=37912&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Romansa\",\"LGBTQ\"],\"title\":\"Love Mechanics\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240618/1718714857452_5566fdc7a2145f22a0377cfa13912806hxipSVUVrnbsgQjAIsmicGD4Ps1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":45666,\"imageUrl\":\"https://img.netpop.app/cover/20240622/1719046359077_60144eff62da6d9d3e95061c927e5b26曼谷名妓.png\",\"introduction\":\"Tiga wanita, seorang pekerja seks dengan mimpi besar, seorang gadis yang mencari cinta, dan yang lain dijual ke dalam perdagangan, berjuang untuk membebaskan diri mereka sendiri dan merebut kembali martabat mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=45666&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":9.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Sejarah\",\"Kostum\"],\"title\":\"Bangkok Blossom\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632624021161_69bcbd678f9b7c283c6a51b357f4e0f4画板 1 拷贝 425.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1259,\"imageUrl\":\"https://img.netpop.app/cover/20211013/1634123917098_9e53c096e61bc9b6fbbea3d52caf79d19hDXqzN5l4lBmEtb8IstXr91k8z.jpg\",\"introduction\":\"A mysterious, clever girl named Nanno transfers to different schools, exposing the lies and misdeeds of the students and faculty at every turn.\",\"jumpAddress\":\"tiktik://jump/detail?id=1259&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Fantasi\",\"Tegang\",\"Thriller\"],\"title\":\"Girl from Nowhere Season 1\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"爱情神话\",\"coverType\":1,\"homeSectionId\":84166,\"homeSectionName\":\"Myth of Love\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250513/1747115715700_fea001df179680c9a0499de3ae6dbd4c2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":90349,\"imageUrl\":\"https://img.netpop.app/cover/20250513/1747115720996_6ddfde00e8ef584542ce5f932bd6c21d1.jpg\",\"introduction\":\"Jin U dan teman -temannya, yang masing -masing mengalami puncak pubertas mereka, memiliki minat dan penyebab masalah yang unik. Satu -satunya minat umum di antara mereka adalah Seon A, siswa model yang mewujudkan rahmat dan keindahan. Bagi mereka, Seon A terlihat seperti mimpi yang tidak dapat dicapai, meskipun dia berada di kelas yang sama\",\"jumpAddress\":\"tiktik://jump/detail?id=90349&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"You Are the Apple of My Eye\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250219/1739931496345_647386bf1c63aaca27b447385da0a562tt7dTwvfi4Ay0sHX2aJ5OPZh5HR.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":73768,\"imageUrl\":\"https://img.netpop.app/cover/20250219/1739931510082_3d2e19e0de80486c3ebc33b0bcfd3d73uX8Z3qWJ5OjV1uP7yT6yRlw9UL9.jpg\",\"introduction\":\"Romansa postapokaliptik di mana pelampung dan satelit bertemu secara online dan jatuh cinta setelah berakhirnya peradaban manusia.\",\"jumpAddress\":\"tiktik://jump/detail?id=73768&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.6,\"showMark\":false,\"tagList\":[\"Drama\",\"Sci-Fi\"],\"title\":\"Love Me\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250213/1739426530699_928069c08e26bfaad9d64aa09e1f85cdaf7HqyI1CSxV2febOcIxyMLLFbl.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":72138,\"imageUrl\":\"https://img.netpop.app/cover/20250213/1739429971999_b77c1fd1236e87d961d194a9c6ccbde2bioObjvmJdDRxnWM3TrQYaMUbAQ.jpg\",\"introduction\":\"Seorang gadis berusia 18 tahun pindah dari Amerika ke London bersama ibu dan ayah tiri kaya. Dia bertemu dengan saudara tirinya, dan sebuah atraksi menyeduh meskipun ada upaya mereka. Tidak sadar, ayahnya yang terasing melacaknya setelah dibebaskan dari penjara\",\"jumpAddress\":\"tiktik://jump/detail?id=72138&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"My Fault: London\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250217/1739779963640_83e66628cfaac88cf4b679fdc06e828dlBcXozUeABairkTavz3X3ZAtOL0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":73366,\"imageUrl\":\"https://img.netpop.app/cover/20250217/1739779960250_3d027b199a1c5bd9c22eee38fe928574yu9dRyKcUHTfKcqsomUtpord4t3.jpg\",\"introduction\":\"Remaja pemberontak lokal Clotaire jatuh cinta pada teman sekolahnya Jackie, tetapi kekerasan geng membawanya ke jalan destruktif yang lebih gelap. Setelah bertahun-tahun terpisah, para pecinta yang bersilang bintang menemukan bahwa setiap jalan yang mereka ambil membawa mereka kembali bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=73366&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Tarian & Bernyanyi\",\"Romansa\"],\"title\":\"Beating Hearts\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250211/1739207161452_6e9f072edb7ca1561b13c1ef029bbceaqk9r1KRLE0IapvO7YO9seRsLPRT.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":71575,\"imageUrl\":\"https://img.netpop.app/cover/20250211/1739207158385_f67e73a81955561fab263211044743e5dcOi8eEsd3TkFo0CC8fpA2G8SAX.jpg\",\"introduction\":\"Komedi romantis ini menceritakan kisah seorang gadis muda yang melarikan diri dari universitas top di Bangkok ke kota kelahirannya untuk merenungkan masa depannya, memberi tahu ibunya bahwa dia memiliki istirahat sekolah. Haruskah dia berjuang untuk lulus dan mengambil jalan dalam hidup yang akan memungkinkannya untuk mendukung keluarganya, atau haruskah dia mengejar tujuan dan impiannya sendiri?\",\"jumpAddress\":\"tiktik://jump/detail?id=71575&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"I Love You Two Thousand\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241228/1735387191662_49925f7fa9369e2eeb19c2e0d94bbbe1小心肝儿2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":65246,\"imageUrl\":\"https://img.netpop.app/cover/20241228/1735387185590_436a39f88c98e2d8489655b406ffe356小心肝儿1.jpg\",\"introduction\":\"Seorang CEO bertenaga tinggi menempatkan karier dan keluarganya di telepon ketika dia memulai perselingkuhan yang panas dengan pekerja magang yang jauh.\",\"jumpAddress\":\"tiktik://jump/detail?id=65246&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Tegang\",\"Thriller\"],\"title\":\"Babygirl\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241119/1731993399715_76c8cb659dbdf85c1f52e291375e7998微信截图_20241119130918.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":55790,\"imageUrl\":\"https://img.netpop.app/cover/20241119/1731993395066_ac56c8f6c65e9bf3d8c0a94685824bba6kYDG8Imfhph2duBYZeYksHgx7L.jpg\",\"introduction\":\" Terlepas dari upaya orang tua mereka untuk memisahkan mereka, cinta Nuh dan Nick tampaknya tidak bisa dipecahkan. Namun, pekerjaan dan kuliah membuka hidup mereka untuk hubungan baru.\",\"jumpAddress\":\"tiktik://jump/detail?id=55790&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Your Fault\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241211/1733901022976_09b89f9ae08592022addb415c6cb8989阿诺拉横版.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":60357,\"imageUrl\":\"https://img.netpop.app/cover/20241211/1733901014870_411fbded9cb89aac4863f8fd417e81e5阿诺拉.jpg\",\"introduction\":\"Anora, seorang pekerja seks muda dari Brooklyn, bertemu dan secara impulsif menikahi putra seorang oligarki. Setelah berita mencapai Rusia, dongengnya terancam ketika orang tuanya berangkat ke New York untuk membuat pernikahan dibatalkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=60357&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Anora\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241116/1731724512752_176188d4af89e7773f8101ad732e4d44lqnQ5O4l8NcF2IKjNknx5JRG7af.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":55538,\"imageUrl\":\"https://img.netpop.app/cover/20241211/1733908283881_ceaa749a2109b2f26a4271e234b3df51听说.png\",\"introduction\":\"Yong Joon bekerja paruh waktu di rumah kotak makan siang orang tuanya. Yeo Reum hidup hanya untuk mendukung saudara perempuan perenang yang mengalami gangguan pendengaran. \\n\\n Suatu hari, Yong Joon bertemu Yeo Reum sambil mengantarkan kotak makan siang dan jatuh cinta pada pandangan pertama. Yeo Reum perlahan membuka hatinya untuk Yong Joon yang berhati hangat.\",\"jumpAddress\":\"tiktik://jump/detail?id=55538&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Hear Me: Our Summer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240311/1710126861724_21df287c866fc6ad7749bf118e8a8230pk5ibyxRfwhqJSjzjCwlP0hadHE.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":42031,\"imageUrl\":\"https://img.netpop.app/cover/20240311/1710126857799_0a964d798c1c9f76a4f7b6f8173b34dfY5P4Q3q8nrruZ9aD3wXeJS2Plg.jpg\",\"introduction\":\"Solène, seorang ibu tunggal berusia 40 tahun, memulai romansa yang tidak terduga dengan Hayes Campbell yang berusia 24 tahun, penyanyi utama August Moon, band boy terpanas di planet ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=42031&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"The Idea of You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230614/1686709786396_64af1cd3582b955bfc04233f838b481ezpY97OUNunOAPIxXYO4ZUGl7fnK.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":22264,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658200586663_dc3e5077d40a9cc09ba4f203f11dff70clAMlA3DcwKMJIYeAFGGN0vyJQp.jpg\",\"introduction\":\"Cassie Salazar dan Luke Morrow sangat berbeda. Cassie yang cerdas bekerja malam di sebuah bar di Austin, Texas untuk memenuhi kebutuhannya sambil mengejar mimpinya menjadi penyanyi/penulis lagu. Luke adalah seorang peserta pelatihan Angkatan Darat, yang akan dikirim untuk bertugas, yang menemukan kenyamanan dalam disiplin pelayanan yang teguh. Tapi pertemuan kebetulan di bar Cassie mengubah jalan hidup mereka berdua. Cassie tenggelam dalam tagihan medis setelah didiagnosis menderita diabetes.\",\"jumpAddress\":\"tiktik://jump/detail?id=22264&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Musikal\",\"Romansa\"],\"title\":\"Purple Hearts\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211020/1634710683986_21c2cd5c8bd047fa1e9756b4f36fa12aAfter We Fell.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3881,\"imageUrl\":\"https://img.netpop.app/cover/20241105/1730793814691_7923a6ad7ff39db4a5cbfe376a72530adU4HfnTEJDf9KvxGS9hgO7BVeju.jpg\",\"introduction\":\"Sama seperti Tessa membuat keputusan terbesar dalam hidupnya, semuanya berubah. Wahyu tentang keluarganya, dan kemudian Hardin, melemparkan semua yang mereka kenal sebelumnya dan membuat masa depan mereka yang sulit bersama lebih sulit untuk diklaim.\",\"jumpAddress\":\"tiktik://jump/detail?id=3881&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Remaja\"],\"title\":\"After We Fell\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240407/1712457449238_09c389ba8349285a3ad2ac68a3ec054a竖.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":42763,\"imageUrl\":\"https://img.netpop.app/cover/20240407/1712457439413_1649213043374efc86a3a74cb6889bf5横.jpg\",\"introduction\":\"Terkadang ketakutan terbesar kita adalah menerima bahwa seseorang dapat dengan jujur mencintai kita apa adanya. Nica dan Rigel siap untuk menemukannya bersama.\",\"jumpAddress\":\"tiktik://jump/detail?id=42763&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\",\"Thriller\"],\"title\":\"The Tearsmith\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240208/1707381943835_afae107324460fdaf57ba314e78d4ff31PkBhxXdEejw8c5BC7T3cN7jz9g.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":41188,\"imageUrl\":\"https://img.netpop.app/cover/20240218/1708221350522_617a75d56666fbe124bd3c3cc251b9588.jpg\",\"introduction\":\"Setelah kencan pertama yang luar biasa, objek wisata Bea dan Ben yang berapi-api berubah menjadi sedingin es-sampai mereka menemukan diri mereka secara tak terduga bersatu kembali di pernikahan tujuan di Australia. Jadi mereka melakukan apa yang akan dilakukan oleh dua orang dewasa yang matang: berpura -pura menjadi pasangan.\",\"jumpAddress\":\"tiktik://jump/detail?id=41188&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Anyone But You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241112/1731398969716_1339c109e1672d2cb2b1e05183c507c3横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":55147,\"imageUrl\":\"https://img.netpop.app/cover/20241112/1731398962931_a8bb5dd5e5676900aa78d4b6f00af6c4竖.jpg\",\"introduction\":\"Seorang anak laki -laki berteman dengan semangat seorang gadis tahun 1920 -an yang berlama -lama di rumah barunya, membentuk ikatan yang tidak mungkin namun mendalam selama beberapa dekade.\",\"jumpAddress\":\"tiktik://jump/detail?id=55147&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Romansa\"],\"title\":\"Girl Haunts Boy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230810/1691647272534_07955f0bd8dac3d1dcd15b8f93fc1a5d6.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":34846,\"imageUrl\":\"https://img.netpop.app/cover/20230810/1691647223091_35566a08cdbd50c1b50db18831747bd01.jpg\",\"introduction\":\"Di ambang kehilangan rumahnya, Maddie menemukan daftar pekerjaan yang menarik: orang tua helikopter mencari seseorang untuk membawa putra mereka yang berusia 19 tahun keluar dari cangkangnya sebelum kuliah. Dia memiliki satu musim panas untuk menjadikannya pria atau mati mencoba.\",\"jumpAddress\":\"tiktik://jump/detail?id=34846&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Komedi\"],\"title\":\"No Hard Feelings\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220111/1641887153051_9a73575a538f1c436a3ec34f67bee386mcSQa6hyBY3kLj0Eaey2K1Ev852.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":10574,\"imageUrl\":\"https://img.netpop.app/cover/20220112/1641955620510_a60422b49adf4816d3667095dedb16a81nXN4e3IoTJD42ci7WHZeI1Cgpm.jpg\",\"introduction\":\"Maggie (Hathaway) adalah roh bebas memikat yang tidak akan membiarkan siapa pun - atau apa pun - ikat dia. Tetapi dia memenuhi pertandingannya di Jamie (Gyllenhaal), yang pesonong yang tanpa henti dan hampir sempurna melayani dia dengan baik dengan para wanita dan di dunia jual farmasi yang cutthroat. Maggie dan hubungan Jamie yang berkembang membawa mereka berdua terkejut, karena mereka menemukan diri mereka di bawah pengaruh obat pamungkas: cinta.\",\"jumpAddress\":\"tiktik://jump/detail?id=10574&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2010,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Love & Other Drugs\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230614/1686709531057_24e5d052ce61bb87df7923cd64ae231epNOccytgkGuyofTLmh1sqEfTJuE.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":34618,\"imageUrl\":\"https://img.netpop.app/cover/20230612/1686538244070_2c10854a04a43d576f015593d76175de7.jpg\",\"introduction\":\"Nuh harus meninggalkan kotanya, pacar, dan teman -temannya dan pindah ke mansion suami kaya ibunya yang baru. Mereka dia bertemu Nick, saudara tirinya yang baru. Mereka diam -diam jatuh cinta dengan gila.\",\"jumpAddress\":\"tiktik://jump/detail?id=34618&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Romansa\"],\"title\":\"My Fault\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220425/1650871835603_6a826202f7baa52200943dd706f8b5f4j9V2HVQKiyu2FzAckXK2q6b44wc.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":16781,\"imageUrl\":\"https://img.netpop.app/cover/20220425/1650871825706_a27ff5d62687cce6eb9746c28a3a5a11cBpef6K40Su2CcBb3c18WdwRFCL.jpg\",\"introduction\":\"Kehidupan seorang pemilik toko buku sederhana berubah ketika dia bertemu dengan bintang film paling terkenal di dunia.\",\"jumpAddress\":\"tiktik://jump/detail?id=16781&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1999,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Notting Hill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210928/1632798900553_ac93d494ef605fb0b8bf539177666992meGzYSwHzBWNQk9lYVNxdUrFqiC.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2762,\"imageUrl\":\"https://img.netpop.app/cover/20210928/1632798893294_5b4267e4e5301c3d775a62d546a1856buDO8zWDhfWwoFdKS4fzkUJt0Rf0.jpg\",\"introduction\":\"Calon aktris menyajikan lattes ke bintang film di antara audisi dan musisi jazz Sebastian gores dengan memainkan pertunjukan pesta koktail di bar suram. Tetapi sebagai dudukan kesuksesan, mereka dihadapkan dengan keputusan yang menghilangkan kain rapuh dari perselingkuhan cinta mereka, dan mimpi-mimpi mereka bekerja sangat keras untuk mempertahankan satu sama lain mengancam untuk memisahkan mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=2762&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Musikal\",\"Romansa\"],\"title\":\"La La Land\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"另类超英\",\"coverType\":1,\"homeSectionId\":84278,\"homeSectionName\":\"Alternative Superhero \",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250505/1746446147850_cfff2845af8ba63844bd89ba0852f1cb2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":88805,\"imageUrl\":\"https://img.netpop.app/cover/20250505/1746446137330_aab9195a3200e94c5b6050e010a334da1.jpg\",\"introduction\":\"Setelah mendapati diri mereka terjerat dalam perangkap kematian, tim antiheroes yang tidak konvensional harus memulai misi berbahaya yang akan memaksa mereka untuk menghadapi sudut -sudut paling gelap dari masa lalu mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=88805&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Kriminal\",\"Drama\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Thunderbolts*\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210916/1631780524740_80f0697d5fb179461058de8e375b42c7uXsE8WOKB55GxLMfvMxmNVq6yMk.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1877,\"imageUrl\":\"https://img.netpop.app/cover/20240806/1722924170935_c247ee3d45154ed3d384fc3443abab9dwg3MLoL0wEtY2r2pbtdK5aF6e6F.jpg\",\"introduction\":\"Ini adalah kisah asal mantan pasukan khusus yang beralih Mercenary Wade Wilson, yang setelah dikenai percobaan jahat yang membuatnya memiliki kekuatan penyembuhan yang dipercepat, mengadopsi deadpool alter ego. Bersenjata dengan kemampuan barunya dan selera humor yang gelap dan bengkok, Deadpool memburu pria yang hampir menghancurkan hidupnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=1877&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Sci-Fi\"],\"title\":\"Deadpool\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220113/1642041982237_bdbb241e2b1a9085970aaa2937aadde5bEAQfLTykGg232kJogBlxRYaRqU.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":10698,\"imageUrl\":\"https://img.netpop.app/cover/20220113/1642041967797_26a1bff7967c227e656f2d947acae570sCmwhWMMNStxkKi078eEx1CpyB8.jpg\",\"introduction\":\"Wolverine comes to Japan to meet an old friend whose life he saved years ago, and gets embroiled in a conspiracy involving yakuza and mutants.\",\"jumpAddress\":\"tiktik://jump/detail?id=10698&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Sci-Fi\"],\"title\":\"The Wolverine\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211201/1638344944638_412dc2f11995866dfe042bc4b28aac1b3P52oz9HPQWxcwHOwxtyrVV1LKi.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1883,\"imageUrl\":\"https://img.netpop.app/cover/20211201/1638344884971_89c0ec06634e3c085919343371bec708to0spRl1CMDvyUbOnbb4fTk3VAd (1).jpg\",\"introduction\":\"Setelah kalah dari Vanessa (Morena Baccarin), cinta hidupnya, Mercenary Wall Hearner Wade Wilson Wilson AKA Deadpool (Ryan Reynolds) harus merakit tim dan melindungi anak muda, Russell Collins AKA dari Kabel (Jos Brolin), cyborg tanpa omong kosong, berbahaya dari masa depan, dan juga harus belajar pelajaran paling penting dari semuanya: untuk menjadi bagian dari keluarga lagi.\",\"jumpAddress\":\"tiktik://jump/detail?id=1883&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Sci-Fi\"],\"title\":\"Deadpool 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632624067041_7a25cfc27a5c9c9bfe95a01a3307972aAvengers_ Endgame.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1749,\"imageUrl\":\"https://img.netpop.app/cover/20211105/1636113345450_7ec3fbe341667496b620151f6f4b7cd636CTH2SPmt4DRcsAP2iZUw0SBtE.jpg\",\"introduction\":\"Setelah peristiwa dahsyat Avengers: Infinity Wer (2018), alam semesta berada di reruntuhan. Dengan bantuan sekutu yang tersisa, Avengers berkumpul sekali lagi untuk membalikkan tindakan Thanos dan mengembalikan keseimbangan kepada alam semesta.\",\"jumpAddress\":\"tiktik://jump/detail?id=1749&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Sci-Fi\"],\"title\":\"Avengers: Endgame\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211221/1640055315284_6e614de84043d7a34bdcfe9377e5ab20p2771212640.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":8084,\"imageUrl\":\"https://img.netpop.app/cover/20220312/1647052303811_d94d9b24e1de4c6e1f9d36ba57d33d071639710975272_2b9fecba9ec05b00566e58006089e9ca1g0dhYtq4irTY1GPXvft6k4YLjm.jpeg\",\"introduction\":\"With Spider-Man's identity now revealed, Peter asks Doctor Strange for help. When a spell goes wrong, dangerous foes from other worlds start to appear, forcing Peter to discover what it truly means to be Spider-Man.\",\"jumpAddress\":\"tiktik://jump/detail?id=8084&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Spider-Man: No Way Home\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220113/1642042566776_c247281f79da7ebce5f6c898cd0ff8c4c71zkXAykw5uu4cHnUCE6vA3NY0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":10699,\"imageUrl\":\"https://img.netpop.app/cover/20220113/1642042561146_04884666710ab24ed6c5e6b3e319f915pF7CLvow3KQRF2Ua3koKXezohU9.jpg\",\"introduction\":\"Di masa depan di mana mutan hampir punah, lansia dan lelah logan memimpin kehidupan yang tenang. Tetapi ketika Laura, seorang anak mutan yang dikejar oleh para ilmuwan, datang kepadanya untuk bantuan, ia harus membuatnya aman.\",\"jumpAddress\":\"tiktik://jump/detail?id=10699&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2017,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sci-Fi\"],\"title\":\"Logan\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210917/1631846374079_d2d9e3fafbeb2529f270876c76c23054VuukZLgaCrho2Ar8Scl9HtV3yD.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2548,\"imageUrl\":\"https://img.netpop.app/cover/20210917/1631846370937_52acc92b775e6407e078cb432f5bd5e02uNW4WbgBXL25BAbXGLnLqX71Sw.jpg\",\"introduction\":\"Seorang reporter yang gagal diikat pada entitas alien, salah satu dari banyak Symbiotes yang telah menginvasi Bumi. Tetapi sedang memperhatikan Bumi dan memutuskan untuk melindunginya.\",\"jumpAddress\":\"tiktik://jump/detail?id=2548&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Venom\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230509/1683599487333_915519a2b4e1edec223f49fc67de8502银河 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":33727,\"imageUrl\":\"https://img.netpop.app/cover/20230509/1683599484535_9da770ed59343cc74668e4b93789cfdf银河 竖.jpg\",\"introduction\":\"Peter Quill, yang masih terhuyung -huyung karena kehilangan Gamora, harus mengumpulkan timnya di sekitarnya untuk mempertahankan alam semesta bersama dengan melindungi salah satu dari mereka. Sebuah misi yang, jika tidak berhasil diselesaikan, sangat mungkin mengarah pada akhir wali seperti yang kita kenal.\",\"jumpAddress\":\"tiktik://jump/detail?id=33727&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Sci-Fi\"],\"title\":\"Guardians of the Galaxy Vol. 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210926/1632624604271_cae3ef2805a8c84bf10d6c0322a915c5Captain America_ The Winter Soldier.png\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1752,\"imageUrl\":\"https://img.netpop.app/cover/20210929/1632911454887_af1678125eefc45285a67d2a65ebdda5wxwt0pLxFZwKzy7pAu8WixadwqO.jpg\",\"introduction\":\"Ketika Steve Rogers berjuang untuk merangkul perannya di dunia modern, ia bekerja dengan sesama agen Avenger dan S.H.I.E.L.D, Black Widow, untuk memerangi ancaman baru dari sejarah: seorang assassin yang dikenal sebagai prajurit musim dingin.\",\"jumpAddress\":\"tiktik://jump/detail?id=1752&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Captain America: The Winter Soldier\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230220/1676864117389_4b4eb028ad0136943b5046ceb3d00eea蚁人 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":31301,\"imageUrl\":\"https://img.netpop.app/cover/20230220/1676864114672_b0b99e18ae085aa9d914d7e73d0c6cad蚁人 竖.jpg\",\"introduction\":\"Scott Lang dan Hope Van Dyne, bersama dengan Hank Pym dan Janet Van Dyne, menjelajahi dunia kuantum, di mana mereka berinteraksi dengan makhluk -makhluk aneh dan memulai petualangan yang melampaui batas apa yang mereka pikir mungkin.\",\"jumpAddress\":\"tiktik://jump/detail?id=31301&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Sci-Fi\"],\"title\":\"Ant-Man and the Wasp: Quantumania\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210929/1632889452441_2346b87d68b39c3e934d5bba8cc1011eqhPtAc1TKbMPqNvcdXSOn9Bn7hZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2806,\"imageUrl\":\"https://img.netpop.app/cover/20210929/1632889447875_df4311163c37a89a780c65bc546f61b0qhPtAc1TKbMPqNvcdXSOn9Bn7hZ.jpg\",\"introduction\":\"Marvel's \\\"Iron Man 3\\\" Pits Brash-but-Brilian Industrialis Tony Stark / Iron Man melawan musuh yang jangkaiannya tidak mengenal batas. Ketika Stark menemukan dunia pribadinya dihancurkan di tangan musuhnya, ia memulai pencarian yang mengerikan untuk menemukan mereka yang bertanggung jawab. Perjalanan ini, di setiap giliran, akan menguji keberaniannya. Dengan punggungnya di dinding, Stark dibiarkan bertahan hidup oleh perangkatnya sendiri, mengandalkan kecerdikannya dan naluri untuk melindungi mereka yang paling dekat dengannya. Ketika dia berjuang kembali, Stark menemukan jawaban atas pertanyaan yang diam-diam menghantuinya: Apakah pria itu membuat jas itu membuat pria itu? \\n\",\"jumpAddress\":\"tiktik://jump/detail?id=2806&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Iron Man 3\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"王的女人\",\"coverType\":1,\"homeSectionId\":84293,\"homeSectionName\":\"Wanita Sang Raja\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260202/1770018837251_870d6bd3a44008bfbbd37fb590da4ef721世纪大君夫人0.webp\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":126366,\"imageUrl\":\"https://img.netpop.app/cover/20260310/1773136575252_d43263153400f740254d8bec97999c5cuyau9OSO6Je9mfBHPiAlLv97DzD.webp\",\"introduction\":\"Di Korea modern dengan monarki konstitusional, seorang pewaris Chaebol dan seorang pangeran yang tidak berdaya memasuki pernikahan kontrak, menemukan cinta dan keberanian saat mereka menghadapi hambatan sosial dan luka pribadi.\",\"jumpAddress\":\"tiktik://jump/detail?id=126366&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularitas di atas 30000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"Perfect Crown\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211013/1634117556443_d66606b3414d33f86a8684be300aa2feKing 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3309,\"imageUrl\":\"https://img.netpop.app/cover/20211013/1634117553146_e89e9bacb9cacacc9b29ebba54f66662King 竖.jpg\",\"introduction\":\"In 1994, the Kingdom of Corea encounters severe upheaval. The King is murdered by his brother Lee Lim and the King's son Lee Gon is stabbed in the neck, but he survives. The murderous Lee Lim seeks to possess the Manpasikjeok, which is legendary flute that holds supernatural powers. After a mysterious figure appears with a gun, Lee Lim slips away with only half of the now broken flute. The young Lee Gon holds onto a police badge he grabbed from the mysterious figure. The next day, Lee Gon is appointed the next ruler of the Kingdom of Corea. 25 years later, in the autumn of 2019, King Lee Gon governs the Kingdom of Corea as its benevolent leader. He is still haunted by what happened when he was a child and the mystery behind the police badge left by his savior. The police badge he held was issued on November 11, 2019 for Lieutenant Jeong Tae Eul. Autumn 2019, in the Republic of Korea. Jeong Tae Eul is a detective in the Violent Crimes Division at the Seoul Jongo Police Station. She is working undercover to take down the operator of an illegal online gambling operation. Meanwhile, in the Kingdom of Corea, King Lee Gon chases after someone that is dressed like a rabbit with a clock. King Lee Gon has a feeling that the person dressed like a rabbit may be his mysterious savior from 25 years earlier. King Lee Gon mounts his horse Maximus and enters the forest. Soon, he crosses over from the Kingdom of Corea into the parallel world of the Republic of Korea, where Lee Gon finally meets Detective Jeong Tae Eul.\",\"jumpAddress\":\"tiktik://jump/detail?id=3309&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Tegang\",\"Romansa\"],\"title\":\"The King: Eternal Monarch\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211020/1634703504849_200d51c5e9186989050443af43353eff王后 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3856,\"imageUrl\":\"https://img.netpop.app/cover/20220915/1663240689285_251301754e415ed30cd6b812e8e2480d11.jpg\",\"introduction\":\"Pada hari ini, Jang Bong Hwan adalah seorang koki yang bekerja untuk politisi top negara itu di Blue House. Dia memiliki semangat bebas, tetapi rohnya entah bagaimana menemukan jalan ke tubuh Ratu Cheorin (Shin Hye-sun) dalam periode Joseon. Raja Cheoljong (Kim Jung-hyun), The Monarch yang berkuasa, adalah orang yang lembut dan santai. Namun, dia hanya nama raja. Ratu Sunwon (Bae Jong-Ok), istri almarhum Raja Sunjo, menggunakan kekuatan sejati di negara itu dan telah menurunkan Raja Cheoljong ke suatu bonus. Adiknya yang ambisius, Kim Jwa Geun (Kim Tae-woo), juga menginginkan kekuasaan. Ratu Cheorin segera menemukan bahwa Raja Cheoljong bukanlah apa yang tampaknya dia lakukan, dan bahwa ia memiliki sisi yang gelap dan mencurigakan baginya.\",\"jumpAddress\":\"tiktik://jump/detail?id=3856&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":8.8,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Fantasi\",\"Sejarah\",\"Romansa\",\"Kostum\"],\"title\":\"Cheolinwanghoo\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211108/1636351530300_4dd1889eccbcdd9a8e079f4495be0138aYagJuQhXpeuq9PEc5ktrk9eukc.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":5764,\"imageUrl\":\"https://img.netpop.app/cover/20221025/1666667629779_ae76cc24cf07d45c60605323b43f2fa01647682175227_ae76cc24cf07d45c60605323b43f2fa0c0xkumbQcInSXSYjJVIm7SnQ9H5.jpg\",\"introduction\":\"Mahasiswa seni yang bersemangat, kehidupan Shin Chae-Kyung terbalik ketika dia diberitahu bahwa dia telah bertunangan dengan teman sekelasnya, Lee Shin, yang juga kebetulan adalah Putra Mahkota Korea Selatan. Untuk menyelamatkan keluarganya dari hutang, dia menyetujui pernikahan. Tetapi komplikasi muncul dari semua sisi. Pengantin baru hampir tidak bisa saling berdiri. Shin masih pinus untuk mantan pacar dan balerina min hyo rin. Chae-Kyung menemukan menyesuaikan diri dengan kehidupan istana sulit. Dan setelah bertahun-tahun di luar negeri, Lee Yul kembali. Skandal keluarga yang lalu telah mengungsi dari garis suksesi. Sekarang, dia terjebak di antara intrik ibunya dan perasaannya yang tumbuh terhadap pengantin muda sepupunya.\",\"jumpAddress\":\"tiktik://jump/detail?id=5764&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2006,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":24,\"resourceStatus\":2,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\"],\"title\":\"Palace\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210918/1631949326695_a26139838e03f9e0e18a77dd68e28abd3yEHM2HT2vrUtO93YzTJNgEfiZG.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":2595,\"imageUrl\":\"https://img.netpop.app/cover/20220909/1662704688454_0c37738be0593210a88911a9fb18db0e爱的迫降竖版.png\",\"introduction\":\"Kisah cinta rahasia absolut dari seorang Heiress Chaebol yang membuat pendaratan darurat di Korea Utara karena kecelakaan paralayang dan seorang perwira khusus Korea Utara yang jatuh cinta padanya dan siapa yang bersembunyi dan melindunginya.\",\"jumpAddress\":\"tiktik://jump/detail?id=2595&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.7,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Komedi\",\"Romansa\",\"Remaja\"],\"title\":\"Sa-rang-eui bul-sa-chak\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211111/1636610522462_a982c853c9ea97b9b001bf5fce6b66756C5m9nzCTB0ijS9PjYus0eTYpct.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6153,\"imageUrl\":\"https://img.netpop.app/cover/20211111/1636610519784_3f4d980e7609656a1e72f7c9139ef5b6kWJw89ce4gxGREKxaFSiQmETWQN.jpg\",\"introduction\":\"Set in an alternate universe, in which Korea is a constitutional monarchy in 2018, Oh Sunny is a bright and vivacious musical actress who marries the emperor. She becomes involved in the palace power struggle and a mysterious murder that sets off events that threaten the monarchy itself, while searching for true love and happiness. But, she ends up falling in love with Na Wang Sik who works as a bodyguard for the imperial family. He started working in the palace to take revenge on the person responsible for his mother's death.\",\"jumpAddress\":\"tiktik://jump/detail?id=6153&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":26,\"resourceStatus\":2,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"The Last Empress\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211027/1635324276329_ffb3df1ea930086424bf093632650650七日 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":4685,\"imageUrl\":\"https://img.netpop.app/cover/20211027/1635324273599_5682e73f09a9da88aa48f2cc6f49da00七日 竖.jpg\",\"introduction\":\"Kyung adalah putri seorang politisi yang kuat selama Dinasti Joseon. Dia jatuh cinta dengan Putra Mahkota Lee Yuk, yang tinggal di bawah tirani saudara tirinya, Raja Yeon San Gun. Ketika Lee Yuk naik ke tahta dan menjadi Raja Jung Jong, Chae Kyung menjadi Ratu Dan Kyung, yang menjadi tertangkap di persebangsaan dari berbagai faksi politik serta kecemburuan antara saudara-saudara ketika ayah dan ayah sendiri menemukan kudeta terhadap Raja, Ratu Dan Kyung hanya didukung setelah tujuh hari dan dikeluarkan dari istana. Apa yang akan terjadi pada cinta antara Raja dan Ratu ketika mereka tidak bisa lagi bersama?\",\"jumpAddress\":\"tiktik://jump/detail?id=4685&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2017,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"Queen For Seven Days\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231016/1697451667837_6430cadeaeef447a2f0f7f9a78ec0592p2890271804.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":37841,\"imageUrl\":\"https://img.netpop.app/cover/20231122/1700622556300_0fcc859e3f785ce2d89f57cc98cece85c9xQuvJKm46nVJ913EeFqyLJWmR.jpg\",\"introduction\":\"tentang pewaris chaebol melakukan hee yang merupakan musuh semua orang dan iblis Jung Koo menang yang kehilangan kekuatannya suatu hari ketika mereka akhirnya hidup bersama. Jung Koo Won lebih unggul dari manusia dalam segala hal, tetapi ketika dia kehilangan kekuatannya, dia harus bekerja dengan Do Do Hee untuk memulihkannya, dan romansa mulai mekar dalam proses ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=37841&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"My Demon\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211110/1636538033962_8d48679fcc459193a1c5577f2355cf1c恋慕.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3252,\"imageUrl\":\"https://img.netpop.app/cover/20220719/1658201948599_4b56f0915e0f2c481df921ab1f2c6456恋.jpg\",\"introduction\":\"Istri Putra Mahkota melahirkan kembar, tetapi kembar dianggap sebagai tanda yang tidak menyenangkan. Putri kembar seharusnya dibunuh, tetapi ibunya memohon untuk menyelamatkan hidupnya. Diam-diam, putri kembar dikirim keluar dari istana. Beberapa tahun kemudian, putra kembar Lee Hwi meninggal karena suatu penyakit. Istri Putra Mahkota menyembunyikan kematian putra kembarnya dan membawa putri kembarnya kembali ke istana dan membangkitkannya sebagai Pangeran Lee Hwi. Lee Hwi akhirnya menjadi putra mahkota, tetapi dia takut identitas aslinya akan terungkap. Karena rahasianya, Lee Hwi tidak dapat memiliki siapa pun yang dekat dengannya. Dia menyembunyikan emosinya dari orang lain dan dia membuat komentar menggigit. Jung Ji Woon adalah guru Lee Hwi. Jung Ji Woon berasal dari keluarga bangsawan. Dia tampan, pintar dan optimis yang menikmati hidup. Putra Mahkota Lee Hwi mengembangkan perasaan untuk Jung Ji Woon.\",\"jumpAddress\":\"tiktik://jump/detail?id=3252&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":20,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Romansa\"],\"title\":\"The King's Affection\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230508/1683535039562_973a30bdc27ab9efbd56e0af696dedfeking 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":33710,\"imageUrl\":\"https://img.netpop.app/cover/20230518/1684403707756_27f7e6054df424dc85dae578df12edc3King the Land.png\",\"introduction\":\"anggun, karismatik, cerdas, dan chic, pewaris kelompok King Goo Won memiliki segalanya kecuali kenangan ibunya. Dalam upaya untuk memulihkan ingatannya, ia kembali ke King Hotel. Dikenal sebagai King Hotel's Queen of Smiles and Hospitality, Cheon Sa-Rang bekerja naik dari meja depan untuk sekarang bekerja di ruang \\\"King the Land\\\" yang glamor, di mana ia bertemu Goo Won.\",\"jumpAddress\":\"tiktik://jump/detail?id=33710&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.5,\"showMark\":false,\"tagList\":[\"Komedi\",\"Romansa\",\"Remaja\"],\"title\":\"King the Land\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211020/1634703720647_b1279a0a73c1dc9bb5ed0947a4b71e22月光 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":3857,\"imageUrl\":\"https://img.netpop.app/cover/20220805/1659681106738_a222f2284d643da1ee149a1b0437b79bqKir5S1ka8UkWVo8aGW9T19IIHC.jpg\",\"introduction\":\"Ada putra mahkota yang jatuh cinta dengan kasim politiknya. Namun, Lee Yeong, sang pangeran, tahu dia tidak mungkin mengusulkan perasaannya. Sementara itu, Hong Raon, subjeknya, takut dia mungkin menunjukkan dirinya dalam warna sejati. Apakah mereka? Teman atau Pecinta? Haruskah mereka tidak bertemu satu sama lain?\",\"jumpAddress\":\"tiktik://jump/detail?id=3857&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":18,\"resourceStatus\":2,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Love in the Moonlight\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211122/1637576792041_7b9ec2013c4f5c68bdb32de712d713c84kUZ8OkcafQri7vn3ADLlDel9S0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6962,\"imageUrl\":\"https://img.netpop.app/cover/20211122/1637576788393_72605986103d00880c4a8263a45306ca7eVpYaLdFperkEV7LHlapQlN3Wu.jpg\",\"introduction\":\"Kang Eun Bo (Jin Se Yeon) adalah seorang wanita yang sedang dalam misi. Ketika saudara kembarnya dibunuh, dia bersumpah untuk menemukan pembunuh dan membawa mereka ke pengadilan. Tetapi selama era Dinasti Joseon yang sangat konservatif (1392-1910), satu-satunya wanita dengan kekuatan untuk memerintahkan perburuan untuk seorang pembunuh adalah ratu. Jadi Kang Eun Bo memutuskan untuk memenangkan gelar kerajaan yang berharga sehingga suatu hari dia bisa membalas kematian saudara perempuannya. Namun, untuk melakukannya, ia harus pertama -tama memenangkan hati Joseon King Yi Kyung (Kim Min Kyu). Yi Kyung tumbuh dalam masa kerusuhan politik yang hebat, dan kurang tertarik pada masalah hati - dan lebih peduli dengan membawa kedamaian ke ranah. Kang Eun Bo segera menemukan bahwa memenangkan bantuan raja tidak akan mudah - Pengadilan Kerajaan juga dibanjiri dengan wanita muda yang cantik, banyak dari mereka berharap untuk menikahi raja. Tetapi ketika raja tiba -tiba menyadari bahwa ia mengenali Kang Eun Bo dari mimpi, keduanya mulai membentuk ikatan yang tidak mungkin. Akankah Kang Eun Bo pernah menemukan pembunuh kembarnya? Dan bisakah cinta mekar antara jalanan Kang Eun Bo dan raja idealis?\",\"jumpAddress\":\"tiktik://jump/detail?id=6962&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Romansa\",\"Kostum\"],\"title\":\"Queen: Love and War\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211116/1637044350101_5cb8cf273bc59ac16878a0c79ea4ad3epefCiIoIrWglxwpoqIdnhL0IlGZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":6495,\"imageUrl\":\"https://img.netpop.app/cover/20220816/1660640540006_63ecd8e5f8899ae7c8450cfe575b9f86男孩.jpg\",\"introduction\":\"Kisah wanita itu menggambarkan perjuangannya untuk menjadi permaisuri dan melindungi cintanya.\",\"jumpAddress\":\"tiktik://jump/detail?id=6495&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":51,\"resourceStatus\":2,\"score\":8.5,\"showMark\":false,\"tagList\":[\"Drama\",\"Kostum\"],\"title\":\"Empress Ki\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210918/1631949534680_6cd691358fe70e502669c1f6b9f6523d3GC4cfyGuUkSx4EMZms2KccUGDg.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":2596,\"imageUrl\":\"https://img.netpop.app/cover/20240312/1710224016145_6da0171138678a44f9f17c71b44b1b421.jpg\",\"introduction\":\"Terletak jauh di jantung pusat kota Seoul yang berkembang pesat, hotel yang aneh, yang tidak pernah dilihatnya sebelumnya. Tua Beyond Beyond, bangunan telah berdiri untuk ribuan tahun, bukti yang selalu hadir untuk fakta bahwa segala sesuatu tidak selalu seperti apa yang mereka kelihatan. Menjalankan hotel ini adalah Jang Man Wol, seorang jiwa yang serakah dan mencurigakan yang telah menghabiskan seribu tahun terakhir bertindak sebagai CEO pendirian. Terkutuk untuk dosa dia tidak dapat lagi mengingat komitmen, Man Wol ditakdirkan untuk menghabiskan semua keabadian yang menjalankan pendirian aneh ini, melayani kebutuhan pelanggan yang paling aneh. Satu-satunya harapannya untuk melarikan diri adalah menemukan seseorang yang telah melakukan dosa yang lebih buruk daripada dirinya sendiri tetapi setelah seribu tahun, dia mulai kehilangan harapan. Namun, hal-hal mengambil giliran yang menarik ketika Goo Chan Seong muncul. Setelah manajer asisten termuda bekerja di perusahaan hotel multinasional, Chan Seong menemukan dirinya dipaksa untuk mengelola Hotel Del Luna karena kesepakatan yang dibuat ayahnya dengan Manusia tahun yang lalu. Stickler untuk peraturan dan peraturan, dia perfeksionis ke ekstrim tetapi mungkin persis seperti apa pendirian aneh ini dan kebutuhan CEO yang dikutuk.\",\"jumpAddress\":\"tiktik://jump/detail?id=2596&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Fantasi\",\"Horor\",\"Tegang\",\"Romansa\"],\"title\":\"Hotel Del Luna\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"奥斯卡获奖片单\",\"coverType\":1,\"homeSectionId\":84496,\"homeSectionName\":\"Oscar-winning films\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250922/1758510504484_4a3552c50042fb6183cd1840dc27ef27meIhAEsNJQ3hL8d7sJp4Kk1Sm2v.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":108164,\"imageUrl\":\"https://img.netpop.app/cover/20250922/1758510497145_84ab7ae6748512b6b5247771c31a1efaleQ7ilvHdnQWAB5JV3ATBnRyQSD.webp\",\"introduction\":\"Ketika musuh jahat mereka muncul kembali setelah 16 tahun, sekelompok mantan revolusioner bersatu kembali untuk menyelamatkan salah satu putri mereka sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=108164&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Thriller\"],\"title\":\"One Battle After Another\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250422/1745302357464_772415df7a7c422b59514f45f06defa6nAxGnGHOsfzufThz20zgmRwKur3.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":87083,\"imageUrl\":\"https://img.netpop.app/cover/20250422/1745302352754_a38174553827a1193cd18b32f522718byqsCU5XOP2mkbFamzAqbqntmfav.webp\",\"introduction\":\"Mencoba meninggalkan kehidupan mereka yang bermasalah, saudara kembar kembali ke kota asal mereka untuk memulai lagi, hanya untuk mengetahui bahwa kejahatan yang lebih besar sedang menunggu untuk menyambut mereka kembali.\",\"jumpAddress\":\"tiktik://jump/detail?id=87083&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Thriller\"],\"title\":\"Sinners\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260204/1770183915124_67a1ccd01d2366314c1930202b9fbaabyt9m5CiU2MZkQoNl1kqLPODNR4t.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":126651,\"imageUrl\":\"https://img.netpop.app/cover/20260204/1770183906919_15102639c11cef5bab96c4fcd52cc0c3vbeyOZm2bvBXcbgPD3v6o94epPX.webp\",\"introduction\":\"Setelah kehilangan putra mereka Hamnet karena wabah penyakit, Agnes dan William Shakespeare bergulat dengan kesedihan di Inggris pada abad ke-16. Sebagai seorang penyembuh, Agnes harus menemukan kekuatan untuk merawat anak-anaknya yang masih hidup sambil memproses kehilangannya yang menyedihkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=126651&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Sejarah\",\"Romansa\"],\"title\":\"Hamnet\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250809/1754732130873_ee94729cba7e8848a43e44dfccf5224c9ovPzyPMh7latEnFDKHM0SxxE3z.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":102282,\"imageUrl\":\"https://img.netpop.app/cover/20250809/1754732125580_fe4c012622ac28ae8c7631425fe702f4cpf7vsRZ0MYRQcnLWteD5jK9ymT.webp\",\"introduction\":\"Ketika semua kecuali satu anak dari kelas yang sama secara misterius menghilang pada malam yang sama pada waktu yang sama, sebuah komunitas dibiarkan mempertanyakan siapa atau apa yang ada di balik hilangnya mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=102282&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Weapons\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250612/1749701953550_31d539b3ab355a372cb597ac57568ed0oRxHRlSetf49evkXLsqkAzofJo2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":94485,\"imageUrl\":\"https://img.netpop.app/cover/20250612/1749701936568_f7d6523dd725a3ff347060c8c3efd527zT7Lhw3BhJbMkRqm9Zlx2YGMsY0.jpg\",\"introduction\":\" Kelompok gadis K-pop yang terkenal di dunia menyeimbangkan kehidupan mereka dalam sorotan dengan identitas rahasia mereka sebagai pemburu iblis.\",\"jumpAddress\":\"tiktik://jump/detail?id=94485&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Fantasi\",\"Musikal\",\"Tarian & Bernyanyi\"],\"title\":\"K-Pop: Demon Hunters\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251105/1762322971629_ce12fe9ea2383c77d471219f5e106082pN3eaCl3sqwrerU8UNdp40F2mK0.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":112979,\"imageUrl\":\"https://img.netpop.app/cover/20251105/1762322964743_b390f9ae7b73d1b0181a8206484e10a15bxrxnRaxZooBAxgUVBZ13dpzC7.webp\",\"introduction\":\"Keluarga Jake dan Neytiri bergulat dengan kesedihan setelah kematian Neteyam, bertemu dengan suku Na'vi baru yang agresif, Orang Ash, yang dipimpin oleh Varang yang berapi-api, saat konflik di Pandora meningkat dan fokus moral baru muncul.\",\"jumpAddress\":\"tiktik://jump/detail?id=112979&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Avatar: Fire and Ash\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251010/1760062423870_d821a3248f8a28ed7034366fdc9ff9c6sy7Y4jCDsGPCzoQIEmxqAgPjAgr.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":110036,\"imageUrl\":\"https://img.netpop.app/cover/20251010/1760062413739_5f21007846d041d9203188881e079d135fqmZYw3o22VoJpXx9bjQuc7ZPV.webp\",\"introduction\":\"Sutradara pemenang Oscar, Guillermo del Toro, mengadaptasi kisah klasik Mary Shelley tentang Victor Frankenstein, seorang ilmuwan brilian namun egois yang menghidupkan makhluk dalam eksperimen mengerikan yang pada akhirnya mengarah pada kehancuran sang pencipta dan ciptaannya yang tragis.\",\"jumpAddress\":\"tiktik://jump/detail?id=110036&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Sci-Fi\"],\"title\":\"Frankenstein\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250625/1750830492069_98799eaf916260bfb5e75cb12b36494dvqBmyAj0Xm9LnS1xe1MSlMAJyHq.webp\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":96536,\"imageUrl\":\"https://img.netpop.app/cover/20250625/1750830485823_5080f4b9d11653573bb7274c25c8b3a1vqBmyAj0Xm9LnS1xe1MSlMAJyHq.webp\",\"introduction\":\"Seorang pengemudi Formula Satu keluar dari masa pensiun untuk membimbing dan bekerja sama dengan pengemudi yang lebih muda.\",\"jumpAddress\":\"tiktik://jump/detail?id=96536&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Olahraga\"],\"title\":\"F1: The Movie\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241211/1733901022976_09b89f9ae08592022addb415c6cb8989阿诺拉横版.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":60357,\"imageUrl\":\"https://img.netpop.app/cover/20241211/1733901014870_411fbded9cb89aac4863f8fd417e81e5阿诺拉.jpg\",\"introduction\":\"Anora, seorang pekerja seks muda dari Brooklyn, bertemu dan secara impulsif menikahi putra seorang oligarki. Setelah berita mencapai Rusia, dongengnya terancam ketika orang tuanya berangkat ke New York untuk membuat pernikahan dibatalkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=60357&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Romansa\"],\"title\":\"Anora\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20250107/1736242891903_3411ae3a915196dba7ab60d4ec1985bb粗野派2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":66762,\"imageUrl\":\"https://img.netpop.app/cover/20250107/1736242888003_dc4c68263ac6b1ff3005631697c75797粗野派1.jpg\",\"introduction\":\"Ketika seorang arsitek visioner dan istrinya melarikan diri dari Eropa pasca-perang pada tahun 1947 untuk membangun kembali warisan mereka dan menyaksikan kelahiran Amerika Serikat modern, kehidupan mereka diubah selamanya oleh klien misterius dan kaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=66762&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\"],\"title\":\"The Brutalist\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241113/1731486068385_3863fddd9bbe573bdc33d81818adb875横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":55248,\"imageUrl\":\"https://img.netpop.app/cover/20241113/1731486061197_b7e2afe4f7077def7d65344b53ddf812竖.jpg\",\"introduction\":\"Di Meksiko, seorang pengacara menerima tawaran tak terduga untuk membantu bos kartel yang ditakuti pensiun dari bisnisnya dan menghilang selamanya dengan menjadi wanita yang selalu diimpikannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=55248&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Thriller\"],\"title\":\"Emilia Pérez\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241231/1735639713055_3b35599a0985c67d867dd6c5f0d2cf77nGC3ZkXEcjGbqAAonS1xn6gaNpb.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":65790,\"imageUrl\":\"https://img.netpop.app/cover/20241231/1735639709583_09791dd8a298989dc12cc66d79f3c78338lb62nJcNvVgCDkFt2wiVE0bX4.jpg\",\"introduction\":\"Sepupu yang tidak cocok bersatu kembali untuk tur melalui Polandia untuk menghormati nenek mereka yang tercinta, tetapi ketegangan lama mereka muncul kembali dengan latar belakang sejarah keluarga mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=65790&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\"],\"title\":\"A Real Pain\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241124/1732448789575_9974b34fdf11fe948d75958304dbd5c4uVlUu174iiKhsUGqnOSy46eIIMU.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":56650,\"imageUrl\":\"https://img.netpop.app/cover/20241124/1732448786243_ef8e5bb43a65cde15d92fa3dd153ddd6c5Tqxeo1UpBvnAc3csUm7j3hlQl.jpg\",\"introduction\":\"Elphaba, seorang wanita muda yang disalahpahami karena kulitnya yang hijau, dan Glinda, seorang gadis yang populer, menjadi teman di Universitas Shiz di tanah Oz. Setelah pertemuan dengan Wizard of Oz yang indah, persahabatan mereka mencapai persimpangan jalan.\",\"jumpAddress\":\"tiktik://jump/detail?id=56650&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.3,\"showMark\":false,\"tagList\":[\"Fantasi\",\"Tarian & Bernyanyi\",\"Romansa\"],\"title\":\"Wicked: Part One\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241008/1728374103546_a36e3e25b5e4bf3d45c9fe898fcdc8cc横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52615,\"imageUrl\":\"https://img.netpop.app/cover/20241008/1728374099585_43fd9d2e2c4095c548f2cbda3a9f4de7竖.jpg\",\"introduction\":\"Selebriti yang memudar mengambil obat pasar gelap: zat yang mereplikasi sel yang sementara menciptakan versi yang lebih muda dan lebih baik dari dirinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=52615&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"The Substance\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241103/1730612614083_b103c7691edc41e8711162b3577b08d6秘密会议 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":56648,\"imageUrl\":\"https://img.netpop.app/cover/20250425/1745551875512_e5339e788d52970e1d0773c1e072573fm5x8D0bZ3eKqIVWZ5y7TnZ2oTVg.webp\",\"introduction\":\"Ketika Kardinal Lawrence ditugaskan untuk memimpin salah satu peristiwa paling tertutup dan kuno di dunia, memilih paus baru, ia mendapati dirinya berada di pusat konspirasi yang dapat mengguncang fondasi Gereja Katolik.\",\"jumpAddress\":\"tiktik://jump/detail?id=56648&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Thriller\"],\"title\":\"Conclave\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240306/1709695752855_4485ffc4771685e40b2b6fddc3ba78bdxOMo8BRK7PfcJv9JCnx7s5hj0PX.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":41911,\"imageUrl\":\"https://img.netpop.app/cover/20240306/1709695749085_2b012159ffb01c17e478b48fe574a77a87jZEVp4FW6GwTx56mbbqIQQF75.jpg\",\"introduction\":\"Paul Atreides bersatu dengan Chani dan Fremen sambil membalas dendam terhadap para konspirator yang menghancurkan keluarganya.\",\"jumpAddress\":\"tiktik://jump/detail?id=41911&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Sci-Fi\"],\"title\":\"Dune: Part Two\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241018/1729232502756_d750f98b9c3a1f9267050b7128051b62横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53704,\"imageUrl\":\"https://img.netpop.app/cover/20241018/1729232498966_3e7c31c694077583a0beb4e79bf435df竖.jpg\",\"introduction\":\"Dunia tampaknya dihancurkan, dan sisa -sisa manusia ada di mana -mana. Rumah kucing dihancurkan oleh banjir besar, dan menemukan tempat berlindung di atas kapal yang penuh dengan hewan yang berbeda. Meskipun ada perbedaan di antara mereka, itu harus bekerja sama dengan mereka untuk menghadapi berbagai tantangan yang tidak diketahui.\",\"jumpAddress\":\"tiktik://jump/detail?id=53704&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Fantasi\"],\"title\":\"Flow\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"青少年奇幻剧\",\"coverType\":1,\"homeSectionId\":83943,\"homeSectionName\":\"Young adult fiction\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211214/1639473644770_1cc1f94dd7bc56a0cfa9fd35ddca28c2tuDhEdza074bA497bO9WFEPs6O6.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":8795,\"imageUrl\":\"https://img.netpop.app/cover/20211214/1639473730835_6a5fe7925358f01da7a554337c049bb7kzJip9vndXYSKQHCgekrgqbnUrA.jpg\",\"introduction\":\"Empat anak dari keluarga yang sama harus meninggalkan kota mereka karena pemboman WWII. Seorang wanita dan seorang profesor membawa anak-anak ke rumah mereka. Sambil bermain permainan petak umpet, anggota termuda dari keluarga, Lucy, menemukan lemari pakaian untuk bersembunyi. Dia berkeliling kembali dan kembali ke lemari pakaian dan menemukan tempat bernama Narnia. Setelah masuk dua kali, keempat anak pergi bersama untuk terakhir kalinya. Mereka bertarung serigala, bertemu dengan binatang yang berbicara, menghadapi penyihir putih jahat dan bertemu singa yang luar biasa bernama Aslan. Apakah ini akan menjadi akhir dari perjalanan mereka ke Narnia atau akan mereka tinggal?\",\"jumpAddress\":\"tiktik://jump/detail?id=8795&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2005,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Fantasi\"],\"title\":\"The Chronicles of Narnia: The Lion, the Witch and the Wardrobe\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241224/1735021829304_7c4f7d928e0ecf7e02bb8bd772873a9c怪奇物语5.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":63926,\"imageUrl\":\"https://img.netpop.app/cover/20251113/1763005100888_d8e24536e271a59b185c3f064e75e0f0cVxVGwHce6xnW8UaVUggaPXbmoE.webp\",\"introduction\":\"Setelah jatuhnya Hawkins, geng tersebut kembali bersama untuk terakhir kalinya tetapi apakah mereka sendirian?\",\"jumpAddress\":\"tiktik://jump/detail?id=63926&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Horror daftar Peringkat 4\",\"rankId\":57,\"rankType\":1},\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Horor\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Stranger Things Season 5\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220614/1655185291365_e1a1c69f4c4ce710bb791ea014cd1206bOpen7SOIrOBSVfC4ePNbwy3lrc.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":20655,\"imageUrl\":\"https://img.netpop.app/cover/20220614/1655185285905_82be7d4730553b373824ab3cb1802fbbyD3FHZ5gE0uKpBCYsxlq82UJCcP.jpg\",\"introduction\":\"Ditetapkan di New York City kontemporer, seorang remaja yang tampaknya biasa, Clary Fray, menemukan bahwa dia adalah keturunan dari Pemburu Bayangan, kader rahasia prajurit setengah malaikat muda yang terkunci dalam pertempuran kuno untuk melindungi dunia kita dari setan. Setelah ibunya menghilang, Clary harus bergabung dengan sekelompok Pemburu Bayangan, yang memperkenalkannya pada alternatif berbahaya New York yang disebut Dunia Bayangan, yang dipenuhi setan, penyihir, vampir, manusia serigala, dan makhluk mematikan lainnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=20655&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\"],\"title\":\"The Mortal Instruments: City of Bones\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211110/1636540316769_2cecf3b1c8890f7684d6ea8cac0d5044萨布丽娜的惊心冒险 第一季.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":1313,\"imageUrl\":\"https://img.netpop.app/cover/20211110/1636540294951_36dc6a04bda429423ca9d3a3ad82ca7a萨布丽娜的惊心冒险 第一季.png\",\"introduction\":\"Sebagai hari ulang tahunnya yang dekat, Sabrina harus memilih antara dunia penyihir dari keluarganya dan dunia manusia dari teman-temannya. Berdasarkan komik Archie.\",\"jumpAddress\":\"tiktik://jump/detail?id=1313&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":11,\"resourceStatus\":2,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Chilling Adventures of Sabrina Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220225/1645759005832_9d1a4b3b56f7e3eb9fd16bf9e70df237lfqR5Sx9zjdx90RlnM2Ycg7ECxF.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12914,\"imageUrl\":\"https://img.netpop.app/cover/20220225/1645758999314_be867b1ee7ed265b794e46404ed7b1a5tAu90qEpLqwqiZLsMqpaMVr55oN.jpg\",\"introduction\":\"Dalam menceritakan kembali buku Rick Riordans, \\\"Laut Monster\\\", Percy Jackson, ditemani teman-temannya Annabeth Chase, Clarisse La Rue dan Tyson, saudara tirinya, melakukan perjalanan ke lautan monster untuk mengambil bulu emas dan Simpan kemah setengah darah.\",\"jumpAddress\":\"tiktik://jump/detail?id=12914&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.8,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Keluarga\",\"Fantasi\"],\"title\":\"Percy Jackson: Sea of Monsters\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210929/1632885225553_61b0a39d1d8157f99369fa1bc29ba1faiYE1e8dbaQohYad8g6ySpmsSuj0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2815,\"imageUrl\":\"https://img.netpop.app/cover/20210929/1632888885266_7482bd6eff7ffd1fb7be3c0382f52e151ewwtjqAcwZ5abr2X7coGN0UwaI.jpg\",\"introduction\":\"Dalam masa depan distopsi, negara totaliter Panem dibagi menjadi 12 kabupaten dan kapitol. Setiap tahun dua perwakilan muda dari setiap kabupaten dipilih oleh lotere untuk berpartisipasi dalam permainan kelaparan. Bagian Entertainment, sebagian retribusi brutal untuk pemberontakan masa lalu, game yang disiarkan disiarkan disiarkan di seluruh Panem. 24 peserta dipaksa untuk menghilangkan pesaing mereka sementara warga Panem diharuskan untuk menonton. Ketika kakak laki-laki KATNISS berusia 16 tahun, Prim, terpilih sebagai perwakilan wanita Distrik 12, sukarelawan Katniss untuk menggantikannya. Dia dan rekan prianya, Peeta, diadu terhadap perwakilan yang lebih besar dan lebih kuat, beberapa di antaranya telah melatih untuk seluruh hidup mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=2815&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2012,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Hunger Games\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230119/1674113736203_f98bee724def4c2517a1fc372c1ae1d7tcF46ItZ4aVsUlkTal5ZKeYukNj.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":30445,\"imageUrl\":\"https://img.netpop.app/cover/20230119/1674113733372_76ad26614361ebf1e14613a439027891lxWSGo8D6MbFbQmM9tqhbaG80TP.jpg\",\"introduction\":\"Di London, di mana para pemburu hantu remaja yang paling berbakat melakukan usaha setiap malam menjadi pertempuran yang berbahaya dengan roh-roh yang mematikan, di tengah-tengah banyak agen perusahaan yang dikelola orang dewasa, satu berdiri sendiri: terlepas dari imperatif komersial atau pengawasan orang dewasa, startup kecil, dijalankan oleh dua remaja Anak laki -laki dan seorang gadis yang baru tiba, sangat berbakat secara psikis, trio pemberontak yang ditakdirkan untuk mengungkap misteri yang akan mengubah arah sejarah.\",\"jumpAddress\":\"tiktik://jump/detail?id=30445&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Horor\",\"Thriller\"],\"title\":\"Lockwood & Co\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220221/1645438458341_cf81282072a6cbc2304b6ae41f79137cnaudQkDg4MY2OFlYLBFU8Gq18Yt.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":12680,\"imageUrl\":\"https://img.netpop.app/cover/20220223/1645611639004_9d58ac0cd4362a8bf8969583dccc2bd2硫磺泉镇的秘密_12680竖版.png\",\"introduction\":\"Seorang anak laki-laki dan keluarganya pindah ke hotel yang diduga dihantui di tepi sebuah kota kecil.\",\"jumpAddress\":\"tiktik://jump/detail?id=12680&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":11,\"resourceStatus\":2,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Keluarga\",\"Tegang\"],\"title\":\"Secrets of Sulphur Springs\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220506/1651830499020_c79c19155f0bae9c7e9ccfcfa47dfe4auWHAG2WbZ76fX6QWWDW3X6QegTh.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":17421,\"imageUrl\":\"https://img.netpop.app/cover/20220506/1651830487599_df71b437548fb6c6828706f89d898600AlhcID6tU8GNkNQpXx3f9qDdDqd.jpg\",\"introduction\":\"Tinggal di antara serigala di hutan, anak muda Cub Mowgli dengan cepat belajar untuk menjalani kehidupan di antara paket serigala dan semua hewan yang mendiami hutan, tetapi ketika harimau yang jahat Shere Khan mengancam kehidupan Mowgli, Black Panther Bagheera menawarkan untuk membawa Mowgli ke a Desa Manusia Terdekat di mana dia akan aman dari murka harimau. Sepanjang jalan, Mowgli menjadi kusut dalam serangkaian pertemuan dengan ular licik bernama Kaa, gigantopithecus yang kejam bernama King Louie dan seekor beruang malas bernama Baloo, yang dengan cepat menjadi panduannya untuk 'kebutuhan beruang' kehidupan.\",\"jumpAddress\":\"tiktik://jump/detail?id=17421&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Keluarga\",\"Fantasi\"],\"title\":\"The Jungle Book\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240116/1705391660726_2ef7670c820ffc66653ffacbddbd916asyc4jp5vlEBlI4QX3RSTUk52EUN.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":40241,\"imageUrl\":\"https://img.netpop.app/cover/20240222/1708593699874_ac8543327ed17042a3c8e40b58cda7fej7hzLQlwBjapTVwZzsIocH43g4d.jpg\",\"introduction\":\" Adaptasi aksi langsung dari seri animasi yang berpusat pada petualangan Aang dan teman-temannya, yang berjuang untuk menyelamatkan dunia dengan mengalahkan Nation.\",\"jumpAddress\":\"tiktik://jump/detail?id=40241&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Suspense daftar Peringkat 2\",\"rankId\":56,\"rankType\":1},\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Drama\",\"Fantasi\",\"Tegang\"],\"title\":\"Avatar: The Last Airbender\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231010/1696938709804_ffd50d549a2545d3e507c0055e092853h72ewwxrJMfozSMLp7jmj2aq23p.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":37671,\"imageUrl\":\"https://img.netpop.app/cover/20231010/1696938707720_2025a60a1334fc2fe4f4fe9bd0b328ed1.jpg\",\"introduction\":\"Kelly Quinn dan dua teman baiknya, Darbie dan Hannah, menemukan buku masak Nenek Kelly di loteng dan menemukan beberapa resep aneh. Mereka segera mulai menyadari bahwa mereka memiliki buku yang penuh dengan resep ajaib.\",\"jumpAddress\":\"tiktik://jump/detail?id=37671&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2015,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":13,\"resourceStatus\":2,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Komedi\",\"Drama\",\"Keluarga\",\"Fantasi\"],\"title\":\"Just Add Magic Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220610/1654845241390_c29c89a1c865c8608f679ed8f90917b3aZQIZ5VdY4I1K6yAB3QFV01JOQu.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":20416,\"imageUrl\":\"https://img.netpop.app/cover/20220610/1654845238686_0a1ce6767014598797dcc0ea7332abcdlyaS7S4emzEaYUcSnCvyqfJpOcA.jpg\",\"introduction\":\"Di alam semesta paralel, Lyra Belacqua muda melakukan perjalanan ke ujung Utara untuk menyelamatkan sahabatnya dan anak-anak lain yang diculik dari eksperimen mengerikan oleh organisasi misterius.\",\"jumpAddress\":\"tiktik://jump/detail?id=20416&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Keluarga\",\"Fantasi\"],\"title\":\"The Golden Compass\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211217/1639712616316_6e2d9864d697ddbb3d4ab8667c041e1eqGqlWb5izTPtFngBWdbJAEmninR.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":9117,\"imageUrl\":\"https://img.netpop.app/cover/20211217/1639712609828_d596c9a34400d83db6d4ef5a0da85eb72lAItR73KJcH3uIBJNFCe7xyegc.jpg\",\"introduction\":\"Bumi dirusak oleh formal, ras alien tampaknya bertekad untuk menghancurkan kemanusiaan. Lima puluh tahun kemudian, orang-orang Bumi tetap bersatu untuk mencegah pemusnahan mereka sendiri dari spesies alien yang unggul secara teknologi ini. Ender Wiggin, bocah yang tenang tapi brilian, mungkin menjadi Juru Selamat Ras Manusia. Dia dipisahkan dari saudara perempuannya yang tercinta dan saudara lelakinya yang menakutkan dan dibawa ke sekolah pertempuran di orbit di sekitar Bumi. Dia akan diuji dan diasah menjadi pembunuh empatik yang mulai membenci apa yang dia lakukan ketika dia belajar untuk bertarung dengan harapan menyelamatkan Bumi dan keluarganya.\",\"jumpAddress\":\"tiktik://jump/detail?id=9117&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\"],\"title\":\"Ender's Game\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220314/1647221382075_fd3d0329b4b41f656cd52b0e0605a276ipikQozG6cAtLqhaFqRneA0LI4o.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":13861,\"imageUrl\":\"https://img.netpop.app/cover/20220314/1647221379780_aced21099fa5f9824564d99cff05061caNh4Q3iuPKDMPi2SL7GgOpiLukX.jpg\",\"introduction\":\"Di dunia yang dibagi dengan faksi berdasarkan kebajikan, Tris belajar dia berbeda dan tidak akan cocok. Ketika dia menemukan plot untuk menghancurkan divergen, Tris dan empat misterius harus mencari tahu apa yang membuat divergen berbahaya sebelum terlambat.\",\"jumpAddress\":\"tiktik://jump/detail?id=13861&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Tegang\",\"Sci-Fi\"],\"title\":\"Divergent\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230407/1680851802121_ca4de2862d1430719956d86bec8720ad横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":23401,\"imageUrl\":\"https://img.netpop.app/cover/20230407/1680851797720_6aa5de42c62644fef8af59aeeadf839d竖.jpg\",\"introduction\":\"Kehidupan Praremaja terbalik ketika dia berteman dengan gadis baru di sekolah dan mereka membayangkan dunia fantasi yang sama sekali baru untuk melarikan diri dari kenyataan.\",\"jumpAddress\":\"tiktik://jump/detail?id=23401&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Fantasi\"],\"title\":\"Bridge to Terabithia\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230428/1682672574876_deadd48db840eb46da92cad6787a7fe5彼得潘 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":33546,\"imageUrl\":\"https://img.netpop.app/cover/20230428/1682672572631_30c81ec74512dfefd368ef9e9ad28930彼得潘 竖.jpg\",\"introduction\":\"Berdasarkan novel J. M. Barrie Peter and Wendy dan terinspirasi oleh klasik animasi tahun 1953, Peter Pan dan Wendy adalah kisah abadi tentang seorang gadis muda yang, menentang keinginan orang tuanya untuk menghadiri sekolah asrama, bepergian dengan dua adik laki -lakinya ke Magical Neverland Neverland yang ajaib Neverland untuk ajaib Neverland untuk ajaib Neverland untuk ajaib Neverland untuk ajaib Neverland untuk ajaib Neverland untuk Magical Neverland ' . Di sana, dia bertemu dengan seorang anak laki -laki yang menolak untuk tumbuh dewasa, peri kecil dan seorang kapten bajak laut jahat, dan mereka segera menemukan diri mereka dalam sebuah petualangan yang mendebarkan dan berbahaya jauh, jauh dari keluarga mereka dan kenyamanan rumah.\",\"jumpAddress\":\"tiktik://jump/detail?id=33546&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":2.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Komedi\",\"Keluarga\",\"Fantasi\",\"Musikal\",\"Romansa\"],\"title\":\"Peter Pan & Wendy\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210928/1632823262523_fc0fbee62ce10ba0c95b34f4c65b9039暮光1 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2813,\"imageUrl\":\"https://img.netpop.app/cover/20210928/1632823259101_c5c87b541c83ad4443f18efa3329477c暮光1 竖.jpg\",\"introduction\":\"Bella Swan selalu sedikit berbeda. Jangan pernah berlari dengan kerumunan, Bella tidak pernah peduli dengan pas dengan gadis-gadis trendi di Phoenix, Arizona High School. Ketika ibunya menikah lagi dan Bella memilih untuk tinggal bersama ayahnya di kota kecil Hujan Forks, Washington, dia tidak berharap banyak hal berubah. Tetapi hal-hal berubah ketika dia bertemu Edward Cullen yang misterius dan menyilaukan. Untuk Edward tidak seperti anak laki-laki yang pernah dia temui. Dia tidak seperti orang yang dia temui, periode. Dia cerdas dan jenaka, dan dia sepertinya melihat langsung ke jiwanya. Dalam waktu singkat, mereka tersapu dalam romansa yang bersemangat dan jelas tidak ortodoks - tidak ortodoks karena Edward benar-benar tidak seperti anak laki-laki lain. Dia bisa berlari lebih cepat dari singa gunung. Dia bisa menghentikan mobil yang bergerak dengan tangan kosong. Oh, dan dia belum berusia sejak 1918. Seperti semua vampir, dia abadi. Itu benar - vampir. Tapi dia tidak punya taring - itu hanya di film. Dan dia tidak minum darah manusia, meskipun Edward dan keluarganya unik di kalangan vampir dalam pilihan gaya hidup itu. Ke Edward, Bella adalah hal yang dia tunggu 90 tahun untuk - jodoh. Tetapi semakin dekat yang mereka dapatkan, semakin Edward harus berjuang untuk menahan tarikan primal dari aromanya, yang dapat mengirimnya ke kegilaan yang tak terkendali. Entah bagaimana atau lainnya, mereka harus mengelola cinta mereka yang tak terkelola. Tetapi ketika pengunjung yang tak terduga datang ke kota dan menyadari bahwa ada manusia di antara mereka Edward harus berjuang untuk menyelamatkan Bella? Kisah modern, visual, dan visceral Romeo dan Juliet tentang urusan cinta terlarang - antara vampir dan fana.\",\"jumpAddress\":\"tiktik://jump/detail?id=2813&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2008,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Romansa\"],\"title\":\"Twilight\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240606/1717652913357_68a48b52aa271f641eb7ed7942b09fcc横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":45202,\"imageUrl\":\"https://img.netpop.app/cover/20240606/1717652909520_40f9346b0ee95314f3ebcb77cae3ebcb竖.jpg\",\"introduction\":\"Ditangkap dan dipenjara oleh orang -orang terakhir, seorang bocah rusa yang sangat istimewa bernama Gus mengambil tindakan untuk membantu teman -teman hibrida yang baru ditemukannya melarikan diri sebelum terlambat.\",\"jumpAddress\":\"tiktik://jump/detail?id=45202&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Sweet Tooth Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220927/1664249334076_fc8be2afa580e82c309088122e8e3050l56gka4kw2R4K7M4hSJRt12M6R6.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":25704,\"imageUrl\":\"https://img.netpop.app/cover/20220927/1664247714588_23f645095c8b308c54e017f0dbc7287ez7TQV2AwI2bLYyQ68QHxfAPfaJZ.jpg\",\"introduction\":\"Sebuah misteri misteri sleuthing, supernatural memetakan tahun Rabu Addams sebagai mahasiswa di Nevermore Academy. Upaya hari Rabu untuk menguasai kemampuan psikisnya yang muncul, menggagalkan pembunuhan mengerikan yang telah meneror kota setempat, dan memecahkan misteri supranatural yang melibatkan orang tuanya 25 tahun yang lalu - semuanya sambil menavigasi hubungannya yang baru dan sangat kusut di Nevermore.\",\"jumpAddress\":\"tiktik://jump/detail?id=25704&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Horror daftar Peringkat 2\",\"rankId\":57,\"rankType\":1},\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.1,\"showMark\":false,\"tagList\":[\"Komedi\",\"Keluarga\",\"Fantasi\",\"Horor\"],\"title\":\"Wednesday\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210928/1632813766008_c95def2f99ece8039d401ad9ab4f71b7画板 1 拷贝 31.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":850,\"imageUrl\":\"https://img.netpop.app/cover/20211105/1636116620720_ba7b1f0a25145e1c2657db2edd418732jUrDkXkVXe5cDIYA7Ss81P1CvtX.jpg\",\"introduction\":\"When a young boy disappears, his mother, a police chief and his friends must confront terrifying supernatural forces in order to get him back.\",\"jumpAddress\":\"tiktik://jump/detail?id=850&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.7,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Horor\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Stranger Things Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230818/1692325264107_d5d6013ef9aeaa5d1f2a8be2551573b5tXFjtSpK1W6XbEbBbVx5qDbYFj8.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":36451,\"imageUrl\":\"https://img.netpop.app/cover/20230818/1692325259499_46050c4051b43e8ceeb22e4a8d4104capbh99N5Uguoq8XWtOQmCf46eDp7.jpg\",\"introduction\":\"Kisah Mickey Bolitar dan kehidupan barunya dengan seorang ibu di rehabilitasi, seorang ayah yang mati, seorang bibi yang menjengkelkan, dan sebuah sekolah baru di New Jersey.\",\"jumpAddress\":\"tiktik://jump/detail?id=36451&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":6.4,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Drama\",\"Tegang\"],\"title\":\"Harlan Coben's Shelter\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211126/1637918895098_4cb337e30157a34e706f0ab04cca5c758IRT0XYSJuEbT7hqtOhNtoQMjjw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":7342,\"imageUrl\":\"https://img.netpop.app/cover/20211126/1637918894518_a8772bc2b3c61e043ac12e02abda8cbccmYt3dPxb4Ogj5vt3HJfJ6lHdeZ.jpg\",\"introduction\":\"Kebangkitan di lift, mengingat apa-apa tentang masa lalunya, Thomas muncul di dunia sekitar tiga puluh laki-laki remaja, semua tanpa ingatan masa lalu, yang telah belajar untuk bertahan hidup di bawah peraturan mereka sendiri di lingkungan yang sepenuhnya tertutup, bertahan di pertanian mereka sendiri dan persediaan. Dengan seorang bocah lelaki yang tiba setiap tiga puluh hari, kelompok itu telah berada di \\\"The Glade\\\" selama tiga tahun, berusaha menemukan cara untuk melarikan diri melalui labirin yang mengelilingi ruang hidup mereka (dipatroli oleh monster cyborg bernama 'Grivers'). Mereka telah mulai memberikan harapan ketika seorang gadis koma tiba dengan nada aneh, dan dunia mereka mulai berubah dengan anak laki-laki membaginya menjadi dua faksi: mereka yang mau mengambil risiko hidup mereka untuk melarikan diri dan mereka yang ingin bertahan dan bertahan hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=7342&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Maze Runner\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231123/1700725945364_846dfbc351465f444a4362e1f6340dc05a4JdoFwll5DRtKMe7JLuGQ9yJm.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":38639,\"imageUrl\":\"https://img.netpop.app/cover/20231211/1702273733222_8f13deb43a2a7f63bcb1d91cf09be6799cbeNkXx0OTC9pg30OZIWRi9HmL.jpg\",\"introduction\":\"Coriolanus Snow Mentors dan mengembangkan perasaan untuk penghormatan Distrik 12 wanita selama Hunger Games ke -10.\",\"jumpAddress\":\"tiktik://jump/detail?id=38639&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Sci-Fi\",\"Thriller\",\"Perang\"],\"title\":\"The Hunger Games: The Ballad of Songbirds & Snakes\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230223/1677144473780_7eeceb528de3a04c42355715d077e16e星尘 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":31459,\"imageUrl\":\"https://img.netpop.app/cover/20230223/1677144471065_6b67ada23ace3254920587a7cc2b2569星尘 竖.jpg\",\"introduction\":\"Perikop dari dunia ini ke kerajaan fantasi Stormhold adalah melalui pelanggaran di dinding di samping desa Inggris. Pada tahun 1800 -an, seorang anak laki -laki menjadi laki -laki ketika dia berkelana melalui pelanggaran dalam mengejar bintang yang jatuh, untuk membuktikan cintanya pada keindahan desa. Bintang itu bukan benjolan batu, itu seorang gadis, yvaine. Tristan, pemuda itu, bukan satu -satunya yang mencarinya: tiga penyihir, dipimpin oleh Lamia, ingin hatinya membuat mereka muda; Dan, putra -putra Raja Stormhold yang mati menginginkannya karena dia memegang rubi yang akan memberikan salah satu dari mereka gelar itu ke dalam takhta. Membantu Tristan adalah ibunya, korban mantra, dan bajak laut yang berputar-putar di langit. Akankah Tristan memenangkan cinta sejatinya?\",\"jumpAddress\":\"tiktik://jump/detail?id=31459&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.6,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Keluarga\",\"Fantasi\",\"Romansa\"],\"title\":\"Stardust\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211109/1636438906188_f3acda73b747d3269230a663358efb4a8z9qQkx7wA6FXpLV8Tiw9mfsRFK.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":892,\"imageUrl\":\"https://img.netpop.app/cover/20211109/1636438901936_ee0ad93c1116a45c911792062682af06uBVX9ZQuHAvnzihvKEKTSvjFJuW.jpg\",\"introduction\":\"Kekuatan gelap berkonspirasi melawan Orphan Mapmaker Alina Starkov ketika dia melepaskan kekuatan luar biasa yang bisa mengubah nasib dari dunia yang robeknya.\",\"jumpAddress\":\"tiktik://jump/detail?id=892&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Fantasi\",\"Tegang\"],\"title\":\"Shadow and Bone 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220225/1645758059880_543187314aab2db0cde2599d1ad57b8cq4PPJDf9zgo2cTQY27yl4KZhLSP.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12912,\"imageUrl\":\"https://img.netpop.app/cover/20220225/1645758055747_8667ead8e2d936e5ae00aa5bf1e92b8345FLfu74nXjhNHhbsTJ4ROsGLR5.jpg\",\"introduction\":\"Ketika baut petirnya dicuri, Zeus menuduh putra Poseidon Percy Jackson dan memberi putra Poseidon empat belas hari untuk mengembalikannya, kalau tidak, dia akan memulai perang di antara para dewa. Sementara itu remaja, Percy, yang menderita disleksia dan ADHD mengunjungi Museum Metropolitan Art dan diserang oleh kemarahan yang disamarkan di gurunya. Sahabatnya yang cacat secara fisik, Grover mengungkapkan bahwa Percy adalah seorang Demigod dan bahwa dia adalah pelindungnya dan gurunya, Brunner memberinya pena yang memberitahunya bahwa itu adalah senjata yang kuat. Mereka pergi ke rumah Percy dan bersama-sama dengan ibunya Sally mereka pergi ke kemah setengah darah. Namun Sally diserang oleh minotaur dan lenyap sebelum Percy dapat membantunya. Di kamp, ​​Percy berteman dengan Annabeth yang cantik; Ketika mereka diserang oleh Hades yang menginginkan baut pencahayaan untuk dirinya sendiri, Percy menemukan bahwa ibunya ada di dunia bawah dengan Hades. Percy memutuskan untuk melakukan perjalanan dengan pencarian berbahaya untuk mengambil petir dan menyelamatkan ibunya. Grover dan Annabeth bergabung dengannya dan Lukas memberikan perisainya sendiri untuk melindungi Percy. Apakah mereka akan berhasil?\",\"jumpAddress\":\"tiktik://jump/detail?id=12912&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2010,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.9,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Keluarga\",\"Fantasi\"],\"title\":\"Percy Jackson & the Olympians: The Lightning Thief\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230926/1695708429759_2dd07a03faa4709ab9f5239933e2517b横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":37372,\"imageUrl\":\"https://img.netpop.app/cover/20230926/1695708424838_c032090a3778f1b0167417eaf28dcf5b竖.jpg\",\"introduction\":\"Empat teman remaja, di perbatasan Prancis-Swiss, yang hidupnya terbalik oleh eksperimen LHC, collider partikel terbesar di dunia.\",\"jumpAddress\":\"tiktik://jump/detail?id=37372&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Fantasi\",\"Tegang\"],\"title\":\"Parallels\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220122/1642819892024_3931c9d1680702df3e253448c63f56edzyWbOvKCdA9V9P5xuUG2eiPYsUo.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":11198,\"imageUrl\":\"https://img.netpop.app/cover/20220122/1642819889196_e52192e3dcc8e4c691484c47d14c5937cN4Tb2WDhwJMlYLU9vKctunx4rg.jpg\",\"introduction\":\"Anak-anak keluarga Sayang menerima kunjungan dari Peter Pan, yang membawa mereka untuk tidak pernah mendarat di mana perang yang berkelanjutan dengan kapten bajak laut jahat yang sedang berlangsung.\",\"jumpAddress\":\"tiktik://jump/detail?id=11198&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2003,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Anime\",\"Drama\",\"Fantasi\"],\"title\":\"Peter Pan\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220210/1644459558302_c8128d9fe6d284e3cbf88148fa87b5776.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":12163,\"imageUrl\":\"https://img.netpop.app/cover/20220210/1644462566171_5f3b0d83cdd7a1e8c9f98b7cb7a54e8611.jpg\",\"introduction\":\"Bahannya yang gelap adalah salah satu karya besar fiksi imajinatif untuk anak-anak dan orang dewasa yang diterbitkan pada abad ke-20. Lampu utara memperkenalkan Lyra, seorang yatim piatu, yang tinggal di alam semesta paralel di mana ilmu pengetahuan, teologi dan sihir terjalin. Pencarian Lyra untuk seorang teman yang diculik mengungkap plot jahat yang melibatkan anak-anak yang dicuri, dan berubah menjadi pencarian untuk memahami fenomena misterius yang disebut debu. Di pisau halus dia bergabung dengan perjalanannya dengan Will, seorang bocah lelaki yang memiliki pisau yang dapat memotong jendela di antara dunia. Ketika Lyra mempelajari kebenaran tentang orang tuanya dan takdirnya yang dinubuatkan, kedua orang muda itu terjebak dalam perang melawan kekuatan selestial yang berkisar di banyak dunia dan mengarah pada kesimpulan yang mendebarkan di Spyglass Amber.\",\"jumpAddress\":\"tiktik://jump/detail?id=12163&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Keluarga\",\"Thriller\"],\"title\":\"His Dark Materials Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211208/1638956403416_1528a349c08bb92f4cb260c3fc0ea37enSJvwZziYaGMbftSDQqQ5GIb47a.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":8293,\"imageUrl\":\"https://img.netpop.app/cover/20211208/1638956400827_ab428473033a4a586a23b16120e6750c5AcRJx2OnTJnYXI3xecvktopnNz.jpg\",\"introduction\":\"Bagi Emma Swan, Hidup ini sama sekali kecuali akhir yang bahagia. Tetapi ketika dia bersatu kembali dengan Henry - putra yang dia berikan untuk diadopsi sepuluh tahun yang lalu - pada malam ulang tahunnya yang ke-28, semuanya berubah. Henry yang sekarang berusia 10 tahun sangat membutuhkan bantuan Emma karena dia percaya membaca buku dongeng bahwa dia adalah putri Salju Putih dan Pangeran menawan - yang mengirimnya pergi dari hutan yang terpesona untuk dilindungi dari a kutukan yang diberlakukan oleh ratu jahat. Emma awalnya menolak untuk mempercayai kata-kata kisah Henry tetapi segera menemukan bahwa kampung halamannya tentang StoryBrooke, Maine lebih dari kelihatannya. Karena dalam cerita bahwa semua karakter klasik yang kita kenal dibekukan pada waktunya tanpa ingatan tentang diri mereka sebelumnya - kecuali untuk Ratu jahat, yang adalah walikota Storybrooke dan ibu Regina Mills angkat Henry. Sekarang, sebagai \\\"pertempuran terakhir\\\" epik untuk masa depan kedua dunia mendekati, Emma harus menerima takdirnya dan mengungkap misteri di belakang tempat di mana dongeng akan dipercaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=8293&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2011,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":22,\"resourceStatus\":2,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Fantasi\"],\"title\":\"Once Upon a Time\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"邪典cult\",\"coverType\":1,\"homeSectionId\":84329,\"homeSectionName\":\"Film Kultus\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241126/1732591896098_f74a921cfdc16cd033094365da7c2d15横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":56834,\"imageUrl\":\"https://img.netpop.app/cover/20241126/1732591890913_f0395d7d7afaa4eb29dc701b7a29bfc9竖.jpg\",\"introduction\":\"Di masa depan dengan udara beracun, model mengambil obat yang menyebabkan transformasi. Dia mencoba membalikkannya tetapi mengetahui bahwa mutasinya bisa menyelamatkan umat manusia.\",\"jumpAddress\":\"tiktik://jump/detail?id=56834&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.5,\"showMark\":false,\"tagList\":[\"Aksi\",\"Sci-Fi\"],\"title\":\"The Fix\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241008/1728374103546_a36e3e25b5e4bf3d45c9fe898fcdc8cc横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52615,\"imageUrl\":\"https://img.netpop.app/cover/20241008/1728374099585_43fd9d2e2c4095c548f2cbda3a9f4de7竖.jpg\",\"introduction\":\"Selebriti yang memudar mengambil obat pasar gelap: zat yang mereplikasi sel yang sementara menciptakan versi yang lebih muda dan lebih baik dari dirinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=52615&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"The Substance\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221022/1666420247866_ffbaec5250cf93a1ea9b1a244429be696.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":26640,\"imageUrl\":\"https://img.netpop.app/cover/20221026/1666777272476_2128eb4d5c4ba84490de602c128271cbwRKHUqYGrp3PO91mZVQ18xlwYzW.jpg\",\"introduction\":\"Setelah dibangkitkan oleh entitas jahat, Art the Clown kembali ke kota Miles County yang pemalu di mana ia menargetkan seorang gadis remaja dan adik laki-lakinya pada malam Halloween.\",\"jumpAddress\":\"tiktik://jump/detail?id=26640&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.5,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Terrifier 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230724/1690186155296_b4b0911ce576bc4960dda677de07a261snbRXbkzEpc35mFDlwUg41cN8aw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":35831,\"imageUrl\":\"https://img.netpop.app/cover/20230724/1690186150596_a862c2a04c3fd1796fe09d21d5c6f1556ilIBfycIpd5TnnZo8EX7Dw6XlT.jpg\",\"introduction\":\"Matt dan Kate membeli rumah terpencil. Saat bergerak, mereka menemukan ruang aneh yang memberi mereka sejumlah keinginan materi yang tidak terbatas. Tetapi karena Kate mengalami dua keguguran, yang paling mereka rindukan adalah seorang anak.\",\"jumpAddress\":\"tiktik://jump/detail?id=35831&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Tegang\",\"Sci-Fi\"],\"title\":\"The Room\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211202/1638425540136_fc44e29055abcc859efbbdc724dab820dVOlJVHYRWx7DhMQRNLnbf5bT1q.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3941,\"imageUrl\":\"https://img.netpop.app/cover/20241014/1728877556499_b6d82e76a51b0acc5329b4720dfea267p2870563433.jpg\",\"introduction\":\"Setelah serangkaian kejahatan yang tidak dapat dijelaskan, seorang ayah dipersatukan kembali dengan putra yang telah hilang selama 10 tahun. Titane: logam yang sangat tahan terhadap panas dan korosi, dengan paduan kekuatan tarik tinggi.\",\"jumpAddress\":\"tiktik://jump/detail?id=3941&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Titane\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230327/1679907632003_a8532f2c72ef6bffcdd9ad5d21a8185c着魔 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":32528,\"imageUrl\":\"https://img.netpop.app/cover/20230327/1679914523180_4cfddf7dc03a5a79117ae9ed70d3100ep2604314064.png\",\"introduction\":\"Seorang wanita muda meninggalkan keluarganya karena alasan yang tidak ditentukan. Sang suami memutuskan untuk mencari tahu kebenaran dan mulai mengikuti istrinya. Pada awalnya, ia curiga bahwa seorang pria terlibat. Tetapi secara bertahap, ia mengetahui lebih banyak perilaku aneh dan insiden aneh yang menunjukkan sesuatu yang lebih dari sekadar hubungan cinta yang dimiliki.\",\"jumpAddress\":\"tiktik://jump/detail?id=32528&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1981,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"Possession\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221020/1666245428769_6dbbe005e74bd6411d3ce9b7b737d955微笑 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":26491,\"imageUrl\":\"https://img.netpop.app/cover/20221115/1668509881523_2482eb7fa718df3734314bce7d283468HbNIA43R6a9pcZXh3enCX0XfCg.jpg\",\"introduction\":\"Setelah menyaksikan kejadian traumatis yang aneh yang melibatkan seorang pasien, Dr. Rose Cotter mulai mengalami kejadian menakutkan yang tidak bisa dia jelaskan. Rose harus menghadapi masa lalunya yang bermasalah untuk bertahan hidup dan melarikan diri dari kenyataan barunya yang mengerikan.\",\"jumpAddress\":\"tiktik://jump/detail?id=26491&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Smile\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220223/1645602767385_c723a0a4cd82f332aa5b61a3ce16c2bcoPXWnMlpBoVrSeA9ElbnU13G1fV.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":12825,\"imageUrl\":\"https://img.netpop.app/cover/20220223/1645602760399_b17693f5ddaad3cca74ef40d96b22720kc8jT1MAiKM0iwdjAwC5lQrTNry.jpg\",\"introduction\":\"Seorang wanita muda, belajar untuk menjadi dokter hewan, mengembangkan keinginan untuk daging manusia.\",\"jumpAddress\":\"tiktik://jump/detail?id=12825&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2016,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.0,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"Raw\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240419/1713509191169_39428b759d26429b837e002fd166cee94yrOyO3N55XazHQXXYoqiiPQd40.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":43257,\"imageUrl\":\"https://img.netpop.app/cover/20240419/1713509185904_891e5f68fba682025eaf0e21447be1fczvunKmAOoBHRSNBpM5oWRNlv3Gg.jpg\",\"introduction\":\"Siaran televisi langsung pada tahun 1977 menjadi sangat salah, melepaskan kejahatan ke ruang tamu bangsa.\",\"jumpAddress\":\"tiktik://jump/detail?id=43257&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Late Night with the Devil\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240716/1721102148777_e68b92749c0a10f23872143bedbdf18aviKEEaaCaZ0hZ2nGuvIEozlLooL.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":46989,\"imageUrl\":\"https://img.netpop.app/cover/20240716/1721102137805_1ddc2c7bb3673cfadf5bab0b88b364fbArvoFK6nlouZRxYmtIOUzKIrg90.jpg\",\"introduction\":\"Pada 1980 -an Hollywood, bintang film dewasa dan aktris yang bercita -cita tinggi Maxine Minx akhirnya mendapatkan terobosan besar. Tetapi ketika seorang pembunuh misterius menguntit bintang -bintang Hollywood, jejak darah mengancam untuk mengungkapkan masa lalunya yang menyeramkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=46989&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"MaXXXine\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221021/1666348041104_61905d4e508a7b5f4436abb3d5704bc1珀尔 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":26629,\"imageUrl\":\"https://img.netpop.app/cover/20221021/1666348037689_f0ed59eaef9aad2da40a9ef31b348a8c珀尔 竖.jpg\",\"introduction\":\"Terperangkap di pertanian keluarganya yang terisolasi, Pearl harus merawat ayahnya yang sakit di bawah pengawasan ibunya yang taat dan pahit. Mendambakan kehidupan glamor seperti yang dia lihat di film-film, Pearl menemukan ambisi, godaan, dan represinya semua bertabrakan dalam kisah asal penjahat ikonik X ini.\",\"jumpAddress\":\"tiktik://jump/detail?id=26629&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Pearl\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240529/1716965345954_f01baad388372e2b81bb5948a867ddacq8IEFmEGGSGmAWfwRs23XDwdFN4.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":44783,\"imageUrl\":\"https://img.netpop.app/cover/20240529/1716965342180_01b8701a6ef9f45603c08acaf0a678eciADOJ8Zymht2JPMoy3R7xceZprc.jpg\",\"introduction\":\"Kisah asal usul prajurit Renegade Furiosa sebelum pertemuannya dan bekerja sama dengan Mad Max.\",\"jumpAddress\":\"tiktik://jump/detail?id=44783&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Furiosa: A Mad Max Saga\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220517/1652758686534_559c8e4264044cfe6108a2f15f19e194mmd1HnuvAzFc4iuVJcnBrhDNEKr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":18163,\"imageUrl\":\"https://img.netpop.app/cover/20220517/1652758678994_af05924646e2f0faf29480dd078d94b0b6ko0IKC8MdYBBPkkA1aBPLe2yz.jpg\",\"introduction\":\"Dihantui oleh blok penulis yang gigih, penulis yang bercita-cita tinggi dan pecandu alkohol yang pulih, Jack Torrance, menyeret istrinya, Wendy, dan putranya yang berbakat, Danny, up hotel yang terpencil di Colorado yang tertutup salju setelah mengambil pekerjaan sebagai pengasuh di luar musim. Saat Hotel Cavernous dimatikan untuk musim ini, manajer memberi Jack tur besar, dan koki fasilitas itu, Mr Hallorann yang menua, memiliki obrolan yang menarik dengan Danny tentang hadiah psikis langka yang disebut \\\"The Shining\\\", memastikan untuk memperingatkannya Tentang kamar-kamar hotel yang ditinggalkan, dan, khususnya, ruang terlarang 237. Namun, alih-alih mengatasi kebiasaan kreatif yang suram, sedikit demi sedikit, Jack mulai kehilangan pikiran, terperangkap dalam lingkungan badai salju yang tampaknya tak ada habisnya, dan a Penjara bisu raksasa penuh dengan kejadian aneh dan visi yang menakutkan. Sekarang, suara -suara yang tak henti -hentinya di dalam kepala Jack menuntut pengorbanan. Apakah Jack mampu membunuh? \\n\",\"jumpAddress\":\"tiktik://jump/detail?id=18163&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1980,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.4,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"The Shining\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241014/1728883677174_2fa4fdd2d3a44b3aa321df23c71f9727xPGiAPvneeicUxvJJfBpdnO99s.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53222,\"imageUrl\":\"https://img.netpop.app/cover/20241014/1728883673061_d58f47a1cf291b888fb4071b09bf54963pyE6ZqDbuJi7zrNzzQzcKTWdmN.jpg\",\"introduction\":\"Pasangan yang baru terlibat mengalami gangguan di daerah yang terisolasi dan harus mencari perlindungan di kediaman aneh Dr. Frank-N-Furter.\",\"jumpAddress\":\"tiktik://jump/detail?id=53222&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":1975,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Komedi\",\"Tarian & Bernyanyi\"],\"title\":\"The Rocky Horror Picture Show\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241014/1728883932929_f91db512fe237d2d0b893c72518f17af2eGDwLLsKKC8t4CdHO7CR2Amvi0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53224,\"imageUrl\":\"https://img.netpop.app/cover/20241014/1728884466148_5e8bc3f4dc652d97a273abb79ac6e33d81WxuJkCJSL._AC_UF894,1000_QL80_(1).jpg\",\"introduction\":\"Dilengkapi dengan senjata khusus, dua saudara perempuan mengambil bos cincin pemanen organ dan pasukan anteknya\",\"jumpAddress\":\"tiktik://jump/detail?id=53224&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Sci-Fi\"],\"title\":\"Rise of the Machine Girls\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"反乌托邦惊悚\",\"coverType\":1,\"homeSectionId\":84318,\"homeSectionName\":\"Horor Fiksi Ilmiah Distopia\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240715/1721031214037_c1344b923a808751e3d1709e722a1673aSvAKp2wCObifgR0tj9qYRNN1Fi.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":46946,\"imageUrl\":\"https://img.netpop.app/cover/20240715/1721031208282_6a76d4d107ad35677c5f34798f6573aetvIpBg12IIA5Dr9Sjn38ygS1vQp.jpg\",\"introduction\":\" Perjalanan fisik yang mendebarkan yang memungkinkan pendekatan ke kegelapan, di mana itu menakutkan untuk dilihat. Ini menarik bagi tanggung jawab sipil pemirsa dan memaksa mereka untuk menghadapi batas solidaritas mereka sendiri.\",\"jumpAddress\":\"tiktik://jump/detail?id=46946&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Platform 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241015/1728969787007_bb0692d82795ee8c83953ede254fe6585nw5fm2fUzTffKA7hqBy3sNWuXr.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53358,\"imageUrl\":\"https://img.netpop.app/cover/20241015/1728969733908_cdbd3b9e411afea90fc90a84c8781b17yiYbpmjmnjif9b4BNa02ObfhVfm.jpg\",\"introduction\":\"Metafora sosiopolitik dunia sebagai makan malam formal yang mengambil giliran yang tidak terduga ketika tidak ada lagi makanan untuk disajikan.\",\"jumpAddress\":\"tiktik://jump/detail?id=53358&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.7,\"showMark\":false,\"tagList\":[\"Anime\",\"Drama\"],\"title\":\"Dinner for Few\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221001/1664620538531_2dbd82ba65a978051fb3e44426aa2914维斯 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":25879,\"imageUrl\":\"https://img.netpop.app/cover/20221001/1664620535835_949081bf296311bccb572cde2d1f14a9维斯 竖.jpg\",\"introduction\":\"Setelah runtuhnya ekosistem Bumi, Vesper, seorang gadis berusia 13 tahun yang berjuang untuk bertahan hidup dengan ayahnya yang lumpuh, bertemu dengan seorang wanita dengan rahasia yang akan memaksanya untuk menggunakan kecerdasan, kekuatan, dan kemampuan bio-hackingnya untuk memperjuangkan kemungkinan tersebut. memiliki masa depan.\",\"jumpAddress\":\"tiktik://jump/detail?id=25879&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.6,\"showMark\":false,\"tagList\":[\"Petualangan\",\"Drama\",\"Sci-Fi\"],\"title\":\"Vesper\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231010/1696915042715_fbc88f52e2153d2b98867ff61a67e0a6横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":37635,\"imageUrl\":\"https://img.netpop.app/cover/20231010/1696915038965_c1b99dad85068fbd9289194f60370e4c竖.jpg\",\"introduction\":\"Selama perjamuan mewah, sebelas tamu yang dimanjakan berpartisipasi dalam apa yang tampaknya menjadi pembantaian gastronomi ritualistik. Di alam semesta yang aneh ini, urutan peristiwa yang tidak terduga mengacaukan simfoni kelimpahan yang tak ada habisnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=37635&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2008,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Film singkat\"],\"title\":\"Next Floor\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210929/1632885225553_61b0a39d1d8157f99369fa1bc29ba1faiYE1e8dbaQohYad8g6ySpmsSuj0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":2815,\"imageUrl\":\"https://img.netpop.app/cover/20210929/1632888885266_7482bd6eff7ffd1fb7be3c0382f52e151ewwtjqAcwZ5abr2X7coGN0UwaI.jpg\",\"introduction\":\"Dalam masa depan distopsi, negara totaliter Panem dibagi menjadi 12 kabupaten dan kapitol. Setiap tahun dua perwakilan muda dari setiap kabupaten dipilih oleh lotere untuk berpartisipasi dalam permainan kelaparan. Bagian Entertainment, sebagian retribusi brutal untuk pemberontakan masa lalu, game yang disiarkan disiarkan disiarkan di seluruh Panem. 24 peserta dipaksa untuk menghilangkan pesaing mereka sementara warga Panem diharuskan untuk menonton. Ketika kakak laki-laki KATNISS berusia 16 tahun, Prim, terpilih sebagai perwakilan wanita Distrik 12, sukarelawan Katniss untuk menggantikannya. Dia dan rekan prianya, Peeta, diadu terhadap perwakilan yang lebih besar dan lebih kuat, beberapa di antaranya telah melatih untuk seluruh hidup mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=2815&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2012,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.2,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Hunger Games\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240820/1724146784540_133a62b9c4394a813bac807a8615a166eQQQuvIrDNVM4wA1Qfzlqlv1QZ6.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":49578,\"imageUrl\":\"https://img.netpop.app/cover/20240820/1724146780559_e60ce2d116e8ffc95167d95a8cc98c93t6WP4kilpxPzHttWQjH5x7Iu6Bo.jpg\",\"introduction\":\"Sebuah dunia di mana operasi wajib menghapus perbedaan fisik dan membuat semua orang cantik.\",\"jumpAddress\":\"tiktik://jump/detail?id=49578&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Drama\",\"Fantasi\",\"Sci-Fi\"],\"title\":\"Uglies\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230926/1695718114589_fc5f96df6243bbe33e66726fd848bede9x5NZIBphD7pLI3GkKDeJrlI1jn.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":37390,\"imageUrl\":\"https://img.netpop.app/cover/20230927/1695796325773_85f1d1faa6d9cd48271e2277d7be81621.jpg\",\"introduction\":\"Film ini adalah tentang mereka yang selamat di kota yang pergi ke reruntuhan setelah gempa bumi besar -besaran menghancurkan semua beton. \\n\\n Tak muda adalah seorang pemimpin yang bekerja untuk melindungi apartemen Hwang Goong dari orang luar. Min Sung adalah gaji yang dipilih untuk membantu Tak muda dan menjadi semakin berani saat ia bertemu krisis. Myung Hwa adalah istri dan mantan perawat Min Sung, seorang karakter hangat yang peduli pada mereka yang terluka dalam situasi berbahaya.\",\"jumpAddress\":\"tiktik://jump/detail?id=37390&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Concrete Utopia\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220314/1647221382075_fd3d0329b4b41f656cd52b0e0605a276ipikQozG6cAtLqhaFqRneA0LI4o.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":13861,\"imageUrl\":\"https://img.netpop.app/cover/20220314/1647221379780_aced21099fa5f9824564d99cff05061caNh4Q3iuPKDMPi2SL7GgOpiLukX.jpg\",\"introduction\":\"Di dunia yang dibagi dengan faksi berdasarkan kebajikan, Tris belajar dia berbeda dan tidak akan cocok. Ketika dia menemukan plot untuk menghancurkan divergen, Tris dan empat misterius harus mencari tahu apa yang membuat divergen berbahaya sebelum terlambat.\",\"jumpAddress\":\"tiktik://jump/detail?id=13861&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Tegang\",\"Sci-Fi\"],\"title\":\"Divergent\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211126/1637918895098_4cb337e30157a34e706f0ab04cca5c758IRT0XYSJuEbT7hqtOhNtoQMjjw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":7342,\"imageUrl\":\"https://img.netpop.app/cover/20211126/1637918894518_a8772bc2b3c61e043ac12e02abda8cbccmYt3dPxb4Ogj5vt3HJfJ6lHdeZ.jpg\",\"introduction\":\"Kebangkitan di lift, mengingat apa-apa tentang masa lalunya, Thomas muncul di dunia sekitar tiga puluh laki-laki remaja, semua tanpa ingatan masa lalu, yang telah belajar untuk bertahan hidup di bawah peraturan mereka sendiri di lingkungan yang sepenuhnya tertutup, bertahan di pertanian mereka sendiri dan persediaan. Dengan seorang bocah lelaki yang tiba setiap tiga puluh hari, kelompok itu telah berada di \\\"The Glade\\\" selama tiga tahun, berusaha menemukan cara untuk melarikan diri melalui labirin yang mengelilingi ruang hidup mereka (dipatroli oleh monster cyborg bernama 'Grivers'). Mereka telah mulai memberikan harapan ketika seorang gadis koma tiba dengan nada aneh, dan dunia mereka mulai berubah dengan anak laki-laki membaginya menjadi dua faksi: mereka yang mau mengambil risiko hidup mereka untuk melarikan diri dan mereka yang ingin bertahan dan bertahan hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=7342&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2014,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.8,\"showMark\":false,\"tagList\":[\"Aksi\",\"Tegang\",\"Sci-Fi\",\"Thriller\"],\"title\":\"The Maze Runner\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211202/1638424084878_88eebd277e2db758ff36fc88e82be0cc9DET8yv7MYMwOWe1eR2CigFkev4.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3836,\"imageUrl\":\"https://img.netpop.app/cover/20220706/1657088045120_da79c8e03c3906f3127f84ee26165043雪国.jpg\",\"introduction\":\"Terletak pada tahun 2031, seluruh dunia dibekukan kecuali bagi mereka di atas salju. Selama tujuh belas tahun, para penyintas dunia berada di kereta yang meluncur di seluruh dunia menciptakan sistem ekonomi dan kelas mereka sendiri. Dipimpin oleh Curtis (Chris Evans), sekelompok warga kelas bawah yang tinggal di Squalor di belakang kereta bertekad untuk sampai ke depan kereta dan menyebarkan kekayaan di sekitar. Setiap bagian dari kereta menampung kejutan baru bagi kelompok yang harus bertarung melalui jalan mereka. Sebuah revolusi sedang berlangsung.\",\"jumpAddress\":\"tiktik://jump/detail?id=3836&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.1,\"showMark\":false,\"tagList\":[\"Aksi\",\"Drama\",\"Sci-Fi\"],\"title\":\"Snowpiercer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220314/1647222720406_597361ffa873c9586384234b2410cf4f40c44BcAfrv0VxuD89ZUsyyjqWI.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":13867,\"imageUrl\":\"https://img.netpop.app/cover/20220314/1647222718037_32dcc6e980e9fe326077f4eb8c9c2701bkuuvDoPkOJpg0ZDzHkUWt8ZG5A.jpg\",\"introduction\":\"Dalam waktu dekat, krisis keuangan akan menabrak Korea dan daerah kumuh muncul. Dari daerah-daerah itu, sekelompok orang muda melakukan kejahatan untuk bertahan hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=13867&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Kriminal\",\"Drama\",\"Sci-Fi\",\"Thriller\"],\"title\":\"Time to Hunt\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20221025/1666669148731_a2aae1e527f7282e577116c458aaaed98HbqSozBJxv6UldR9lMUECUlbLI.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":26727,\"imageUrl\":\"https://img.netpop.app/cover/20221025/1666669142135_653f5cd72ae69d59cac2c73875ade1beijJm0RSeKIr67qkHLtSmtigS6ra.jpg\",\"introduction\":\"Setelah kecelakaan kolosal dan misterius, seorang arsitek muda berbakat kembali ke akal sehatnya di dunia yang sangat aneh yang hanya menyerupai kenyataan. Dunia ini didasarkan pada kenangan orang -orang yang hidup di dalamnya - orang -orang yang saat ini menemukan diri mereka dalam koma yang mendalam. Ingatan manusia adalah hancur, kacau dan tidak stabil. Hal yang sama adalah koma - koleksi ingatan yang aneh dan ingatan - kota, gletser, dan sungai semuanya dapat ditemukan di satu ruangan. Semua hukum fisika dapat dilanggar. Arsitek harus mengetahui hukum dan peraturan koma yang tepat saat ia berjuang untuk hidupnya, memenuhi cinta dalam hidupnya dan terus mencari jalan keluar ke dunia nyata yang ia harus berkenalan dengan banyak hal setelah pengalaman itu setelah pengalaman dari koma.\",\"jumpAddress\":\"tiktik://jump/detail?id=26727&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2020,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Aksi\",\"Petualangan\",\"Fantasi\",\"Tegang\",\"Sci-Fi\"],\"title\":\"Coma\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"恐怖精选\",\"coverType\":1,\"homeSectionId\":83921,\"homeSectionName\":\"Film Horor Pilihan\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240424/1713927090187_ba14028059dff4d3a5baa0b08396f184oLu4szayJyyWk9E1QkuiJrErbcu.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":43361,\"imageUrl\":\"https://img.netpop.app/cover/20240424/1713927086313_4725e5bf96b7220a4dc8dee9f4735799nMmkLfWTpWrlfu6Qo5tpEXDDueE.jpg\",\"introduction\":\"\\\"Taste of Horror\\\" adalah seri Omnibus dengan total 10 film pendek. Setiap film disutradarai oleh sutradara yang berbeda menceritakan kisah terpisah. \\n\\n \\\"Tick Tock Tick Tock\\\" \\n Sebuah film horor emosional yang terjadi ketika seorang anak yang dilecehkan oleh seorang ibu bertemu hantu. Itu terjadi di era di mana minat pada kebugaran lebih tinggi dari sebelumnya dan ada hantu di gym yang hanya tersedia untuk penduduk. terluka selama operasi penyelamatan. \\n\\n \\\"pengiriman lengkap\\\" \\n sebuah cerita yang menggabungkan fenomena era taktik yang berinteraksi melalui perangkat dengan ketakutan. \\n\\n \\\"tantangan dong\\\" Jika mereka berhasil. \\n\\n \\\"Hei, Marmons\\\" \\n Sebuah cerita tentang hubungan pasangan yang sudah menikah putus karena kekayaan hari ini yang diceritakan oleh pembicara AI. \\n\\n \\\"Binatang berkaki empat\\\" \\n Sebuah kisah hantu di mana darah empat- Hewan berkaki meningkatkan nilai. \\n\\n \\\"gigi emas\\\" \\n Kisah ini tentang Jin Tae, yang mencuri gigi emas dari tubuh dan melunasi hutang penipuan investasinya. Seorang pria yang memenangkan jackpot tetap di sebuah motel selama sehari.\",\"jumpAddress\":\"tiktik://jump/detail?id=43361&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Taste of Horror\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241022/1729563000900_fd263950e0f1db0ff2c87782ac45f7451.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53784,\"imageUrl\":\"https://img.netpop.app/cover/20241022/1729562746360_f9a59041c767e0d18515e4d1b0c34572Bagman1.jpg\",\"introduction\":\"Ketika ancaman jahat dari masa kecilnya kembali untuk menghantuinya, seorang ayah sangat berjuang melawan ketakutan batinnya yang terdalam. Hanya saja kali ini, pertarungan bukan untuk dirinya sendiri; Ini untuk keluarganya.\",\"jumpAddress\":\"tiktik://jump/detail?id=53784&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.6,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Bagman\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230726/1690366398503_ed742cc7ded1b5221230f9740ac9fd72cFXjwxtsw5I0Nsdix2B78Xuv4WV.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":33469,\"imageUrl\":\"https://img.netpop.app/cover/20230427/1682567964021_3d1410eb135acab08a6d2bc08ace424e1.jpg\",\"introduction\":\"Follow Gabriele Amorth, the Vatican's leading exorcist, as he investigates the possession of a child and uncovers a conspiracy the Vatican has tried to keep secret.\",\"jumpAddress\":\"tiktik://jump/detail?id=33469&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.2,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"The Pope's Exorcist\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230321/1679392629175_226da51b85f229f52bb985c0653d097dly4vC69g78oVRogaSyBFDRu52kG.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":32356,\"imageUrl\":\"https://img.netpop.app/cover/20230327/1679907663395_1667ff993ffff4f3fd86f3011b8301df8.jpg\",\"introduction\":\"Grace, seorang dokter mata muda, dipanggil ke sebuah biara terpencil di Skotlandia setelah dugaan bunuh diri dari saudara lelakinya. Tidak mempercayai kisah gereja, Grace mencoba mencari tahu apa yang sebenarnya terjadi dengan bantuan pendeta Vatikan, Pastor Romero. Ketika dia menjelajahi serambi makam biara, dan tebing liar dan pantai-pantai berangin di dekatnya, dia tidak hanya mengungkap pembunuhan dan penistaan, tetapi kebenaran yang mengganggu tentang masa lalunya sendiri yang membawa trauma lama yang terkubur ke permukaan.\",\"jumpAddress\":\"tiktik://jump/detail?id=32356&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Consecration\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240910/1725973504476_076f3f9cab7f55921f1e7ac64e7d417dThe Well.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":51070,\"imageUrl\":\"https://img.netpop.app/cover/20240911/1726033896571_9498a97f148e2cfad88505048b2084b2zK1X5T7gAdXxLFhj0hYyCTVrvpU.jpg\",\"introduction\":\"Seorang pemulih seni pemula melakukan perjalanan ke sebuah desa kecil di Italia untuk mengembalikan lukisan abad pertengahan ke kejayaannya. Tanpa ia sadari, ia mempertaruhkan hidupnya dari kutukan jahat dan monster yang lahir dari mitos dan rasa sakit yang brutal.\",\"jumpAddress\":\"tiktik://jump/detail?id=51070&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.4,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The Well\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230726/1690363860638_387172359a91629cc56795c26088ed7cthe gust.png\",\"dramaTypeVo\":{\"dramaName\":\"Drama\",\"dramaType\":\"TV\"},\"id\":5852,\"imageUrl\":\"https://img.netpop.app/cover/20211109/1636453267240_501a66ef25a552d6571864dd4ab8a6415Y0apzo2oc0dBjDKQRZR7vjGRC7.jpg\",\"introduction\":\"Twenty years ago, Yoon Hwa Pyung (Kim Dong Wook), a young psychic born into a shaman family, learns about the powerful demon called \\\"Sohn\\\" (Guest). The demon is very powerful and possesses the power to control other demons and allow them to possess weak people. The possessed people then go mad, kill their families, and stab themselves in the eye. Hwa Pyung, Choi Yoon (Kim Jae Wook); a young boy born in a religious Catholic family, and Kang Gil Young (Jung Eun Chae); the daughter of a detective, fatefully meet when their families are killed by a demon. Twenty years later, the demon killings started again. Hwa Pyung is now a taxi driver who uses his power to seek out possessed people in order to help them, Yoon is a Catholic priest who is talented in exorcism, and Gil Young is a detective who doesn't believe in ghosts. The trio meets again and tries to work together to defeat \\\"Sohn\\\".\",\"jumpAddress\":\"tiktik://jump/detail?id=5852&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":8.2,\"showMark\":false,\"tagList\":[\"Kriminal\",\"Horor\"],\"title\":\"Son: The Guest\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241022/1729568696783_34479f6cd58119a3ea20c9e2530f0b55夺命假期1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":53787,\"imageUrl\":\"https://img.netpop.app/cover/20241022/1729568637406_831159beb470946fab8883c0ec08b80b夺命假期.jpg\",\"introduction\":\"Liburan akhir pekan sederhana keluarga Keenan benar -benar berubah menjadi liburan untuk mati, karena empat pembunuh gila memainkan permainan sadis mengunci hotel mereka dan bersaing untuk pembunuhan paling kreatif dari semua tamu.\",\"jumpAddress\":\"tiktik://jump/detail?id=53787&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.3,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Stream\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240410/1712756999489_4c383bce5eba2041c5dcc60f4d3c4031kic44ybFEIy12W1e9UXG0kcY9SB.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":42971,\"imageUrl\":\"https://img.netpop.app/cover/20240410/1712756996609_feb866e4aaab7e9c34ec355fce6be8eccIzk6GhxEZuweekGFXWEoAyuaMX.jpg\",\"introduction\":\"Seorang wanita muda Amerika dikirim ke Roma untuk memulai kehidupan yang melayani gereja, tetapi menemukan kegelapan yang menyebabkan dia mempertanyakan imannya dan mengungkap konspirasi menakutkan yang berharap dapat membawa kelahiran penjelmaan jahat.\",\"jumpAddress\":\"tiktik://jump/detail?id=42971&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.9,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The First Omen\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240715/1721056916580_ba4ac3608ff1b54e9af6176ee3432cachK0FFcNLaJYWcDCrN254nE1Lqvk.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":46970,\"imageUrl\":\"https://img.netpop.app/cover/20240715/1721056912854_e9a89e8e5ab233719cbd9dcaa10533ectxGP42LsRw0ylD7X4f6MvxHD2js.jpg\",\"introduction\":\"Hobi Realtor Jung Tae menyelinap ke rumah -rumah orang asing dan mengintip ke dalam kehidupan mereka. Suatu hari, wajah yang tidak dikenal di daerah itu menarik perhatiannya: Bintang Instagram jadi Ra. Ajaibnya, jadi Ra meninggalkan rumahnya di agensi Jung Tae, dan Jung Tae mengunjungi rumahnya kapan pun dia bisa, senang dan bersemangat. \\n\\n Seperti hari lainnya, Jung Tae melakukan kunjungan lain dan menemukan apa yang tidak dia harapkan: orang mati Tubuh So Ra. Lebih buruk lagi, semua bukti mengatakan bahwa Jung Tae adalah penjahat. Bisakah dia menemukan pembunuh yang sebenarnya dan membersihkan namanya?\",\"jumpAddress\":\"tiktik://jump/detail?id=46970&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Following\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230912/1694484303913_128fcb1d763fd706d6e4488423c5bb20lDCIQ1Qe7cRnhZ4ybQVVEbadMZ.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":36999,\"imageUrl\":\"https://img.netpop.app/cover/20230912/1694487258427_1134648908160a4a34e679d842dc2bb9x5sWVFL78X6KC4dil7QSOqCDqS8.jpg\",\"introduction\":\"Ketika sekelompok teman menemukan cara menyulap roh menggunakan tangan yang dibalsem, mereka menjadi ketagihan pada sensasi baru, sampai salah satu dari mereka melangkah terlalu jauh dan membuka pintu ke dunia roh yang memaksa mereka untuk memilih siapa yang harus dipercaya: orang mati atau yang mati atau yang mati atau hidup.\",\"jumpAddress\":\"tiktik://jump/detail?id=36999&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.4,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Talk to Me\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230829/1693289695258_e3bbe22d426a0d649fd1dbc1968dcf5amK0a3t62lM8ho3mmvBWf6NxdWvw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":36698,\"imageUrl\":\"https://img.netpop.app/cover/20230829/1693292215889_a100628d777529f30bc8f0bb3e7282d22ikRhOvFwvKlSBm3btJiQh5YtGL.jpg\",\"introduction\":\"Masih belum pulih dari kematian tragis ibu mereka, seorang gadis remaja dan adik perempuannya mendapati diri mereka diganggu oleh kehadiran sadis di rumah mereka dan berjuang untuk mendapatkan perhatian dari ayah mereka yang berduka sebelum terlambat.\",\"jumpAddress\":\"tiktik://jump/detail?id=36698&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.1,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"The Boogeyman\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241008/1728374103546_a36e3e25b5e4bf3d45c9fe898fcdc8cc横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52615,\"imageUrl\":\"https://img.netpop.app/cover/20241008/1728374099585_43fd9d2e2c4095c548f2cbda3a9f4de7竖.jpg\",\"introduction\":\"Selebriti yang memudar mengambil obat pasar gelap: zat yang mereplikasi sel yang sementara menciptakan versi yang lebih muda dan lebih baik dari dirinya.\",\"jumpAddress\":\"tiktik://jump/detail?id=52615&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.9,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\"],\"title\":\"The Substance\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220812/1660287133313_f3be1494d2db0e65d479b92f4ee9f04c修女 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":23677,\"imageUrl\":\"https://img.netpop.app/cover/20220812/1660295047753_504470f14f746e5d18cdc240903ea5fdxiunv.png\",\"introduction\":\"Saat dalam perjalanan akhir pekan, sekelompok teman terpaksa mencari perlindungan di dalam penjara yang ditinggalkan di mana seorang biarawati bernama Sister Monday pernah ditugaskan. Selama berada di penjara, Sister Monday dicurigai membunuh para tahanan yang sedang menjalani hukuman mereka tetapi sebelum dia dapat diinterogasi, dia menghilang. Begitu berada di dalam penjara, kenangan masa kecil yang menakutkan dan konflik keluarga muncul ke permukaan untuk kelompok di mana mereka dipaksa untuk menghadapi ketakutan mereka. Jangan LINTAS Sister Monday. Dia akan MANGSA untuk Anda.\",\"jumpAddress\":\"tiktik://jump/detail?id=23677&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.7,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"A Nun's Curse\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230426/1682490518750_98573ac648a96583cbc059336f0272c5鬼玩人 横.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":33422,\"imageUrl\":\"https://img.netpop.app/cover/20230426/1682490516056_618c67fe3575cce11328b78a5c20fc15鬼玩人 竖.jpg\",\"introduction\":\"Menggerakkan aksi keluar dari hutan dan masuk ke kota, \\\"Evil Dead Rise\\\" menceritakan kisah dua saudara perempuan yang terasing, diperankan oleh Sutherland dan Sullivan, yang reuni dipotong oleh kebangkitan daging yang memiliki setan, mendorong mereka ke dalam primal Pertempuran untuk bertahan hidup saat mereka menghadapi versi keluarga yang paling mengerikan yang bisa dibayangkan.\",\"jumpAddress\":\"tiktik://jump/detail?id=33422&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":4,\"rankDesc\":\"American daftar Peringkat 5\",\"rankId\":148,\"rankType\":1},\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Evil Dead Rise\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240415/1713165559461_cc9dc80af14dfb738d0bb80155cb1cb7b4xaqpUZFUkgyJ1VcFEPXmDML34.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":43089,\"imageUrl\":\"https://img.netpop.app/cover/20240415/1713165553203_031473ed5d5e978a0b0b13a67f66e78blbOyeiiRYAE6Nm2e7xiNAAaRwZB.jpg\",\"introduction\":\"Seorang wanita muda mewarisi pub yang rusak dan menemukan rahasia gelap di dalam ruang bawah tanahnya - Baghead - makhluk yang menggeser bentuk yang akan membuat Anda berbicara dengan orang -orang terkasih yang hilang, tetapi bukan tanpa konsekuensi.\",\"jumpAddress\":\"tiktik://jump/detail?id=43089&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.8,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Baghead\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20241003/1727946686762_3a08d73e49e260e93cf948128b4abfc68uFSl2oHyUNikI93nRar6ZZVnSG.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52467,\"imageUrl\":\"https://img.netpop.app/cover/20241003/1727946683197_a7f2111a938ee722c8005c14fc66a2a1mk8dEpi3ePHyDbbkBuEbGtksjWX.jpg\",\"introduction\":\"Keluarga menavigasi dinamika tahun 1960 -an yang bergejolak. Ibu memisahkan dari suami alkoholik. Anak perempuan bergulat dengan perubahan. Hadiah Antik Ayah menyembunyikan kekuatan gelap yang merusak semua.\",\"jumpAddress\":\"tiktik://jump/detail?id=52467&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.5,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The Curse of the Necklace\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220708/1657265412030_c07aea874e867f07fe0f41c0d4835fdavqEX1uF3Spl12rOACQ3gJ6j4MSR.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":21791,\"imageUrl\":\"https://img.netpop.app/cover/20220711/1657507366202_c775380c6be44bb731c3515ac645de3f咒.jpg\",\"introduction\":\"Nama saya Ruo-Nan, alasan saya membuat video ini adalah saya berharap orang-orang dapat membantu saya mengangkat kutukan yang diberikan kepada putri saya setelah menonton apa yang saya katakan. Karena ketidaktahuan saya, saya tidak pernah berpikir bahwa tindakan sayalah yang membawa kutukan. Konten berikut mungkin mengandung bahaya dan risiko tersembunyi tertentu, termasuk saya menceritakan kembali pertemuan mengerikan yang terjadi enam tahun lalu. 6 tahun yang lalu, saya mendirikan studio \\\"Ghostbusters\\\" dengan pacar saya dan teman sekelas jurnalisme saya, kami bertujuan untuk memecahkan mitos takhayul dan membagikannya di blog kami. Suatu hari, pemberitahuan mendesak datang dari rumah pacar saya, memanggilnya untuk kembali untuk ritual pemujaan kuno yang terjadi setiap dua dekade sekali di keluarganya. Berpikir itu akan menjadi bahan yang layak untuk blog kami, kami semua tiba untuk ritual. Sayangnya kami kemudian mengalami kutukan kuno paling mengerikan di sana.\",\"jumpAddress\":\"tiktik://jump/detail?id=21791&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2022,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.5,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Incantation\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[{\"id\":2,\"name\":\"lgbt\",\"sort\":2}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240423/1713851558553_31284199b623f42a5d270aa4f756cb58xLfP6FxRyN4EkqcqYJIaR8s7QdM.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":43334,\"imageUrl\":\"https://img.netpop.app/cover/20240423/1713851555212_34d0b0b43db3c996bc1e9bcb5d6554c5p7jyFWiLyHPttqYBFAlLJwtYTYH.jpg\",\"introduction\":\"Manajer gym Lou Falls untuk Jackie, seorang binaragawan yang melewati kota dalam perjalanan ke kompetisi di Las Vegas.\",\"jumpAddress\":\"tiktik://jump/detail?id=43334&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Romansa\",\"Thriller\",\"LGBTQ\"],\"title\":\"Love Lies Bleeding\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230915/1694748876674_01d64ea659595ec274a5ed8506d8e614qaykuAPezrTTQAWDjP8lLnV3cJx.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":37128,\"imageUrl\":\"https://img.netpop.app/cover/20230915/1694748869031_c36c47005a96ccbd2c51c4e2bf0b07c03VGfYYIyYyJcsjRajBT0FwEMv9J.jpg\",\"introduction\":\"Supernatural Horror, berdasarkan fenomena online eponymous, sebuah ritual yang dilakukan di lift, di mana para pemain mencoba melakukan perjalanan ke dimensi lain menggunakan serangkaian aturan yang dapat ditemukan online.\",\"jumpAddress\":\"tiktik://jump/detail?id=37128&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.2,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Elevator Game\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230509/1683624888876_93509a743f16987f4d5f5df91ec8034ctNVri3EgpXQ0wXmGJqIvTvd6kGj.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":33750,\"imageUrl\":\"https://img.netpop.app/cover/20230509/1683624876598_207402ee84ccfd17aaf2243c7dd60f68mGt7LOIjgmBIXsNyHgUSZGBaZZK.jpg\",\"introduction\":\"Nell Margaret Sweetzer yang berusia tujuh belas tahun ditemukan benar-benar gila ketika mencoba menjelaskan kepemilikannya oleh iblis yang disebut Abalam. Setelah perawatan medis dan psikologis, ia dikirim ke Deveraux Transition House di New Orleans yang dikelola oleh Frank Merle, yang membantunya memulai kehidupan baru. Dia menemukan pekerjaan sebagai pembantu rumah tangga hotel, berteman dengan teman sekamar barunya, dan mengembangkan naksir rekan kerjanya, Chris. Segera, Nell menyadari bahwa dia dihantui oleh orang -orang dari kultusnya ... dan dengan kekuatan jahat yang sama yang pernah merasukinya. Ketika Nell bertemu Miss Cecile, dia memberi tahu Nell bahwa dia telah mengikutinya sejak rumah sakit. Lebih lanjut, dia mengungkapkan bahwa dia termasuk dalam urutan sekte tangan kanan, dan bahwa mereka dapat melindunginya dari kejahatan dalam upaya untuk mengalihkan ramalan kiamat. Akankah Nell menerima bantuan, dan dilindungi dari kekuatan Abalam yang sangat kuat dan jahat - atau akankah dia datang untuk menerima ... dirinya sendiri?\",\"jumpAddress\":\"tiktik://jump/detail?id=33750&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2013,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":4.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"The Last Exorcism Part II\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230823/1692782242910_4d1d8198955d37c5be1f2ce17967859eiP1i4fztyyPNRy2C6Rv3oZuyAIz.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":36590,\"imageUrl\":\"https://img.netpop.app/cover/20230823/1692782236213_31796e7768f27b0f8520b06715501923wdk78Zn12fAYTpCB8lvRtCfOLPx.jpg\",\"introduction\":\"Yaşar, seorang pemuda, mengalami kesulitan setelah kematian ayahnya. Warisannya dari ayahnya menyebabkan Yaşar memiliki masalah dengan ibu tirinya. Sementara itu, Yaşar mengetahui bahwa saudara iparnya, Canan, yang tinggal di rumah yang sama, jatuh cinta padanya. Sementara Yaşar berurusan dengan masalah warisan dan ipar perempuannya, ia menyadari bahwa ada beberapa peristiwa aneh di rumah. Putri Dark Efsun yang mengalami gangguan mental Yasar adalah masa lalu yang gelap digali, membuat segalanya menjadi lebih rumit. Rasa sakit keluarga, yang harus menghadapi masa lalu yang gelap dari Efsun, hanyalah permulaan bagi mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=36590&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2019,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.1,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"Siccin 6\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20230713/1689233216390_1af40bbade83f343bbc3b0ca66dcdb60hPcP1kv6vrkRmQO3YgV1H97FE5Q.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":35569,\"imageUrl\":\"https://img.netpop.app/cover/20230713/1689233214502_c859bf4deb6d0f077686c30a31eed8bbuS1AIL7I1Ycgs8PTfqUeN6jYNsQ.jpg\",\"introduction\":\"Lamberts harus masuk lebih dalam ke lebih jauh dari sebelumnya untuk menempatkan setan mereka untuk beristirahat sekali dan untuk semua.\",\"jumpAddress\":\"tiktik://jump/detail?id=35569&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Insidious: The Red Door\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240910/1725970242384_29b3580f3202e976eef3dbd37a087a13愿者安息.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":51068,\"imageUrl\":\"https://img.netpop.app/cover/20240910/1725970220340_24ce5099f9ebae65e8f3de0622d87714愿者安息1.jpg\",\"introduction\":\"Cemal mengemudikan mobil jenazah untuk mencari nafkah. Ia ditugaskan untuk membawa jenazah seorang gadis muda secara diam-diam atas permintaan keluarganya. Suatu malam, ia mendengar erangan aneh dari belakang truk, meskipun gadis itu tidak memiliki denyut nadi.\",\"jumpAddress\":\"tiktik://jump/detail?id=51068&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.2,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The Funeral\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211021/1634813575246_8dd724f0f5c815e301627d94552afb9b9SISFlf6SEiIb7CMk8h0Gu3NYow.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":4088,\"imageUrl\":\"https://img.netpop.app/cover/20220715/1657871642257_76e988b56b1a72a0fed8e19ffaf03b53灵.jpg\",\"introduction\":\"Kisah mengerikan tentang warisan dukun di wilayah Isan di Thailand. Apa yang bisa memiliki anggota keluarga mungkin bukan dewi yang mereka lakukan.\",\"jumpAddress\":\"tiktik://jump/detail?id=4088&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The Medium\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20231024/1698129663367_5fa5af414d0949a4c4d57e96f1f9a5e74DpVWbDmYanToTTkTp2SQLQX1p4.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":37983,\"imageUrl\":\"https://img.netpop.app/cover/20231024/1698134586419_91b351aef1cac0a048d7728f6ccc08623.jpg\",\"introduction\":\"Ketika putri ayah tunggal Victor Fielding, Angela, dan temannya Katherine, menunjukkan tanda -tanda kepemilikan setan, itu melepaskan rangkaian peristiwa yang memaksanya untuk menghadapi sifat kejahatan. Takut dan putus asa, dia mencari Chris MacNeil, satu -satunya orang yang hidup yang menyaksikan hal seperti itu sebelumnya.\",\"jumpAddress\":\"tiktik://jump/detail?id=37983&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2023,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":5.1,\"showMark\":false,\"tagList\":[\"Horor\"],\"title\":\"The Exorcist: Believer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20220816/1660633424466_ef6e2bf45e660440b463c3ac2bb1d095满足.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":5898,\"imageUrl\":\"https://img.netpop.app/cover/20220816/1660633391249_756c2eb5ffc828753974a4da517090fb111.jpg\",\"introduction\":\"Ketika ibunya yang sakit mental meninggal, Annie (Toni Collette), suaminya (Gabriel Byrne), Son (Alex Wolff), dan putri (Milly Shapiro) semua meratapi kehilangannya. Keluarga beralih ke sarana yang berbeda untuk menangani kesedihan mereka, termasuk Annie dan putrinya berdua menggoda dengan supranatural. Mereka masing-masing mulai mengganggu, pengalaman dunia lain terkait dengan rahasia jahat dan trauma emosional yang telah melewati generasi keluarga mereka.\",\"jumpAddress\":\"tiktik://jump/detail?id=5898&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2018,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":7.3,\"showMark\":false,\"tagList\":[\"Drama\",\"Horor\",\"Thriller\"],\"title\":\"Hereditary\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20211201/1638354670565_8894fb136d2ee35d7b6494edede38217l5BNdekn7J7sYUOKruCMJfMzOQO.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":3436,\"imageUrl\":\"https://img.netpop.app/cover/20220908/1662626046963_429613a3db1b16616383e6e5a846a33ehFVWRWDRMdH6piSb3NmSq0E9kh7.jpg\",\"introduction\":\"Every town has its own ghost story, and a local folktale around Ravens Fair is about a ventriloquist named Mary Shaw. After she went mad in the 1940s, she was accused of kidnapping a young boy who yelled out in one of her performances that she was a fraud. Because of this she was hunted down by townspeople who in the ultimate act of revenge, cut out her tongue and then killed her. They buried her along with her \\\"children,\\\" a handmade collection of vaudeville dolls, and assumed they had silenced her forever. However, Ravens Fair has been plagued by mysterious deaths around them after Mary Shaws collection has returned from their graves and have come to seek revenge on people that killed her and their families. Far from the pall of their cursed hometown, newlyweds Jamie and Lisa Ashen thought they had established a fresh start, until Jamie's wife is grotesquely killed in their apartment. Jamie returns to Ravens Fair for the funeral, intent on unraveling the mystery of Lisa's death. Once reunited with his ill father, Edward, and his father's new young bride, Ella, Jamie must dig into the town's bloody past to find out who killed his wife and why. All the while, he is doggedly pursued by a detective who doesn't believe a word he says. As he uncovers the legend of Mary Shaw, he will unlock the story of her curse and the truth behind the threat from a rhyme in his childhood: if you see Mary Shaw and scream, she'll take your tongue. And the last thing you will hear before you die...is your own voice speaking back to you.\",\"jumpAddress\":\"tiktik://jump/detail?id=3436&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2007,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.2,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"Dead Silence\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240927/1727416810317_587c2b5993c745a9a82c585ac5ea9ad1hJpTWcFlucIOOo5WEuYN0w69fJi.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52088,\"imageUrl\":\"https://img.netpop.app/cover/20240927/1727416622910_f1279a6b7108f61fbd869d5f69cd5640j7ncdqBVufydVzVtxmXu8Ago4ox.jpg\",\"introduction\":\"Penulis Ben Mears kembali ke rumah masa kecilnya di tanah Yerusalem untuk mencari inspirasi untuk buku berikutnya hanya untuk menemukan kota kelahirannya sedang dipangsa oleh vampir yang haus darah.\",\"jumpAddress\":\"tiktik://jump/detail?id=52088&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Salem's Lot\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20240927/1727416230492_16c328cbdd93aa861e81fdbb2eac3d2e9FX2a2QHtDPavm3LaUvX5Upzie0.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":52081,\"imageUrl\":\"https://img.netpop.app/cover/20240927/1727418714142_088ac85df183effd57d27a2ba5be9ce24m11l8D2Jn8D1mAJephVpN2d7ir.png\",\"introduction\":\"Seorang penari yang berjuang mendapati dirinya tertarik pada kekuatan gelap oleh pasangan aneh yang menjanjikan ketenarannya.\",\"jumpAddress\":\"tiktik://jump/detail?id=52081&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2024,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":false,\"tagList\":[\"Horor\",\"Thriller\"],\"title\":\"Apartment 7A\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20210916/1631758572383_ebc05942820aed700c2955655b2bf247qi6Edc1OPcyENecGtz8TF0DUr9e.jpg\",\"dramaTypeVo\":{\"dramaName\":\"Film\",\"dramaType\":\"MOVIE\"},\"id\":1809,\"imageUrl\":\"https://img.netpop.app/cover/20210916/1631774008641_31fcbf6bc9d4ecc787dbbfbca667ebb0xbSuFiJbbBWCkyCCKIMfuDCA4yV.jpg\",\"introduction\":\"Kisah mengerikan tentang teror, pembunuhan dan kejahatan yang tidak diketahui yang mengejutkan bahkan mengalami penyelidik paranormal kehidupan nyata Ed dan Lorraine Warren. Salah satu kasus paling sensasional dari file-file mereka, itu dimulai dengan pertarungan untuk jiwa seorang bocah lelaki, kemudian membawa mereka melampaui apa pun yang pernah mereka lihat sebelumnya, untuk menandai pertama kalinya dalam sejarah AS bahwa seorang tersangka pembunuhan akan mengklaim iblis kepemilikan sebagai pertahanan.\",\"jumpAddress\":\"tiktik://jump/detail?id=1809&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2021,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.3,\"showMark\":false,\"tagList\":[\"Horor\",\"Tegang\",\"Thriller\"],\"title\":\"The Conjuring: The Devil Made Me Do It\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":null}]},\"msg\":\"Success\"}"
          },
