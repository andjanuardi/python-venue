,\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260520/1779258745389_1a5dad664bb6e7bb5537a13aac72937281bhMcDJFZNCKjm1wRTPIHpWWwa.webp\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":142847,\"imageUrl\":\"https://img.netpop.app/cover/20260520/1779258738399_31105b13d0f635b09ceff343470cfc8dvjUWJXdd275UYJDzblaNPZp9319.webp\",\"introduction\":\"Follows Jack Ryan who reunites with CIA operatives to navigate a treacherous web of betrayal against an enemy who knows their every move, facing a past they thought was long put to rest.\",\"jumpAddress\":\"tiktik://jump/detail?id=142847&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Action\"],\"title\":\"Tom Clancy's Jack Ryan: Ghost War\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260515/1778822866107_0bb1b383049a4714db109fa8f33e74da痴迷u.webp\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":141411,\"imageUrl\":\"https://img.netpop.app/cover/20260515/1778822860081_e792d33f12a4a133c8d236225ff13297痴迷.webp\",\"introduction\":\"After breaking the mysterious \\\"One Wish Willow\\\" to win his crush's heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"jumpAddress\":\"tiktik://jump/detail?id=141411&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":8,\"rankDesc\":\"HOT list Top 1\",\"rankId\":12,\"rankType\":1},\"releaseTime\":2025,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":8.0,\"showMark\":true,\"tagList\":[\"Horror\",\"Thriller\"],\"title\":\"Obsession\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[{\"id\":1,\"name\":\"18+\",\"sort\":1}],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260415/1776232128945_551660f0bd29f707afb5e2cc195ed5233ANXZWhhcqPAh0q6nRZ979TIwxC.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":134108,\"imageUrl\":\"https://img.netpop.app/cover/20260415/1776232884490_8f538e1269ff6af2d325e6c6ea97d549tcPc5ZMBO4y2BtCJMe3o2nwZb2B.webp\",\"introduction\":\"A college-set romantic drama chronicling the unexpected love story between a music student and the university's star hockey player, exploring themes of love and the complexities of adulthood through deep friendships and enduring bonds.\",\"jumpAddress\":\"tiktik://jump/detail?id=134108&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Romance list Top 1\",\"rankId\":53,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":8.0,\"showMark\":true,\"tagList\":[\"Romantic\",\"Sports\",\"Sex\",\"Romantic\"],\"title\":\"Off Campus Season 1\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260430/1777538187284_a180864e96cdfccc08a1c1e3f853cdd41oJSeynxNfGJm83de6bi83LetZR.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":138045,\"imageUrl\":\"https://img.netpop.app/cover/20260430/1777538180216_f03e671f7ba8cdc55a93c1f049704d791oJSeynxNfGJm83de6bi83LetZR.webp\",\"introduction\":\"Shen is a woman from a wealthy family who enters into a seemingly perfect marriage with Phoem, a promising government officer. Their relationship begins with happiness, but things take a turn when Phoem leaves for an extended work assignment abroad.\\n\\nDuring his absence, Shen faces constant pressure and mistreatment from her mother-in-law. The difficult environment leaves her emotionally drained, holding on only to the hope of her husband’s return. However, when Phoem comes back, he is no longer the same person. His cold and distant behaviour deepens Shen’s loneliness.\\n\\nIn this vulnerable state, she finds comfort in Tone, a driver whose presence brings emotional support and complicates her situation.\",\"jumpAddress\":\"tiktik://jump/detail?id=138045&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":37,\"rankDesc\":\"HOT list Top 4\",\"rankId\":108,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romantic\"],\"title\":\"Whisper of Desire\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260512/1778566066865_89de154aee7ffd7f110542d5ba6a800fqO55CD8tgVL1T4WKn6zYFFiD6lL.webp\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":140099,\"imageUrl\":\"https://img.netpop.app/cover/20260512/1778566063866_d797fbead08753b89902387771104469aM4L8vrhtoL0sUwXEre56MqiEEO (1).webp\",\"introduction\":\"As Frank Castle searches for meaning beyond revenge, an unexpected force pulls him back into the fight.\",\"jumpAddress\":\"tiktik://jump/detail?id=140099&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Action\",\"Adventure\",\"Crime\",\"Thriller\"],\"title\":\"The Punisher: One Last Kill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260311/1773215631881_ef6840aee6fc1d38c58cc00643821d202cr7imTLVSSrzgL3bFKAMCMdgKw.jpg\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":129733,\"imageUrl\":\"https://img.netpop.app/cover/20260311/1773215626174_f300bf1e318aebbb5a0124fc309561a5k0eYP3ZsgJDGl0ZN28lzJVCIqQI.jpg\",\"introduction\":\"Follows Miranda Priestly's struggle against Emily Charlton, her former assistant turned rival executive, as they compete for advertising revenue amidst declining print media while Miranda nears retirement.\",\"jumpAddress\":\"tiktik://jump/detail?id=129733&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":6.7,\"showMark\":true,\"tagList\":[\"Comedy\"],\"title\":\"The Devil Wears Prada 2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260327/1774590487580_05b36767e3bdf78bac545c09e03ec405夺命许愿i.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":131547,\"imageUrl\":\"https://img.netpop.app/cover/20260327/1774590480281_2b963fa4e27b9939d50ca15a6cf6c88f夺命许愿.webp\",\"introduction\":\"Follows five friends in high school who receive a death warning from a mysterious wish-granting app. As they struggle to escape their fates, they uncover chilling truths that connect the app to the sudden death of a classmate.\",\"jumpAddress\":\"tiktik://jump/detail?id=131547&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Horror\",\"Thriller\"],\"title\":\"If Wishes Could Kill\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260407/1775539414400_cbe885ea4913a32b447f88c08cff39ed1RdC0xql5PNZZGr71LzJ5Ipvn08.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":132450,\"imageUrl\":\"https://img.netpop.app/cover/20260407/1775539405949_368fba1a65237d1161a0f3b83c529c841RdC0xql5PNZZGr71LzJ5Ipvn08.webp\",\"introduction\":\"Unravel the mystery of a town in middle U.S.A. that imprisons everyone who enters. As the residents struggle to maintain a sense of normality and seek a way out, they must also survive the threats of the surrounding forest.\",\"jumpAddress\":\"tiktik://jump/detail?id=132450&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":25,\"rankDesc\":\"Horror list Top 1\",\"rankId\":57,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":7.8,\"showMark\":true,\"tagList\":[\"Horror\",\"Suspense\",\"Sci-Fi\",\"Thriller\"],\"title\":\"From Season 4\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260211/1770789870948_156f86f5c9c457ff7053fe4c7cb745ddkDAx8SQyyxA7QinSVdxpF3kWV2s.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":127330,\"imageUrl\":\"https://img.netpop.app/cover/20260211/1770789868351_74fd86cf4c95c8b0dc54125533815f0cAnVaPUXPKDNOnZbUh6b7WZ5IeMW.webp\",\"introduction\":\"Set in Hawkins, Indiana in the winter of 1985, where Eleven and her friends unravel a paranormal mystery terrorizing their town.\",\"jumpAddress\":\"tiktik://jump/detail?id=127330&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Anime\",\"Fantasy\",\"Horror\"],\"title\":\"Stranger Things: Tales From '85\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260416/1776319445930_436a0ad380fe0fc983ed85f0dfad50859te2BRQjaNeXxvQKD0c3v63UJ8Q.webp\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":134412,\"imageUrl\":\"https://img.netpop.app/cover/20260416/1776319441228_fddc9f705e090f9ff1e306c051334d65gPiyTLo5GGwtJl0L8TlaJF9r0KE.webp\",\"introduction\":\"Avatar Aang, the world's last Airbender, learns of an ancient power that could save his culture from extinction. With the help of his friends, he embarks on a global quest to find it before it falls into the wrong hands.\",\"jumpAddress\":\"tiktik://jump/detail?id=134412&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Adventure\",\"Anime\",\"Fantasy\"],\"title\":\"The Legend of Aang: The Last Airbender\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":0,\"contentType\":\"MOVIE\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260410/1775804990492_079cda3dc6e92ddaa08988695e9d01572.jpg\",\"dramaTypeVo\":{\"dramaName\":\"movie\",\"dramaType\":\"MOVIE\"},\"id\":133185,\"imageUrl\":\"https://img.netpop.app/cover/20260410/1775804986642_5020bbc3a0d5ae3b74cab095dc2ce98e1.jpg\",\"introduction\":\"When a Category 5 hurricane decimates a coastal town, the storm surge brings devastation, chaos and something far more frightening: hungry sharks.\",\"jumpAddress\":\"tiktik://jump/detail?id=133185&type=0\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":null,\"resourceStatus\":null,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Horror\",\"Thriller\"],\"title\":\"Thrash\",\"titleCenter\":false,\"videoName\":\"\"}],\"refRedirectUrl\":\"\",\"sequence\":16},{\"bannerProportion\":null,\"category\":\"\",\"cnName\":\"热门韩剧\",\"coverType\":1,\"homeSectionId\":22238,\"homeSectionName\":\"Hot K-Drama\",\"homeSectionType\":\"SINGLE_ALBUM\",\"recommendContentVOList\":[{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260622/1782107010933_37005fcf54ae30b4648abee901a54d10kyLSLOrqUIehjHhgoBB7ZSmMmC7.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":151436,\"imageUrl\":\"https://img.netpop.app/cover/20260622/1782107007659_782b71d1e780e190dff93db150eea2b7oH31gBIhmx4kPnLxAPrsQM0BJGI.webp\",\"introduction\":\"A romantic comedy exploring the lives of two individuals at different crossroads in life. Reporter Lee Jae has transitioned from a fearless teen driven by dreams to a disillusioned 20-something facing the harsh realities of life, and finally becoming an adult in her 30s who feels like she has settled into mediocrity. On the other hand, film director Su Bin has lived a life designed by his parents during his teenage years but eventually broke free and charged through his 20s and ultimately achieved the dream he had longed for by his 30s.\",\"jumpAddress\":\"tiktik://jump/detail?id=151436&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Romance list Top 2\",\"rankId\":91,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":2,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"Dream to You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260529/1780038846695_dca1b008418f156b2790700f8b7901373whXtw6VDKdEJFxWf2FpYmyncKC.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":145736,\"imageUrl\":\"https://img.netpop.app/cover/20260529/1780038842786_5c335a6c0fa115ab30d65d820e529fb3e32Dr0lZ9SI1wjPyYhQZfUak8OJ.webp\",\"introduction\":\"Depicts the story of Cha Ji Yun, a seventh-year office worker stuck in a career slump, who chooses her prickly boss, Kang Si U, as the \\\"lesser evil\\\" to avoid the \\\"worst.\\\" Together, they grow to become each other's irreplaceable \\\"best.\\\"\",\"jumpAddress\":\"tiktik://jump/detail?id=145736&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Romance list Top 1\",\"rankId\":91,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romantic\"],\"title\":\"See You at Work Tomorrow!\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260513/1778655196183_6e7ba7eb22aea1764eb938621d0497eb医到孤岛爱上你R.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":140636,\"imageUrl\":\"https://img.netpop.app/cover/20260513/1778655188571_281a577d6f58b403f07a9a8c8afc3aa8医到孤岛爱上你.webp\",\"introduction\":\"In South Korea, military service is mandatory for all men. But a select few-like privileged medical students-can serve as public health doctors instead. This is the story of those privileged few. Do Ji Ui, a plastic surgeon, is assigned to Pyeondong-do-an isolated island no one wants to go to. From the very first day, ominous signs begin to appear. Can he survive a full year on this hellish island and make it out alive-or will the island break him before he can hold the line?\",\"jumpAddress\":\"tiktik://jump/detail?id=140636&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Romance list Top 4\",\"rankId\":91,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"Doctor on the Edge\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260623/1782201487333_90c9ef079b15fa2768364e75292901d25x5zahudYXOa40lAnfehfm6mxhl.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":151917,\"imageUrl\":\"https://img.netpop.app/cover/20260623/1782201499271_2ab885e9959e5fd0ed607f22524f9989《The Husband》海报标题方案.png\",\"introduction\":\"On the verge of divorce, Kang Tae Ju's life is shattered when his wife, Ko Se Yun, is kidnapped. As he desperately searches for her, he is implicated in a murder-for-hire case and becomes a wanted fugitive. Hunted by the police, he finds himself locked in a deadly battle with No Man Hui, a seemingly ordinary man whose calm exterior conceals a terrifying cruelty.\\n\\nAs Se Yun struggles to escape her captors, she encounters the mysterious Kim Gyeong Ae, whose kindness hides an unsettling aura and whose role in the case remains uncertain. With hidden motives and dangerous secrets gradually coming to light, Tae Ju is pushed to increasingly perilous extremes and must uncover the truth behind the kidnapping before he loses the woman he is about to leave.\",\"jumpAddress\":\"tiktik://jump/detail?id=151917&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Horror list Top 2\",\"rankId\":126,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romantic\",\"Thriller\"],\"title\":\"The Husband\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260623/1782193185060_8f1ed73276dabf044876fe9da9484639共感细胞C.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":151745,\"imageUrl\":\"https://img.netpop.app/cover/20260623/1782193178867_4c4529419789c72ed19c9745a1e57df1共感细胞.webp\",\"introduction\":\"An emotional transference romance that unfolds as a woman who denies empathy and a man who bears the burden of empathy come to share each other's emotions.\",\"jumpAddress\":\"tiktik://jump/detail?id=151745&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Fantasy list Top 3\",\"rankId\":129,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":4,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Fantasy\",\"Romantic\"],\"title\":\"Love in Sync\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260509/1778295704672_4c145b6f129aee0b4138220bd400038ddjcyiVVoCxd8VsZos0dVHC3NkDX.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":139293,\"imageUrl\":\"https://img.netpop.app/cover/20260509/1778295695340_400de285014f2ade4035f454ecf2e226riDCDdOG8Hf7P1PP987dQrmzxrO.webp\",\"introduction\":\"A reminder life story drama in which the chairman of a leading conglomerate, known as the god of business, gets into an accident and ends up living an unwanted second life.\",\"jumpAddress\":\"tiktik://jump/detail?id=139293&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"HOT list Top 5\",\"rankId\":11,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"Reborn Rookie\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260529/1780040516753_1694d6e5bd0977b8ca2c763dc15e49662.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":145772,\"imageUrl\":\"https://img.netpop.app/cover/20260529/1780040511549_7a21d34cf52bb5783fd31ab02caedcc6处理图片文字.png\",\"introduction\":\"Heo Mun O is a professor of Korean literature at a prestigious university and a novelist who has effectively failed as a writer, having published only one book. He lives without much achievement, forcing himself to endure disappointment and disgust toward students who cannot even complete a proper sentence. He can never forget the words of his successful writer friend, Kim Su Hun, who coldly evaluated his novels in his youth, and as a result, he became unable to write after that.\",\"jumpAddress\":\"tiktik://jump/detail?id=145772&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularity above 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"Notes from the Last Row\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260414/1776156314636_508d6bb076bc5798b28319e70c6bf7d2美丽新世界8.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":133958,\"imageUrl\":\"https://img.netpop.app/cover/20260429/1777446637172_4adf7d66f630dcf6a333e732e5f6bd98rYLQbyIvbEd0lF84iXrx7CbPcBB.jpg\",\"introduction\":\"A legendary villain from the Joseon era is reincarnated in the body of a struggling modern actress and clashes with a cold, calculating chaebol heir, igniting an intense love-hate romance that transcends centuries.\",\"jumpAddress\":\"tiktik://jump/detail?id=133958&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Fantasy list Top 1\",\"rankId\":129,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":14,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Fantasy\",\"Romantic\"],\"title\":\"My Royal Nemesis\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260422/1776839481450_0da52669359c55e9c494477a922068b1pHAT3mdcpekMkWjZ9e6kSHtJhDP.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":135652,\"imageUrl\":\"https://img.netpop.app/cover/20260422/1776839476276_374e5458188100aad389e012c28f9353nmYgPJiZebWUtL6D72D0Qp9ce0H.webp\",\"introduction\":\"Kang Seong Jae is a soldier and gets transferred to the Gangrim Post, where First Sergeant Park Jae Yeong, First Lieutenant Cho Ye Rin and military cook Yun Dong Hyeon are stationed.\",\"jumpAddress\":\"tiktik://jump/detail?id=135652&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularity above 50000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\"],\"title\":\"The Legend of Kitchen Soldier\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260327/1774589966096_76e9190e31e48edc95e99d255ee16e66kRAfOvGkDiclmRbjD1UuLfQL29I.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":131543,\"imageUrl\":\"https://img.netpop.app/cover/20260327/1774589957984_d438410789b553775b86ab667b0a33c792NDWxXuC5vrvdwiF1aU6RqID58.webp\",\"introduction\":\"After being demoted from the elite audit team to internal conduct supervisor, No Gi-joon finds himself reluctantly teamed up with the ruthless and eccentric audit director Joo In-ah, who harbors a secret of her own.\",\"jumpAddress\":\"tiktik://jump/detail?id=131543&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularity above 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\",\"Romantic\"],\"title\":\"Filing for Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260513/1778661127116_a0ab0c395b95e7ff33fbf6731224726e8jUfpHfzJXfrnDJ6yztj8jRWfYB.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":140703,\"imageUrl\":\"https://img.netpop.app/cover/20260513/1778661121445_9ab2548dc2b9d11f46aaeb2a0cf3145dcDLlx3tQbDvYJmMzjS1LJldxvlr.webp\",\"introduction\":\"The collapse of teachers' Authority, the establishment of the Teachers' Authority Protection Bureau under the Ministry of Education, and the dispatch of supervisors to problem schools to punish students and parents who cross the line.\",\"jumpAddress\":\"tiktik://jump/detail?id=140703&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Crime list Top 2\",\"rankId\":312,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Action\",\"Adventure\",\"Comedy\"],\"title\":\"Teach You a Lesson\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260326/1774503497427_6412c4c7712c99383bbe7eb97b04b212aEkOe6JWqkpHdhri3bWQzZ57vgz.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":131368,\"imageUrl\":\"https://img.netpop.app/cover/20260326/1774503490868_2b95967cc335d424b80f323cc6dda7abs41iS2OWYDXIhJ3IEFepK3hEeWV.jpg\",\"introduction\":\"A healing romantic comedy that follows two individuals who pour their hearts into their work every day, yet feel like they have big holes in their hearts.\\nMatthew Lee, runs the world’s only farm that produces miracle ingredients, CEO and lead researcher of a natural cosmetics ingredient company.\\nDam Ye Jin, an ace home shopping host known for her streak of sell-out successes. She handles a wide range of products with expertise, but her intense dedication to work has led her to suffer from chronic, severe insomnia.\",\"jumpAddress\":\"tiktik://jump/detail?id=131368&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularity above 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"Sold out on You\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260407/1775544772303_c4098b1adc84cae489c04c877a153d4asWgf0zfmjKiwXl5ND2b9apkChkV.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":132497,\"imageUrl\":\"https://img.netpop.app/cover/20260407/1775544768394_de1b69fa7e464659fa9efa27ac84d699wY4rhPE90jJ4bp1JZOFY0MeRJQX.webp\",\"introduction\":\"Yeo Eui Ju an ordinary high school student who is average in every way and tries to keep a low profile at school. But at night, she secretly becomes a writer, posting daring adults-only BL novels online. Despite her enthusiasm, her work barely gets any views. Though highly observant and empathetic, she has always been hopeless when it comes to real-life romance. However, her life as a writer takes an unexpected turn when four handsome new teachers arrive at her school.\\n\\nAmong them is Ga U Su, a cold and brilliant math prodigy from a family of renowned mathematicians, who gave up studying abroad after a life-changing incident nearly cost him his vision. No Da Ju, a playful and mischievous Japanese teacher born to a wealthy family, is a gifted polyglot fluent in multiple languages and U Su’s longtime friend, despite their constant squabbling. Jung Gi Jeon, a former luge athlete forced to retire due to injury, is now a warm but clumsy sports teacher who is popular among students and sees Eui Ju as his next prodigy, recognizing her exceptional talent in running. Lastly, Yun Dong Ju is a warm-hearted and modest Korean teacher who is respectful and soft-spoken, treats his students with respect, always uses honorifics, and never loses his temper.\\n\\nAs these four charming new teachers arrive at her school, they become her unexpected muses. Their presence turns both her everyday life and her writing upside down.\",\"jumpAddress\":\"tiktik://jump/detail?id=132497&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"Absolute Value of Romance\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260331/1774945311097_5e69769f41025d89c8819f6f0c39b2ba2.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":131879,\"imageUrl\":\"https://img.netpop.app/cover/20260422/1776825522555_54b9157cfe31a730e87e7c9a284e819fixBHQ96ryMa8Q0uIOFdUCjqRyy8.webp\",\"introduction\":\"Kim Hui Ju works as a security screening agent at an international airport. Due to her boyfriend Lee Do Gyeong, who works as a co-pilot for an airline, she accidentally receives gold from a smuggling organization. Kim Hui Ju becomes obsessed with the gold. She becomes the center of chaos, greed, and betrayal involving various people, including loan shark employee Jang Uk, detective Kim Jin Man, and executive Park Ho Cheo from the gang Geumsung, engaged with the hotel casino Gold Land.\",\"jumpAddress\":\"tiktik://jump/detail?id=131879&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":7,\"rankDesc\":\"Horror list Top 5\",\"rankId\":126,\"rankType\":1},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Crime\",\"Drama\",\"Thriller\"],\"title\":\"Gold Land\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260407/1775532017526_8767735102c6198b58ec344ec452bb144jECasHMehKXtRJE5Q7e53ggGy1.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":132438,\"imageUrl\":\"https://img.netpop.app/cover/20260407/1775532013300_e9cde2e154870b9ff15f15bdc74ae9b2vYJAhjmcVz50uhJwFl5wjTHsdT4.webp\",\"introduction\":\"Kang Tae Ju is a person who starts chasing the criminal after a serial murder case in his hometown, where he returned as a police officer with a strong competitive attitude.\",\"jumpAddress\":\"tiktik://jump/detail?id=132438&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Crime\",\"Drama\",\"Thriller\"],\"title\":\"The Scarecrow\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260311/1773217809195_7dd5a1285dda75d5f835464419a71e69zOEfzdJnGshxmYpJmgzh333zm7x.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":129749,\"imageUrl\":\"https://img.netpop.app/cover/20260408/1775635810361_59a2c7380cd1a607452793c97c4e0794hMrBaA68y4mlmE5zjC3NM2cN1IV.jpg\",\"introduction\":\"A jealous, envious man seeks inner peace while feeling isolated in a world where others seem to succeed.\",\"jumpAddress\":\"tiktik://jump/detail?id=129749&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":8.2,\"showMark\":true,\"tagList\":[\"Drama\"],\"title\":\"We Are All Trying Here\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260319/1773903424482_050dab8a57519b2c9ea40985d651fbe7柔美的细胞小将 第三季1.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":130711,\"imageUrl\":\"https://img.netpop.app/cover/20260413/1776075284334_8f33737e6e712886eb264a8fbb52f418eXpJ1Fg96NLqWyJpFgROVvdsMB.webp\",\"introduction\":\"After quitting her job, Yu Mi became a star writer at the peak of her fame, with her \\\"Writer Cell\\\" taking charge over \\\"Love Cell.\\\" But the sweetness of success doesn’t last forever. Her days soon turn dull and monotonous until a man named Sun Rok steps into her life. Facing this younger man, Yu Mi discovers a new kind of love — unexpected, disarming, and deeply stirring.\\nOnce a common to-go girl in her 30s, Kim Yu Mi is now a celebrated romance novelist. But with no more new goals or challenges, her cells have fallen asleep, leaving her days lifeless—until Sun Rok appears. Yu Mi learns that even a star romance writer can be a total rookie when it comes to real love.\\nSin Sun Rok, an editor in his 20s at Julie Publishing, is all about facts, logic, and boundaries, feeling perfectly relaxed when staying home alone. But as Yu Mi starts to invade his world, he draws a line—only to find himself slowly, irresistibly, falling for her.\",\"jumpAddress\":\"tiktik://jump/detail?id=130711&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"Yumi's Cells Season 3\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260226/1772087336616_d6f889b7b2967f50d39493f32c5ab0bd5SJuxX2g5kWMZBq0jEjWV02L2c2.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":128122,\"imageUrl\":\"https://img.netpop.app/cover/20260226/1772087332005_c06bad7e726c68261140e72fa7e687925SJuxX2g5kWMZBq0jEjWV02L2c2.webp\",\"introduction\":\"Gemini said Possessed lawyer Shin Irang resolves the deep grudges of the dead. He joins Han Nahyeon, a cold elite attorney who bets everything on winning, in a strange yet heartwarming adventure of supernatural justice.\",\"jumpAddress\":\"tiktik://jump/detail?id=128122&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":{\"groupId\":null,\"rankDesc\":\"Popularity above 10000\",\"rankId\":null,\"rankType\":0},\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Drama\",\"Fantasy\",\"Suspense\"],\"title\":\"Phantom Lawyer\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260312/1773280481204_311d799dfcfc691cac47505d40e78860l0p6O6_3f.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":129788,\"imageUrl\":\"https://img.netpop.app/cover/20260312/1773280376387_3bc1291b0abe28d6211885f176a8e07dcPpO3FsWxwaw9kQP0QLLZ1Swy2R.webp\",\"introduction\":\"In order to pay off their debt, three daring youths jump into the money-lending business while confronting the rich and powerful who prey on the weak.\",\"jumpAddress\":\"tiktik://jump/detail?id=129788&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":7,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Action\",\"Crime\"],\"title\":\"Bloodhounds season2\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260212/1770893001506_0844ac9120ad98d5019a713e12353101pHhGVPOi9qI6CVYIrgZ2VWflg0u.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":127566,\"imageUrl\":\"https://img.netpop.app/cover/20260212/1770892997992_ecb51be2d2297970a5a16ffc3ab982bddc4YYEMeoiYLas0ao5UZugXeSSo.webp\",\"introduction\":\"Depicts the story of Sunwoo Chan, who lost his hearing and memory through an accident, and Song Ha Ran who becomes his savior.\\n\\nSunwoo Chan is a bright and lively animator who works at an American animation studio. Despite his cheerful energy and positive facade, he’s a mysterious figure who hides a lot of secrets.\\n\\nSong Ha Ran, the eldest among three siblings and a renowned designer. Her natural artistic sense, creativity, and work ethic have earned her a solid reputation in the industry. While she gets along well with everyone, she secretly hopes to not form any special bonds with anyone.\",\"jumpAddress\":\"tiktik://jump/detail?id=127566&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romantic\"],\"title\":\"In Your Radiant Season\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260126/1769416724684_e7f768ad2c28925e6f82cd072e5a6838fdeQbvNLXhu7bwxmlWiSMOYjVPh.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":125703,\"imageUrl\":\"https://img.netpop.app/cover/20260227/1772181251039_678642cc613abf699bfe8f259f434b758r8YU97YfSf6QtMKfePmTqhFTeQ.webp\",\"introduction\":\"A mystery melo who depicts the story of a dangerous woman who may be a serial killer, and a man who falls in love while tracking her.\",\"jumpAddress\":\"tiktik://jump/detail?id=125703&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Suspense\",\"Romantic\",\"Thriller\"],\"title\":\"Siren’s Kiss\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260304/1772595324602_56c981278bd817a7f211619661eec2d2pclFMJZcw5g1cBSXV9FJ0t3bqdx.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":128952,\"imageUrl\":\"https://img.netpop.app/cover/20260304/1772595317753_ded0ef7c628a9f9ffaab7d39474ba0eaAvWzvm2MwNKHB3Xf90FBBnVpMuj.jpg\",\"introduction\":\"In Korea, nothing defines success more than owning a building. Ki Su Jong, once an ordinary office worker, believes that going all in—risking everything and drowning in debt—to finally become a landlord will be his way out. But when global capital swoops in and threatens to push his building into foreclosure, Su Jong clings to a desperate plan with his best friend: a staged kidnapping in the building’s basement that spirals into a real one. Trapped in a chain of crimes that could destroy his life or save it, Su Jong is forced to make impossible choices. How far will he go to keep his dream from collapsing?\",\"jumpAddress\":\"tiktik://jump/detail?id=128952&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Crime\",\"Thriller\"],\"title\":\"Mad Concrete Dreams\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260123/1769135790462_b05a8771583067f0fe9662c04f264d7dpractical-guide-to-love-04-1.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":125098,\"imageUrl\":\"https://img.netpop.app/cover/20260227/1772174935969_5e4c83000021cc1552b1471c4bc69806AhZDz5309V0zsZfUyF4cilkUM4T.webp\",\"introduction\":\"A story about a woman who has decided to fall in love and meets two men with different charms on a blind date, and discovers the true meaning of love. Lee Ui Yeong is the representative of the hotel purchasing team.\",\"jumpAddress\":\"tiktik://jump/detail?id=125098&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Romantic\"],\"title\":\"The Practical Guide to Love\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260313/1773386050594_9282f47bbd6212446fcd0e2703a7bb5d申医生U.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":130012,\"imageUrl\":\"https://img.netpop.app/cover/20260313/1773386044439_d35084e7cb69d9e487da0e098f0c7e7c申医生.jpg\",\"introduction\":\"A medical thriller melodrama depicting the events that unfold between a genius doctor and the woman he loves after a chance accident.\",\"jumpAddress\":\"tiktik://jump/detail?id=130012&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Fantasy\",\"Romantic\",\"Thriller\"],\"title\":\"Doctor Sin\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251231/1767161820144_14cc5432155dc1c9b6fb2d97613e5e236yyKOxjQgb0C3I43T6qyXbieHni.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":121373,\"imageUrl\":\"https://img.netpop.app/cover/20251231/1767161816834_560b9ef0f23be213c9d60e3b05694332bZr3i8yczHGDzyqZQ9oOArEEVON.webp\",\"introduction\":\"Set in the late 1990s, Hong Geum-bo, an elite securities supervisor in his 30s, disguises himself as a 20-year-old junior employee at a securities company where suspicious money flows are detected.\",\"jumpAddress\":\"tiktik://jump/detail?id=121373&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":16,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Comedy\",\"Crime\",\"Romantic\"],\"title\":\"Undercover Miss Hong\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260226/1772088529685_7e6f1ba412833c2bf60e4005963194a2依然闪亮s.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":128141,\"imageUrl\":\"https://img.netpop.app/cover/20260226/1772088520926_1180630251d5a3514d23e567330ef0e9依然闪亮.webp\",\"introduction\":\"A story in which young people who share a world of their own become each other’s confidants and the light that illuminates their lives.\\nYeon Tae Seo is a subway driver with a sharp perspective on the world. Tae Seo is an independent person who lives faithfully to the present, focusing on \\\"just today\\\" rather than the future or dreams. While successfully achieving his longed-for independence and settling down, he encounters Mo Eun A, his first love from when he was nineteen, which gently stirs up ripples in his daily life.\\nMo Eun A is a former hotelier turned Seoul lodging manager brimming with passion, depth, and lovable charm. Setting goals for herself—where, with whom, what, and how—she experiences small triumphs and major setbacks until she reunites with her first love, Yeon Tae Seo.\",\"jumpAddress\":\"tiktik://jump/detail?id=128141&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":10,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Romantic\",\"Youth\"],\"title\":\"Still Shining\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260202/1770046179175_3b0d2feb405931f6e78581320be7faf8ywlngnpPRj2ijZcUi8LSaUUi7yF.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":124363,\"imageUrl\":\"https://img.netpop.app/cover/20260202/1770046164994_7d7f669ca7675300f592f45612f9cf4ckxTZS9V7jSVpI703DC8t2mYNVKy.webp\",\"introduction\":\"Three lawyers who are longtime friends who met in college. When a secret buried for two decades resurfaces and disrupts their lives, the women fight back with persistence and determination, showing an unbreakable bond and resilience.\",\"jumpAddress\":\"tiktik://jump/detail?id=124363&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":12,\"resourceStatus\":2,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Crime\",\"Drama\",\"Suspense\"],\"title\":\"Honour\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20251219/1766130096143_0ceabd0355f1db3777c10bfc3040ee011ZeVzjPZi1OEhbIWRgj5W62hyuZ.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":119013,\"imageUrl\":\"https://img.netpop.app/cover/20260108/1767850707603_bf727673caa27118330f47fe27446eb9bSX49M4tjDsnC8dOVQxt1sLgH6z.webp\",\"introduction\":\"Eun Ho is a gumiho, known in folklore as a mythical creature with 9 tails. She is different from other gumihos. She doesn't want to become a human unlike other gumihos. She enjoys her eternal youth that never changes. She picks out the fun parts in the human world and enjoys them herself. To avoid becoming a human, she refrains from small virtues and accumulating small bad deeds. One day, an unexpected incident takes place.\",\"jumpAddress\":\"tiktik://jump/detail?id=119013&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"