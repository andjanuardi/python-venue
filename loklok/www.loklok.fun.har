,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260607/1780803484555_fe81220b7a9109373fa4a17be81c48cciw1knpC8Jg5davMn2MPxNVxBF8N.webp\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":147707,\"imageUrl\":\"https://img.netpop.app/cover/20260607/1780803477075_035a9d7241ac50eaceb0a732a33640cap2932389853.jpg\",\"introduction\":\"A vampire tells his epic story of love, blood, and the perils of immortality to a journalist.\",\"jumpAddress\":\"tiktik://jump/detail?id=147707&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":6,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Fantasy\",\"Horror\",\"Romantic\"],\"title\":\"Anne Rice's The Vampire Lestat\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260605/1780626383016_da01d1df72b0acb01051a65d48d36cd667d7dSnCeGxjbyCXn7giFtjPN2k.jpg\",\"dramaTypeVo\":{\"dramaName\":\"drama\",\"dramaType\":\"TV\"},\"id\":147409,\"imageUrl\":\"https://img.netpop.app/cover/20260605/1780626379593_11e06b3b89d92ddce843924a09f13774mpZjJ0yOxMX2GCCXJ4viTZKhdRX.jpg\",\"introduction\":\"A happily married couple faces a growing threat when a notorious killer from their past, Max Cady, is released from prison and seeks revenge.\",\"jumpAddress\":\"tiktik://jump/detail?id=147409&type=1\",\"jumpType\":\"\",\"onlineTime\":\"\",\"rankInfo\":null,\"releaseTime\":2026,\"reserveNum\":\"\",\"reserved\":false,\"resourceNum\":8,\"resourceStatus\":1,\"score\":9.0,\"showMark\":true,\"tagList\":[\"Crime\",\"Drama\",\"Thriller\"],\"title\":\"Cape Fear\",\"titleCenter\":false,\"videoName\":\"\"},{\"category\":1,\"contentType\":\"DRAMA\",\"cornerInfoList\":[],\"coverHorizontalUrl\":\"https://img.netpop.app/cover/20260527/1779852509396_fd76b6d1d9a6458e5b61fdb00ebae6b0好女孩的谋